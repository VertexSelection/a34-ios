# /a34/backboardd.env: KEY=VALUE lines that a34gl-bbd puts into backboardd's environment before
# it execs the real backboardd (copy this file to /a34/backboardd.env to use it; # starts a comment
# line). Not read with boot-arg a34gl=0. The launchd job's EnvironmentVariables work as well
# (tools/root-add-job.py --env), except for DYLD_* variables, which launchd drops.

# The log of liba34gl and its loader. backboardd runs as mobile: a file mobile may write.
A34GL_LOG=/var/mobile/a34gl.log

# Switches of eagl.c, the words the kernel's boot-args may also carry (userland/a34gl/README.md):
#A34GL=glframes=1 glcopy=1

# Everything off (CoreAnimation's software renderer) without touching launchd.plist:
#A34GL_OFF=1

# Mesa and redwood-drm:
#PAN_MESA_DEBUG=sync
#REDWOOD_DRM_DEBUG=1
#EGL_LOG_LEVEL=debug
