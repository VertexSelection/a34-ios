    inputs.fau.pushable_ubos = BITFIELD_BIT(0);
+#ifdef __APPLE__
+   /* A34 (patch 0012; HackiOS's "pushubo", MIT, Darwin on redwood contributors): every UBO of
+    * a Metal driver's shader (label "air") may be pushed. Its uniforms are in buffers 1 and up,
+    * which upstream leaves as loads from memory for every pixel; the driver binds each as its
+    * buffer AND that buffer's processor mapping (air_metal.c, bind_stage), and
+    * panfrost_emit_const_buf reads the pushed words from the mapping. REDWOOD_PAN_PUSHUBO=0
+    * (the plug-in's rwm_pushubo=0) pushes only UBO 0, as upstream -- for shaders compiled from
+    * then on: the disk cache keeps what it has. */
