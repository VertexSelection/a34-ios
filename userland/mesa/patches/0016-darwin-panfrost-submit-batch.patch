+#ifdef __APPLE__
+/*
+ * A34 (patch 0016): in a process drawing through Metal, a batch's vertex/tiler chain and its
+ * fragment job in ONE request to the kernel (redwood-drm's redwood_drm_submit_batch over kernel
+ * 0988's SUBMIT_BATCH) instead of one each -- ~35 us a request, two a batch, ~15 batches a frame
+ * (boot 0980-b). Both name the same buffers, gathered once. ENOTSUP when the kernel or the mode
+ * has no SUBMIT_BATCH, nothing then queued: the caller sends the two as before.
+ */
+static int
+redwood_jm_submit_pair(struct panfrost_batch *batch, uint32_t reqs, uint32_t out_sync)
+{
+   struct panfrost_context *ctx = batch->ctx;
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+
+   if (!redwood_drm_submit_batch)
+      return ENOTSUP;
+
+   uint32_t *bo_handles = calloc(panfrost_pool_num_bos(&batch->pool) +
+                                    panfrost_pool_num_bos(&batch->invisible_pool) +
+                                    batch->num_bos + 2,
+                                 sizeof(*bo_handles));
+   if (!bo_handles)
+      return ENOMEM;
+
+   uint32_t count = 0;
+   pan_bo_access *flags = util_dynarray_begin(&batch->bos);
+   unsigned end_bo = util_dynarray_num_elements(&batch->bos, pan_bo_access);
+
+   for (unsigned i = 0; i < end_bo; ++i) {
+      if (!flags[i])
+         continue;
+      bo_handles[count++] = i;
+   }
+   panfrost_pool_get_bo_handles(&batch->pool, bo_handles + count);
+   count += panfrost_pool_num_bos(&batch->pool);
+   panfrost_pool_get_bo_handles(&batch->invisible_pool, bo_handles + count);
+   count += panfrost_pool_num_bos(&batch->invisible_pool);
+   if (batch->jm.jobs.vtc_jc.first_tiler)
+      bo_handles[count++] = panfrost_bo_handle(dev->tiler_heap);
+   bo_handles[count++] = panfrost_bo_handle(dev->sample_positions);
+
+   struct drm_panfrost_submit submits[2] = {
+      {
+         .jc = batch->jm.jobs.vtc_jc.first_job,
+         .bo_handles = (uint64_t)(uintptr_t)bo_handles,
+         .bo_handle_count = count,
+         .requirements = reqs,
+         .jm_ctx_handle = ctx->jm.handle,
+      },
+      {
+         .jc = batch->jm.jobs.frag,
+         .out_sync = out_sync,
+         .bo_handles = (uint64_t)(uintptr_t)bo_handles,
+         .bo_handle_count = count,
+         .requirements = reqs | PANFROST_JD_REQ_FS,
+         .jm_ctx_handle = ctx->jm.handle,
+      },
+   };
+
+   int ret = redwood_drm_submit_batch(submits, 2) == 0 ? 0 : errno;
+   free(bo_handles);
+   if (ret == 0) {
+      /* the buffers' accesses reported once, for the pair (jm_submit_jc does it per job) */
+      for (unsigned i = 0; i < end_bo; ++i) {
+         if (flags[i])
+            panfrost_context_report_bo_access(ctx, pan_lookup_bo(dev, i), flags[i]);
+      }
+   }
+   return ret;
+}
+#endif
+
