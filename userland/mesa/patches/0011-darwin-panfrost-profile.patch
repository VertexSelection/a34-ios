 #define foreach_batch(ctx, idx)                                                \
    BITSET_FOREACH_SET(idx, ctx->batches.active, PAN_MAX_BATCHES)
 
+/* A34 (patch 0011): what stores and loads cost in a batch pool's memory against malloc's, once
+ * per Metal process, at its first batch (redwood_pan_prof.h, redwood_pan_memtest). The pool's
+ * buffer is fresh: nothing has been allocated from it yet, and what is written here is written
+ * over by the descriptors that will be. */
+uint64_t redwood_pan_memtest[RWP_MEM_SLOTS];
+static volatile uint32_t redwood_pan_memtest_sink;
+
+static void
+redwood_pan_measure_memory(struct panfrost_pool *pool)
+{
+   static bool done;
+
+   if (done || !redwood_pan_metal || !pool->transient_bo || !pool->transient_bo->ptr.cpu ||
+       panfrost_bo_size(pool->transient_bo) < 8192)
+      return;
+   done = true;
+
+   uint32_t *ram = malloc(8192), *src = malloc(4096);
+   if (!ram || !src) {
+      free(ram);
+      free(src);
+      return;
+   }
+   memset(ram, 0, 8192);
+   memset(src, 0x5a, 4096);
+   volatile uint32_t *where[2] = { (volatile uint32_t *)pool->transient_bo->ptr.cpu,
+                                   (volatile uint32_t *)ram };
+   for (unsigned m = 0; m < 2; m++) {
+      volatile uint32_t *w = where[m];
+      uint32_t sum = 0;
+
+      for (unsigned i = 0; i < 2048; i++)   /* first touch, not timed */
+         w[i] = 0;
+      uint64_t t0 = os_time_get_nano();
+      for (unsigned i = 0; i < 1024; i++)
+         w[i] = i * 2654435761u;
+      uint64_t t1 = os_time_get_nano();
+      memcpy((void *)(w + 1024), src, 4096);
+      uint64_t t2 = os_time_get_nano();
+      for (unsigned i = 0; i < 1024; i++)
+         sum += w[i];
+      uint64_t t3 = os_time_get_nano();
+      redwood_pan_memtest_sink = sum;
+      redwood_pan_memtest[m ? RWP_MEM_RAM_STORE : RWP_MEM_POOL_STORE] = t1 - t0;
+      redwood_pan_memtest[m ? RWP_MEM_RAM_COPY : RWP_MEM_POOL_COPY] = t2 - t1;
+      redwood_pan_memtest[m ? RWP_MEM_RAM_LOAD : RWP_MEM_POOL_LOAD] = t3 - t2;
+   }
+   free(ram);
+   free(src);
+}
