Darwin: which written-back targets are sampled again in the same work, for the profile.

A34 (local to this port; nothing here goes upstream). In boot 1001-120-a every pass wrote its
colour target back (3932 write-backs for 3932 passes). A write-back nothing reads is one a
DontCare store could save. In a process drawing through Metal, the targets written back in a
span of work are kept with their size (patch 0019's re-entry table, moved to file scope), and
panfrost_batch_read_rsrc marks one as sampled when a later batch reads it. When the span ends,
those not sampled after (IOSurfaces left out: they are shown, or another process's) are counted
with their KB, and the others too; the traced pass that wrote one says "sampled after" or "not
sampled after in this work". Something CoreAnimation keeps for a later frame (a layer rendered
once) shows as not sampled here, so this is where to look, not a list of what to drop.

--- a/src/gallium/drivers/panfrost/pan_job.c
+++ b/src/gallium/drivers/panfrost/pan_job.c
@@ -228,13 +228,54 @@
 extern uint64_t redwood_drm_last_seq(void) __attribute__((weak_import));
 #endif
 
+/*
+ * (patch 0021) The targets written back in this span of work, and whether anything sampled them
+ * after (panfrost_batch_read_rsrc): a target written out and never read again in the same work,
+ * and not an IOSurface (shown, or another process's), is one whose write-back a DontCare store
+ * would have saved -- unless it is read in a later frame (a layer CoreAnimation keeps). Counted when
+ * the span ends; the traced pass that wrote it says "read later" when one did.
+ */
+static struct {
+   const void *res;
+   uint64_t kb;
+   bool shared, read;
+   int trace_slot;
+} redwood_written[64];
+static unsigned redwood_nwritten;
+static uint64_t redwood_written_span = ~0ull;
+
+static void
+redwood_pan_written_tally(void)
+{
+   for (unsigned k = 0; k < redwood_nwritten; k++) {
+      if (!redwood_written[k].shared && !redwood_written[k].read) {
+         redwood_pan_prof[RWP_WB_UNREAD]++;
+         redwood_pan_prof[RWP_WB_UNREAD_KB] += redwood_written[k].kb;
+      } else if (!redwood_written[k].shared) {
+         redwood_pan_prof[RWP_WB_READ]++;
+      }
+   }
+   redwood_nwritten = 0;
+}
+
+static void
+redwood_pan_note_read(const struct panfrost_resource *rsrc)
+{
+   for (unsigned k = 0; k < redwood_nwritten; k++) {
+      if (redwood_written[k].res == &rsrc->base) {
+         redwood_written[k].read = true;
+         int slot = redwood_written[k].trace_slot;
+         if (slot >= 0 && slot < (int)redwood_pan_trace_n)
+            redwood_pan_trace[slot].read_later = true;
+         return;
+      }
+   }
+}
+
