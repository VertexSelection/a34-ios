+/*
+ * A34 (from HackiOS, Darwin on redwood, tools/mesa/panfrost-redwood-perf.patch): a 16-bit
+ * UBO load at a constant offset as a 32-bit load and a shift and truncation per half.
+ * Only for shaders of the Metal driver (nir->info.label "air", set by the AIR frontend);
+ * boot-arg widen16=0 leaves them as they are.
+ */
+static bool
+redwood_widen_ubo16(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   (void)data;
+   if (intr->intrinsic != nir_intrinsic_load_ubo || intr->def.bit_size != 16 ||
+       !nir_src_is_const(intr->src[1]))
+      return false;
+
+   uint32_t at = nir_src_as_uint(intr->src[1]);
+   unsigned comps = intr->def.num_components;
+   uint32_t first = at & ~3u, words = ((at & 3u) + 2 * comps + 3) / 4;
+
+   if (words > 4)
+      return false;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *w = nir_load_ubo(b, words, 32, intr->src[0].ssa, nir_imm_int(b, first),
+                             .align_mul = 4, .align_offset = 0, .range_base = 0,
+                             .range = nir_intrinsic_range(intr));
+   nir_def *halves[NIR_MAX_VEC_COMPONENTS];
+
+   for (unsigned i = 0; i < comps; i++) {
+      unsigned byte = (at & 3u) + 2 * i;
+      nir_def *word = nir_channel(b, w, byte / 4);
+
+      /* (a shift and a truncation: the unpack_32_2x16 opcodes are lowered by now) */
+      halves[i] = nir_u2u16(b, (byte & 2) ? nir_ushr_imm(b, word, 16) : word);
+   }
+   nir_def_replace(&intr->def, nir_vec(b, halves, comps));
+   return true;
+}
+
+static bool
+redwood_is_metal_shader(const nir_shader *nir)
+{
+   return nir->info.label != NULL && strcmp(nir->info.label, "air") == 0;
+}
+
+static bool
+redwood_widen16_off(void)
+{
+   static int off = -1;
+
+   if (off < 0) {
+      char args[1024] = "";
+      size_t n = sizeof(args) - 1;
+
+      off = sysctlbyname("kern.bootargs", args, &n, NULL, 0) == 0 && strstr(args, "widen16=0") != NULL;
+   }
+   return off;
+}
+#endif
