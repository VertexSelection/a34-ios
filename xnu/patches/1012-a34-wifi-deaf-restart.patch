+/* (1012) the last scan heard nothing at all: the firmware counted no beacon on 20+ channels and forwarded no frame */
+static bool a34w_last_scan_deaf;
+static uint32_t a34w_deaf_scans, a34w_restarts;
+#define DEAF_SCANS                      3u      /* scans, 5 s apart, before a start is called deaf */
+static uint32_t a34w_restarts_most = 1;  /* firmware restarts a boot: kern.a34wifi.restarts_most, boot-arg a34wifirestarts */
+
 static bool
