 {
@@ -2107,15 +2124,136 @@ a34w_scan_for(const char *who, bool stay, const uint8_t *ssid, uint32_t ssid_len
 	a34w_say("%s: SCAN_DONE in %llu ms: scan %u (asked %u), %u channels done, state %u, version %u, %u beacons "
 	    "counted by the firmware; %u frames forwarded", who, (unsigned long long)(a34w_ms() - t0), done[0], a34w_scan_seq,
 	    done[4], done[5], done[6], a34w_le32(done + 8), a34w_rx_frames - frames0);
+	a34w_last_scan_deaf = done[4] >= 20u && a34w_le32(done + 8) == 0 && a34w_rx_frames == frames0;
+	a34w_deaf_scans = a34w_last_scan_deaf ? a34w_deaf_scans + 1u : 0;
