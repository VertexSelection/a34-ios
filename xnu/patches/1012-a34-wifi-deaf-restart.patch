+/* (1012) a scan, and while it hears nothing at all two more, 5 s apart */
+static bool
+a34w_scan_sure(const char *who, bool stay)
+{
+	for (uint32_t i = 1;; i++) {
+		if (!a34w_scan(who, stay)) {
+			return false;
+		}
+		if (!a34w_last_scan_deaf || i >= DEAF_SCANS) {
+			return true;
+		}
+		a34w_say("%s: not one beacon on any channel (the firmware counted none): scanning again in 5 s (%u of %u)", who,
+		    i + 1u, DEAF_SCANS);
+		sweet_log_flush();
+		delay(5000000);
+	}
+}
+
+/*
+ * (1012) WFSYS off, as soc5_0.c wf_pwr_off_consys_mcu does it (Android, at every Wi-Fi off):
+ * conn_infra kept awake, the bus sleep protection on, WFSYS_ON_TOP off and its reset seen,
+ * WFSYS's semaphore reset, the A-die's top clock 1 off, the EMI/infra requests toggled.
+ * conn_infra and Bluetooth stay as they are.
+ */
+#define WFSYS_SW_RST_B                  0x00140u        /* CONN_INFRA_RGU + 0x140: WFSYS's semaphore */
+#define WB_SLP_TOP_CK_1                 0x05124u        /* conn_wt_slp_ctl: the A-die's top clock 1 (Wi-Fi) */
+#define CONN_CFG_WFSYS_EMI_REQ          0x01414u
+
+static bool
+a34w_wf_off(void)
+{
+	uint32_t v = 0;
+	bool ok = true;
+
+	a34w_mbox_ready = false;
+	a34w_data_rings = false;
+	a34w_set(a34w_conn, HOST_WAKEPU_WF, 1u);
+	if (!a34w_poll_mask(a34w_conn, CONN_CFG_IP_VERSION, 0xffffffffu, CONN_HW_VER, 10, 1000, &v)) {
+		a34w_say("Wi-Fi off: conn_infra did not wake (IP version 0x%08x)", v);
+		return false;
+	}
+	a34w_set(a34w_conn, CONN_CFG_WF_SLP_CTRL, 1u);  /* conn_infra <-> WFSYS / WFDMA sleep protection on */
+	if (!a34w_poll_mask(a34w_conn, CONN_CFG_WF_SLP_STATUS, 1u << 25, 1u << 25, 100, 500, &v)) {
+		a34w_say("Wi-Fi off: WFDMA to conn_infra sleep protection not ready (0x%08x); going on", v);
+	}
+	for (uint32_t i = 0; i <= 100u && ((v = a34w_rd(a34w_conn, CONN_CFG_WF_SLP_STATUS)) & 0xa0000000u) == 0; i++) {
+		delay(500);
+	}
+	if ((v & 0xa0000000u) == 0) {
+		a34w_say("Wi-Fi off: WFSYS to conn_infra sleep protection not ready (0x%08x); going on", v);
+	}
+	v = a34w_rd(a34w_conn, CONN_RGU_WFSYS_ON_TOP_PWR_CTL);
+	a34w_wr(a34w_conn, CONN_RGU_WFSYS_ON_TOP_PWR_CTL, (v & 0x0000ff7fu) | 0x57460000u);    /* key 0x5746, off */
+	if (!a34w_poll_mask(a34w_conn, HOST_DBG_DUMMY_3, 1u << 30, 0, 10, 500, &v)) {
+		a34w_say("Wi-Fi off: WFSYS still powered (DBG_DUMMY_3 0x%08x)", v);
+		ok = false;
+	}
+	a34w_clr(a34w_conn, WFSYS_SW_RST_B, 1u);
+	a34w_set(a34w_conn, WFSYS_SW_RST_B, 1u);
+	a34w_clr(a34w_conn, WB_SLP_TOP_CK_1, 1u);
+	if (!a34w_poll_mask(a34w_conn, WB_SLP_TOP_CK_1, 1u << 1, 0, 100, 500, &v)) {
+		a34w_say("Wi-Fi off: the A-die's top clock 1 still on (0x%08x); going on", v);
+	}
+	a34w_set(a34w_conn, CONN_CFG_WFSYS_EMI_REQ, 1u);
+	a34w_clr(a34w_conn, CONN_CFG_WFSYS_EMI_REQ, 1u);
+	a34w_set(a34w_conn, CONN_CFG_WFSYS_EMI_REQ, 1u << 5);
+	a34w_clr(a34w_conn, CONN_CFG_WFSYS_EMI_REQ, 1u << 5);
+	delay(50);
+	/* what the next start polls for must not be left from this one: the ROM's mailbox, the ready bits */
+	v = a34w_rd(a34w_conn, HOST_MAILBOX_DBG);
+	a34w_wr(a34w_conn, HOST_MAILBOX_DBG, 0);
+	a34w_mask(a34w_conn, HOST_SW_SYNC0, 3u, 0);
+	a34w_say("Wi-Fi off: %s; ROM mailbox 0x%08x -> 0x%08x, CONN_ON_MISC 0x%08x, A-die top clock 1 0x%08x", ok ? "WFSYS off" :
+	    "WFSYS NOT OFF", v, a34w_rd(a34w_conn, HOST_MAILBOX_DBG), a34w_rd(a34w_conn, HOST_SW_SYNC0),
+	    a34w_rd(a34w_conn, WB_SLP_TOP_CK_1));
+	a34w_clr(a34w_conn, HOST_WAKEPU_WF, 1u);
+	return ok;
+}
+
+/* (1012) the firmware started again: WFSYS off, steps 4-6 */
+static bool
+a34w_restart(const char *who)
+{
+	bool ok;
+
+	a34w_restarts++;
+	a34w_say("%s: the radio hears nothing at all (%u scans without a beacon on any channel; FW_FINISH took %llu ms): "
+	    "the Wi-Fi firmware is started again (%u of %u this boot)", who, a34w_deaf_scans,
+	    (unsigned long long)a34w_fw_finish_ms, a34w_restarts, a34w_restarts_most);
+	a34w_say("%s: before: radio status 0x%08x, A-die top clocks 0x%08x/0x%08x, CONN_ON_MISC 0x%08x, LPCTL 0x%08x, WF sleep "
+	    "status 0x%08x", who, a34w_rd(a34w_conn, SYSRAM_RADIO_STATUS), a34w_rd(a34w_conn, WB_SLP_TOP_CK_1 - 4u),
+	    a34w_rd(a34w_conn, WB_SLP_TOP_CK_1), a34w_rd(a34w_conn, HOST_SW_SYNC0), a34w_rd(a34w_conn, HOST_LPCTL),
+	    a34w_rd(a34w_conn, CONN_CFG_WF_SLP_STATUS));
+	sweet_log_flush();
+	if (!a34w_wf_off()) {
+		return false;
+	}
+	a34w_restarting = true;
+	ok = a34w_step4() && a34w_step5() && a34w_step6();
+	a34w_restarting = false;
+	a34w_deaf_scans = 0;
+	a34w_say("%s: the Wi-Fi firmware %s", who, ok ? "runs again" : "did NOT start again");
+	return ok;
+}
+
+/* step 7: a scan (three while nothing at all is heard); a deaf start restarted (once by default) */
