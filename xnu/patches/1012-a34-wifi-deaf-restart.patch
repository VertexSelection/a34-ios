+		if (!a34w_last_scan_deaf || a34w_restarts >= a34w_restarts_most) {
+			if (a34w_last_scan_deaf) {
+				a34w_say("step 7: still nothing heard after %u restarts: going on (scans can be asked again)", a34w_restarts);
+			}
+			return true;
+		}
+		if (!a34w_restart("step 7")) {
+			return false;
+		}
+	}
 }
 
