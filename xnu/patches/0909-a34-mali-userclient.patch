 {
@@ -777,15 +1517,7 @@ am_thread(void *arg, wait_result_t result)
 	printf("A34 MALI: bring-up start (a34mali=%u, pause %u s, park %u)\n", am_mode, am_pause_s, am_park);
 	reached = am_bringup();
 	if (reached == 6) {
-		/*
-		 * TODO: start the user client here -- HackiOS's RedwoodMaliStart()
-		 * (iokit/Kernel/RedwoodMali.cpp, the panfrost-style IOKit service)
-		 * once it is ported. What a shader job needs and this WRITE_VALUE
-		 * does not comes with it: SHADER_CONFIG SC_VAR_ALGORITHM (G68
-		 * TTRX_2968/3162), JM_CONFIG IDVS group size, the 26 MHz parking
-		 * around every shader power transition, MMU fault handling.
-		 */
-		printf("A34 MALI: user client not started (RedwoodMali.cpp is not ported yet)\n");
+		am_uc_start();          /* the RedwoodMali service, for programs */
 	}
 	printf("A34 MALI: done step %u/6\n", reached);
 }
diff --git a/iokit/Kernel/arm/A34Mali.cpp b/iokit/Kernel/arm/A34Mali.cpp
new file mode 100644
index 0000000..f72b864
--- /dev/null
+++ b/iokit/Kernel/arm/A34Mali.cpp
@@ -0,0 +1,706 @@
+/*
+ * A34 (0909): the Mali-G68 for programs, as Linux's panfrost DRM driver.
+ *
+ * Ported from HackiOS's RedwoodMali, iokit/Kernel/RedwoodMali.cpp of
+ * hakios-mt6768 (github.com/oosexgang/hakios-mt6768 @ad65e1f), Apple Public
+ * Source License 2.0, which did this for the Infinix's Mali-G52. The half
+ * that touches the GPU is bsd/dev/a34_mali.c, which starts this service
+ * (RedwoodMaliStart) once its bring-up has run a job through the GPU's page
+ * tables (boot-arg a34mali=1 or 2) and the GPU has been set up for programs.
+ *
+ * A program finds the service with IOServiceMatching("RedwoodMali"), opens
+ * it (type 0) and speaks panfrost's interface, Linux's
+ * include/uapi/drm/panfrost_drm.h at driver version 1.5: every request is
+ * IOConnectCallStructMethod() with the ioctl's number as the selector (the
+ * panfrost ones 0x40 + n, DRM_COMMAND_BASE; the core DRM ones as they are)
+ * and its structure passed in and given back. What Linux does with mmap() of
+ * the device node is IOConnectMapMemory64() of the memory type that is the
+ * buffer's handle (MMAP_BO answers handle << 12 as the offset).
+ *
+ *   0x00 VERSION (the three numbers of struct drm_version: 1.5.0; the names
+ *        are the caller's), 0x09 GEM_CLOSE, 0x40 SUBMIT, 0x41 WAIT_BO,
+ *   0x42 CREATE_BO, 0x43 MMAP_BO, 0x44 GET_PARAM, 0x45 GET_BO_OFFSET,
+ *   0x48 MADVISE, 0x49 SET_LABEL_BO, 0x4a/0x4b JM_CTX_CREATE/DESTROY,
+ *   0x4c SYNC_BO, 0x4d QUERY_BO_INFO. Not here: PERFCNT_ENABLE/DUMP (0x46,
+ *   0x47, kIOReturnUnsupported), PRIME and syncobjs (the library's side).
+ *
+ * Buffers are wired kernel memory (IOBufferMemoryDescriptor), zero when made
+ * and write-combined in every mapping (the GPU is not coherent with the
+ * processors: what a program writes goes to memory, where the GPU reads it;
+ * the GPU's caches are cleaned at the end of every job), entered into the
+ * GPU's address space AS0 at addresses from 32 MB to 4 GB, 4 KB GPU pages,
+ * four to a kernel page. One address space for every program for now: a
+ * program's jobs could reach another's buffers. A heap (PANFROST_BO_HEAP,
+ * Mesa's tiler heap) gets all the GPU addresses it asks for but memory only
+ * for its first a34maliheap MB (boot-arg, default 64): panfrost grows heaps
+ * on GPU faults, this does not, and a job that needs more faults and fails.
+ * Every buffer of every program together: at most a34malimem MB (default 1024).
+ *
+ * A job chain is run to its end before SUBMIT returns (an error if it failed
+ * or did not finish in 2 s; the GPU is then reset), one at a time for every
+ * program, so a buffer has nothing to wait for, WAIT_BO answers at once,
+ * SYNC_BO has nothing to do (no mapping is cached) and the syncobjs Mesa asks
+ * about can all be answered "signalled" in the library. A buffer is freed at
+ * GEM_CLOSE or when the program goes: no job can be using it then.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+/* bsd/dev/a34_mali.c declares the same (keep them alike). */
+struct a34_mali_job {
+	uint64_t jc;                    /* in: the job chain's GPU address */
+	uint32_t requirements;          /* in: PANFROST_JD_REQ_FS (1), _CYCLE_COUNT (2) */
+	uint32_t js_status;             /* out: JSn_STATUS after it */
+	uint64_t ns;                    /* out: how long it took */
+	uint64_t fault_va;              /* out: AS0_FAULTADDRESS, meaningful when mmu_raw != 0 */
+	uint32_t mmu_raw;               /* out: MMU_INT_RAWSTAT bits of AS0 (a fault) */
+	uint32_t job_raw;               /* out: JOB_INT_RAWSTAT bits of the slot (0: no answer) */
+};
+
+extern "C" {
+/* bsd/dev/a34_mali.c; all but a34_mali_ready() with gA34MaliLock held */
+bool a34_mali_ready(void);
+bool a34_mali_param(uint32_t param, uint64_t *value);
+uint64_t a34_mali_va_alloc(uint64_t size, bool exec);
+void a34_mali_va_free(uint64_t va, uint64_t size);
+bool a34_mali_map(uint64_t va, uint64_t pa, uint64_t size);
+void a34_mali_unmap(uint64_t va, uint64_t size);
+bool a34_mali_submit(struct a34_mali_job *job);
+void a34_mali_cpu_flush(uintptr_t va, uint64_t size);
+
+bool RedwoodMaliStart(void);
+}
+
+/* The requests: Linux's include/uapi/drm/panfrost_drm.h and drm.h (as of Linux 7.x, Mesa 26). */
+enum {
+	kA34DrmVersion          = 0x00,
+	kA34DrmGemClose         = 0x09,
+	kA34PanfrostSubmit      = 0x40,
+	kA34PanfrostWaitBO      = 0x41,
+	kA34PanfrostCreateBO    = 0x42,
+	kA34PanfrostMmapBO      = 0x43,
+	kA34PanfrostGetParam    = 0x44,
+	kA34PanfrostGetBOOffset = 0x45,
+	kA34PanfrostPerfcntEnable = 0x46,
+	kA34PanfrostPerfcntDump = 0x47,
+	kA34PanfrostMadvise     = 0x48,
+	kA34PanfrostSetLabelBO  = 0x49,
+	kA34PanfrostJmCtxCreate = 0x4a,
+	kA34PanfrostJmCtxDestroy = 0x4b,
+	kA34PanfrostSyncBO      = 0x4c,
+	kA34PanfrostQueryBOInfo = 0x4d,
+};
+
+#define A34_DRIVER_MAJOR        1
+#define A34_DRIVER_MINOR        5       /* 1.6 would add SELECTED_COHERENCY and WB mmap: answered too, not needed */
+
+#define PANFROST_BO_NOEXEC      1u
+#define PANFROST_BO_HEAP        2u
+#define PANFROST_BO_WB_MMAP     4u
+#define PANFROST_JD_REQ_FS      (1u << 0)
+#define PANFROST_JD_REQ_CYCLE_COUNT (1u << 1)
+#define PANFROST_JM_CTX_PRIORITY_HIGH 2u
+
+struct a34_drm_version {                /* the start of drm.h's struct drm_version */
+	int32_t major, minor, patchlevel;
+};
+
+struct a34_gem_close {
+	uint32_t handle, pad;
+};
+
+struct a34_submit {
+	uint64_t jc, in_syncs;
+	uint32_t in_sync_count, out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count, requirements;
+	uint32_t jm_ctx_handle, pad;    /* (1.5) */
+};
+
+struct a34_wait_bo {
+	uint32_t handle, pad;
+	int64_t timeout_ns;
+};
+
+struct a34_create_bo {
+	uint32_t size, flags, handle, pad;
+	uint64_t offset;
+};
+
+struct a34_mmap_bo {
+	uint32_t handle, flags;
+	uint64_t offset;
+};
+
+struct a34_get_param {
+	uint32_t param, pad;
+	uint64_t value;
+};
+
+struct a34_get_bo_offset {
+	uint32_t handle, pad;
+	uint64_t offset;
+};
+
+struct a34_madvise {
+	uint32_t handle, madv, retained;
+};
+
+struct a34_set_label_bo {
+	uint32_t handle, pad;
+	uint64_t label;
+};
+
+struct a34_jm_ctx {                     /* jm_ctx_create {handle, priority}, jm_ctx_destroy {handle, pad} */
+	uint32_t handle, priority;
+};
+
+struct a34_sync_bo {
+	uint64_t ops;
+	uint32_t op_count, pad;
+};
+
+struct a34_query_bo_info {
+	uint32_t handle, extra_flags, create_flags, pad;
+};
+
+union a34_request {
+	struct a34_drm_version version;
+	struct a34_gem_close close;
+	struct a34_submit submit;
+	struct a34_wait_bo wait;
+	struct a34_create_bo create;
+	struct a34_mmap_bo mmapbo;
+	struct a34_get_param param;
+	struct a34_get_bo_offset offset;
+	struct a34_madvise madvise;
+	struct a34_set_label_bo label;
+	struct a34_jm_ctx ctx;
+	struct a34_sync_bo sync;
+	struct a34_query_bo_info info;
+	uint8_t raw[64];                /* the largest: struct drm_version */
+};
+
+struct a34_bo {
+	IOBufferMemoryDescriptor *mem;  /* NULL: the handle is free */
+	uint64_t va;                    /* its GPU address */
+	uint64_t vasize;                /* GPU addresses it holds (a heap: all it asked for) */
+	uint64_t backed;                /* bytes of memory, mapped from va on */
+	uint32_t flags;                 /* the PANFROST_BO_* it was made with */
+	uint32_t pad;
+};
+
+#define A34_BOS                 4096u           /* handles of a client: 1..A34_BOS */
+#define A34_UNIT                0x4000ull       /* buffers in kernel pages */
+#define A34_BO_MAX              (512ull << 20)
+#define A34_HEAP_VA_MAX         (1024ull << 20)
+#define A34_LOGGED_SUBMITS      8u
+#define A34_LOGGED_ERRORS       64u
+
+static IOLock *gA34MaliLock;
+static uint64_t gA34MaliWired;                  /* bytes of every client's buffers */
+static uint64_t gA34MaliWiredMax = 1024ull << 20;
+static uint64_t gA34MaliHeapBacked = 64ull << 20;
+static uint32_t gA34MaliClients;
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class RedwoodMali : public IOService
+{
+	OSDeclareDefaultStructors(RedwoodMali);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodMali, IOService);
+
+bool
+RedwoodMali::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "RedwoodMaliUserClient");
+	setName("RedwoodMali");
+	registerService();
+	return true;
+}
+
+/* From bsd/dev/a34_mali.c's thread, once the GPU is ready for programs. */
+bool
+RedwoodMaliStart(void)
+{
+	IOService *platform = IOService::getPlatform();
+	RedwoodMali *gpu;
+	uint32_t mb;
+
+	if (gA34MaliLock == NULL) {
+		gA34MaliLock = IOLockAlloc();
+	}
+	mb = 0;
+	if (PE_parse_boot_argn("a34maliheap", &mb, sizeof(mb)) && mb >= 2 && mb <= 1024) {
+		gA34MaliHeapBacked = (uint64_t)mb << 20;
+	}
+	mb = 0;
+	if (PE_parse_boot_argn("a34malimem", &mb, sizeof(mb)) && mb >= 64 && mb <= 4096) {
+		gA34MaliWiredMax = (uint64_t)mb << 20;
+	}
+	gpu = OSTypeAlloc(RedwoodMali);
+	if (gA34MaliLock == NULL || platform == NULL || gpu == NULL || !gpu->init()) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("A34 MALI UC: cannot create the RedwoodMali service\n");
+		return false;
+	}
+	if (!gpu->attach(platform)) {
+		gpu->release();
+		IOLog("A34 MALI UC: cannot attach the RedwoodMali service\n");
+		return false;
+	}
+	if (!gpu->start(platform)) {
+		gpu->detach(platform);
+		gpu->release();
+		IOLog("A34 MALI UC: the RedwoodMali service did not start\n");
+		return false;
+	}
+	gpu->release();                 /* the registry holds it */
+	IOLog("A34 MALI UC: RedwoodMali published (panfrost %d.%d, heaps backed %llu MB, buffers at most %llu MB)\n",
+	    A34_DRIVER_MAJOR, A34_DRIVER_MINOR, (unsigned long long)(gA34MaliHeapBacked >> 20),
+	    (unsigned long long)(gA34MaliWiredMax >> 20));
+	return true;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class RedwoodMaliUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(RedwoodMaliUserClient);
+
+	struct a34_bo *fBos;                    /* handle n is fBos[n - 1] */
+	uint32_t fNextBo;                       /* where the search for a free handle starts */
+	uint32_t fNextCtx;
+	uint32_t fBoCount, fBoMade, fSubmits, fFailed, fErrors;
+	uint64_t fWired;                        /* bytes of this client's buffers */
+	bool fOpen, fClosed;
+	char fName[32];
+
+	struct a34_bo *lookup(uint32_t handle);
+	void freeBo(struct a34_bo *b);
+	void releaseAll(void);
+	void describeFault(uint64_t va);
+	IOReturn createBo(struct a34_create_bo *req);
+	IOReturn request(uint32_t selector, union a34_request *r);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodMaliUserClient, IOUserClient);
+
+bool
+RedwoodMaliUserClient::start(IOService *provider)
+{
+	uint32_t clients;
+
+	if (OSDynamicCast(RedwoodMali, provider) == NULL || gA34MaliLock == NULL || !a34_mali_ready() ||
+	    !IOUserClient::start(provider)) {
+		IOLog("A34 MALI UC: a client could not be started (GPU %s)\n", a34_mali_ready() ? "ready" : "not ready");
+		return false;
+	}
+	fBos = IONewZero(struct a34_bo, A34_BOS);
+	if (fBos == NULL) {
+		IOLog("A34 MALI UC: no memory for a client's handles\n");
+		return false;
+	}
+	proc_selfname(fName, sizeof(fName));
+	IOLockLock(gA34MaliLock);
+	fOpen = true;
+	clients = ++gA34MaliClients;
+	IOLockUnlock(gA34MaliLock);
+	IOLog("A34 MALI UC: %s opened the GPU (%u clients)\n", fName, clients);
+	return true;
+}
+
+/* With the lock held. */
+struct a34_bo *
+RedwoodMaliUserClient::lookup(uint32_t handle)
+{
+	if (fBos == NULL || fClosed || handle == 0 || handle > A34_BOS || fBos[handle - 1].mem == NULL) {
+		return NULL;
+	}
+	return &fBos[handle - 1];
+}
+
+/* With the lock held. No job can be using it: every job ran to its end before its SUBMIT returned. */
+void
+RedwoodMaliUserClient::freeBo(struct a34_bo *b)
+{
+	a34_mali_unmap(b->va, b->backed);
+	a34_mali_va_free(b->va, b->vasize);
+	gA34MaliWired -= b->backed;
+	fWired -= b->backed;
+	fBoCount--;
+	b->mem->release();              /* a program's mapping of it holds it until unmapped */
+	bzero(b, sizeof(*b));
+}
+
+void
+RedwoodMaliUserClient::releaseAll(void)
+{
+	uint32_t freed = 0, clients = 0;
+	bool was = false;
+
+	IOLockLock(gA34MaliLock);
+	if (fOpen && !fClosed) {
+		was = true;
+		for (uint32_t i = 0; i < A34_BOS; i++) {
+			if (fBos[i].mem != NULL) {
+				freeBo(&fBos[i]);
+				freed++;
+			}
+		}
+		fClosed = true;
+		clients = --gA34MaliClients;
+	}
+	IOLockUnlock(gA34MaliLock);
+	if (was) {
+		IOLog("A34 MALI UC: %s closed the GPU: %u buffers freed (%u made), %u job chains, %u failed, %u errors; %u clients left\n",
+		    fName, freed, fBoMade, fSubmits, fFailed, fErrors, clients);
+	}
+}
+
+/* With the lock held: which of this client's buffers a GPU fault address is in. */
+void
+RedwoodMaliUserClient::describeFault(uint64_t va)
+{
+	for (uint32_t i = 0; i < A34_BOS; i++) {
+		struct a34_bo *b = &fBos[i];
+
+		if (b->mem != NULL && va >= b->va && va < b->va + b->vasize) {
+			IOLog("A34 MALI UC: %s: the fault at 0x%llx is 0x%llx into buffer %u (0x%llx bytes at 0x%llx, 0x%llx backed, flags 0x%x)%s\n",
+			    fName, (unsigned long long)va, (unsigned long long)(va - b->va), i + 1,
+			    (unsigned long long)b->vasize, (unsigned long long)b->va, (unsigned long long)b->backed, b->flags,
+			    va - b->va >= b->backed ? ": past its memory, the tiler heap is full (boot-arg a34maliheap)" : "");
+			return;
+		}
+	}
+	IOLog("A34 MALI UC: %s: the fault at 0x%llx is in none of its %u buffers\n", fName, (unsigned long long)va, fBoCount);
+}
+
+/* With the lock held. panfrost_ioctl_create_bo(): the buffer, its handle and GPU address. */
+IOReturn
+RedwoodMaliUserClient::createBo(struct a34_create_bo *req)
+{
+	IOBufferMemoryDescriptor *mem;
+	IOMemoryDescriptor *md;
+	struct a34_bo *b = NULL;
+	uint64_t vasize, backed, va, off;
+	uint32_t handle = 0;
+	bool heap = (req->flags & PANFROST_BO_HEAP) != 0;
+
+	if (req->size == 0 || req->pad != 0 ||
+	    (req->flags & ~(PANFROST_BO_NOEXEC | PANFROST_BO_HEAP | PANFROST_BO_WB_MMAP)) != 0 ||
+	    (heap && (req->flags & (PANFROST_BO_NOEXEC | PANFROST_BO_WB_MMAP)) != PANFROST_BO_NOEXEC)) {
+		return kIOReturnBadArgument;
+	}
+	vasize = ((uint64_t)req->size + A34_UNIT - 1) & ~(A34_UNIT - 1);
+	if (vasize > (heap ? A34_HEAP_VA_MAX : A34_BO_MAX)) {
+		return kIOReturnBadArgument;
+	}
+	backed = heap && vasize > gA34MaliHeapBacked ? gA34MaliHeapBacked : vasize;
+	if (gA34MaliWired + backed > gA34MaliWiredMax) {
+		IOLog("A34 MALI UC: %s: a buffer of %llu KB would make %llu MB of GPU buffers (a34malimem=%llu)\n", fName,
+		    (unsigned long long)(backed >> 10), (unsigned long long)((gA34MaliWired + backed) >> 20),
+		    (unsigned long long)(gA34MaliWiredMax >> 20));
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t n = 0; n < A34_BOS; n++) {
+		uint32_t i = (fNextBo + n) % A34_BOS;
+
+		if (fBos[i].mem == NULL) {
+			b = &fBos[i];
+			handle = i + 1;
+			break;
+		}
+	}
+	if (b == NULL) {
+		IOLog("A34 MALI UC: %s: all %u handles in use\n", fName, A34_BOS);
+		return kIOReturnNoResources;
+	}
+	mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, (vm_size_t)backed, PAGE_SIZE);
+	if (mem == NULL) {
+		IOLog("A34 MALI UC: %s: no memory for a buffer of %llu KB\n", fName, (unsigned long long)(backed >> 10));
+		return kIOReturnNoMemory;
+	}
+	/* Zeroed through a cached mapping before it became write-combined: nothing of that may stay in a cache. */
+	a34_mali_cpu_flush((uintptr_t)mem->getBytesNoCopy(), backed);
+	va = a34_mali_va_alloc(vasize, (req->flags & PANFROST_BO_NOEXEC) == 0);
+	if (va == 0) {
+		mem->release();
+		IOLog("A34 MALI UC: %s: no GPU addresses left for %llu KB\n", fName, (unsigned long long)(vasize >> 10));
+		return kIOReturnNoSpace;
+	}
+	md = mem;
+	for (off = 0; off < backed;) {
+		IOByteCount seglen = 0;
+		addr64_t pa = md->getPhysicalSegment(off, &seglen, kIOMemoryMapperNone);
+		uint64_t len = seglen;
+
+		if (len > backed - off) {
+			len = backed - off;
+		}
+		len &= ~0xfffull;
+		if (pa == 0 || len == 0 || !a34_mali_map(va + off, pa, len)) {
+			a34_mali_unmap(va, backed);
+			a34_mali_va_free(va, vasize);
+			mem->release();
+			IOLog("A34 MALI UC: %s: a buffer of %llu KB would not go into the GPU's tables (at 0x%llx: 0x%llx, 0x%llx bytes)\n",
+			    fName, (unsigned long long)(backed >> 10), (unsigned long long)off, (unsigned long long)pa,
+			    (unsigned long long)seglen);
+			return kIOReturnNoMemory;
+		}
+		off += len;
+	}
+	b->mem = mem;
+	b->va = va;
+	b->vasize = vasize;
+	b->backed = backed;
+	b->flags = req->flags;
+	fNextBo = handle % A34_BOS;
+	gA34MaliWired += backed;
+	fWired += backed;
+	fBoCount++;
+	fBoMade++;
+	req->handle = handle;
+	req->offset = va;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RedwoodMaliUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	struct a34_bo *b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gA34MaliLock);
+	b = lookup(type);
+	if (b != NULL && (b->flags & PANFROST_BO_HEAP) == 0) {
+		b->mem->retain();               /* given to the mapping */
+		*memory = b->mem;
+		*options = 0;                   /* the buffer's own cache mode: write-combined */
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gA34MaliLock);
+	if (ret != kIOReturnSuccess) {
+		IOLog("A34 MALI UC: %s: no buffer %u to map\n", fName, (unsigned)type);
+	}
+	return ret;
+}
+
+/* With the lock held: one request, *r its structure in and back. */
+IOReturn
+RedwoodMaliUserClient::request(uint32_t selector, union a34_request *r)
+{
+	struct a34_bo *b;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (fBos == NULL || !fOpen || fClosed) {
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case kA34DrmVersion:
+		r->version.major = A34_DRIVER_MAJOR;
+		r->version.minor = A34_DRIVER_MINOR;
+		r->version.patchlevel = 0;
+		break;
+	case kA34PanfrostGetParam:
+		if (r->param.pad != 0 || !a34_mali_param(r->param.param, &r->param.value)) {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case kA34PanfrostCreateBO:
+		ret = createBo(&r->create);
+		break;
+	case kA34DrmGemClose:
+		b = lookup(r->close.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else {
+			freeBo(b);
+		}
+		break;
+	case kA34PanfrostMmapBO:        /* the offset is the handle: the program maps client memory of that type */
+		b = lookup(r->mmapbo.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else if (r->mmapbo.flags != 0 || (b->flags & PANFROST_BO_HEAP) != 0) {
+			ret = kIOReturnBadArgument;
+		} else {
+			r->mmapbo.offset = (uint64_t)r->mmapbo.handle << 12;
+		}
+		break;
+	case kA34PanfrostGetBOOffset:
+		b = lookup(r->offset.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else {
+			r->offset.offset = b->va;
+		}
+		break;
+	case kA34PanfrostWaitBO:        /* every job ended before its SUBMIT returned */
+	case kA34PanfrostSetLabelBO:    /* labels are not kept */
+		ret = lookup(r->wait.handle) != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+		break;
+	case kA34PanfrostMadvise:       /* nothing is ever purged */
+		if (lookup(r->madvise.handle) == NULL) {
+			ret = kIOReturnNotFound;
+		} else if (r->madvise.madv > 1) {
+			ret = kIOReturnBadArgument;
+		} else {
+			r->madvise.retained = 1;
+		}
+		break;
+	case kA34PanfrostQueryBOInfo:
+		b = lookup(r->info.handle);
+		if (b == NULL) {
+			ret = kIOReturnNotFound;
+		} else {
+			r->info.extra_flags = 0;
+			r->info.create_flags = b->flags;
+			r->info.pad = 0;
+		}
+		break;
+	case kA34PanfrostSyncBO:        /* no mapping is cached: nothing to clean or invalidate */
+		if (r->sync.pad != 0) {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case kA34PanfrostJmCtxCreate:   /* one queue for all: a context is only a number */
+		if (r->ctx.priority > PANFROST_JM_CTX_PRIORITY_HIGH) {
+			ret = kIOReturnBadArgument;
+		} else {
+			r->ctx.handle = ++fNextCtx;
+		}
+		break;
+	case kA34PanfrostJmCtxDestroy:
+		if (r->ctx.handle == 0 || r->ctx.handle > fNextCtx) {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case kA34PanfrostSubmit: {
+		struct a34_mali_job job;
+		uint32_t n;
+
+		if (r->submit.jc == 0 || (r->submit.requirements & ~(PANFROST_JD_REQ_FS | PANFROST_JD_REQ_CYCLE_COUNT)) != 0) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		bzero(&job, sizeof(job));
+		job.jc = r->submit.jc;
+		job.requirements = r->submit.requirements;
+		n = ++fSubmits;
+		if (!a34_mali_submit(&job)) {
+			fFailed++;
+			IOLog("A34 MALI UC: %s: job chain %u at 0x%llx (%s) failed after %llu us: JOB_INT 0x%08x JS_STATUS 0x%08x MMU_INT 0x%08x\n",
+			    fName, n, (unsigned long long)job.jc, (job.requirements & PANFROST_JD_REQ_FS) ? "fragment" : "vertex/tiler/compute",
+			    (unsigned long long)(job.ns / 1000), job.job_raw, job.js_status, job.mmu_raw);
+			if (job.mmu_raw != 0) {
+				describeFault(job.fault_va);
+			}
+			ret = a34_mali_ready() ? kIOReturnIOError : kIOReturnNotReady;
+		} else if (n <= A34_LOGGED_SUBMITS) {
+			IOLog("A34 MALI UC: %s: job chain %u at 0x%llx (%s, %u buffers) done in %llu us\n", fName, n,
+			    (unsigned long long)job.jc, (job.requirements & PANFROST_JD_REQ_FS) ? "fragment" : "vertex/tiler/compute",
+			    fBoCount, (unsigned long long)(job.ns / 1000));
+		}
+		break;
+	}
+	case kA34PanfrostPerfcntEnable:
+	case kA34PanfrostPerfcntDump:
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	return ret;
+}
+
+IOReturn
+RedwoodMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	union a34_request r;
+	uint32_t insize = args->structureInputSize, outsize;
+	IOReturn ret;
+
+	if (args->structureInputDescriptor != NULL || args->structureOutputDescriptor != NULL ||
+	    insize > sizeof(r) || (insize != 0 && args->structureInput == NULL)) {
+		ret = kIOReturnBadArgument;
+	} else {
+		bzero(&r, sizeof(r));
+		if (insize != 0) {
+			memcpy(&r, args->structureInput, insize);
+		}
+		if (selector == kA34PanfrostWaitBO && r.wait.timeout_ns <= 0) {
+			/* only a look: a job of another thread or program still running is "busy" */
+			if (!IOLockTryLock(gA34MaliLock)) {
+				return kIOReturnBusy;
+			}
+		} else {
+			IOLockLock(gA34MaliLock);
+		}
+		ret = request(selector, &r);
+		if (ret != kIOReturnSuccess && fErrors++ < A34_LOGGED_ERRORS) {
+			IOLog("A34 MALI UC: %s: request 0x%02x (%u bytes) -> 0x%x%s\n", fName, selector, insize, ret,
+			    fErrors == A34_LOGGED_ERRORS ? " (no more errors logged for this client)" : "");
+		}
+		IOLockUnlock(gA34MaliLock);
+		if (args->structureOutput != NULL && args->structureOutputSize != 0) {
+			outsize = args->structureOutputSize < sizeof(r) ? args->structureOutputSize : (uint32_t)sizeof(r);
+			memcpy(args->structureOutput, &r, outsize);
+			args->structureOutputSize = outsize;
+		}
+		return ret;
+	}
+	if (fErrors++ < A34_LOGGED_ERRORS) {
+		IOLog("A34 MALI UC: %s: request 0x%02x with %u bytes in, %u out: not a structure this takes\n", fName, selector,
+		    insize, args->structureOutputSize);
+	}
+	return ret;
+}
+
+IOReturn
+RedwoodMaliUserClient::clientClose(void)
+{
+	releaseAll();
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+RedwoodMaliUserClient::free(void)
+{
+	if (fBos != NULL) {
+		releaseAll();
+		IODelete(fBos, struct a34_bo, A34_BOS);
+		fBos = NULL;
+	}
+	IOUserClient::free();
+}
+#endif /* SWEET */
