+/* ---- 7: the GPU for programs (iokit/Kernel/arm/A34Mali.cpp, RedwoodMali) ---- */
+
+/*
+ * One address space, AS0, for every program, on step 6's tables: GPU
+ * addresses from 32 MB to 4 GB, the range Linux panfrost hands out and Mesa
+ * assumes (its level-0 entry 0; step 6's own page goes). Buffers get those
+ * addresses in kernel pages (16 KB), first fit, executable ones never across
+ * a 16 MB boundary nor in the last 16 MB below 4 GB (panfrost_gem_open(),
+ * panfrost_drm_mm_color_adjust()). Tables are made as needed, a 16 KB kernel
+ * page cut into four 4 KB GPU tables, and kept: at most 1 + 4 + 2048 of them.
+ * A changed entry goes to memory at once (am_flush); the GPU forgets what it
+ * remembered of the tables before the next job, the way panfrost enables an
+ * address space (lock everything, FLUSH_MEM, then UPDATE). One job at a time,
+ * run to its end: done, failed, an MMU fault in AS0, or no answer in 2 s --
+ * then the slot is hard-stopped and the GPU reset and set up again.
+ */
+#define GPU_CORE_FEATURES       0x008u
+#define GPU_MEM_FEATURES        0x010u
+#define GPU_AFBC_FEATURES       0x04cu
+#define GPU_TIMESTAMP_LO        0x098u
+#define GPU_TIMESTAMP_HI        0x09cu
+#define GPU_THREAD_MAX_THREADS  0x0a0u
+#define GPU_THREAD_MAX_WG_SIZE  0x0a4u
+#define GPU_THREAD_MAX_BARRIER  0x0a8u
+#define GPU_THREAD_FEATURES     0x0acu
+#define GPU_TEXTURE_FEATURES(n) (0x0b0u + 4u * (n))
+#define GPU_JS_FEATURES(n)      (0x0c0u + 4u * (n))
+#define GPU_SHADER_PWROFF_LO    0x1c0u
+#define GPU_SHADER_PWRTRANS_LO  0x200u
+#define GPU_THREAD_TLS_ALLOC    0x310u
+#define GPU_JM_CONFIG           0xf00u
+#define GPU_SHADER_CONFIG       0xf04u
+#define SC_VAR_ALGORITHM        (1u << 29)
+#define JM_IDVS_GROUP_SIZE_MASK (0x3fu << 16)
+#define JM_IDVS_GROUP_SIZE_DEF  (0xfu << 16)
+#define GPU_CMD_HARD_RESET      2u
+#define GPU_CMD_CYCLE_COUNT_START 5u
+#define GPU_CMD_CYCLE_COUNT_STOP 6u
+#define AM_JS(n)                (0x1800u + 0x80u * (n))
+#define JOB_INT_DONE(n)         (1u << (n))
+#define JOB_INT_FAIL(n)         (1u << ((n) + 16u))
+#define MMU_INT_AS0             ((1u << 0) | (1u << 16))        /* AS0 page fault, AS0 bus fault */
+#define AS_LOCKADDR_LO          0x10u
+#define AS_LOCKADDR_HI          0x14u
+#define AS_COMMAND_LOCK         2u
+#define AS_COMMAND_FLUSH_MEM    5u
+#define AM_REQ_FS               (1u << 0)
+#define AM_REQ_CYCLE_COUNT      (1u << 1)
+
+#define AM_UVA_START            0x0000000002000000ull   /* 32 MB */
+#define AM_UVA_END              0x0000000100000000ull   /* 4 GB */
+#define AM_UVA_UNIT             0x4000ull               /* a kernel page */
+#define AM_UVA_UNITS            ((uint32_t)((AM_UVA_END - AM_UVA_START) / AM_UVA_UNIT))   /* 260096 */
+#define AM_UVA_EXEC_UNITS       (AM_UVA_UNITS - (uint32_t)((16ull << 20) / AM_UVA_UNIT))
+#define AM_JOB_TIMEOUT_NS       (2ull * NSEC_PER_SEC)
+
+static bool am_uc_ready, am_dead, am_pt_dirty, am_tls_said;
+static uint64_t am_as0_tab;                     /* step 6's level-0 table */
+static uint32_t am_as0_cfg;                     /* and its TRANSCFG */
+static uint64_t *am_pt_l1, *am_pt_l2[4], *am_pt_l3[2048];        /* kernel addresses of the tables below 4 GB */
+static vm_offset_t am_pt_page;                  /* the kernel page tables are cut from */
+static uint64_t am_pt_page_pa;
+static uint32_t am_pt_next;                     /* 4 KB tables of it given out */
+static uint64_t am_va_taken[AM_UVA_UNITS / 64];  /* a set bit: that 16 KB of GPU addresses is taken */
+
+/* A zeroed 4 KB GPU table, its physical address in *pa. */
+static uint64_t *
+am_pt_alloc(uint64_t *pa)
+{
+	vm_offset_t page = 0;
+	ppnum_t pn;
+	uint64_t *table;
+
+	if (am_pt_page == 0 || am_pt_next == (uint32_t)(PAGE_SIZE / 0x1000u)) {
+		if (kmem_alloc_contig(kernel_map, &page, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		pn = pmap_find_phys(kernel_pmap, (addr64_t)page);
+		if (pn == 0 || ptoa_64(pn) + PAGE_SIZE > (1ull << am_pa_bits)) {
+			return NULL;
+		}
+		am_flush(page, PAGE_SIZE);      /* its zeroes in memory, where the GPU walks */
+		am_pt_page = page;
+		am_pt_page_pa = ptoa_64(pn);
+		am_pt_next = 0;
+	}
+	*pa = am_pt_page_pa + 0x1000ull * am_pt_next;
+	table = (uint64_t *)(am_pt_page + 0x1000u * am_pt_next);
+	am_pt_next++;
+	return table;
+}
+
+/* Level 0 entry 0 -> a level-1 table -> four level-2 tables: GPU addresses below 4 GB. */
+static bool
+am_uc_tables(void)
+{
+	uint64_t *l0 = (uint64_t *)(am_mem + AM_PT_OFF);
+	uint64_t pa;
+	unsigned i;
+
+	am_pt_l1 = am_pt_alloc(&pa);
+	if (am_pt_l1 == NULL) {
+		return false;
+	}
+	for (i = 0; i < 4; i++) {
+		uint64_t l2pa;
+
+		am_pt_l2[i] = am_pt_alloc(&l2pa);
+		if (am_pt_l2[i] == NULL) {
+			return false;
+		}
+		am_pt_l1[i] = (l2pa & PTE_ADDR) | PTE_TABLE;
+	}
+	am_flush((vm_offset_t)am_pt_l1, 4 * sizeof(uint64_t));
+	l0[0] = (pa & PTE_ADDR) | PTE_TABLE;
+	am_flush((vm_offset_t)&l0[0], sizeof(uint64_t));
+	am_pt_dirty = true;
+	return true;
+}
+
+/* The level-3 table for GPU address va (below 4 GB), made if there is none. */
+static uint64_t *
+am_l3_for(uint64_t va)
+{
+	uint32_t slot = (uint32_t)(va >> 21);
+	uint64_t *l2 = am_pt_l2[(va >> 30) & 3u], *l3, pa;
+
+	if (am_pt_l3[slot] != NULL) {
+		return am_pt_l3[slot];
+	}
+	l3 = am_pt_alloc(&pa);
+	if (l3 == NULL) {
+		return NULL;
+	}
+	l2[slot & 511u] = (pa & PTE_ADDR) | PTE_TABLE;
+	am_flush((vm_offset_t)&l2[slot & 511u], sizeof(uint64_t));
+	am_pt_l3[slot] = l3;
+	return l3;
+}
+
+/* Shader cores on or off, the GPU clock parked on 26 MHz while they switch (see step 4). */
+static bool
+am_shaders_switch(bool on)
+{
+	uint32_t cfg20 = am_rd(am_top, TOP_CLK_CFG_20);
+	bool park = am_park != 0 && (cfg20 & TOP_MFG_PLL1) && !(cfg20 & TOP_MFG_INT1_PLL4);
+	bool ok;
+
+	if (park) {
+		am_wr(am_top, TOP_CLK_CFG_20_CLR, TOP_MFG_INT1_PLL4);
+		am_wr(am_top, TOP_CLK_CFG_20_CLR, TOP_MFG_PLL1);
+		delay(2);
+	}
+	if (on) {
+		am_wr(am_gpu, GPU_SHADER_PWRON_LO, am_shaders);
+		ok = am_wait(am_gpu, GPU_SHADER_READY_LO, am_shaders, am_shaders, 100000);
+	} else {
+		am_wr(am_gpu, GPU_SHADER_PWROFF_LO, am_shaders);
+		ok = am_wait(am_gpu, GPU_SHADER_READY_LO, am_shaders, 0, 100000) &&
+		    am_wait(am_gpu, GPU_SHADER_PWRTRANS_LO, am_shaders, 0, 100000);
+	}
+	if (park) {
+		am_wr(am_top, TOP_CLK_CFG_20_SET, TOP_MFG_PLL1);
+		am_wr(am_top, TOP_CLK_CFG_20_CLR, TOP_MFG_INT1_PLL4);
+	}
+	return ok;
+}
+
+/*
+ * The GPU from whatever state to idle and ready: shader cores off (only if
+ * `idle`: a core stuck in a job would not go off, and the clock must not be
+ * unparked with its power-off still pending), a soft reset (a hard one if
+ * that does not finish), the G68's settings while no core has power
+ * (panfrost_gpu_init_quirks(), kbase_pm_hw_issues_apply()), L2, tiler and
+ * shader cores on, AS0 on the tables. False: it did not come back.
+ */
+static bool
+am_gpu_reinit(bool idle)
+{
+	uint32_t sc, jm;
+
+	if (idle && (am_rd(am_gpu, GPU_SHADER_READY_LO) & am_shaders) != 0 && !am_shaders_switch(false)) {
+		printf("A34 MALI UC: shader cores not off in 100 ms (SHADER_READY 0x%08x PWRTRANS 0x%08x), reset anyway\n",
+		    am_rd(am_gpu, GPU_SHADER_READY_LO), am_rd(am_gpu, GPU_SHADER_PWRTRANS_LO));
+	}
+	if (!am_soft_reset()) {
+		printf("A34 MALI UC: no RESET_COMPLETED in 100 ms after a soft reset, hard reset\n");
+		am_wr(am_gpu, GPU_INT_CLEAR, 0xffffffffu);
+		am_wr(am_gpu, GPU_CMD, GPU_CMD_HARD_RESET);
+		if (!am_wait(am_gpu, GPU_INT_RAWSTAT, GPU_IRQ_RESET_COMPLETED, GPU_IRQ_RESET_COMPLETED, 100000)) {
+			printf("A34 MALI UC: no RESET_COMPLETED after a hard reset either (GPU_INT_RAWSTAT 0x%08x)\n",
+			    am_rd(am_gpu, GPU_INT_RAWSTAT));
+			return false;
+		}
+		am_wr(am_gpu, GPU_INT_CLEAR, 0xffffffffu);
+	}
+	sc = am_rd(am_gpu, GPU_SHADER_CONFIG);
+	jm = am_rd(am_gpu, GPU_JM_CONFIG);
+	am_wr(am_gpu, GPU_SHADER_CONFIG, sc | SC_VAR_ALGORITHM);
+	am_wr(am_gpu, GPU_JM_CONFIG, (jm & ~JM_IDVS_GROUP_SIZE_MASK) | JM_IDVS_GROUP_SIZE_DEF);
+	am_wr(am_gpu, GPU_L2_PWRON_LO, am_l2);
+	if (!am_wait(am_gpu, GPU_L2_READY_LO, am_l2, am_l2, 50000)) {
+		printf("A34 MALI UC: L2 not ready in 50 ms (L2_READY 0x%x)\n", am_rd(am_gpu, GPU_L2_READY_LO));
+		return false;
+	}
+	am_wr(am_gpu, GPU_TILER_PWRON_LO, am_tiler);
+	if (!am_wait(am_gpu, GPU_TILER_READY_LO, am_tiler, am_tiler, 50000)) {
+		printf("A34 MALI UC: tiler not ready in 50 ms (TILER_READY 0x%x)\n", am_rd(am_gpu, GPU_TILER_READY_LO));
+		return false;
+	}
+	if (!am_shaders_switch(true)) {
+		printf("A34 MALI UC: shader cores not ready in 100 ms (SHADER_READY 0x%08x)\n",
+		    am_rd(am_gpu, GPU_SHADER_READY_LO));
+		return false;
+	}
+	if (!am_as0_set(am_as0_tab, am_as0_cfg)) {
+		return false;
+	}
+	am_wr(am_gpu, MMU_INT_CLEAR, 0xffffffffu);
+	am_wr(am_gpu, JOB_INT_CLEAR, 0xffffffffu);
+	am_pt_dirty = false;
+	printf("A34 MALI UC: GPU reset and set up: SHADER_CONFIG 0x%08x -> 0x%08x, JM_CONFIG 0x%08x -> 0x%08x, "
+	    "L2_READY 0x%x TILER_READY 0x%x SHADER_READY 0x%08x CLK_CFG_20 0x%08x\n", sc,
+	    am_rd(am_gpu, GPU_SHADER_CONFIG), jm, am_rd(am_gpu, GPU_JM_CONFIG), am_rd(am_gpu, GPU_L2_READY_LO),
+	    am_rd(am_gpu, GPU_TILER_READY_LO), am_rd(am_gpu, GPU_SHADER_READY_LO), am_rd(am_top, TOP_CLK_CFG_20));
+	return true;
+}
+
+/* A job that did not finish, or failed, on slot js: stop it, reset and set up the GPU. */
+static void
+am_uc_recover(uint32_t js)
+{
+	uint32_t raw, mmu;
+
+	am_wr(am_gpu, AM_JS(js) + JS_COMMAND_NEXT, JS_COMMAND_NOP);
+	am_wr(am_gpu, AM_JS(js) + JS_COMMAND, JS_COMMAND_HARD_STOP);
+	raw = am_wait_any(am_gpu, JOB_INT_RAWSTAT, JOB_INT_DONE(js) | JOB_INT_FAIL(js), 20000);
+	mmu = am_rd(am_gpu, MMU_INT_RAWSTAT) & MMU_INT_AS0;
+	if (!am_gpu_reinit(raw != 0 && mmu == 0)) {
+		am_dead = true;
+	}
+	printf("A34 MALI UC: recovery: after hard stop JOB_INT_RAWSTAT bits 0x%08x, MMU_INT_RAWSTAT bits 0x%08x; %s\n", raw,
+	    mmu, am_dead ? "the GPU did not come back, no more jobs" : "GPU reset, ready again");
+}
+
+/*
+ * Everything the GPU remembers of AS0's tables forgotten, as panfrost's
+ * panfrost_mmu_enable() does it: the whole space locked (region 2^64 from 0)
+ * and FLUSH_MEM, then the registers again and UPDATE.
+ */
+static bool
+am_as0_flush(void)
+{
+	if (!am_wait(am_gpu, AS0 + AS_STATUS, AS_STATUS_ACTIVE, 0, 50000)) {
+		return false;
+	}
+	am_wr(am_gpu, AS0 + AS_LOCKADDR_LO, 63u);
+	am_wr(am_gpu, AS0 + AS_LOCKADDR_HI, 0);
+	am_wr(am_gpu, AS0 + AS_COMMAND, AS_COMMAND_LOCK);
+	if (!am_wait(am_gpu, AS0 + AS_STATUS, AS_STATUS_ACTIVE, 0, 50000)) {
+		return false;
+	}
+	am_wr(am_gpu, AS0 + AS_COMMAND, AS_COMMAND_FLUSH_MEM);
+	if (!am_wait(am_gpu, AS0 + AS_STATUS, AS_STATUS_ACTIVE, 0, 50000)) {
+		return false;
+	}
+	am_wr(am_gpu, AS0 + AS_TRANSTAB_LO, (uint32_t)am_as0_tab);
+	am_wr(am_gpu, AS0 + AS_TRANSTAB_HI, (uint32_t)(am_as0_tab >> 32));
+	am_wr(am_gpu, AS0 + AS_MEMATTR_LO, AS_MEMATTR_ALL_WB);
+	am_wr(am_gpu, AS0 + AS_MEMATTR_HI, AS_MEMATTR_ALL_WB);
+	am_wr(am_gpu, AS0 + AS_TRANSCFG_LO, am_as0_cfg);
+	am_wr(am_gpu, AS0 + AS_TRANSCFG_HI, 0);
+	am_wr(am_gpu, AS0 + AS_COMMAND, AS_COMMAND_UPDATE);
+	if (!am_wait(am_gpu, AS0 + AS_STATUS, AS_STATUS_ACTIVE, 0, 50000)) {
+		return false;
+	}
+	am_pt_dirty = false;
+	return true;
+}
+
+/*
+ * Until a bit of mask is set in JOB_INT_RAWSTAT or AS0 faults, for at most
+ * 2 s: polled for the first half millisecond, then asleep 200 us at a time,
+ * so that a long job does not keep a processor busy. The bits seen (0: none).
+ */
+static uint32_t
+am_wait_job(uint32_t mask, uint32_t *mmu)
+{
+	uint64_t deadline, nap;
+	uint32_t seen, polls = 0;
+
+	nanoseconds_to_absolutetime(AM_JOB_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		seen = am_rd(am_gpu, JOB_INT_RAWSTAT) & mask;
+		*mmu = am_rd(am_gpu, MMU_INT_RAWSTAT) & MMU_INT_AS0;
+		if (seen != 0 || *mmu != 0 || mach_absolute_time() > deadline) {
+			return seen;
+		}
+		if (polls < 50) {
+			polls++;
+			delay(10);
+		} else {
+			clock_interval_to_deadline(200, (uint32_t)NSEC_PER_USEC, &nap);
+			(void)assert_wait_deadline(&am_sleep_chan, THREAD_UNINT, nap);
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+}
+
+static uint64_t
+am_rd64(uint32_t lo)
+{
+	return am_rd(am_gpu, lo) | ((uint64_t)am_rd(am_gpu, lo + 4u) << 32);
+}
+
+/* The GPU's TIMESTAMP (the system counter), with its cycle counter running as panfrost has it. */
+static uint64_t
+am_timestamp(void)
+{
+	uint32_t hi, lo, hi2;
+	unsigned tries;
+
+	am_wr(am_gpu, GPU_CMD, GPU_CMD_CYCLE_COUNT_START);
+	hi = am_rd(am_gpu, GPU_TIMESTAMP_HI);
+	lo = am_rd(am_gpu, GPU_TIMESTAMP_LO);
+	for (tries = 0; tries < 4; tries++) {
+		hi2 = am_rd(am_gpu, GPU_TIMESTAMP_HI);
+		if (hi2 == hi) {
+			break;
+		}
+		hi = hi2;
+		lo = am_rd(am_gpu, GPU_TIMESTAMP_LO);
+	}
+	am_wr(am_gpu, GPU_CMD, GPU_CMD_CYCLE_COUNT_STOP);
+	return ((uint64_t)hi << 32) | lo;
+}
+
+bool
+a34_mali_ready(void)
+{
+	return am_uc_ready && !am_dead;
+}
+
+/* DRM_PANFROST_PARAM_* (panfrost_drm.h order), as panfrost_ioctl_get_param() answers them. */
+bool
+a34_mali_param(uint32_t param, uint64_t *value)
+{
+	uint64_t v;
+
+	if (!am_uc_ready) {
+		return false;
+	}
+	switch (param) {
+	case 0:                 /* GPU_PROD_ID */
+		v = am_gpu_id >> 16;
+		break;
+	case 1:                 /* GPU_REVISION */
+		v = am_gpu_id & 0xffffu;
+		break;
+	case 2:                 /* SHADER_PRESENT */
+		v = am_rd64(GPU_SHADER_PRESENT_LO);
+		break;
+	case 3:                 /* TILER_PRESENT */
+		v = am_rd64(GPU_TILER_PRESENT_LO);
+		break;
+	case 4:                 /* L2_PRESENT */
+		v = am_rd64(GPU_L2_PRESENT_LO);
+		break;
+	case 5:                 /* STACK_PRESENT */
+		v = am_rd64(GPU_STACK_PRESENT_LO);
+		break;
+	case 6:                 /* AS_PRESENT */
+		v = am_rd(am_gpu, GPU_AS_PRESENT);
+		break;
+	case 7:                 /* JS_PRESENT */
+		v = am_rd(am_gpu, GPU_JS_PRESENT);
+		break;
+	case 8:                 /* L2_FEATURES */
+		v = am_rd(am_gpu, GPU_L2_FEATURES);
+		break;
+	case 9:                 /* CORE_FEATURES */
+		v = am_rd(am_gpu, GPU_CORE_FEATURES);
+		break;
+	case 10:                /* TILER_FEATURES */
+		v = am_rd(am_gpu, GPU_TILER_FEATURES);
+		break;
+	case 11:                /* MEM_FEATURES */
+		v = am_rd(am_gpu, GPU_MEM_FEATURES);
+		break;
+	case 12:                /* MMU_FEATURES */
+		v = am_rd(am_gpu, GPU_MMU_FEATURES);
+		break;
+	case 13:                /* THREAD_FEATURES */
+		v = am_rd(am_gpu, GPU_THREAD_FEATURES);
+		break;
+	case 14:                /* MAX_THREADS */
+		v = am_rd(am_gpu, GPU_THREAD_MAX_THREADS);
+		break;
+	case 15:                /* THREAD_MAX_WORKGROUP_SZ */
+		v = am_rd(am_gpu, GPU_THREAD_MAX_WG_SIZE);
+		break;
+	case 16:                /* THREAD_MAX_BARRIER_SZ */
+		v = am_rd(am_gpu, GPU_THREAD_MAX_BARRIER);
+		break;
+	case 17:                /* COHERENCY_FEATURES */
+		v = am_rd(am_gpu, GPU_COHERENCY_FEATURES);
+		break;
+	case 38:                /* NR_CORE_GROUPS: one per L2 */
+		v = (uint64_t)__builtin_popcountll(am_rd64(GPU_L2_PRESENT_LO));
+		break;
+	case 39:                /* THREAD_TLS_ALLOC */
+		/*
+		 * Never below MAX_THREADS, Mesa's own fallback: HackiOS saw a
+		 * G52 write past a spilling shader's stack sized by less. More
+		 * only makes Mesa's stack buffers bigger.
+		 */
+		v = am_rd(am_gpu, GPU_THREAD_TLS_ALLOC);
+		if (v < am_rd(am_gpu, GPU_THREAD_MAX_THREADS)) {
+			v = am_rd(am_gpu, GPU_THREAD_MAX_THREADS);
+		}
+		if (!am_tls_said) {
+			am_tls_said = true;
+			printf("A34 MALI UC: THREAD_TLS_ALLOC 0x%x, MAX_THREADS 0x%x: answered 0x%llx\n",
+			    am_rd(am_gpu, GPU_THREAD_TLS_ALLOC), am_rd(am_gpu, GPU_THREAD_MAX_THREADS),
+			    (unsigned long long)v);
+		}
+		break;
+	case 40:                /* AFBC_FEATURES */
+		v = am_rd(am_gpu, GPU_AFBC_FEATURES);
+		break;
+	case 41:                /* SYSTEM_TIMESTAMP */
+		v = am_timestamp();
+		break;
+	case 42:                /* SYSTEM_TIMESTAMP_FREQUENCY: the system counter's, as arch_timer_get_cntfrq() */
+		__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(v));
+		break;
+	case 43:                /* ALLOWED_JM_CTX_PRIORITIES: low and medium, as for a program without CAP_SYS_NICE */
+		v = (1u << 0) | (1u << 1);
+		break;
+	case 44:                /* SELECTED_COHERENCY: DRM_PANFROST_GPU_COHERENCY_NONE */
+		v = 31;
+		break;
+	default:
+		if (param >= 18 && param <= 21) {               /* TEXTURE_FEATURES0..3 */
+			v = am_rd(am_gpu, GPU_TEXTURE_FEATURES(param - 18u));
+			break;
+		}
+		if (param >= 22 && param <= 37) {               /* JS_FEATURES0..15, for the slots there are */
+			v = (param - 22u) < (uint32_t)__builtin_popcount(am_rd(am_gpu, GPU_JS_PRESENT)) ?
+			    am_rd(am_gpu, GPU_JS_FEATURES(param - 22u)) : 0;
+			break;
+		}
+		return false;
+	}
+	*value = v;
+	return true;
+}
+
+/* GPU addresses unit p on: the first taken one before `end`, or `end` if none is. */
+static uint32_t
+am_va_first_taken(uint32_t p, uint32_t end)
+{
+	while (p < end) {
+		uint64_t w = am_va_taken[p >> 6] >> (p & 63u);
+
+		if (w == 0) {
+			p = (p | 63u) + 1;
+			continue;
+		}
+		p += (uint32_t)__builtin_ctzll(w);
+		return p < end ? p : end;
+	}
+	return end;
+}
+
+static void
+am_va_mark(uint32_t p, uint32_t n, bool taken)
+{
+	uint32_t i;
+
+	for (i = p; i < p + n; i++) {
+		if (taken) {
+			am_va_taken[i >> 6] |= 1ull << (i & 63u);
+		} else {
+			am_va_taken[i >> 6] &= ~(1ull << (i & 63u));
+		}
+	}
+}
+
+/* `size` bytes of GPU addresses (rounded to 16 KB), as panfrost places them. 0: none left. */
+uint64_t
+a34_mali_va_alloc(uint64_t size, bool exec)
+{
+	uint32_t units, align = 1, limit, p, q;
+
+	if (!am_uc_ready || size == 0 || size > AM_UVA_END - AM_UVA_START) {
+		return 0;
+	}
+	units = (uint32_t)((size + AM_UVA_UNIT - 1) / AM_UVA_UNIT);
+	if (exec && size <= (16ull << 20)) {
+		while (align < units) {         /* naturally aligned: never across 16 MB */
+			align <<= 1;
+		}
+	} else if (size >= (2ull << 20)) {
+		align = (uint32_t)((2ull << 20) / AM_UVA_UNIT);
+	}
+	limit = exec ? AM_UVA_EXEC_UNITS : AM_UVA_UNITS;
+	for (p = 0; units <= limit && p <= limit - units;) {
+		q = am_va_first_taken(p, p + units);
+		if (q == p + units) {
+			am_va_mark(p, units, true);
+			return AM_UVA_START + (uint64_t)p * AM_UVA_UNIT;
+		}
+		p = (q + align) & ~(align - 1);
+	}
+	return 0;
+}
+
+void
+a34_mali_va_free(uint64_t va, uint64_t size)
+{
+	uint64_t units = (size + AM_UVA_UNIT - 1) / AM_UVA_UNIT, p;
+
+	if (va < AM_UVA_START || va >= AM_UVA_END || size == 0 || size > AM_UVA_END - va || (va & (AM_UVA_UNIT - 1)) != 0) {
+		return;
+	}
+	p = (va - AM_UVA_START) / AM_UVA_UNIT;
+	am_va_mark((uint32_t)p, (uint32_t)units, false);
+}
+
+/* [va, va + size) of the GPU to physical memory from pa on, 4 KB pages. */
+bool
+a34_mali_map(uint64_t va, uint64_t pa, uint64_t size)
+{
+	uint64_t end = va + size, *l3;
+	uint32_t first, n, i;
+
+	if (!am_uc_ready || size == 0 || ((va | pa | size) & 0xfffu) != 0 || va < AM_UVA_START || va >= AM_UVA_END ||
+	    size > AM_UVA_END - va || pa + size > (1ull << am_pa_bits)) {
+		return false;
+	}
+	while (va < end) {
+		l3 = am_l3_for(va);
+		if (l3 == NULL) {
+			return false;
+		}
+		first = (uint32_t)((va >> 12) & 511u);
+		n = 512u - first;
+		if (((uint64_t)n << 12) > end - va) {
+			n = (uint32_t)((end - va) >> 12);
+		}
+		for (i = 0; i < n; i++) {
+			l3[first + i] = ((pa + ((uint64_t)i << 12)) & PTE_ADDR) | PTE_AF | PTE_SH_INNER | PTE_AP_RW | PTE_PAGE;
+		}
+		am_flush((vm_offset_t)&l3[first], n * sizeof(uint64_t));
+		va += (uint64_t)n << 12;
+		pa += (uint64_t)n << 12;
+		am_pt_dirty = true;
+	}
+	return true;
+}
+
+void
+a34_mali_unmap(uint64_t va, uint64_t size)
+{
+	uint64_t end = va + size, *l3;
+	uint32_t first, n, i;
+
+	if (!am_uc_ready || size == 0 || ((va | size) & 0xfffu) != 0 || va < AM_UVA_START || va >= AM_UVA_END ||
+	    size > AM_UVA_END - va) {
+		return;
+	}
+	while (va < end) {
+		first = (uint32_t)((va >> 12) & 511u);
+		n = 512u - first;
+		if (((uint64_t)n << 12) > end - va) {
+			n = (uint32_t)((end - va) >> 12);
+		}
+		l3 = am_pt_l3[va >> 21];
+		if (l3 != NULL) {
+			for (i = 0; i < n; i++) {
+				l3[first + i] = 0;
+			}
+			am_flush((vm_offset_t)&l3[first], n * sizeof(uint64_t));
+			am_pt_dirty = true;
+		}
+		va += (uint64_t)n << 12;
+	}
+}
+
+/* What the processor wrote through a cached mapping, to memory (the GPU is not coherent). */
+void
+a34_mali_cpu_flush(uintptr_t va, uint64_t size)
+{
+	am_flush((vm_offset_t)va, (vm_size_t)size);
+}
+
+/*
+ * One job chain, run to its end: fragment jobs (PANFROST_JD_REQ_FS) on slot
+ * 0, the rest on slot 1 (panfrost_job_get_slot()), through AS0 with the
+ * caches cleaned and invalidated at both ends, priority 8, on every shader
+ * core (panfrost_job_hw_submit(); no flush reduction, no chain flag: one job
+ * at a time). False: not done -- and then the GPU has been reset.
+ */
+bool
+a34_mali_submit(struct a34_mali_job *job)
+{
+	uint32_t js = (job->requirements & AM_REQ_FS) ? 0u : 1u, base = AM_JS(js);
+	uint32_t want = JOB_INT_DONE(js) | JOB_INT_FAIL(js), raw, mmu = 0;
+	bool counted = (job->requirements & AM_REQ_CYCLE_COUNT) != 0;
+	uint64_t start;
+
+	job->ns = 0;
+	job->js_status = 0;
+	job->fault_va = 0;
+	job->mmu_raw = 0;
+	job->job_raw = 0;
+	if (!am_uc_ready || am_dead) {
+		return false;
+	}
+	if (am_pt_dirty && !am_as0_flush()) {
+		printf("A34 MALI UC: AS0 flush not done in 50 ms (AS_STATUS 0x%x)\n", am_rd(am_gpu, AS0 + AS_STATUS));
+		am_uc_recover(js);
+		return false;
+	}
+	if (am_rd(am_gpu, base + JS_COMMAND_NEXT) != 0) {
+		printf("A34 MALI UC: job slot %u busy (JS_COMMAND_NEXT 0x%x)\n", js, am_rd(am_gpu, base + JS_COMMAND_NEXT));
+		am_uc_recover(js);
+		return false;
+	}
+	am_wr(am_gpu, JOB_INT_CLEAR, want);
+	am_wr(am_gpu, MMU_INT_CLEAR, MMU_INT_AS0);
+	if (counted) {
+		am_wr(am_gpu, GPU_CMD, GPU_CMD_CYCLE_COUNT_START);
+	}
+	am_wr(am_gpu, base + JS_HEAD_NEXT_LO, (uint32_t)job->jc);
+	am_wr(am_gpu, base + JS_HEAD_NEXT_HI, (uint32_t)(job->jc >> 32));
+	am_wr(am_gpu, base + JS_AFFINITY_NEXT_LO, am_shaders);
+	am_wr(am_gpu, base + JS_AFFINITY_NEXT_HI, 0);
+	am_wr(am_gpu, base + JS_CONFIG_NEXT, JS_CONFIG_AS0);
+	start = mach_absolute_time();
+	am_wr(am_gpu, base + JS_COMMAND_NEXT, JS_COMMAND_START);
+	raw = am_wait_job(want, &mmu);
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &job->ns);
+	if (counted) {
+		am_wr(am_gpu, GPU_CMD, GPU_CMD_CYCLE_COUNT_STOP);
+	}
+	job->job_raw = raw;
+	job->mmu_raw = mmu;
+	job->js_status = am_rd(am_gpu, base + JS_STATUS);
+	job->fault_va = ((uint64_t)am_rd(am_gpu, AS0 + AS_FAULTADDRESS_HI) << 32) | am_rd(am_gpu, AS0 + AS_FAULTADDRESS_LO);
+	if (raw == JOB_INT_DONE(js) && mmu == 0) {
+		am_wr(am_gpu, JOB_INT_CLEAR, want);
+		return true;
+	}
+	printf("A34 MALI UC: job chain at 0x%llx on slot %u %s after %llu us: JOB_INT_RAWSTAT 0x%08x JS%u_STATUS 0x%08x "
+	    "JS%u_HEAD 0x%08x%08x MMU_INT_RAWSTAT 0x%08x AS0_FAULTSTATUS 0x%08x at 0x%llx GPU_FAULT_STATUS 0x%08x at 0x%08x%08x\n",
+	    (unsigned long long)job->jc, js, mmu != 0 ? "faulted in AS0" : (raw == 0 ? "NO ANSWER" : "FAILED"),
+	    (unsigned long long)(job->ns / 1000), am_rd(am_gpu, JOB_INT_RAWSTAT), js, job->js_status, js,
+	    am_rd(am_gpu, base + JS_HEAD_HI), am_rd(am_gpu, base + JS_HEAD_LO), am_rd(am_gpu, MMU_INT_RAWSTAT),
+	    am_rd(am_gpu, AS0 + AS_FAULTSTATUS), (unsigned long long)job->fault_va, am_rd(am_gpu, GPU_FAULT_STATUS),
+	    am_rd(am_gpu, GPU_FAULT_ADDRESS_LO + 4u), am_rd(am_gpu, GPU_FAULT_ADDRESS_LO));
+	am_uc_recover(js);
+	return false;
+}
+
+/*
+ * After step 6: the tables below 4 GB, the GPU reset and set up for programs
+ * (and checked with step 6's job once more), step 6's page out of AS0, the
+ * service started.
+ */
+static void
+am_uc_start(void)
+{
+	uint64_t *l3 = (uint64_t *)(am_mem + AM_PT_OFF + 0x3000);
+
+	am_as0_tab = am_mem_pa + AM_PT_OFF;
+	am_as0_cfg = AS_TRANSCFG_AARCH64_4K | AS_TRANSCFG_INA_BITS(55u - am_va_bits) |
+	    AS_TRANSCFG_PTW_WB | AS_TRANSCFG_PTW_RA;
+	if (!am_uc_tables()) {
+		printf("A34 MALI UC: no memory for the GPU's tables, user client not started\n");
+		return;
+	}
+	if (!am_gpu_reinit(true)) {
+		printf("A34 MALI UC: the GPU did not come back from its reset, user client not started\n");
+		return;
+	}
+	if (!am_run_job(7, AM_GPU_VA, 0xc0ffee07u)) {
+		printf("A34 MALI UC: the job after the reset failed, user client not started\n");
+		return;
+	}
+	l3[(AM_GPU_VA >> 12) & 511] = 0;
+	am_flush((vm_offset_t)&l3[(AM_GPU_VA >> 12) & 511], sizeof(uint64_t));
+	am_pt_dirty = true;
+	am_uc_ready = true;
+	if (!RedwoodMaliStart()) {
+		am_uc_ready = false;
+		printf("A34 MALI UC: the RedwoodMali service did not start\n");
+		return;
+	}
+	printf("A34 MALI UC: RedwoodMali started: GPU addresses 0x%llx..0x%llx in AS0 for every program, one job at a time\n",
+	    (unsigned long long)AM_UVA_START, (unsigned long long)AM_UVA_END);
+}
+
 static void
