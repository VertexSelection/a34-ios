+/*
+ * A34 (0936): the client's lazy tiler heaps backed (a34maliheap MB each, or all
+ * of the heap if smaller), before a job of it can use them: SUBMIT calls this
+ * first while fLazyHeaps says there is one. Takes the lock itself, as
+ * createBo(): memory is got and cleaned before it. The heap's one page is
+ * replaced in the GPU's tables (no job of the client has run: the GPU has not
+ * used it) and let go of. False: no memory for it (the SUBMIT fails).
+ */
+bool
+RedwoodMaliUserClient::heapGrow(void)
+{
+	for (;;) {
+		IOBufferMemoryDescriptor *mem, *old = NULL;
+		struct a34_bo *b;
+		uint64_t want = 0, off;
+		uint32_t handle = 0;
+		bool ok = false;
+
+		a34_gpu_lock();
+		for (uint32_t i = 0; fBos != NULL && fOpen && !fClosed && i < A34_BOS; i++) {
+			if (fBos[i].mem != NULL && (fBos[i].state & A34_BO_LAZY) != 0) {
+				handle = i + 1;
+				want = fBos[i].vasize > gA34MaliHeapBacked ? gA34MaliHeapBacked : fBos[i].vasize;
+				break;
+			}
+		}
+		IOLockUnlock(gA34MaliLock);
+		if (handle == 0) {
+			return true;
+		}
+		if (gA34MaliWired + want > gA34MaliWiredMax) {
+			IOLog("A34 MALI UC: %s: its tiler heap of %llu MB would make more than %llu MB of GPU buffers (a34malimem)\n",
+			    fName, (unsigned long long)(want >> 20), (unsigned long long)(gA34MaliWiredMax >> 20));
+			return false;
+		}
+		mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared,
+		    (vm_size_t)want, PAGE_SIZE);
+		if (mem == NULL) {
+			IOLog("A34 MALI UC: %s: no memory for its tiler heap of %llu MB\n", fName, (unsigned long long)(want >> 20));
+			return false;
+		}
+		a34_mali_cpu_flush((uintptr_t)mem->getBytesNoCopy(), want);
+		a34_gpu_lock();
+		b = (fBos != NULL && fOpen && !fClosed) ? lookup(handle) : NULL;
+		if (b == NULL || (b->state & A34_BO_LAZY) == 0) {
+			ok = true;                      /* (closed, or backed by another thread of the client) */
+		} else {
+			for (off = 0; off < want;) {
+				IOByteCount seglen = 0;
+				addr64_t pa = mem->getPhysicalSegment(off, &seglen, kIOMemoryMapperNone);
+				uint64_t len = seglen;
+
+				if (len > want - off) {
+					len = want - off;
+				}
+				len &= ~0xfffull;
+				if (pa == 0 || len == 0 || !a34_mali_map(b->va + off, pa, len)) {
+					break;
+				}
+				off += len;
+			}
+			if (off < want) {
+				/* back to the one page: nothing of the new memory is left in the tables */
+				a34_mali_unmap(b->va, want);
+				off = 0;
+				while (off < b->backed) {
+					IOByteCount seglen = 0;
+					addr64_t pa = b->mem->getPhysicalSegment(off, &seglen, kIOMemoryMapperNone);
+					uint64_t len = seglen > b->backed - off ? b->backed - off : seglen;
+
+					len &= ~0xfffull;
+					if (pa == 0 || len == 0 || !a34_mali_map(b->va + off, pa, len)) {
+						break;
+					}
+					off += len;
+				}
+			} else {
+				old = b->mem;
+				gA34MaliWired += want - b->backed;
+				fWired += want - b->backed;
+				b->mem = mem;
+				mem = NULL;
+				b->backed = want;
+				b->state &= ~A34_BO_LAZY;
+				fLazyHeaps--;
+				fHeapsGrown++;
+				ok = true;
+			}
+		}
+		IOLockUnlock(gA34MaliLock);
+		if (old != NULL) {
+			IOLog("A34 MALI UC: %s: tiler heap (buffer %u) backed before its first job: %llu MB (GPU buffers of all "
+			    "clients now %llu MB)\n", fName, handle, (unsigned long long)(want >> 20),
+			    (unsigned long long)(gA34MaliWired >> 20));
+		} else if (!ok) {
+			IOLog("A34 MALI UC: %s: its tiler heap of %llu MB would not go into the GPU's tables\n", fName,
+			    (unsigned long long)(want >> 20));
+		}
+		OSSafeReleaseNULL(mem);
+		OSSafeReleaseNULL(old);
+		if (!ok) {
+			return false;
+		}
+	}
+}
