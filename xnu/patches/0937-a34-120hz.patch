+/*
+ * A34 (0937): the rate commands, between frames: the display lock held (the
+ * console's kicks only try it; the kick work loop does not exist yet), the
+ * link idle first, the keys closed whatever happened, and the frame header
+ * (CMDQ0, CMDQ_CON) put back as it was found -- MediaTek writes 0x002c3909
+ * there before every frame, our frames reuse what LK left.
+ */
+bool
+AppleCLCD::panelHzSend(bool to120)
+{
+	static const uint8_t keyOn[3][3] = { { 0x9F, 0xA5, 0xA5 }, { 0xF0, 0x5A, 0x5A }, { 0xFC, 0x5A, 0x5A } };
+	static const uint8_t keyOff[3][3] = { { 0xFC, 0xA5, 0xA5 }, { 0xF0, 0xA5, 0xA5 }, { 0x9F, 0x5A, 0x5A } };
+	static const uint8_t rate120[3] = { 0x60, 0x00, 0x00 }, rate60[3] = { 0x60, 0x08, 0x00 };
+	static const uint8_t update[2] = { 0xF7, 0x0F };
+	uint32_t cmdq0, cmdqCon;
+	uint64_t t;
+	bool ok = true, closed = true;
+
+	if (!a34_dsi_lock()) {
+		return false;
+	}
+	if (!a34_dsi_wait_idle(&t, SWEET_FB_TE_PROBE_MS)) {
+		a34_dsi_unlock();
+		return false;
+	}
+	cmdq0 = a34_dsi_rd(SWEET_FB_DSI_CMDQ(0));
+	cmdqCon = a34_dsi_rd(SWEET_FB_DSI_CMDQ_CON);
+	for (unsigned i = 0; i < 3 && ok; i++) {
+		ok = sweet_fb_dcs(keyOn[i], 3);
+	}
+	ok = ok && sweet_fb_dcs(to120 ? rate120 : rate60, 3);
+	ok = ok && sweet_fb_dcs(update, 2);
+	for (unsigned i = 0; i < 3; i++) {
+		closed = sweet_fb_dcs(keyOff[i], 3) && closed;
+	}
+	a34_dsi_wr(SWEET_FB_DSI_CMDQ(0), cmdq0);
+	a34_dsi_wr(SWEET_FB_DSI_CMDQ_CON, cmdqCon);
+	a34_dsi_unlock();
+	return ok && closed;
+}
+
+/*
+ * A34 (0937) stage 2: microseconds to the next vsync tick. a34vsync=te: on
+ * the TE's grid (the last TE the kick saw, or the measured period from now),
+ * SWEET_FB_VSYNC_LEAD_US before a TE so a copy started on the tick is done for
+ * it; never less than a quarter period away. Otherwise 16667 us as before.
+ */
+uint32_t
+AppleCLCD::vsyncUS(void)
+{
+	uint64_t now, next, lead, ns, last = fTELast, p = fTEPeriod;
+
+	if (!fVsyncTE || p == 0) {
+		return SWEET_FB_VSYNC_US;
+	}
+	now = mach_absolute_time();
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_VSYNC_LEAD_US * NSEC_PER_USEC, &lead);
+	if (last == 0 || last > now) {
+		next = now + p;
+	} else {
+		next = last + ((now - last) / p + 1) * p;
+		next = next > lead ? next - lead : next;
+		while (next < now + p / 4) {
+			next += p;
+		}
+	}
+	absolutetime_to_nanoseconds(next - now, &ns);
+	return (uint32_t)(ns / NSEC_PER_USEC);
+}
