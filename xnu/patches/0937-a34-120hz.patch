+/*
+ * A34 (0937) stage 1: one DCS write from the CPU to the command-mode panel,
+ * the display lock held and the link idle (no frame in flight), as
+ * MediaTek's _mtk_mipi_dsi_write_gce() packs it for command mode: 1 byte a
+ * DCS short write (0x05), 2 bytes one with a parameter (0x15), more a DCS
+ * long write (0x39, payload from CMDQ1, little-endian); HS (config bit 3,
+ * no LPM for this panel), CMDQ_CON = words | bit 15, DSI_START 0, 1, 0, the
+ * link idle again. CMDQ0 is the frame header's register too: the caller puts
+ * it back.
+ */
+static bool
+sweet_fb_dcs(const uint8_t *buf, uint32_t len)
+{
+	uint64_t t;
+	uint32_t hdr, words;
+
+	if (len == 0 || len > 12 || !a34_dsi_wait_idle(&t, SWEET_FB_DCS_IDLE_MS)) {
+		return false;
+	}
+	if (len > 2) {
+		for (uint32_t i = 0; i < len; i += 4) {
+			uint32_t w = 0;
+
+			for (uint32_t k = 0; k < 4 && i + k < len; k++) {
+				w |= (uint32_t)buf[i + k] << (8u * k);
+			}
+			a34_dsi_wr(SWEET_FB_DSI_CMDQ(1u + i / 4u), w);
+		}
+		hdr = (len << 16) | (0x39u << 8) | 0x02u | 0x08u;
+		words = 1u + (len + 3u) / 4u;
+	} else {
+		hdr = (len == 2 ? (uint32_t)buf[1] << 24 : 0u) | ((uint32_t)buf[0] << 16) |
+		    ((len == 2 ? 0x15u : 0x05u) << 8) | 0x08u;
+		words = 1u;
+	}
+	a34_dsi_wr(SWEET_FB_DSI_CMDQ(0), hdr);
+	a34_dsi_wr(SWEET_FB_DSI_CMDQ_CON, (a34_dsi_rd(SWEET_FB_DSI_CMDQ_CON) & ~0xffu) | words | 0x8000u);
+	a34_dsi_wr(SWEET_FB_DSI_START, 0);
+	a34_dsi_wr(SWEET_FB_DSI_START, 1);
+	a34_dsi_wr(SWEET_FB_DSI_START, 0);
+	IODelay(20);
+	return a34_dsi_wait_idle(&t, SWEET_FB_DCS_IDLE_MS);
+}
