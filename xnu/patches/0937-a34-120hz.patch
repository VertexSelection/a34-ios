+/*
+ * A34 (0937) stage 3, boot-arg a34iomfbhz=120: IOMFBDisplayRefresh on this
+ * service before backboardd starts (QuartzCore reads it once, at its start:
+ * AppleCLCDDisplay::heartbeat_rate(); CA_HEARTBEAT_RATE overrides it), after
+ * ios-viva 0189 (MIT) and HackiOS's publishRefresh() (MIT):
+ * displayMinRefreshInterval/MaxRefreshInterval/RefreshStep = 2^32 / Hz
+ * (seconds, 0.32 fixed point), displayRefreshStepMachTime = one refresh in
+ * mach time. Only a rate the panel was measured at (a34panelhz), or 60.
+ */
+void
+AppleCLCD::publishRefresh(uint32_t hz)
+{
+	OSDictionary *refresh;
+	OSNumber *interval, *step;
+	uint64_t ticks = 0;
