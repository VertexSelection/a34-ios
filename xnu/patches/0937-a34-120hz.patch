+/*
+ * A34 (0937) stage 1, boot-arg a34panelhz=120 (60: back to 60): the panel's
+ * refresh rate by its own command, in AppleCLCD::start, before the GUI's
+ * first frame: test keys on (9F A5 A5, F0 5A 5A, FC 5A 5A), 60 00 00 (120 Hz)
+ * or 60 08 00 (60 Hz), F7 0F (the panel latches it), keys off -- the minimal
+ * part of what Samsung's smcdsd_panel_set_mode() sends; the DSI data rate
+ * does not change (806 Mbps either way). Only with the TE listened to
+ * (EXT_TE_EN): the TE period is measured before and SWEET_FB_HZ_SETTLE_MS
+ * after; not within 10% of the rate asked: 60 Hz is sent again. On success
+ * the TE-timed transfers (a34fbte, 0933) and a34vsync=te go by the new period.
+ * a34fbte=1 belongs with it: at 120 Hz a transfer not started at the TE tears.
+ */
+void
+AppleCLCD::panelHz(uint32_t hz)
+{
+	uint32_t mode = a34_dsi_rd(SWEET_FB_DSI_MODE_CTRL), txrx = a34_dsi_rd(SWEET_FB_DSI_TXRX_CTRL), nBefore, nAfter;
+	uint64_t before = 0, after = 0, beforeNs = 0, afterNs = 0, wantNs = NSEC_PER_SEC / hz;
+	bool sent;
+
+	IOLog("A34 FB 120: a34panelhz=%u: DSI MODE_CTRL 0x%08x TXRX_CTRL 0x%08x CMDQ0 0x%08x CMDQ_CON 0x%08x 0x6C 0x%08x\n",
+	    hz, mode, txrx, a34_dsi_rd(SWEET_FB_DSI_CMDQ(0)), a34_dsi_rd(SWEET_FB_DSI_CMDQ_CON),
+	    a34_dsi_rd(SWEET_FB_DSI_TYPE1_HS));
+	if (mode == 0xdeadbeefu || (mode & 3u) != 0 || (txrx & SWEET_FB_EXT_TE_EN) == 0) {
+		IOLog("A34 FB 120: not switched: it needs a command-mode DSI that listens to the TE (EXT_TE_EN)\n");
+		return;
+	}
+	nBefore = teCount(SWEET_FB_TE_PROBE_MS, &before);
+	absolutetime_to_nanoseconds(before, &beforeNs);
+	if (nBefore < 2) {
+		IOLog("A34 FB 120: not switched: no TE before (%u in %u ms): the new rate could not be checked\n", nBefore,
+		    SWEET_FB_TE_PROBE_MS);
+		return;
+	}
+	sent = panelHzSend(hz == 120);
+	IOSleep(SWEET_FB_HZ_SETTLE_MS);
+	nAfter = teCount(SWEET_FB_TE_PROBE_MS, &after);
+	absolutetime_to_nanoseconds(after, &afterNs);
+	if (sent && nAfter >= 2 && afterNs + wantNs / 10 > wantNs && afterNs < wantNs + wantNs / 10) {
+		fTEPeriod = after;
+		fTELast = 0;
+		fPanelHz = hz;
+		IOLog("A34 FB 120: the panel at %u Hz: TE every %llu us (%u in %u ms; before: every %llu us)%s\n", hz,
+		    (unsigned long long)(afterNs / NSEC_PER_USEC), nAfter, SWEET_FB_TE_PROBE_MS,
+		    (unsigned long long)(beforeNs / NSEC_PER_USEC), fTE ? "" : "; transfers are not started at the TE "
+		    "(a34fbte=1 is not on): expect tearing");
+		return;
+	}
+	IOLog("A34 FB 120: the panel did not settle at %u Hz (commands %s; TE every %llu us, %u in %u ms): 60 Hz sent "
+	    "again\n", hz, sent ? "sent" : "NOT all sent", (unsigned long long)(afterNs / NSEC_PER_USEC), nAfter,
+	    SWEET_FB_TE_PROBE_MS);
+	sent = panelHzSend(false);
+	IOSleep(SWEET_FB_HZ_SETTLE_MS);
+	nAfter = teCount(SWEET_FB_TE_PROBE_MS, &after);
+	absolutetime_to_nanoseconds(after, &afterNs);
+	if (nAfter >= 2) {
+		fTEPeriod = after;
+		fTELast = 0;
+	}
+	IOLog("A34 FB 120: back at 60 Hz (commands %s): TE every %llu us, %u in %u ms\n", sent ? "sent" : "NOT all sent",
+	    (unsigned long long)(afterNs / NSEC_PER_USEC), nAfter, SWEET_FB_TE_PROBE_MS);
+}
