+/*
+ * A34 (1008): after a transfer (and once at start): the OVLs' and RDMA0's
+ * error bits (frame underflow, EOF abnormal, SMI underflow, abnormal SOF;
+ * RDMA0 EOF abnormal, FIFO underflow), counted by the kind of frame just
+ * sent, the first 16 logged, cleared.
+ */
+void
+AppleCLCD::afbcCheck(bool afbc)
+{
+	uint32_t st[2] = { 0, 0 }, rdma = 0;
+
+	for (unsigned o = 0; o < 2; o++) {
+		if (fOvl[o] != NULL) {
+			st[o] = fOvl[o][SWEET_FB_OVL_INTSTA / 4] & SWEET_FB_OVL_INT_ERRORS;
+			if (st[o] != 0) {
+				fOvl[o][SWEET_FB_OVL_INTSTA / 4] = ~st[o];
+			}
+		}
+	}
+	if (fAfbcRdma != NULL) {
+		rdma = fAfbcRdma[SWEET_FB_RDMA_INT_STA / 4] & SWEET_FB_RDMA_INT_ERRORS;
+		if (rdma != 0) {
+			fAfbcRdma[SWEET_FB_RDMA_INT_STA / 4] = ~rdma;
+		}
+	}
+	sweet_fb_afbc_stats[afbc ? 0 : 1]++;
+	if ((st[0] | st[1]) != 0) {
+		sweet_fb_afbc_stats[afbc ? 2 : 3]++;
+	}
+	if (afbc && rdma != 0) {
+		sweet_fb_afbc_stats[4]++;
+	}
+	if ((st[0] | st[1] | rdma) != 0 && fAfbcErrSaid < 16) {
+		fAfbcErrSaid++;
+		IOLog("A34 FB AFBC: error bits after %s: OVL0_2L INTSTA 0x%04x, OVL0 0x%04x, RDMA0 0x%x (%llu AFBC frames sent so far)\n",
+		    afbc ? "an AFBC frame" : "a linear frame (or from before)", st[0], st[1], rdma,
+		    (unsigned long long)sweet_fb_afbc_stats[0]);
+	}
+}
