+/*
+ * A34 (1008): an AFBC frame's layer registers, as MediaTek's
+ * compr_l_config_AFBC_V1_2() works them out for a 32x8 superblock, 4 bytes
+ * a pixel, not rotated: the window (r: left, top, width, height) widened to
+ * whole superblocks across and half superblocks (4 rows) down, the rest
+ * clipped; Ln_ADDR at the window's first body slot (1 KB each, in raster
+ * order from the surface's bodies), Ln_HDR_ADDR at its header (16 bytes
+ * each), Ln_PITCH = a linear row of the aligned width * 8 (one row of
+ * superblocks), HDR_PITCH = a row of headers, YTR always, the second-half
+ * bit when the window starts 4 rows into a superblock. 1125x2436 at x 22
+ * y 48 for 1080x2400: 36 superblocks a row, 1120x2400 read, 22 clipped left
+ * and 18 right. False: not possible (outside the surface, above 4 GB).
+ */
+bool
+AppleCLCD::afbcRegs(SweetSurface *s, const int32_t r[6], struct sweet_fb_afbc *a)
+{
+	uint64_t base = s->scanPA + s->offset, hdr = base + s->scanHeader, body = base + s->scanBody;
+	uint32_t cols = (s->width + SWEET_SURFACE_AFBC_W - 1) / SWEET_SURFACE_AFBC_W;
+	uint32_t rows = (s->height + SWEET_SURFACE_AFBC_H - 1) / SWEET_SURFACE_AFBC_H;
+	uint32_t pitch8 = cols * SWEET_SURFACE_AFBC_W * 4 * SWEET_SURFACE_AFBC_H;
+	uint32_t x, y, w, h, xa, wa, ya, yh, ye, hh, tile;
+
+	if (r[0] < 0 || r[1] < 0 || r[4] <= 0 || r[5] <= 0) {
+		return false;
+	}
+	x = (uint32_t)r[0];
+	y = (uint32_t)r[1];
+	w = (uint32_t)r[4];
+	h = (uint32_t)r[5];
+	if (x + w > cols * SWEET_SURFACE_AFBC_W || y + h > rows * SWEET_SURFACE_AFBC_H || (pitch8 >> 16) > 0xfu ||
+	    body + (uint64_t)cols * rows * SWEET_SURFACE_AFBC_SLOT > (1ull << 32)) {
+		return false;
+	}
+	xa = x / SWEET_SURFACE_AFBC_W * SWEET_SURFACE_AFBC_W;
+	wa = (1 + (x + w - 1) / SWEET_SURFACE_AFBC_W) * SWEET_SURFACE_AFBC_W - xa;
+	ya = y / SWEET_SURFACE_AFBC_H * SWEET_SURFACE_AFBC_H;
+	yh = y / (SWEET_SURFACE_AFBC_H / 2) * (SWEET_SURFACE_AFBC_H / 2);
+	ye = (1 + (y + h - 1) / (SWEET_SURFACE_AFBC_H / 2)) * (SWEET_SURFACE_AFBC_H / 2) - 1;
+	hh = ye - yh + 1;
+	tile = xa / SWEET_SURFACE_AFBC_W + cols * (ya / SWEET_SURFACE_AFBC_H);
+	a->on = 1;
+	a->surface = s->id;
+	a->addr = (uint32_t)(body + (uint64_t)tile * SWEET_SURFACE_AFBC_SLOT);
+	a->hdrAddr = (uint32_t)(hdr + (uint64_t)tile * SWEET_SURFACE_AFBC_HDR);
+	a->pitch = pitch8 & 0xffffu;
+	a->pitchMsb = SWEET_FB_PITCH_YTR | (ya != yh ? SWEET_FB_PITCH_2ND : 0) | ((pitch8 >> 16) & 0xfu);
+	a->hdrPitch = cols * SWEET_SURFACE_AFBC_HDR;
+	a->srcSize = (hh << 16) | wa;
+	a->clip = (x - xa) | ((xa + wa - x - w) << 8) | ((y - yh) << 16) | ((yh + hh - y - h) << 24);
+	return true;
+}
