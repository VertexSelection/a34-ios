+/*
+ * A34 (1008), the kick's, with the display lock held and the link idle (the
+ * layer registers take effect at once: BYPASS_SHADOW): the layers that read
+ * picture 0 read the AFBC frame `a`. The loader's linear settings are kept
+ * the first time for ovlLinear().
+ */
+void
+AppleCLCD::ovlAfbc(const struct sweet_fb_afbc *a)
+{
+	if (!fOvlLinSaved) {
+		for (unsigned o = 0; o < 2; o++) {
+			if (fOvl[o] == NULL) {
+				continue;
+			}
+			fOvlLinPath[o] = fOvl[o][SWEET_FB_OVL_DATAPATH / 4];
+			for (unsigned n = 0; n < 4; n++) {
+				if ((fOvlFlip[o] & (1u << n)) == 0) {
+					continue;
+				}
+				fOvlLin[o][n][0] = fOvl[o][SWEET_FB_OVL_CON(n) / 4];
+				fOvlLin[o][n][1] = fOvl[o][SWEET_FB_OVL_SRC_SIZE(n) / 4];
+				fOvlLin[o][n][2] = fOvl[o][SWEET_FB_OVL_CLIP(n) / 4];
+				fOvlLin[o][n][3] = fOvl[o][SWEET_FB_OVL_PITCH_MSB(n) / 4];
+				IOLog("A34 FB AFBC: %s layer %u as the loader left it: CON 0x%08x SRC_SIZE 0x%08x CLIP 0x%08x PITCH_MSB "
+				    "0x%08x; DATAPATH_CON 0x%08x\n", o == 0 ? "OVL0_2L" : "OVL0", n, fOvlLin[o][n][0], fOvlLin[o][n][1],
+				    fOvlLin[o][n][2], fOvlLin[o][n][3], fOvlLinPath[o]);
+			}
+		}
+		fOvlLinSaved = true;
+	}
+	for (unsigned o = 0; o < 2; o++) {
+		volatile uint32_t *ovl = fOvl[o];
+
+		for (unsigned n = 0; ovl != NULL && n < 4; n++) {
+			if ((fOvlFlip[o] & (1u << n)) == 0) {
+				continue;
+			}
+			ovl[SWEET_FB_OVL_DATAPATH / 4] = ovl[SWEET_FB_OVL_DATAPATH / 4] | (1u << (4 + n));
+			ovl[SWEET_FB_OVL_SYSRAM(n) / 4] = 0;
+			ovl[SWEET_FB_OVL_SYSRAM(n) / 4 + 1] = 0;
+			ovl[SWEET_FB_OVL_SYSRAM(n) / 4 + 2] = 0;
+			ovl[SWEET_FB_OVL_CON(n) / 4] = (fOvlLin[o][n][0] & ~SWEET_FB_OVL_CON_FMT) | fAfbcCon;
+			ovl[SWEET_FB_OVL_SRC_SIZE(n) / 4] = a->srcSize;
+			ovl[SWEET_FB_OVL_CLIP(n) / 4] = a->clip;
+			ovl[SWEET_FB_OVL_PITCH_MSB(n) / 4] = a->pitchMsb;
+			ovl[SWEET_FB_OVL_PITCH(n) / 4] = (ovl[SWEET_FB_OVL_PITCH(n) / 4] & ~0xffffu) | a->pitch;
+			ovl[SWEET_FB_OVL_HDR_ADDR(n) / 4] = a->hdrAddr;
+			ovl[SWEET_FB_OVL_HDR_PITCH(n) / 4] = a->hdrPitch;
+			ovl[SWEET_FB_OVL_ADDR(n) / 4] = a->addr;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fOvlAfbc = true;
+	if (fAfbcSaid < 8) {
+		fAfbcSaid++;
+		IOLog("A34 FB AFBC: frame of surface %u: headers 0x%08x (%u a row), bodies 0x%08x, read %ux%u, clip 0x%08x, pitch "
+		    "0x%04x msb 0x%06x\n", a->surface, a->hdrAddr, a->hdrPitch, a->addr, a->srcSize & 0xffffu, a->srcSize >> 16,
+		    a->clip, a->pitch, a->pitchMsb);
+	}
+}
+
+/* A34 (1008): the kick's, as ovlAfbc(): the layers linear again, as the loader set them */
+void
+AppleCLCD::ovlLinear(void)
+{
+	for (unsigned o = 0; o < 2; o++) {
+		volatile uint32_t *ovl = fOvl[o];
+
+		for (unsigned n = 0; ovl != NULL && fOvlLinSaved && n < 4; n++) {
+			if ((fOvlFlip[o] & (1u << n)) == 0) {
+				continue;
+			}
+			ovl[SWEET_FB_OVL_DATAPATH / 4] = (ovl[SWEET_FB_OVL_DATAPATH / 4] & ~(1u << (4 + n))) |
+			    (fOvlLinPath[o] & (1u << (4 + n)));
+			ovl[SWEET_FB_OVL_CON(n) / 4] = fOvlLin[o][n][0];
+			ovl[SWEET_FB_OVL_SRC_SIZE(n) / 4] = fOvlLin[o][n][1];
+			ovl[SWEET_FB_OVL_CLIP(n) / 4] = fOvlLin[o][n][2];
+			ovl[SWEET_FB_OVL_PITCH_MSB(n) / 4] = fOvlLin[o][n][3];
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fOvlAfbc = false;
+}
