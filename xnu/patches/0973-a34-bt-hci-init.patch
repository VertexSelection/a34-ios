+/*
+ * (0973) The standard commands this controller lacks and bluetoothd's init asks, answered here: Command Complete,
+ * status 0, and their return parameters. True when cmd was one of them.
+ */
+static bool
+br_standard_here(const uint8_t *cmd, uint32_t n)
+{
+	static uint32_t said;
+	uint16_t op = (uint16_t)(cmd[1] | (cmd[2] << 8));
+	uint8_t ev[8] = { 0x04, 0x0e, 4, 1, cmd[1], cmd[2], 0, 0 };
+	uint32_t len = 7;
+
+	if (op == 0x0c5a) {
+		ev[2] = 5;                                      /* Read_Default_Erroneous_Data_Reporting: mode 0 (off) */
+		len = 8;
+	} else if (op != 0x0c5b && op != 0x0c84) {
+		return false;
+	}
+	if (said++ < 16) {
+		printf("A34 BT: br: command %04x (%u bytes) answered here: the controller does not have it\n", op, n - 4);
+	}
+	br_dump("br=", ev, len);
+	bt_deliver(ev, len);
+	a34_btsk_deliver(ev, len);
+	return true;
+}
