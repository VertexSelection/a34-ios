diff --git a/bsd/kern/a34_inject.c b/bsd/kern/a34_inject.c
new file mode 100644
index 0000000..b0e6c0c
--- /dev/null
+++ b/bsd/kern/a34_inject.c
@@ -0,0 +1,95 @@
+/*
+ * A34 (0914): DYLD_INSERT_LIBRARIES for named programs, added by the kernel
+ * at exec. After ios-topaz's kern.exec_inject (MakrSas/ios-topaz patch 0919,
+ * from HackiOS's darwin-redwood; Apple Public Source License 2.0).
+ *
+ * launchd passes no DYLD_* variable from a job description to a system
+ * daemon, and a wrapper binary in the daemon's place has to be a validly
+ * signed platform binary (launchd panics on "unexpected exec of non-platform
+ * binary"). So the kernel adds the variable to the environment of the
+ * program itself, backboardd for CoreAnimation's OpenGL ES renderer.
+ *
+ * Boot-arg a34inject=LIBRARY,NAME[,NAME...]: a program whose file name is
+ * one of the NAMEs starts with one more environment string,
+ * DYLD_INSERT_LIBRARIES=LIBRARY, unless its environment has that variable
+ * already. Without the boot-arg nothing changes. dyld honours the variable
+ * only when AMFI's dyld policy allows it (bsd/kern/sweet_amfi.c, a34dyld).
+ * The library must be signed (ad hoc is enough on the root filesystem); one
+ * that does not load is left out, the program starts without it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+#define A34_INJECT_VAR          "DYLD_INSERT_LIBRARIES="
+#define A34_INJECT_MAX          256
+
+/* bsd/kern/kern_exec.c, exec_extract_strings() */
+const char *a34_exec_inject(const char *name, int namelen, const char *env, const char *env_end);
+
+static char a34_inject_env[sizeof(A34_INJECT_VAR) + A34_INJECT_MAX];   /* the variable, "" for none */
+static char a34_inject_names[A34_INJECT_MAX];                           /* "NAME,NAME..." */
+
+__startup_func
+static void
+a34_inject_init(void)
+{
+	char conf[A34_INJECT_MAX];
+	char *comma;
+
+	if (!PE_parse_boot_arg_str("a34inject", conf, (int)sizeof(conf))) {
+		return;
+	}
+	comma = strchr(conf, ',');
+	if (conf[0] != '/' || comma == NULL || comma[1] == 0 || comma[1] == ',') {
+		printf("A34 INJECT: boot-arg a34inject=%s ignored (LIBRARY,NAME[,NAME...], LIBRARY a full path)\n", conf);
+		return;
+	}
+	*comma = 0;
+	strlcpy(a34_inject_names, comma + 1, sizeof(a34_inject_names));
+	snprintf(a34_inject_env, sizeof(a34_inject_env), "%s%s", A34_INJECT_VAR, conf);
+	printf("A34 INJECT: %s for %s\n", a34_inject_env, a34_inject_names);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, a34_inject_init);
+
+/*
+ * The environment string to add for the program `name` (namelen bytes, not
+ * NUL-terminated) whose environment strings so far lie in [env, env_end),
+ * or NULL.
+ */
+const char *
+a34_exec_inject(const char *name, int namelen, const char *env, const char *env_end)
+{
+	const char *p = a34_inject_names;
+
+	if (a34_inject_env[0] == 0 || name == NULL || namelen <= 0) {
+		return NULL;
+	}
+	while (*p != 0) {
+		const char *word = p;
+
+		while (*p != 0 && *p != ',') {
+			p++;
+		}
+		if (p - word == namelen && strncmp(word, name, (size_t)namelen) == 0) {
+			/* a variable of the program's own comes first and wins in dyld: nothing to add */
+			while (env != NULL && env < env_end) {
+				size_t len = strnlen(env, (size_t)(env_end - env));
+
+				if (strncmp(env, A34_INJECT_VAR, sizeof(A34_INJECT_VAR) - 1) == 0) {
+					return NULL;
+				}
+				env += len + 1;
+			}
+			printf("A34 INJECT: %.*s starts with %s\n", namelen, name, a34_inject_env);
+			return a34_inject_env;
+		}
+		if (*p == ',') {
+			p++;
+		}
+	}
+	return NULL;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
