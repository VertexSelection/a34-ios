+/*
+ * With the lock held. A34 (0914): the surfaces among the buffers a job
+ * names (SUBMIT's bo_handles, a user address; Mesa lists every buffer a
+ * batch reads or writes), cleaned and invalidated like the client's own
+ * buffers: a surface is cacheable memory for every processor and program,
+ * and the GPU is not coherent. Each surface once per call; a list that
+ * cannot be read, or none: every surface of the client.
+ */
+void
+RedwoodMaliUserClient::flushSurfaces(user_addr_t list, uint32_t count)
+{
+	uint32_t chunk[A34_SUBMIT_BOS_CHUNK], round, done = 0;
+	bool all = list == 0 || count == 0 || count > A34_SUBMIT_BOS_MAX;
+
+	if (fBos == NULL || fSurfaceBos == 0) {
+		return;
+	}
+	if (++fFlushRound == 0) {
+		fFlushRound = 1;
+	}
+	round = fFlushRound;
+	while (!all && done < count) {
+		uint32_t n = count - done < A34_SUBMIT_BOS_CHUNK ? count - done : A34_SUBMIT_BOS_CHUNK;
+
+		if (copyin(list + (user_addr_t)done * sizeof(uint32_t), chunk, n * sizeof(uint32_t)) != 0) {
