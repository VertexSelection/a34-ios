+/*
+ * A34 (0914), after ios-topaz 0902 and 0147 (MakrSas/ios-topaz, APSL 2.0):
+ * dyld asks the MAC policy named "AMFI" what it may do for the process it
+ * starts: __mac_syscall("AMFI", 0x5a, { u64 flags in, user pointer to u64
+ * flags out }), amfi_check_dyld_policy_self(). With no policy of that name
+ * the call fails and every process runs restricted: dyld ignores DYLD_*
+ * variables and refuses @ paths ("security policy does not allow @ path
+ * expansion"). This policy is named "AMFI" and answers that call with
+ * everything allowed (@ paths, DYLD_* variables, fallback paths,
+ * interposing; a library that cannot be inserted is left out instead of
+ * killing the process). Every other AMFI call answers ENOPOLICY, as when
+ * there was no such policy. Boot-arg a34dyld=0: the old name, no answer.
+ */
+#define SWEET_AMFI_CHECK_DYLD_POLICY    0x5a
+#define SWEET_AMFI_DYLD_ALLOW_ALL       0xffULL
+
+static TUNABLE(uint32_t, a34_dyld_policy, "a34dyld", 1);
+
+static int
+sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	static bool said;
+	uint64_t in_out[2] = { 0, 0 };
+	uint64_t allow = SWEET_AMFI_DYLD_ALLOW_ALL;
+	int error;
+
+	if (call != SWEET_AMFI_CHECK_DYLD_POLICY || a34_dyld_policy == 0) {
+		return ENOPOLICY;
+	}
+	error = copyin(arg, in_out, sizeof(in_out));
+	if (error == 0) {
+		error = copyout(&allow, (user_addr_t)in_out[1], sizeof(allow));
+	}
+	if (!said) {
+		char name[32];
+
+		said = true;
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("A34 AMFI: dyld policy of %s (flags 0x%llx in): 0x%llx (%d)\n", name,
+		    (unsigned long long)in_out[0], (unsigned long long)allow, error);
+	}
+	return error;
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_policy_syscall = sweet_amfi_syscall,
 };
 
 /*
@@ -373,8 +418,11 @@ void sweet_amfi_policy_register(void);
 void
 sweet_amfi_policy_register(void)
 {
+	if (a34_dyld_policy != 0) {
+		sweet_amfi_mac_conf.mpc_name = "AMFI";  /* A34 (0914): the name dyld asks (see sweet_amfi_syscall) */
+	}
