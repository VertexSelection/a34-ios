diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index bd729ab..30642be 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -728,12 +728,51 @@ static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
  */
 static volatile uint32_t *fbcon_dsi, *fbcon_mutex;
 
+/*
+ * A34 (0913): one trigger at a time. The text console (every new line, from
+ * whichever CPU printed it) and the GUI's kick work loop both start frames;
+ * a start while another frame is still in flight wedged the display pipe for
+ * good (DSI busy forever from the first GUI frame on). Both paths now take
+ * this flag around "wait until idle, start"; the console only tries, and
+ * stops starting frames once the GUI has muted it.
+ */
+extern int sweet_console_muted;         /* osfmk/console/serial_console.c */
+static volatile uint32_t a34_disp_lockword;
+
+static int
+a34_disp_trylock(void)
+{
+	return __sync_bool_compare_and_swap(&a34_disp_lockword, 0u, 1u);
+}
+
+int a34_dsi_lock(void);
+int
+a34_dsi_lock(void)
+{
+	for (unsigned int i = 0; i < 50000000u; i++) {
+		if (a34_disp_trylock()) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+void a34_dsi_unlock(void);
+void
+a34_dsi_unlock(void)
+{
+	__sync_lock_release(&a34_disp_lockword);
+}
+
 static void
 fbcon_kick(void)
 {
 	if (fbcon_dsi == NULL || (fbcon_dsi[0x14 / 4] & 3)) {
 		return;
 	}
+	if (sweet_console_muted || !a34_disp_trylock()) {
+		return;
+	}
 	__asm__ volatile("dsb sy" ::: "memory");
 	/* A34 (0905): was 2,000,000 reads (~200 ms when the busy bit stays up,
 	 * which stalled every GUI frame); a frame transfer takes < 20 ms. */
@@ -749,6 +788,33 @@ fbcon_kick(void)
 	fbcon_dsi[0] = 0;
 	fbcon_dsi[0] = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
+	a34_dsi_unlock();
+}
+
+/*
+ * A34 (0913): get a wedged pipe going again: reset every display mutex
+ * that has modules (MUTEX_RST, 0x28 + 0x20 n) and the DSI engine
+ * (DSI_CON_CTRL bit 0, as Linux's mtk_dsi_reset_engine); the caller holds
+ * the lock and starts a frame afterwards.
+ */
+void a34_dsi_recover(void);
+void
+a34_dsi_recover(void)
+{
+	if (fbcon_dsi == NULL || fbcon_mutex == NULL) {
+		return;
+	}
+	for (unsigned int n = 0; n < 16; n++) {
+		if (fbcon_mutex[(0x30 + 0x20 * n) / 4]) {
+			fbcon_mutex[(0x28 + 0x20 * n) / 4] = 1;
+			__asm__ volatile("dsb sy" ::: "memory");
+			fbcon_mutex[(0x28 + 0x20 * n) / 4] = 0;
+		}
+	}
+	fbcon_dsi[0x10 / 4] |= 1u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	fbcon_dsi[0x10 / 4] &= ~1u;
+	__asm__ volatile("dsb sy" ::: "memory");
 }
 
