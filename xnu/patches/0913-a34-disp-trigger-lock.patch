 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 extern "C" uint32_t a34_dsi_rd(uint32_t off);
+extern "C" int a34_dsi_lock(void);
+extern "C" void a34_dsi_unlock(void);
+extern "C" void a34_dsi_recover(void);
 extern "C" uint32_t a34_mutex_rd(uint32_t off);
 
 /*
@@ -257,14 +260,32 @@ a34_kick_action(OSObject *owner, IOTimerEventSource *sender)
 	(void)owner;
 	(void)sender;
 
+	/* A34 (0913): wait-for-idle and start under the console's lock too. */
+	if (!a34_dsi_lock()) {
+		a34_kick_stats[5]++;
+		return;
+	}
 	if (!a34_dsi_wait_idle(&wait)) {
 		a34_kick_stats[5]++;
+		a34_disp_dump("busy for 1 s before a start");
+		a34_dsi_recover();
 	}
 	a34_dsi_trigger();
+	a34_dsi_unlock();
 	IODelay(50);
 	if (!a34_dsi_wait_idle(&xfer)) {
 		a34_kick_stats[5]++;
 		a34_disp_dump("transfer did not finish in 1 s");
+		if (a34_dsi_lock()) {
+			a34_dsi_recover();
+			a34_dsi_trigger();
+			a34_dsi_unlock();
+			IODelay(50);
+			uint64_t again;
+			bool ok = a34_dsi_wait_idle(&again);
+			IOLog("A34 DISP: after mutex/DSI reset and a new start: %s in %llu us (DSI_INTSTA 0x%08x)\n",
