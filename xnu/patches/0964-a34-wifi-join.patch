+/* (from a34w_wfdma_init, DMA off) TX ring 0 empty, RX rings 2..5 the DMA's, DMASHDL as Android's */
+static void
+a34w_data_rings_init(void)
+{
+	for (uint32_t s = 0; s < DATA_TX_SLOTS; s++) {
+		volatile uint32_t *t = a34w_desc(DMA_TX0_DESC, s);
+
+		t[0] = 0;
+		t[1] = DESC_DMADONE;
+		t[2] = 0;
+		t[3] = 0;
+	}
+	for (uint32_t n = 2; n <= 5u; n++) {
+		struct a34w_rx_ring *r = &a34w_drx[n - 2u];
+
+		r->slots = n <= 3u ? DATA_RX_SLOTS : FREE_RX_SLOTS;
+		r->buf_size = n <= 3u ? DATA_RX_BUF_SIZE : FREE_RX_BUF_SIZE;
+		r->cidx = r->slots - 1u;
+		for (uint32_t s = 0; s < r->slots; s++) {
+			volatile uint32_t *d = a34w_desc(DMA_RXN_DESC(n), s);
+
+			d[0] = (uint32_t)A34W_DMA_PA + DMA_RXN_BUFS(n) + s * SLOT_SIZE;
+			d[1] = DESC_SDLEN0(r->buf_size);
+			d[2] = 0;
+			d[3] = 0;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a34w_dtx_cidx = 0;
+	a34w_tokens_busy = 0;
+	a34w_wr(a34w_conn, WFDMA_TX_RING(DATA_TX_RING) + 0x0u, (uint32_t)A34W_DMA_PA + DMA_TX0_DESC);
+	a34w_wr(a34w_conn, WFDMA_TX_RING(DATA_TX_RING) + 0x8u, 0);
+	a34w_wr(a34w_conn, WFDMA_TX_RING(DATA_TX_RING) + 0x4u, DATA_TX_SLOTS);
+	for (uint32_t n = 2; n <= 5u; n++) {
+		a34w_wr(a34w_conn, WFDMA_RX_RING(n) + 0x0u, (uint32_t)A34W_DMA_PA + DMA_RXN_DESC(n));
+		a34w_wr(a34w_conn, WFDMA_RX_RING(n) + 0x8u, a34w_drx[n - 2u].cidx);
+		a34w_wr(a34w_conn, WFDMA_RX_RING(n) + 0x4u, a34w_drx[n - 2u].slots);
+	}
+	a34w_dmashdl_init();
+	a34w_data_rings = true;
+}
