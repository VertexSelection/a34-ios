+/* ---- the network the owner wants joined: /a34/wifi/network ---- */
+
+/*
+ * "key=value" lines; '#' starts a comment line; the value is everything after the first '=' up
+ * to the end of the line (a '\r' before it dropped, nothing else trimmed: names and passphrases
+ * may have spaces). ssid= (1..32 bytes), psk= (8..63 printable characters, or 64 hex digits),
+ * bssid= (optional). NULL when good, else what is wrong (never the passphrase).
+ */
+static const char *
+a34w_network_parse(const uint8_t *text, uint32_t length, struct a34w_network *n)
+{
+	uint32_t at = 0;
+
+	bzero(n, sizeof(*n));
+	while (at < length) {
+		uint32_t end = at, eq, vlen;
+		const uint8_t *v;
+
+		while (end < length && text[end] != '\n') {
+			end++;
+		}
+		vlen = end;
+		if (vlen > at && text[vlen - 1u] == '\r') {
+			vlen--;
+		}
+		if (vlen == at || text[at] == '#') {
+			at = end + 1u;
+			continue;
+		}
+		for (eq = at; eq < vlen && text[eq] != '='; eq++) {
+		}
+		if (eq == vlen) {
+			return "a line without '='";
+		}
+		v = text + eq + 1u;
+		vlen -= eq + 1u;
+		if (eq - at == 4u && memcmp(text + at, "ssid", 4) == 0) {
+			if (vlen < 1u || vlen > 32u) {
+				return "ssid= is not 1 to 32 bytes";
+			}
+			memcpy(n->ssid, v, vlen);
+			n->ssid_length = vlen;
+		} else if (eq - at == 3u && memcmp(text + at, "psk", 3) == 0) {
+			bool hex = vlen == 64u;
+
+			for (uint32_t i = 0; i < vlen && hex; i++) {
+				hex = a34w_hex(v[i]) >= 0;
+			}
+			if (hex) {
+				for (uint32_t i = 0; i < 32u; i++) {
+					n->pmk[i] = (uint8_t)(a34w_hex(v[2u * i]) << 4 | a34w_hex(v[2u * i + 1u]));
+				}
+				n->psk_is_key = true;
+			} else {
+				if (vlen < 8u || vlen > 63u) {
+					return "psk= is neither 8 to 63 characters nor 64 hex digits";
+				}
+				for (uint32_t i = 0; i < vlen; i++) {
+					if (v[i] < 0x20u || v[i] > 0x7eu) {
+						return "psk= has a character that is not printable ASCII";
+					}
+				}
+				memcpy(n->passphrase, v, vlen);
+				n->passphrase_length = vlen;
+			}
+			n->psk_given = true;
+		} else if (eq - at == 5u && memcmp(text + at, "bssid", 5) == 0) {
+			if (!a34w_mac_text(v, vlen, n->bssid)) {
+				return "bssid= is not xx:xx:xx:xx:xx:xx";
+			}
+			n->bssid_given = true;
+		} else {
+			return "a line that is not ssid=, psk= or bssid=";
+		}
+		at = end + 1u;
+	}
+	return n->ssid_length == 0 ? "no ssid= line" : NULL;
+}
+
+/* the SSID for the log: printable ASCII, the rest as '?' */
+static void
+a34w_net_ssid(char out[33])
+{
+	for (uint32_t i = 0; i < a34w_net.ssid_length; i++) {
+		out[i] = (a34w_net.ssid[i] >= 0x20u && a34w_net.ssid[i] < 0x7fu) ? (char)a34w_net.ssid[i] : '?';
+	}
+	out[a34w_net.ssid_length] = '\0';
+}
+
+static bool
+a34w_network_load(void)
+{
+	uint32_t size = 0;
+	uint8_t *text = a34w_file(A34W_NETWORK_FILE, 6u, "the phone's owner writes it (\"ssid=...\", \"psk=...\")", &size);
+	const char *why;
+	char ssid[33];
+	uint64_t t0;
+
+	if (text == NULL) {
+		return false;
+	}
+	why = size <= 1024u ? a34w_network_parse(text, size, &a34w_net) : "longer than 1024 bytes";
+	bzero(text, size);
+	kfree_data(text, (vm_size_t)size);
+	if (why != NULL) {
+		a34w_say("step 8: " A34W_FW_DIR A34W_NETWORK_FILE ": %s", why);
+		bzero(&a34w_net, sizeof(a34w_net));
+		return false;
+	}
+	a34w_net_ssid(ssid);
+	if (a34w_net.psk_given && !a34w_net.psk_is_key) {
+		t0 = a34w_ms();
+		a34_wpa_pmk(a34w_net.passphrase, a34w_net.passphrase_length, a34w_net.ssid, a34w_net.ssid_length, a34w_net.pmk);
+		bzero(a34w_net.passphrase, sizeof(a34w_net.passphrase));
+		a34w_say("step 8: network \"%s\": WPA2-PSK, a passphrase of %u characters (its key made in %llu ms)%s", ssid,
+		    a34w_net.passphrase_length, (unsigned long long)(a34w_ms() - t0), a34w_net.bssid_given ? ", one BSSID only" : "");
+	} else {
+		a34w_say("step 8: network \"%s\": %s%s", ssid, a34w_net.psk_given ? "WPA2-PSK, a 64-digit key" : "open",
+		    a34w_net.bssid_given ? ", one BSSID only" : "");
+	}
+	return true;
+}
+
+/* ---- the target: the network chosen from a scan ---- */
+
+/* the element `id` among the target's, or NULL */
+static const uint8_t *
+a34w_target_ie(uint8_t id)
+{
+	const uint8_t *ie = a34w_target.ies, *end = a34w_target.ies + a34w_target.ies_length;
+
+	for (; ie + 2 <= end && ie + 2 + ie[1] <= end; ie += 2 + ie[1]) {
+		if (ie[0] == id) {
+			return ie;
+		}
+	}
+	return NULL;
+}
+
+/* (from a34w_mgmt_in, while joining) a beacon or probe response: kept if of the SSID wanted and the loudest so far */
+static void
+a34w_target_heard(const uint8_t *frame, uint32_t length, int rssi, uint8_t channel)
+{
+	const uint8_t *ie, *end = frame + length, *ssid = NULL;
+	uint8_t ds = 0;
+
+	if (!a34w_joining || length < 36u) {
+		return;
+	}
+	for (ie = frame + 36; ie + 2 <= end && ie + 2 + ie[1] <= end; ie += 2 + ie[1]) {
+		if (ie[0] == 0 && ssid == NULL) {
+			ssid = ie;
+		} else if (ie[0] == 3 && ie[1] == 1) {
+			ds = ie[2];
+		}
+	}
+	channel = ds != 0 ? ds : channel;
+	if (ssid == NULL || ssid[1] != a34w_net.ssid_length || memcmp(ssid + 2, a34w_net.ssid, ssid[1]) != 0 ||
+	    (a34w_net.bssid_given && memcmp(frame + 16, a34w_net.bssid, 6) != 0) || channel == 0 ||
+	    (a34w_target.found && rssi <= a34w_target.rssi && memcmp(frame + 16, a34w_target.bssid, 6) != 0)) {
+		return;
+	}
+	if (!a34w_target.found || memcmp(frame + 16, a34w_target.bssid, 6) != 0 || rssi > a34w_target.rssi) {
+		a34w_target.rssi = (int8_t)rssi;
+	}
+	a34w_target.found = true;
+	memcpy(a34w_target.bssid, frame + 16, 6);
+	a34w_target.channel = channel;
+	a34w_target.beacon_interval = (uint16_t)(frame[32] | frame[33] << 8);
+	a34w_target.capability = (uint16_t)(frame[34] | frame[35] << 8);
+	a34w_target.ies_length = length - 36u > A34W_IES_MOST ? A34W_IES_MOST : length - 36u;
+	memcpy(a34w_target.ies, frame + 36, a34w_target.ies_length);
+}
+
+/* 00-0f-ac-<n> */
+static bool
+a34w_suite_is(const uint8_t *s, uint8_t n)
+{
+	return s[0] == 0x00u && s[1] == 0x0fu && s[2] == 0xacu && s[3] == n;
+}
+
+/* NULL if WPA2-PSK with CCMP for both keys is possible without management frame protection, else why not */
+static const char *
+a34w_rsn_check(void)
+{
+	const uint8_t *e = a34w_target_ie(48), *p, *end;
+	uint32_t count;
+	bool ccmp = false, psk = false;
+
+	if (e == NULL) {
+		return (a34w_target.capability & 0x10u) ? "it wants WEP or WPA (no RSN element)" : "it is open";
+	}
+	p = e + 2;
+	end = e + 2 + e[1];
+	if (p + 6 > end || (p[0] | p[1] << 8) != 1) {
+		return "its RSN element is not version 1";
+	}
+	if (!a34w_suite_is(p + 2, 4)) {
+		return "its group cipher is not CCMP (TKIP: WPA/WPA2 mixed mode)";
+	}
+	p += 6;
+	if (p + 2 > end) {
+		return "its RSN element lists no pairwise cipher";
+	}
+	count = (uint32_t)(p[0] | p[1] << 8);
+	p += 2;
+	for (uint32_t i = 0; i < count && p + 4 <= end; i++, p += 4) {
+		ccmp |= a34w_suite_is(p, 4);
+	}
+	if (p + 2 > end) {
+		return "its RSN element lists no key management";
+	}
+	count = (uint32_t)(p[0] | p[1] << 8);
+	p += 2;
+	for (uint32_t i = 0; i < count && p + 4 <= end; i++, p += 4) {
+		psk |= a34w_suite_is(p, 2);
+	}
+	if (!ccmp) {
+		return "its pairwise ciphers do not include CCMP";
+	}
+	if (!psk) {
+		return "it does not offer PSK (WPA3-only SAE, or 802.1X)";
+	}
+	if (p + 2 <= end && (p[0] & 0x40u) != 0) {
+		return "it requires management frame protection (WPA3 / PMF required)";
+	}
+	return NULL;
+}
+
+/* the station's RSN element: WPA2-PSK, CCMP for both keys, no capabilities (message 2 carries it too) */
+static const uint8_t a34w_own_rsn[] = {
+	48, 20, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 2, 0, 0,
+};
+
+/* 2, 4, 11, 22, ... (500 kb/s units) -> the firmware's rate bits (wlan_def.h: bit 0 1M ... bit 13 54M) */
+static uint16_t
+a34w_rate_bit(uint8_t rate)
+{
+	static const uint8_t rates[14] = { 2, 4, 11, 22, 44, 66, 12, 18, 24, 36, 48, 72, 96, 108 };
+
+	for (uint32_t i = 0; i < 14u; i++) {
+		if (rates[i] == (rate & 0x7fu)) {
+			return (uint16_t)(1u << i);
+		}
+	}
+	return 0;
+}
+
+/* the target's operational and basic rate sets, from Supported Rates and Extended Supported Rates */
+static void
+a34w_target_rates(uint16_t *operational, uint16_t *basic)
+{
+	static const uint8_t ids[2] = { 1, 50 };
+
+	*operational = 0;
+	*basic = 0;
+	for (uint32_t k = 0; k < 2u; k++) {
+		const uint8_t *e = a34w_target_ie(ids[k]);
+
+		for (uint32_t i = 0; e != NULL && i < e[1]; i++) {
+			uint16_t bit = a34w_rate_bit(e[2 + i]);
+
+			*operational |= bit;
+			if (e[2 + i] & 0x80u) {
+				*basic |= bit;
+			}
+		}
+	}
+	if (*operational == 0) {                /* (none understood: the band's own) */
+		*operational = a34w_target.channel > 14u ? 0x3fc0u : 0x000fu;
+	}
+	if (*basic == 0) {
+		*basic = a34w_target.channel > 14u ? 0x0540u : 0x0003u;
+	}
+}
+
+/* the lowest basic rate as a TXD rate code (CCK 1/2/5.5/11 M: 0..3; OFDM 6..54 M: 0x4b, 0x4f, 0x4a, ...) */
+static uint16_t
+a34w_lowest_basic_rate(void)
+{
+	static const uint16_t codes[14] = { 0x0000, 0x0001, 0x0002, 0x0003, 0, 0, 0x004b, 0x004f, 0x004a, 0x004e, 0x0049,
+		                            0x004d, 0x0048, 0x004c };
+	uint16_t operational, basic;
+
+	a34w_target_rates(&operational, &basic);
+	for (uint32_t i = 0; i < 14u; i++) {
+		if ((basic & (1u << i)) != 0 && (i < 4u || i >= 6u)) {
+			return codes[i];
+		}
+	}
+	return a34w_target.channel > 14u ? RATE_CODE_OFDM_6M : RATE_CODE_CCK_1M;
+}
+
+/* 2.4 GHz: HR/DSSS, and ERP if any OFDM rate; 5 GHz: OFDM (PHY_TYPE_BIT_*) */
+static uint8_t
+a34w_target_phy(uint16_t operational)
+{
+	if (a34w_target.channel > 14u) {
+		return 0x08u;
+	}
+	return (operational & 0x3fc0u) != 0 ? 0x03u : 0x01u;
+}
+
+/* ---- the frames: TXDs (nic_txd_v2_compose), the mailbox for management frames, TX ring 0 for data ---- */
+
+static uint8_t
+a34w_next_pid(void)
+{
+	a34w_pid = (uint8_t)(a34w_pid % 127u + 1u);     /* 1..127, as nic_tx.c's per-WLAN pool */
+	return a34w_pid;
+}
+
+static void
+a34w_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+/*
+ * The CONNAC2X TXD (32 bytes) for a frame to the AP (WTBL 5): a management frame (802.11 header,
+ * packet format "command", MCU queue 1, lifetime 2 s, 30 tries, the lowest basic rate, a
+ * sequence number) or an Ethernet frame (header translated by the hardware, AC_BE queue; EAPOL
+ * at the lowest basic rate with its TX status asked for). `pid` 0: no TX status.
+ */
+static void
+a34w_txd(uint8_t txd[32], uint32_t length, int mgmt_subtype, bool fixed_rate, bool protect, uint8_t pid)
+{
+	uint32_t dw[8] = { 0 };
+	uint32_t rate = a34w_lowest_basic_rate();
+
+	if (mgmt_subtype >= 0) {
+		uint32_t sub = (uint32_t)mgmt_subtype & 0xfu;
+
+		a34w_mgmt_sn = (uint16_t)(a34w_mgmt_sn % 4095u + 1u);
+		dw[0] = (32u + length) | (16u << 16) | (2u << 23) | (1u << 25);
+		dw[1] = AP_WLAN_INDEX | (1u << 10) | (12u << 11) | (2u << 16) | (1u << 31);
+		dw[2] = sub | (30u << 16) | (1u << 31);
+		dw[3] = (30u << 11) | ((uint32_t)a34w_mgmt_sn << 16) | (1u << 31);
+		dw[6] = rate << 16;
+		dw[7] = (24u << 11) | (sub << 16);
+	} else {
+		dw[0] = (32u + length) | (10u << 16) | (1u << 25);
+		dw[1] = AP_WLAN_INDEX | (1u << 10) | (1u << 15) | (1u << 31);
+		dw[3] = (30u << 11) | (protect ? 2u : 0u);
+		if (fixed_rate) {
+			dw[2] = 1u << 31;
+			dw[6] = rate << 16;
+			dw[7] = 24u << 11;
+		}
+	}
+	if (pid != 0) {
+		dw[5] = pid | (1u << 9);
+	}
+	for (uint32_t i = 0; i < 8u; i++) {
+		a34w_put32(txd + 4u * i, dw[i]);
+	}
+}
+
+/* a management frame (from its Frame Control on, no FCS) to the AP, through the mailbox */
+static bool
+a34w_mgmt_tx(const uint8_t *frame, uint32_t length, const char *what)
+{
+	static uint8_t buf[CMD_FRAME_MOST];
+	uint8_t pid = a34w_next_pid();
+
+	if (32u + length > sizeof(buf)) {
+		return false;
+	}
+	a34w_txd(buf, length, frame[0] >> 4, true, false, pid);
+	memcpy(buf + 32, frame, length);
+	if (!a34w_mbox_put(buf, 32u + length, what, frame[0])) {
+		a34w_say("step 8: %s NOT SENT", what);
+		return false;
+	}
+	a34w_say("step 8: %s sent (%u bytes, TX status %u asked for)", what, length, pid);
+	return true;
+}
+
+/* the RX rings 4/5 reports (HW_MAC_MSDU_REPORT, hal_pdma.c:1342-1393): their tokens free again */
+static void
+a34w_report_in(const uint8_t *r, uint32_t count)
+{
+	uint32_t dw0, dw1, version, tokens, done = 0;
+
+	if (count < 8u) {
+		return;
+	}
+	memcpy(&dw0, r, 4);
+	memcpy(&dw1, r + 4, 4);
+	version = (dw1 >> 16) & 7u;
+	tokens = version == 3u ? (dw0 >> 16) & 0x3ffu : (dw0 >> 16) & 0x7fu;
+	if (a34w_report_version != version) {
+		a34w_report_version = version;
+		a34w_say("TX ring 0: the first token report: version %u, %u tokens, words 0x%08x 0x%08x 0x%08x", version,
+		    tokens, dw0, dw1, count >= 12u ? a34w_le32(r + 8) : 0u);
+	}
+	a34w_reports++;
+	lck_mtx_lock(&a34w_tx_mtx);
+	for (uint32_t i = 0; done < tokens && 8u + 4u * i + 4u <= count; i++) {
+		uint32_t w = a34w_le32(r + 8u + 4u * i), token;
+
+		if (version == 0u) {
+			token = (a34w_le32(r + 8u + 4u * (i >> 1)) >> (16u * (i & 1u))) & 0xffffu;
+		} else if (version == 1u) {
+			token = w & 0xffffu;
+		} else if (version == 2u) {
+			token = w & 0x7fffu;
+		} else if ((w & (1u << 31)) != 0) {
+			continue;                       /* (a rate word, not a token) */
+		} else {
+			token = (w >> 16) & 0x7fffu;
+		}
+		done++;
+		if (token < DATA_TX_SLOTS) {
+			a34w_tokens_busy &= ~(1ull << token);
+			a34w_tokens_back++;
+		}
+	}
+	lck_mtx_unlock(&a34w_tx_mtx);
+}
+
+/*
+ * An Ethernet frame to the AP on TX ring 0: a free token's buffer holds the TXD, the TXP
+ * (fillTxDescAppendByHostV2: the token, where the frame is and how long) and the frame; the
+ * DMA reads the first 64 bytes, the MAC the frame. The token is the DMA's until its report.
+ */
+static bool
+a34w_data_tx(const uint8_t *frame, uint32_t length, bool eapol, bool protect)
+{
+	uint32_t token, slot, next, didx;
+	uint8_t *buf;
+	uint64_t pa;
+	volatile uint32_t *d;
+	uint8_t pid = eapol ? a34w_next_pid() : 0;
+
+	if (!a34w_data_rings || length < 14u || length > FRAME_MOST) {
+		return false;
+	}
+	lck_mtx_lock(&a34w_tx_mtx);
+	for (token = 0; token < DATA_TX_SLOTS && (a34w_tokens_busy & (1ull << token)) != 0; token++) {
+	}
+	slot = a34w_dtx_cidx;
+	next = (slot + 1u) % DATA_TX_SLOTS;
+	didx = a34w_rd(a34w_conn, WFDMA_TX_RING(DATA_TX_RING) + 0xcu) & 0xfffu;
+	if (token == DATA_TX_SLOTS || next == didx) {
+		lck_mtx_unlock(&a34w_tx_mtx);
+		a34w_data_dropped_out++;
+		return false;
+	}
+	buf = (uint8_t *)(a34w_dma + DMA_TOKENS + token * DATA_TOKEN_SIZE);
+	pa = A34W_DMA_PA + DMA_TOKENS + token * DATA_TOKEN_SIZE;
+	a34w_txd(buf, length, -1, eapol, protect, pid);
+	bzero(buf + 32, 32);
+	buf[32] = (uint8_t)token;                       /* MSDU ID 0: the token, valid */
+	buf[33] = (uint8_t)((token >> 8) | 0x80u);
+	a34w_put32(buf + 40, (uint32_t)(pa + 64u));     /* pointer 0 */
+	buf[44] = (uint8_t)length;                      /* length 0, address bits 34:32, last */
+	buf[45] = (uint8_t)(((length >> 8) & 0xfu) | (((pa + 64u) >> 32 & 7u) << 4) | 0x80u);
+	memcpy(buf + 64, frame, length);
+	d = a34w_desc(DMA_TX0_DESC, slot);
+	d[0] = (uint32_t)pa;
+	d[2] = 0;
+	d[3] = 0;
+	d[1] = DESC_SDLEN0(64u) | DESC_LS0;             /* DMADONE clear: the DMA's */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a34w_tokens_busy |= 1ull << token;
+	a34w_dtx_cidx = next;
+	a34w_wr(a34w_conn, WFDMA_TX_RING(DATA_TX_RING) + 0x8u, next);
+	a34w_data_frames_out++;
+	a34w_data_bytes_out += length;
+	lck_mtx_unlock(&a34w_tx_mtx);
+	if (eapol) {
+		a34w_say("step 8: EAPOL out on TX ring 0 (%u bytes, token %u, TX status %u asked for)", length, token, pid);
+	}
+	return true;
+}
+
+/* ---- what comes from the AP ---- */
+
+/* (from RX ring 0) a management frame the firmware forwarded, from its Frame Control on */
+static void
+a34w_mgmt_in(const uint8_t *frame, uint32_t length, int rssi, uint8_t channel)
+{
+	uint8_t subtype;
+
+	if (length < 24u || (frame[0] & 0x0cu) != 0) {
+		a34w_rx_other++;
+		return;
+	}
+	subtype = (uint8_t)(frame[0] >> 4);
+	if (subtype == 8u || subtype == 5u) {           /* beacon, probe response */
+		a34w_heard_frame(frame, length, rssi, channel);
+		a34w_target_heard(frame, length, rssi, channel);
+		return;
+	}
+	if (!a34w_target.found || memcmp(frame + 10, a34w_target.bssid, 6) != 0 || memcmp(frame + 4, a34w_mac, 6) != 0) {
+		return;                                 /* not from the target, or not to us */
+	}
+	switch (subtype) {
+	case 11u:                                       /* Authentication: algorithm, transaction 2, status */
+		if (length >= 30u && (frame[26] | frame[27] << 8) == 2u) {
+			a34w_auth_status = frame[28] | frame[29] << 8;
+		}
+		break;
+	case 1u:                                        /* Association Response: capability, status, AID */
+	case 3u:
+		if (length >= 30u) {
+			a34w_assoc_status = frame[26] | frame[27] << 8;
+			a34w_aid = (uint16_t)((frame[28] | frame[29] << 8) & 0x3fffu);
+		}
+		break;
+	case 10u:                                       /* Disassociation, Deauthentication: reason */
+	case 12u:
+		a34w_say("the AP %s us (reason %u)%s", subtype == 12u ? "deauthenticated" : "disassociated",
+		    length >= 26u ? (unsigned)(frame[24] | frame[25] << 8) : 0u, a34w_joined ? ": LEFT the network" : "");
+		if (a34w_joined && a34w_link_change != NULL) {
+			a34w_link_change(false);
+		}
+		a34w_joined = false;
+		a34w_associated = false;
+		a34w_keys_in = false;
+		break;
+	default:
+		break;
+	}
+}
+
+/* (from RX ring 0, while waiting for something else) events step 8 cares about; true: noted */
+static bool
+a34w_event_note(uint8_t eid, const uint8_t *body, uint32_t length)
+{
+	if (eid == EVENT_ID_TX_DONE && length >= 6u) {
+		a34w_tx_done_pid = body[0];
+		a34w_tx_done_status = body[1];
+		a34w_tx_done_count = body[5];
+		a34w_say("TX status %u: %s (status %u) after %u tries", body[0], body[1] == 0 ? "acknowledged" :
+		    "NOT acknowledged", body[1], body[5]);
+		return true;
+	}
+	if (eid == EVENT_ID_CH_PRIVILEGE && length >= 3u) {
+		if (body[1] == a34w_ch_token) {
+			a34w_ch_status = body[2];
+		}
+		return true;
+	}
+	return false;
+}
+
+static void a34w_eapol_in(const uint8_t *frame, uint32_t length);
+
+/*
+ * A data frame (RXD packet type 2, or forwarded with its header translated): an Ethernet frame
+ * out of it -- as the hardware made it, or out of the 802.11 header and LLC/SNAP -- for EAPOL
+ * (the handshake) or the network interface. `at`: where the frame starts after RXD and groups.
+ */
+static void
+a34w_data_in(const uint8_t *rxd, uint32_t count, uint32_t at, bool translated)
+{
+	static uint8_t eth[FRAME_MOST + 32u];
+	uint32_t dw1, dw2, length;
+	const uint8_t *f = rxd + at;
+
+	memcpy(&dw1, rxd + 4, 4);
+	memcpy(&dw2, rxd + 8, 4);
+	if (at >= count || (dw1 & 0x0b000000u) != 0) { /* FCS, ICV, cipher length errors */
+		a34w_data_dropped_in++;
+		return;
+	}
+	length = count - at;
+	if (translated) {
+		if (length < 14u || length > FRAME_MOST) {
+			a34w_data_dropped_in++;
+			return;
+		}
+		memcpy(eth, f, length);
+	} else {
+		uint32_t header = ((dw2 >> 8) & 0x1fu) * 2u, fc_flags;
+
+		if (header < 24u || length < header + 8u || f[header] != 0xaau || f[header + 1u] != 0xaau || f[header + 2u] != 3u ||
+		    length - header - 8u + 14u > FRAME_MOST || (f[0] & 0x0cu) != 0x08u) {
+			a34w_data_dropped_in++;
+			return;
+		}
+		fc_flags = f[1] & 3u;                   /* ToDS, FromDS: from the AP it is FromDS, A1 DA, A3 SA */
+		memcpy(eth, f + 4, 6);
+		memcpy(eth + 6, fc_flags == 2u ? f + 16 : f + 10, 6);
+		memcpy(eth + 12, f + header + 6u, length - header - 6u);
+		length = length - header - 8u + 14u;
+	}
+	if ((dw1 & (1u << 23)) != 0 && (eth[12] << 8 | eth[13]) != ETHERTYPE_EAPOL) {
+		a34w_data_dropped_in++;                 /* plaintext where a cipher was wanted: only EAPOL may */
+		return;
+	}
+	a34w_data_frames_in++;
+	a34w_data_bytes_in += length;
+	if ((eth[12] << 8 | eth[13]) == ETHERTYPE_EAPOL) {
+		a34w_eapol_in(eth, length);
+	} else if (a34w_eth_input != NULL && a34w_joined) {
+		a34w_eth_input(eth, length);
+	}
+}
+
+/* one RX ring of 2..5 drained; how many buffers it gave */
+static uint32_t
+a34w_drx_poll(uint32_t n)
+{
+	struct a34w_rx_ring *r = &a34w_drx[n - 2u];
+	uint32_t got = 0;
+
+	for (;;) {
+		uint32_t slot = (r->cidx + 1u) % r->slots, count, dw0, dw1, dw2, vld, at;
+		volatile uint32_t *d = a34w_desc(DMA_RXN_DESC(n), slot);
+		const uint8_t *buf = (const uint8_t *)(a34w_dma + DMA_RXN_BUFS(n) + slot * SLOT_SIZE);
+
+		if ((d[1] & DESC_DMADONE) == 0) {
+			break;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		count = (d[1] >> 16) & 0x3fffu;
+		memcpy(&dw0, buf, 4);
+		if (count > r->buf_size) {
+			count = r->buf_size;
+		}
+		if ((d[1] & DESC_LS0) == 0) {
+			a34w_data_dropped_in++;         /* (a frame in pieces: none expected without A-MSDU) */
+		} else if (RXD_PKT_TYPE(dw0) == RX_PKT_TYPE_MSDU_REPORT) {
+			a34w_report_in(buf, count);
+		} else if (RXD_PKT_TYPE(dw0) == RX_PKT_TYPE_DATA && count >= RXD_SIZE) {
+			memcpy(&dw1, buf + 4, 4);
+			memcpy(&dw2, buf + 8, 4);
+			if ((dw0 & 0xffffu) < count) {
+				count = dw0 & 0xffffu;
+			}
+			vld = (dw1 >> 11) & 0x1fu;
+			at = RXD_SIZE + ((vld & 8u) ? 16u : 0u) + ((vld & 1u) ? 16u : 0u) + ((vld & 2u) ? 8u : 0u) +
+			    ((vld & 4u) ? 8u : 0u) + ((vld & 16u) ? 72u : 0u) + ((dw2 >> 14) & 3u) * 2u;
+			if ((dw2 & (1u << 29)) != 0 && (dw2 & (1u << 13)) == 0 && at + 24u <= count) {
+				a34w_mgmt_in(buf + at, count - at, -128, (uint8_t)0);   /* a management frame here */
+			} else {
+				a34w_data_in(buf, count, at, (dw2 & (1u << 13)) != 0);
+			}
+		} else {
+			a34w_rx_other++;
+		}
+		d[0] = (uint32_t)A34W_DMA_PA + DMA_RXN_BUFS(n) + slot * SLOT_SIZE;
+		d[1] = DESC_SDLEN0(r->buf_size);
+		r->cidx = slot;
+		got++;
+	}
+	if (got != 0) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		a34w_wr(a34w_conn, WFDMA_RX_RING(n) + 0x8u, r->cidx);
+	}
+	return got;
+}
+
+/* RX rings 2..5 once; true if anything came */
+static bool
+a34w_data_poll(void)
+{
+	uint32_t got = 0;
+
+	if (!a34w_data_rings) {
+		return false;
+	}
+	for (uint32_t n = 2; n <= 5u; n++) {
+		got += a34w_drx_poll(n);
+	}
+	return got != 0;
+}
+
+/* ---- the four-way handshake (a34_wpa.c) and the keys ---- */
+
+/* ADD_REMOVE_KEY (CMD_802_11_KEY, 64 bytes; wlanoidSetAddKey): CCMP, from the AP, to WTBL `wlan` */
+static bool
+a34w_key_install(bool pairwise, uint8_t key_id, const uint8_t *key, uint8_t wlan)
+{
+	uint8_t c[KEY_CMD_SIZE];
+	bool sent;
+
+	bzero(c, sizeof(c));
+	c[0] = 1;                                       /* ucAddRemove: add */
+	c[1] = pairwise ? 1u : 0u;                      /* ucTxKey */
+	c[2] = pairwise ? 1u : 0u;                      /* ucKeyType: pairwise / group */
+	memcpy(c + 4, a34w_target.bssid, 6);            /* aucPeerAddr */
+	c[10] = BSS_AIS;                                /* ucBssIdx */
+	c[11] = CIPHER_CCMP;                            /* ucAlgorithmId */
+	c[12] = key_id;                                 /* ucKeyId */
+	c[13] = 16;                                     /* ucKeyLen */
+	c[14] = wlan;                                   /* ucWlanIndex */
+	memcpy(c + 16, key, 16);                        /* aucKeyMaterial */
+	sent = a34w_cmd(CMD_ID_ADD_REMOVE_KEY, CMD_SET, c, sizeof(c)) != 0;
+	bzero(c, sizeof(c));
+	return sent;
+}
+
+/* an EAPOL frame (Ethernet, type 0x888e) from the AP: answered, and the keys put in when it says so */
+static void
+a34w_eapol_in(const uint8_t *frame, uint32_t length)
+{
+	static uint8_t reply[14u + A34_WPA_REPLY_MOST];
+	unsigned reply_length = 0;
+	const char *why = NULL;
+	int what;
+
+	a34w_eapol_rx++;
+	if (!a34w_associated || !a34w_net.psk_given) {
+		a34w_say("EAPOL from the AP (%u bytes) while not associated with WPA2: ignored", length);
+		return;
+	}
+	what = a34_wpa_message(&a34w_wpa, frame + 14, length - 14u, reply + 14, &reply_length, &why);
+	if (what == A34_WPA_BAD) {
+		a34w_say("EAPOL from the AP (%u bytes): refused: %s", length, why);
+		return;
+	}
+	if (what == A34_WPA_NOTHING || reply_length == 0) {
+		return;
+	}
+	memcpy(reply, a34w_target.bssid, 6);            /* to the AP, from us, EAPOL */
+	memcpy(reply + 6, a34w_mac, 6);
+	reply[12] = 0x88;
+	reply[13] = 0x8e;
+	a34w_say("EAPOL: message %s from the AP; answered", what == A34_WPA_ANSWER ? "1 of 4" : what == A34_WPA_KEYS ?
+	    "3 of 4" : "1 of 2 (a new group key)");
+	(void)a34w_data_tx(reply, 14u + reply_length, true, what == A34_WPA_GROUP && a34w_keys_in);
+	a34w_eapol_tx++;
+	if (what == A34_WPA_KEYS) {
+		bool p = a34w_key_install(true, 0, a34w_wpa.pairwise, AP_WLAN_INDEX);
+		bool g = a34w_key_install(false, (uint8_t)a34w_wpa.group_index, a34w_wpa.group, BMC_WLAN_INDEX);
+
+		a34w_keys_in = p && g;
+		a34w_say("EAPOL: the four-way handshake is done: pairwise key (WTBL %u) %s, group key %u (WTBL %u) %s",
+		    AP_WLAN_INDEX, p ? "in" : "NOT SENT", a34w_wpa.group_index, BMC_WLAN_INDEX, g ? "in" : "NOT SENT");
+	} else if (what == A34_WPA_GROUP) {
+		bool g = a34w_key_install(false, (uint8_t)a34w_wpa.group_index, a34w_wpa.group, BMC_WLAN_INDEX);
+
+		a34w_say("EAPOL: new group key %u %s", a34w_wpa.group_index, g ? "in" : "NOT SENT");
+	}
+}
+
+/* ---- the commands of joining ---- */
+
+/* CMD_UPDATE_STA_RECORD (168 bytes, version 0) for the AP: state 0 (STA_STATE_1) or 2 (STA_STATE_3) */
+static uint8_t
+a34w_sta_record(uint8_t state, bool need_response)
+{
+	uint8_t c[STA_REC_SIZE];
+	uint16_t operational, basic, fixed = a34w_lowest_basic_rate();
+	int rcpi = (a34w_target.rssi + 110) * 2;
+
+	a34w_target_rates(&operational, &basic);
+	bzero(c, sizeof(c));
+	c[0] = AP_STA_INDEX;                            /* ucStaIndex */
+	c[1] = STA_TYPE_LEGACY_AP;                      /* ucStaType */
+	memcpy(c + 2, a34w_target.bssid, 6);            /* aucMacAddr */
+	c[8] = (uint8_t)a34w_aid;                       /* u2AssocId */
+	c[9] = (uint8_t)(a34w_aid >> 8);
+	c[12] = BSS_AIS;                                /* ucBssIndex */
+	c[13] = a34w_target_phy(operational);           /* ucDesiredPhyTypeSet */
+	c[14] = (uint8_t)operational;                   /* u2DesiredNonHTRateSet */
+	c[15] = (uint8_t)(operational >> 8);
+	c[16] = (uint8_t)basic;                         /* u2BSSBasicRateSet */
+	c[17] = (uint8_t)(basic >> 8);
+	c[20] = state;                                  /* ucStaState */
+	c[50] = (uint8_t)(rcpi < 0 ? 0 : rcpi > 220 ? 220 : rcpi);     /* ucRCPI */
+	c[51] = need_response ? 1u : 0u;                /* ucNeedResp */
+	c[54] = AP_WLAN_INDEX;                          /* ucWlanIndex */
+	c[55] = 0xffu;                                  /* ucBMCWlanIndex, as cnmStaSendUpdateCmd */
+	c[74] = (uint8_t)fixed;                         /* u2HwDefaultFixedRateCode */
+	c[75] = (uint8_t)(fixed >> 8);
+	return a34w_cmd(CMD_ID_UPDATE_STA_RECORD, CMD_SET, c, sizeof(c));
+}
+
+/* CMD_SET_BSS_INFO (116 bytes): BSS 0 connected to the target (or no more), its RLM part at +68 */
+static uint8_t
+a34w_bss_info(bool connected)
+{
+	uint8_t c[BSS_INFO_SIZE], *rlm = c + 68;
+	uint16_t operational, basic, fixed = a34w_lowest_basic_rate();
+	bool five = a34w_target.channel > 14u;
+
+	a34w_target_rates(&operational, &basic);
+	bzero(c, sizeof(c));
+	c[0] = BSS_AIS;                                 /* ucBssIndex */
+	c[1] = (uint8_t)(connected ? 0u : 1u);                   /* ucConnectionState: MEDIA_STATE_CONNECTED 0, DISCONNECTED 1 */
+	c[2] = 0;                                       /* ucCurrentOPMode: infrastructure */
+	c[3] = (uint8_t)a34w_net.ssid_length;           /* ucSSIDLen, aucSSID */
+	memcpy(c + 4, a34w_net.ssid, a34w_net.ssid_length);
+	memcpy(c + 36, a34w_target.bssid, 6);           /* aucBSSID */
+	c[44] = (uint8_t)operational;                   /* u2OperationalRateSet */
+	c[45] = (uint8_t)(operational >> 8);
+	c[46] = (uint8_t)basic;                         /* u2BSSBasicRateSet */
+	c[47] = (uint8_t)(basic >> 8);
+	c[48] = connected ? AP_STA_INDEX : 0xfeu;       /* ucStaRecIdxOfAP */
+	c[50] = (uint8_t)fixed;                         /* u2HwDefaultFixedRateCode */
+	c[51] = (uint8_t)(fixed >> 8);
+	c[52] = five ? 3u : 1u;                         /* ucNonHTBasicPhyType: OFDM / ERP */
+	c[53] = a34w_net.psk_given ? 7u : 0u;           /* ucAuthMode: WPA2-PSK / open */
+	c[54] = a34w_net.psk_given ? 6u : 1u;           /* ucEncStatus: CCMP / none */
+	c[55] = a34w_target_phy(operational);           /* ucPhyTypeSet */
+	c[58] = BMC_WLAN_INDEX;                         /* ucBMCWlanIndex */
+	rlm[0] = BSS_AIS;                               /* rBssRlmParam (rlmFillSyncCmdParam): ucBssIndex */
+	rlm[1] = five ? CMD_BAND_5G : CMD_BAND_2G4;     /* ucRfBand */
+	rlm[2] = a34w_target.channel;                   /* ucPrimaryChannel; SCO 0: 20 MHz, no HT/VHT */
+	rlm[13] = (a34w_target.capability & 0x0020u) ? 1u : 0u;        /* ucUseShortPreamble */
+	rlm[14] = five || (a34w_target.capability & 0x0400u) ? 1u : 0u;/* ucUseShortSlotTime */
+	rlm[20] = 1;                                    /* ucTxNss */
+	rlm[21] = 1;                                    /* ucRxNss */
+	c[90] = DBDC_BAND_AUTO;                         /* ucDBDCBand */
+	c[93] = 1;                                      /* ucNss */
+	return a34w_cmd(CMD_ID_SET_BSS_INFO, CMD_SET, c, sizeof(c));
+}
+
+/* CMD_CH_PRIVILEGE (24 bytes): ask for the target's channel to join on (action 0), or give it back (1) */
+static uint8_t
+a34w_ch_privilege(bool request)
+{
+	uint8_t c[24];
+
+	bzero(c, sizeof(c));
+	if (request) {
+		a34w_ch_token++;
+		a34w_ch_status = -1;
+	}
+	c[0] = BSS_AIS;                                 /* ucBssIndex */
+	c[1] = a34w_ch_token;                           /* ucTokenID (a new one for each request: HakiOS run 449) */
+	c[2] = (uint8_t)(request ? 0u : 1u);                   /* ucAction: REQ / ABORT */
+	if (request) {
+		c[3] = a34w_target.channel;             /* ucPrimaryChannel; SCO 0, 20/40 MHz width 0 */
+		c[5] = a34w_target.channel > 14u ? CMD_BAND_5G : CMD_BAND_2G4;  /* ucRfBand */
+		c[9] = 0;                               /* ucReqType: JOIN */
+		a34w_put32(c + 12, 4000);               /* u4MaxInterval, ms (AIS_JOIN_CH_REQUEST_INTERVAL) */
+	}
+	c[10] = DBDC_BAND_AUTO;                         /* ucDBDCBand */
+	return a34w_cmd(CMD_ID_CH_PRIVILEGE, CMD_SET, c, sizeof(c));
+}
+
+/* the 24 bytes every management frame to the target starts with */
+static uint32_t
+a34w_mgmt_header(uint8_t *f, uint8_t subtype)
+{
+	bzero(f, 24);
+	f[0] = (uint8_t)(subtype << 4);
+	memcpy(f + 4, a34w_target.bssid, 6);
+	memcpy(f + 10, a34w_mac, 6);
+	memcpy(f + 16, a34w_target.bssid, 6);
+	return 24;
+}
+
+/* Association Request: the AP's own rate elements (every legacy rate is ours too), the RSN element for WPA2 */
+static uint32_t
+a34w_frame_assoc(uint8_t *f, uint32_t room)
+{
+	uint32_t n = a34w_mgmt_header(f, 0);
+	uint16_t capability = (uint16_t)(0x0001u | (a34w_target.capability & 0x0430u));  /* ESS; privacy, short preamble/slot as the AP's */
+	const uint8_t *rates = a34w_target_ie(1), *more = a34w_target_ie(50);
+
+	f[n++] = (uint8_t)capability;
+	f[n++] = (uint8_t)(capability >> 8);
+	f[n++] = 10;                                    /* listen interval, beacons (assoc.c) */
+	f[n++] = 0;
+	f[n++] = 0;                                     /* SSID */
+	f[n++] = (uint8_t)a34w_net.ssid_length;
+	memcpy(f + n, a34w_net.ssid, a34w_net.ssid_length);
+	n += a34w_net.ssid_length;
+	if (rates != NULL && n + 2u + rates[1] <= room) {
+		memcpy(f + n, rates, 2u + rates[1]);
+		n += 2u + rates[1];
+	}
+	if (more != NULL && n + 2u + more[1] <= room) {
+		memcpy(f + n, more, 2u + more[1]);
+		n += 2u + more[1];
+	}
+	if (a34w_net.psk_given && n + sizeof(a34w_own_rsn) <= room) {
+		memcpy(f + n, a34w_own_rsn, sizeof(a34w_own_rsn));
+		n += (uint32_t)sizeof(a34w_own_rsn);
+	}
+	return n;
+}
+
+/* until `*status` is set (>= 0) or `ms` pass, with every ring serviced meanwhile */
+static bool
+a34w_wait_status(volatile int *status, uint32_t ms)
+{
+	uint64_t until = a34w_ms() + ms;
+	uint8_t body[64];
+
+	while (*status < 0 && a34w_ms() < until) {
+		(void)a34w_wait_event(EVENT_NONE, 0, body, sizeof(body), 20);   /* (nothing it waits for comes) */
+	}
+	return *status >= 0;
+}
+
+/* everything joining set up, undone (after a failure on the way): the AP told, the firmware too */
+static void
+a34w_unjoin(bool deauth)
+{
+	uint8_t f[26], c[4];
+
+	if (deauth) {
+		(void)a34w_mgmt_header(f, 12);          /* Deauthentication, reason 3: leaving */
+		f[24] = 3;
+		f[25] = 0;
+		(void)a34w_mgmt_tx(f, sizeof(f), "Deauthentication");
+	}
+	bzero(c, sizeof(c));
+	c[0] = BSS_AIS;
+	(void)a34w_cmd(CMD_ID_INDICATE_PM_BSS_ABORT, CMD_SET, c, sizeof(c));
+	(void)a34w_bss_info(false);
+	c[0] = 0;                                       /* CMD_REMOVE_STA_RECORD: action 0, the AP's record, BSS 0 */
+	c[1] = AP_STA_INDEX;
+	c[2] = BSS_AIS;
+	(void)a34w_cmd(CMD_ID_REMOVE_STA_RECORD, CMD_SET, c, sizeof(c));
+	(void)a34w_ch_privilege(false);
+	if (a34w_joined && a34w_link_change != NULL) {
+		a34w_link_change(false);
+	}
+	a34w_joined = false;
+	a34w_associated = false;
+	a34w_keys_in = false;
+}
+
+/* authentication, association, (WPA2) the handshake: with the channel held; true when JOINED */
+static bool
+a34w_connect(void)
+{
+	static uint8_t f[512];
+	uint8_t c[68], answer[16], seq;
+	const uint8_t *tim = a34w_target_ie(5);
+	uint32_t n;
+	int got;
+	uint64_t t0 = a34w_ms();
+
+	a34w_associated = false;
+	a34w_keys_in = false;
+	a34w_aid = 0;
+	if (a34w_ch_privilege(true) == 0 || !a34w_wait_status(&a34w_ch_status, 2000)) {
+		a34w_say("step 8: channel %u NOT GRANTED (CH_PRIVILEGE, token %u)", a34w_target.channel, a34w_ch_token);
+		(void)a34w_ch_privilege(false);
+		return false;
+	}
+	if (a34w_ch_status != 0) {
+		a34w_say("step 8: channel %u refused (status %d)", a34w_target.channel, a34w_ch_status);
+		(void)a34w_ch_privilege(false);
+		return false;
+	}
+	a34w_say("step 8: channel %u granted in %llu ms", a34w_target.channel, (unsigned long long)(a34w_ms() - t0));
+	(void)a34w_sta_record(0, false);                /* the AP's record, state 1, WTBL 5 */
+
+	for (uint32_t tries = 1; tries <= 3u; tries++) {        /* Authentication: open system, transaction 1 */
+		a34w_auth_status = -1;
+		n = a34w_mgmt_header(f, 11);
+		bzero(f + n, 6);
+		f[n + 2] = 1;
+		if (!a34w_mgmt_tx(f, n + 6u, "Authentication") || a34w_wait_status(&a34w_auth_status, 400)) {
+			break;
+		}
+		a34w_say("step 8: no answer to Authentication (try %u)", tries);
+	}
+	if (a34w_auth_status != 0) {
+		a34w_say("step 8: Authentication %s (status %d)", a34w_auth_status < 0 ? "NOT ANSWERED" : "REFUSED",
+		    a34w_auth_status);
+		a34w_unjoin(false);
+		return false;
+	}
+	a34w_say("step 8: authenticated (open system)");
+
+	for (uint32_t tries = 1; tries <= 3u; tries++) {        /* Association */
+		a34w_assoc_status = -1;
+		n = a34w_frame_assoc(f, sizeof(f));
+		if (!a34w_mgmt_tx(f, n, "Association Request") || a34w_wait_status(&a34w_assoc_status, 600)) {
+			break;
+		}
+		a34w_say("step 8: no answer to Association Request (try %u)", tries);
+	}
+	if (a34w_assoc_status != 0) {
+		a34w_say("step 8: Association %s (status %d)", a34w_assoc_status < 0 ? "NOT ANSWERED" : "REFUSED",
+		    a34w_assoc_status);
+		a34w_unjoin(true);
+		return false;
+	}
+	a34w_associated = true;
+	a34w_say("step 8: ASSOCIATED, AID %u (%llu ms in)", a34w_aid, (unsigned long long)(a34w_ms() - t0));
+
+	/* the firmware told: the BSS connected, the AP's record in state 3, power management, CAM, the RX filter */
+	(void)a34w_bss_info(true);
+	seq = a34w_sta_record(2, true);
+	got = seq != 0 ? a34w_wait_event(EVENT_ANY, seq, answer, sizeof(answer), 1000) : -1;
+	a34w_say("step 8: BSS_INFO connected; the AP's record in state 3: %s", got < 0 ? "no answer (going on)" :
+	    "answered");
+	bzero(c, sizeof(c));
+	c[0] = BSS_AIS;                                 /* CMD_INDICATE_PM_BSS_CONNECTED */
+	c[1] = tim != NULL && tim[1] >= 2u ? tim[3] : 1u;   /* ucDtimPeriod (TIM element: count, period) */
+	c[2] = (uint8_t)a34w_aid;
+	c[3] = (uint8_t)(a34w_aid >> 8);
+	c[4] = (uint8_t)a34w_target.beacon_interval;
+	c[5] = (uint8_t)(a34w_target.beacon_interval >> 8);
+	(void)a34w_cmd(CMD_ID_INDICATE_PM_BSS_CONNECTED, CMD_SET, c, 12);
+	bzero(c, sizeof(c));
+	c[0] = BSS_AIS;                                 /* CMD_PS_PROFILE: CAM */
+	(void)a34w_cmd(CMD_ID_POWER_SAVE_MODE, CMD_SET, c, 4);
+	bzero(c, sizeof(c));
+	a34w_put32(c, 0x0fu);                           /* CMD_RX_PACKET_FILTER: directed, multicast, all multicast, broadcast */
+	(void)a34w_cmd(CMD_ID_SET_RX_FILTER, CMD_SET, c, sizeof(c));
+
+	if (a34w_net.psk_given) {                       /* the AP begins the handshake: message 1 within a second or so */
+		uint64_t until = a34w_ms() + 6000u;
+
+		while (!a34w_keys_in && a34w_associated && a34w_ms() < until) {
+			uint8_t body[16];
+
+			(void)a34w_wait_event(EVENT_NONE, 0, body, sizeof(body), 20);
+		}
+		if (!a34w_keys_in) {
+			a34w_say("step 8: the WPA2 handshake did NOT finish (%u EAPOL frames from the AP, %u to it; %llu data "
+			    "frames in; token reports %u)%s", a34w_eapol_rx, a34w_eapol_tx,
+			    (unsigned long long)a34w_data_frames_in, a34w_reports, a34w_associated ? "" : ": the AP let go");
+			a34w_unjoin(a34w_associated);
+			return false;
+		}
+	}
+	(void)a34w_ch_privilege(false);                 /* (Android: when the port is authorized) */
+	a34w_joined = true;
+	if (a34w_link_change != NULL) {
+		a34w_link_change(true);
+	}
+	return true;
+}
+
+/*
+ * Step 8: the network file read, a scan for the network, the loudest BSS of that name joined.
+ * The step can be asked for again after a failure (a34w_thread): each try reads the file anew.
+ */
+static bool
+a34w_step8(void)
+{
+	char ssid[33];
+	const char *why;
+	uint64_t t0 = a34w_ms();
+
+	if (a34w_joined) {
+		a34w_say("step 8: joined already");
+		return true;
+	}
+	if (!a34w_network_load()) {
+		return false;
+	}
+	bzero(&a34w_target, sizeof(a34w_target));
+	a34w_target.rssi = -128;
+	a34w_joining = true;
+	for (uint32_t scan = 1; scan <= 2u && !a34w_target.found; scan++) {
+		(void)a34w_scan("step 8", true);
+	}
+	a34w_joining = false;
+	a34w_net_ssid(ssid);
+	if (!a34w_target.found) {
+		a34w_say("step 8: \"%s\" NOT HEARD in two scans (a hidden network is not looked for)", ssid);
+		(void)a34w_bss_activate(false);
+		return false;
+	}
+	a34w_say("step 8: \"%s\": %02x:%02x:%02x:%02x:%02x:%02x on channel %u, %d dBm, capability 0x%04x, beacon every "
+	    "%u TU", ssid, a34w_target.bssid[0], a34w_target.bssid[1], a34w_target.bssid[2], a34w_target.bssid[3],
+	    a34w_target.bssid[4], a34w_target.bssid[5], a34w_target.channel, a34w_target.rssi, a34w_target.capability,
+	    a34w_target.beacon_interval);
+	why = a34w_rsn_check();
+	if (a34w_net.psk_given && why != NULL) {
+		a34w_say("step 8: cannot join it with WPA2-PSK: %s", why);
+		return false;
+	}
+	if (!a34w_net.psk_given && (a34w_target.capability & 0x10u) != 0) {
+		a34w_say("step 8: it is not open (it wants a passphrase: a psk= line)");
+		return false;
+	}
+	bzero(&a34w_wpa, sizeof(a34w_wpa));
+	if (a34w_net.psk_given) {
+		memcpy(a34w_wpa.pmk, a34w_net.pmk, 32);
+		memcpy(a34w_wpa.own, a34w_mac, 6);
+		memcpy(a34w_wpa.peer, a34w_target.bssid, 6);
+		read_random(a34w_wpa.own_nonce, 32);
+		a34w_wpa.rsn = a34w_own_rsn;
+		a34w_wpa.rsn_length = (unsigned)sizeof(a34w_own_rsn);
+	}
+	sweet_log_flush();
+	if (!a34w_connect()) {
+		bzero(&a34w_wpa, sizeof(a34w_wpa));
+		return false;
+	}
+	a34w_say("step 8: JOINED \"%s\" (%s) in %llu ms: %02x:%02x:%02x:%02x:%02x:%02x, channel %u, AID %u", ssid,
+	    a34w_net.psk_given ? "WPA2-PSK, CCMP" : "open", (unsigned long long)(a34w_ms() - t0), a34w_target.bssid[0],
+	    a34w_target.bssid[1], a34w_target.bssid[2], a34w_target.bssid[3], a34w_target.bssid[4], a34w_target.bssid[5],
+	    a34w_target.channel, a34w_aid);
+	return true;
+}
+
+/*
+ * (the thread, every 2 ms while joined) RX ring 0 (events, management frames: the AP's deauth)
+ * and the data rings (EAPOL rekeys, data, token reports); a line about the traffic now and then.
+ */
+static void
+a34w_service(void)
+{
+	static uint64_t said_at, said_total;
+	uint8_t body[16], seen = 0;
+	uint64_t total;
+
+	for (uint32_t i = 0; i < 16u && a34w_pump(EVENT_NONE, 0, body, sizeof(body), &seen) != -1; i++) {
+	}
+	for (uint32_t i = 0; i < 8u && a34w_data_poll(); i++) {
+	}
+	total = a34w_data_frames_in + a34w_data_frames_out + a34w_data_dropped_in + a34w_data_dropped_out;
+	if (a34w_ms() - said_at >= 30000u && total != said_total) {
+		said_at = a34w_ms();
+		said_total = total;
+		a34w_say("carried: %llu frames out (%llu bytes), %llu in (%llu bytes); dropped %llu out, %llu in; tokens back %u",
+		    (unsigned long long)a34w_data_frames_out, (unsigned long long)a34w_data_bytes_out,
+		    (unsigned long long)a34w_data_frames_in, (unsigned long long)a34w_data_bytes_in,
+		    (unsigned long long)a34w_data_dropped_out, (unsigned long long)a34w_data_dropped_in, a34w_tokens_back);
+	}
+}
