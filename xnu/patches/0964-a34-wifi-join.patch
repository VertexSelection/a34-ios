+/* ---- step 8 (0964, milestone 3): joining a network ---- */
+
+/*
+ * Step 8 joins the network named in /a34/wifi/network (written by the phone's owner, never in
+ * the repository; the passphrase is never said in the log), open or WPA2-PSK with CCMP, as
+ * gen4m_s1's AIS/SAA state machines do it (ais_fsm.c, saa_fsm.c, cnm.c, nic.c), host side
+ * where Android is host side:
+ *
+ *   - a passive scan (step 7's, the BSS left active); the loudest BSS of that name is the target
+ *   - CH_PRIVILEGE (0x1c, JOIN, 4 s) and its grant, EVENT_ID_CH_PRIVILEGE (0x10), token matched
+ *   - UPDATE_STA_RECORD (0x13, 168 bytes, version 0: the A34's module has no 802.11ax) for
+ *     the AP, state 1, WTBL entry 5 (0-3 are BIP's, 4 the broadcast one), no HT/VHT
+ *   - Authentication (open) and Association Request: 802.11 frames built here, sent as
+ *     nicTxCmd sends COMMAND_TYPE_MANAGEMENT_FRAME on soc5_0 -- a CONNAC2X TXD and the frame
+ *     in the SW-WFDMA mailbox (not a ring: soc5_0.c:419); their answers come forwarded on RX
+ *     ring 0, and EVENT_ID_TX_DONE (0x0f) says whether the AP acknowledged each
+ *   - SET_BSS_INFO (0x12) connected, UPDATE_STA_RECORD state 3 with the AID (answered),
+ *     INDICATE_PM_BSS_CONNECTED (0x16), POWER_SAVE_MODE CAM (0x05: HakiOS run 459, else the AP
+ *     thinks the station asleep), the RX filter (0x0a: directed, multicast, broadcast)
+ *   - WPA2: the four-way handshake on the host (a34_wpa.c, HakiOS's lx_wpa.c, MIT); EAPOL
+ *     goes as data on TX ring 0 (gl_kal.c:4161: no more by command) at the BSS's lowest basic
+ *     rate, comes on RX ring 2; then ADD_REMOVE_KEY (0x07) for the pairwise key (WTBL 5) and
+ *     the group key (WTBL 4)
+ *   - CH_PRIVILEGE abort: "JOINED" in the log
+ *
+ * After that the thread services the rings every 2 ms (group rekeys, the AP's deauth, data:
+ * counted here, handed to the network interface from 0965 on). Legacy rates only (no HT
+ * elements are sent): enough for a first connection. A failed join can be asked again.
+ */
+#define CMD_ID_POWER_SAVE_MODE          0x05u
+#define CMD_ID_ADD_REMOVE_KEY           0x07u
+#define CMD_ID_SET_RX_FILTER            0x0au
+#define CMD_ID_SET_BSS_INFO             0x12u
+#define CMD_ID_UPDATE_STA_RECORD        0x13u
+#define CMD_ID_REMOVE_STA_RECORD        0x14u
+#define CMD_ID_INDICATE_PM_BSS_CONNECTED 0x16u
+#define CMD_ID_INDICATE_PM_BSS_ABORT    0x17u
+#define CMD_ID_CH_PRIVILEGE             0x1cu
+#define EVENT_ID_TX_DONE                0x0fu
+#define EVENT_ID_CH_PRIVILEGE           0x10u
+#define STA_REC_SIZE                    168u
+#define BSS_INFO_SIZE                   116u
+#define KEY_CMD_SIZE                    64u
+#define AP_WLAN_INDEX                   5u
+#define AP_STA_INDEX                    0u
+#define STA_TYPE_LEGACY_AP              0x41u
+#define DBDC_BAND_AUTO                  4u
+#define RATE_CODE_CCK_1M                0x0000u
+#define RATE_CODE_OFDM_6M               0x004bu
+#define CIPHER_CCMP                     4u
+#define RX_PKT_TYPE_DATA                2u
+#define RX_PKT_TYPE_MSDU_REPORT         6u
+#define A34W_NETWORK_FILE               "network"
+#define A34W_IES_MOST                   768u
+#define ETHERTYPE_EAPOL                 0x888eu
+#define FRAME_MOST                      1532u           /* an Ethernet frame (hal_pdma.c:2683) */
+
+struct a34w_network {
+	uint8_t ssid[32];
+	uint32_t ssid_length;
+	bool psk_given;                 /* a "psk=" line: WPA2-PSK, else open */
+	bool psk_is_key;                /* 64 hex digits: the PMK itself */
+	uint8_t passphrase[64];         /* 8..63 printable characters (never said in the log) */
+	uint32_t passphrase_length;
+	uint8_t pmk[32];
+	bool bssid_given;
+	uint8_t bssid[6];
+};
+
+struct a34w_target {
+	bool found;
+	uint8_t bssid[6];
+	uint8_t channel;
+	int8_t rssi;
+	uint16_t capability;
+	uint16_t beacon_interval;
+	uint8_t ies[A34W_IES_MOST];     /* its beacon's or probe response's elements (as heard loudest) */
+	uint32_t ies_length;
+};
