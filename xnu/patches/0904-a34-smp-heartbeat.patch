diff --git a/bsd/dev/a34_diag.c b/bsd/dev/a34_diag.c
new file mode 100644
index 0000000..ee7d11c
--- /dev/null
+++ b/bsd/dev/a34_diag.c
@@ -0,0 +1,76 @@
+/*
+ * A34 (0904): heartbeat for the 6-core stall hunt.
+ *
+ * Every a34hb seconds (boot arg, default 0 = off) one line in the kernel log:
+ *
+ *   A34 HB <uptime s> on c<cpu> swaps <n> | c<i> t<timer irqs> i<IPIs>
+ *       o<other irqs> p<ms to the CPU's next timer deadline> ...
+ *
+ * A CPU whose timer count stops while the others go on, or whose next
+ * deadline drifts into the past, is the one that stalls.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern unsigned int a34_cpu_diag(uint64_t *out, unsigned int max_cpus);
+extern uint64_t sweet_fb_swap_count;
+void a34_diag_init(void);
+
+#define A34_HB_CPUS 8
+
+static uint32_t a34_hb_secs;
+static int a34_hb_chan;
+
+static void
+a34_hb_thread(void *arg, wait_result_t result)
+{
+	uint64_t d[4 * A34_HB_CPUS], deadline, now_ns, tick_ns;
+	char line[A34_HB_CPUS * 56];
+	(void)arg;
+	(void)result;
+
+	absolutetime_to_nanoseconds(1000, &tick_ns);    /* ns per 1000 ticks */
+	for (;;) {
+		clock_interval_to_deadline(a34_hb_secs, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&a34_hb_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		unsigned int cpu = a34_cpu_diag(d, A34_HB_CPUS);
+		size_t n = 0;
+		line[0] = 0;
+		for (unsigned int i = 0; i < A34_HB_CPUS; i++) {
+			if (d[4 * i] == 0 && d[4 * i + 1] == 0 && d[4 * i + 2] == 0)
+				continue;
+			int64_t ahead_ms = (int64_t)d[4 * i + 3] / 1000 * (int64_t)tick_ns / 1000000;
+			if (ahead_ms > 99999 || ahead_ms < -99999)
+				ahead_ms = 99999;
+			n += (size_t)snprintf(line + n, sizeof(line) - n, " c%u t%llu i%llu o%llu p%lld",
+			    i, d[4 * i], d[4 * i + 1], d[4 * i + 2], ahead_ms);
+			if (n >= sizeof(line))
+				break;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+		printf("A34 HB %llus on c%u swaps %llu |%s\n", now_ns / NSEC_PER_SEC, cpu,
+		    sweet_fb_swap_count, line);
+	}
+}
+
+void
+a34_diag_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("a34hb", &a34_hb_secs, sizeof(a34_hb_secs)) || a34_hb_secs == 0)
+		return;
+	if (kernel_thread_start(a34_hb_thread, NULL, &thread) == KERN_SUCCESS)
+		thread_deallocate(thread);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
