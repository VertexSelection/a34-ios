+/*
+ * ---- the display engine's clock (A34 0940) ----
+ *
+ * disp0_sel, TOPCKGEN CLK_CFG_1 [3:0] (MediaTek's clk-mt6877.c, Xiaomi's
+ * open-source MT6877 kernel): 0 26M, 1 univpll_d6_d2 208, 2 mainpll_d5_d2
+ * 218.4, 3 mmpll_d6_d2, 4 univpll_d5_d2 249.6, 5 univpll_d4_d2 312, 6
+ * mmpll_d7, 7 univpll_d6 416, 8 mainpll_d4 546, 9 tvdpll, 10 mmpll_d5_d2,
+ * 11 univpll_d4 624 MHz; set through CLK_CFG_1_CLR/SET, latched by
+ * CLK_CFG_UPDATE bit 4. Android's display OPPs (the phone's opp-table-disp):
+ * 208 at 0.55 V, 312 at 0.60, 416 at 0.65, 546 at 0.725 (VCORE). Android asks
+ * 403 MHz for this panel (mtk_dsi_set_mmclk_by_datarate_V1: 806 Mbps x 4 lanes
+ * x 3 (DSC) / 24 bpp) -> 416 MHz. MMPLL_CON1 (APMIXED 0x3a4): PCW [21:0],
+ * post divider [26:24]. VCORE: MT6359P DA_VCORE_VOSEL (0x1526 [6:0]),
+ * 400 mV + 6.25 mV a step. Mapped here on first use: AppleCLCD starts before
+ * a34_clocks_init().
+ */
+#define CK_TOP_CLK_CFG_UPDATE   0x004u
+#define CK_TOP_CLK_CFG_1        0x020u
+#define CK_TOP_CLK_CFG_1_SET    0x024u
+#define CK_TOP_CLK_CFG_1_CLR    0x028u
+#define CK_DISP0_SEL_MASK       0xfu
+#define CK_DISP0_UPD            (1u << 4)
+#define CK_MMPLL_CON1           0x3a4u
+#define CK_VCORE_DBG0           0x1526u
+
+static bool
+ck_disp_map(void)
+{
+	if (ck_top == 0) {
+		ck_top = ml_io_map(CK_TOP_PA, CK_PAGE);
+	}
+	if (ck_apmixed == 0) {
+		ck_apmixed = ml_io_map(CK_APMIXED_PA, CK_PAGE);
+	}
+	if (ck_pwrap == 0) {
+		ck_pwrap = ml_io_map(CK_PWRAP_PA, CK_PAGE);
+	}
+	return ck_top != 0 && ck_apmixed != 0 && ck_pwrap != 0;
+}
+
+/* kHz of disp0_sel (0: not known), its select field, MMPLL in kHz. */
+uint32_t
+a34_disp_clock_khz(uint32_t *sel, uint32_t *mmpll_khz)
+{
+	uint32_t con1, khz[12];
+	uint64_t mm;
+
+	*sel = 0xffu;
+	*mmpll_khz = 0;
+	if (!ck_disp_map()) {
+		return 0;
+	}
+	*sel = ruby_rd32(ck_top, CK_TOP_CLK_CFG_1) & CK_DISP0_SEL_MASK;
+	con1 = ruby_rd32(ck_apmixed, CK_MMPLL_CON1);
+	mm = ((26000ull * (con1 & 0x3fffffu)) >> 14) >> ((con1 >> 24) & 7u);
+	*mmpll_khz = (uint32_t)mm;
+	khz[0] = 26000;
+	khz[1] = 208000;
+	khz[2] = 218400;
+	khz[3] = (uint32_t)(mm / 12u);
+	khz[4] = 249600;
+	khz[5] = 312000;
+	khz[6] = (uint32_t)(mm / 7u);
+	khz[7] = 416000;
+	khz[8] = 546000;
+	khz[9] = 0;                     /* tvdpll: not read */
+	khz[10] = (uint32_t)(mm / 10u);
+	khz[11] = 624000;
+	return *sel < 12u ? khz[*sel] : 0;
+}
+
+/* VCORE in uV, 0 if not read. */
+uint32_t
+a34_vcore_uv(void)
+{
+	uint16_t v = 0;
+
+	if (!ck_disp_map() || !ck_pmic_read(CK_VCORE_DBG0, &v)) {
+		return 0;
+	}
+	return 400000u + (uint32_t)(v & 0x7fu) * 6250u;
+}
+
+/* disp0_sel to `sel` (glitch-free mux; the caller keeps the display idle). */
+bool
+a34_disp_clock_set(uint32_t sel)
+{
+	if (sel > CK_DISP0_SEL_MASK || !ck_disp_map()) {
+		return false;
+	}
+	ruby_wr32(ck_top, CK_TOP_CLK_CFG_1_CLR, CK_DISP0_SEL_MASK);
+	ruby_wr32(ck_top, CK_TOP_CLK_CFG_1_SET, sel);
+	ruby_wr32(ck_top, CK_TOP_CLK_CFG_UPDATE, CK_DISP0_UPD);
+	return (ruby_rd32(ck_top, CK_TOP_CLK_CFG_1) & CK_DISP0_SEL_MASK) == sel;
+}
