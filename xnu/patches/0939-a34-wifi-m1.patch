+/*
+ * ---- the Wi-Fi subsystem (steps 4 and 5) ----
+ *
+ * What wlan_drv_gen4m_6877.ko does on this chip. The phone's module is built from
+ * connectivity/wlan/core/gen4m_s1 (its strings name those files); Samsung's published
+ * gen4m_s1/chips/soc5_0/soc5_0.c lacks the ROM-EMI and chip-info parts the module carries,
+ * which gen4m/chips/soc5_0/soc5_0.c has; the register sequences are the same in both.
+ *
+ *   4  wf_pwr_on_consys_mcu() (gen4m_s1 soc5_0.c): conn_infra woken for Wi-Fi, the WM MCU held
+ *      in reset, the Wi-Fi sleep protection off, WFSYS's power on (0x57460080 into
+ *      WFSYS_ON_TOP_PWR_CTL), its acks, WFSYS's version 0x02050002, the bus-hang and debug
+ *      controls; the MCU's RAM image "ROM EMI" (soc5_0_ram_wmmcu_1_1_hdr.bin: a 48-byte
+ *      ROM_EMI_HEADER, then the image for u4PatchAddr 0xf0380000, i.e. EMI + 0x380000; its
+ *      build date at EMI + 0x4954e0: soc5_0_wlanPowerOnInit, fw_dl.c's ROM-EMI branch); the MCU
+ *      released and its ROM's "done" 0x1d1e polled in CONNAC2X_MAILBOX_DBG (0x18060260); then
+ *      FW own (asicConnac2xPwrOnWmMcu).
+ *   5  wlanAdapterStart()'s part up to a running firmware: driver own (LPCTL 0x18060010: BIT1,
+ *      then bit 2 clear), asicConnac2xCapInit (IRQ enable, the MCU's software interrupts), the
+ *      host WFDMA (0x18024000) set up as halWpdmaInitRing/soc5_0's manual prefetch/WpdmaConfig
+ *      do it for the two rings the start needs -- TX ring 17 (INIT commands) and RX ring 0
+ *      (events) --, the ROM asked for TOP_HVR/TOP_FVR (INIT_CMD_ID_ACCESS_REG, as
+ *      wlanSetChipEcoInfo), PCCIF "Wi-Fi on" (0x10003220 = 0), WIFI_RAM_CODE_soc5_0_1_1.bin by
+ *      its tailer (36 bytes, its regions' 40-byte entries before it, the data back to back from
+ *      the start): regions with feature 0x80 copied into the EMI (wlanDownloadEMISection: the
+ *      address's low 24 bits), the others written through the AP2WF window (downloadImgByDyn
+ *      MemMap: the region's address into AP2WF_REMAP_1 0x18400120, the data at 0x18500000),
+ *      then INIT_CMD_ID_DYN_MEM_MAP_FW_FINISH {0, 0} answered by INIT_EVENT_ID_CMD_RESULT, and
+ *      the firmware's ready bits (0x180600f0 [1:0] = 3, polled 5 ms apart for 2.5 s).
+ *
+ * Not done (M2, docs/wifi-plan.md): PHY_ACTION (pre-calibration with the NVRAM's ePA/eLNA bytes
+ * and connfem's front-end id -- the firmware is expected to start without it, uncalibrated),
+ * LOG_TIME_SYNC, the front-end's GPIO modes, DMASHDL, the other rings, interrupts (everything
+ * here is polled), and the running firmware's commands, which on this chip go through a
+ * mailbox in the EMI ("SW WFDMA") rather than a DMA ring.
+ *
+ * INIT command (asicConnac2xFillInitCmdTxdInfo; nic_connac2x_tx.h, wsys_cmd_handler_fw.h): a
+ * 32-byte TXD -- DW0 the whole length and packet format 2 (command) at [24:23], DW1 header
+ * format 1 (command) at [17:16] --, INIT_HIF_TX_HEADER at 32 (u16 length after the TXD, u16
+ * PQ_ID 0, then INIT_WIFI_CMD: CID, 0xA0, 0, sequence number, 24 bytes reserved), the payload
+ * at 64. Event: a 24-byte RXD (init_evt_rxd_size), INIT_WIFI_EVENT (u16 length, u16 0xE000,
+ * EID, sequence, 2 reserved), the payload. DMA descriptors: DW0 the buffer, DW1 SDLen0 [29:16],
+ * LastSec0 [30], DMADONE [31]; base, count, CPU index and DMA index at a ring's +0/+4/+8/+C.
+ */
+
+#define A34W_WF_PA              0x18400000u     /* WF MCU bus CR .. the AP2WF window */
+#define A34W_WF_SIZE            0x200000u
+
+/* in the conn_infra map (0x18000000 + ...) */
+#define WF_CPU_SW_RST_B                 0x00120u        /* CONN_INFRA_RGU + 0x120: bit 0 the WM MCU runs */
+#define CONN_CFG_WF_SLP_CTRL            0x01540u
+#define CONN_CFG_WF_SLP_STATUS          0x01544u
+#define CONN_VDNR_AXI_DEBUG_CTRL0       0x1d000u
+#define WFDMA_HOST                      0x24000u        /* WF_WFDMA_HOST_DMA0 */
+#define WFDMA_INT_STA                   (WFDMA_HOST + 0x200u)
+#define WFDMA_INT_ENA                   (WFDMA_HOST + 0x204u)
+#define WFDMA_GLO_CFG                   (WFDMA_HOST + 0x208u)
+#define WFDMA_RST_DTX_PTR               (WFDMA_HOST + 0x20cu)
+#define WFDMA_INT_ENA_CLR               (WFDMA_HOST + 0x22cu)
+#define WFDMA_PAUSE_RX_Q_TH10           (WFDMA_HOST + 0x260u)
+#define WFDMA_RST_DRX_PTR               (WFDMA_HOST + 0x280u)
+#define WFDMA_INT_RX_PRI_SEL            (WFDMA_HOST + 0x298u)
+#define WFDMA_MCU2HOST_SW_INT_ENA       (WFDMA_HOST + 0x1f4u)
+#define WFDMA_TX_RING(n)                (WFDMA_HOST + 0x300u + 0x10u * (n))     /* 0..19 */
+#define WFDMA_RX_RING(n)                (WFDMA_HOST + 0x500u + 0x10u * (n))
+#define WFDMA_TX_EXT_CTRL(n)            (WFDMA_HOST + 0x600u + 4u * (n))
+#define WFDMA_RX_EXT_CTRL(n)            (WFDMA_HOST + 0x680u + 4u * (n))
+#define GLO_TX_DMA_EN                   (1u << 0)
+#define GLO_TX_DMA_BUSY                 (1u << 1)
+#define GLO_RX_DMA_EN                   (1u << 2)
+#define GLO_RX_DMA_BUSY                 (1u << 3)
+#define GLO_CHAIN_EN                    (1u << 15)      /* csr_disp_base_ptr_chain_en */
+#define GLO_OMIT_RX_INFO_PFET2          (1u << 21)
+#define GLO_OMIT_RX_INFO                (1u << 27)
+#define GLO_OMIT_TX_INFO                (1u << 28)
+/* asicConnac2xWfdmaControl(enable): bt_size 3, tx_wb_ddone, fifo_little_endian, clk_gate_dis, omit_tx_info,
+ * chain_en, omit_rx_info_pfet2; then tx/rx_dma_en (soc5_0asicConnac2xWpdmaConfig): 0x50209075 */
+#define GLO_ENABLE_BITS                 (0x30u | (1u << 6) | (1u << 12) | (1u << 30) | GLO_OMIT_TX_INFO | \
+	                                 GLO_CHAIN_EN | GLO_OMIT_RX_INFO_PFET2 | GLO_TX_DMA_EN | GLO_RX_DMA_EN)
+#define CCIF_WF_BASE                    0x3d000u        /* AP2WF_CONN_INFRA_ON_CCIF4 */
+#define SYSRAM_SW_WFDMA_OFFSET          0x537fcu        /* where the firmware says its command mailbox is */
+#define HOST_LPCTL                      0x60010u        /* CONNAC2X_BN0_LPCTL */
+#define LPCTL_SET_OWN                   (1u << 0)
+#define LPCTL_CLR_OWN                   (1u << 1)
+#define LPCTL_OWNER_SYNC                (1u << 2)       /* 1: the firmware owns it */
+#define HOST_IRQ_ENA                    0x60018u        /* CONNAC2X_BN0_IRQ_ENA */
+#define HOST_SW_SYNC0                   0x600f0u        /* CONN_ON_MISC: the firmware's ready bits [1:0] */
+#define HOST_WAKEPU_WF                  0x601a4u
+#define HOST_MAILBOX_DBG                0x60260u        /* the ROM's progress: 0x1d1e when done */
+#define HOST_DBG_DUMMY_3                0x602ccu        /* bit 30: WFSYS's power ack */
+#define HOST_WF_MCUSYS_BUS_TIMEOUT      0x6016cu
+#define WFSYS_VERSION                   0x02050002u
+#define ROM_DONE                        0x00001d1eu
+
+/* in the WF map (0x18400000 + ...) */
+#define WF_AP2WF_REMAP_1                0x000120u       /* WF_MCU_BUS_CR + 0x120: what the window shows */
+#define WF_WFDMA_DUMMY_CR               0x002120u       /* MCU WPDMA0 + 0x120: bit 1 "the host set the DMA up" */
+#define WF_TOP_CFG_VERSION              0x0b0010u       /* WF_TOP_CFG (0x184b0000) + 0x10 */
+#define WF_TOP_SLPPROT_ON_STATUS        0x0c300cu       /* 0x184c300c: bits 23 and 21 */
+#define WF_MCU_CFG_LS_BUSHANG           0x0f0440u       /* 0x184f0440 */
+#define WF_WINDOW                       0x100000u       /* 0x18500000: the AP2WF window */
+#define WF_MCUSYS_PWA_CTRL0             0x100000u       /* the window while it shows debug_ctrl_ao 0x810f0000 */
+#define WF_MCUSYS_PWA_CTRL3             0x10000cu
+#define WF_WINDOW_SIZE                  0x100000u
+#define WF_DEBUG_CTRL_AO                0x810f0000u
+
+/* the firmware */
+#define A34W_FW_DIR                     "/a34/wifi/"
+#define FW_ROM_EMI                      "soc5_0_ram_wmmcu_1_1_hdr.bin"
+#define FW_RAM_CODE                     "WIFI_RAM_CODE_soc5_0_1_1.bin"
+#define ROM_EMI_HEADER_SIZE             48u
+#define ROM_EMI_DATE_OFFSET             0x4954e0u       /* WMMCU_MCU_ROM_EMI_DATE_ADDR 0xf04954e0 */
+#define EMI_ADDR_MASK                   0xffffffu       /* WIFI_EMI_ADDR_MASK */
+#define TAILER_SIZE                     36u
+#define REGION_SIZE                     40u
+#define FEATURE_DL_TO_EMI               0x80u
+#define FEATURE_NOT_DOWNLOAD            0x40u
+#define FEATURE_ENCRYPTED               0x01u
+
+/* INIT commands and events (nic_init_cmd_event.h) */
+#define INIT_CMD_ID_ACCESS_REG          3u
+#define INIT_CMD_ID_DYN_MEM_MAP_FW_FINISH 0x41u
+#define INIT_EVENT_ID_CMD_RESULT        1u
+#define INIT_EVENT_ID_ACCESS_REG        2u
+#define INIT_CMD_PACKET_TYPE_ID         0xa0u
+#define TXD_SIZE                        32u
+#define INIT_CMD_HEADER_SIZE            64u             /* TXD + INIT_HIF_TX_HEADER */
+#define INIT_RXD_SIZE                   24u
+#define INIT_EVENT_HEADER_SIZE          8u
+#define TOP_HVR                         0x88000000u
+#define TOP_FVR                         0x88000004u
+
+/* the DMA memory (A34W_DMA_PA): two rings, their buffers */
+#define RING_SLOTS                      32u
+#define SLOT_SIZE                       0x1000u
+#define RX_BUF_SIZE                     3840u
+#define DMA_TX17_DESC                   0x00000u
+#define DMA_RX0_DESC                    0x01000u
+#define DMA_TX17_BUFS                   0x10000u
+#define DMA_RX0_BUFS                    (DMA_TX17_BUFS + RING_SLOTS * SLOT_SIZE)
+#define DESC_DMADONE                    (1u << 31)
+#define DESC_LS0                        (1u << 30)
+#define DESC_SDLEN0(n)                  (((uint32_t)(n) & 0x3fffu) << 16)
+#define HW_TX_CMD_RING                  17u
+#define HW_RX_EVENT_RING                0u
+
+static vm_offset_t a34w_wf, a34w_emi, a34w_dma;
+static uint32_t a34w_tx_cidx, a34w_rx_cidx;
+static uint8_t a34w_seq;
+
+static uint8_t *
+a34w_file(const char *name, uint32_t *size)
+{
+	char path[96];
+	vfs_context_t context = vfs_context_kernel();
+	vnode_t vnode = NULLVP;
+	struct vnode_attr attributes;
+	uint8_t *data = NULL;
+	int left = 0, error;
+
+	for (unsigned s = 0; s < 240u && rootvnode == NULLVP; s++) {
+		if (s == 0) {
+			a34w_say("waiting for the root file system");
+		}
+		delay_for_interval(1, NSEC_PER_SEC);
+	}
+	snprintf(path, sizeof(path), A34W_FW_DIR "%s", name);
+	if ((error = vnode_lookup(path, 0, &vnode, context)) != 0) {
+		a34w_say("%s: not found (%d): tools/wifi-fw.sh puts it there", path, error);
+		return NULL;
+	}
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_data_size);
+	if (vnode_getattr(vnode, &attributes, context) != 0 || attributes.va_data_size < 64u ||
+	    attributes.va_data_size > (8u << 20)) {
+		a34w_say("%s: no size, or not a plausible one", path);
+		vnode_put(vnode);
+		return NULL;
+	}
+	data = kalloc_data((vm_size_t)attributes.va_data_size, Z_WAITOK);
+	if (data == NULL || vn_rdwr(UIO_READ, vnode, (caddr_t)data, (int)attributes.va_data_size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(context), &left, vfs_context_proc(context)) != 0 || left != 0) {
+		a34w_say("%s: not read", path);
+		if (data != NULL) {
+			kfree_data(data, (vm_size_t)attributes.va_data_size);
+		}
+		vnode_put(vnode);
+		return NULL;
+	}
+	vnode_put(vnode);
+	*size = (uint32_t)attributes.va_data_size;
+	return data;
+}
+
+static inline uint32_t
+a34w_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static bool
+a34w_map_wf(void)
+{
+	if (a34w_wf != 0) {
+		return true;
+	}
+	a34w_wf = ml_io_map_unmappable(A34W_WF_PA, A34W_WF_SIZE, A34W_WIMG_IO);
+	a34w_emi = ml_io_map_unmappable((vm_offset_t)A34W_EMI_PA, A34W_EMI_SIZE, A34W_WIMG_WCOMB);
+	a34w_dma = ml_io_map_unmappable((vm_offset_t)A34W_DMA_PA, A34W_DMA_SIZE, A34W_WIMG_WCOMB);
+	if (a34w_wf == 0 || a34w_emi == 0 || a34w_dma == 0) {
+		a34w_say("Wi-Fi registers or memory not mapped (0x%lx 0x%lx 0x%lx)", (unsigned long)a34w_wf,
+		    (unsigned long)a34w_emi, (unsigned long)a34w_dma);
+		a34w_wf = 0;
+		return false;
+	}
+	return true;
+}
+
+/* a register polled until (value & mask) == want, `tries` reads `us` apart; the last value read in *last */
+static bool
+a34w_poll_mask(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, uint32_t tries, uint32_t us,
+    uint32_t *last)
+{
+	uint32_t v = 0;
+
+	for (uint32_t i = 0; i <= tries; i++) {
+		v = a34w_rd(base, off);
+		if ((v & mask) == want) {
+			*last = v;
+			return true;
+		}
+		delay((int)us);
+	}
+	*last = v;
+	return false;
+}
+
+/* ---- step 4: WFSYS on, the WM MCU's ROM running its EMI image ---- */
+
+static bool
+a34w_rom_emi_load(void)
+{
+	uint32_t size = 0, addr, offset;
+	uint8_t *file = a34w_file(FW_ROM_EMI, &size);
+	char date[17];
+
+	if (file == NULL) {
+		return false;
+	}
+	addr = a34w_le32(file + 24);                    /* ROM_EMI_HEADER.u4PatchAddr */
+	offset = addr & EMI_ADDR_MASK;
+	memcpy(date, file, 16);
+	date[16] = '\0';
+	for (unsigned i = 0; i < 16u; i++) {
+		if (date[i] < 0x20 || date[i] > 0x7e) {
+			date[i] = '.';
+		}
+	}
+	if (memcmp(file + 16, "ALPS", 4) != 0 || (addr & 0xff000000u) != 0xf0000000u ||
+	    offset + (size - ROM_EMI_HEADER_SIZE) > ROM_EMI_DATE_OFFSET) {
+		a34w_say("step 4: %s: not a ROM_EMI image this driver knows (platform %.4s, address 0x%08x)", FW_ROM_EMI,
+		    (const char *)(file + 16), addr);
+		kfree_data(file, size);
+		return false;
+	}
+	/* CONNSYS's memory as Android leaves it before a first power-on: nothing in it (logs, dumps, mailboxes) */
+	bzero((void *)a34w_emi, A34W_EMI_SIZE);
+	memcpy((void *)(a34w_emi + offset), file + ROM_EMI_HEADER_SIZE, size - ROM_EMI_HEADER_SIZE);
+	memcpy((void *)(a34w_emi + ROM_EMI_DATE_OFFSET), file, 16);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a34w_say("step 4: %s (built %s, hw 0x%02x%02x): %u bytes into the EMI at +0x%x", FW_ROM_EMI, date, file[20],
+	    file[21], size - ROM_EMI_HEADER_SIZE, offset);
+	kfree_data(file, size);
+	return true;
+}
+
+static bool
+a34w_step4(void)
+{
+	uint32_t v = 0;
+	uint64_t t0;
+
+	if (!a34w_conn_reachable()) {
+		a34w_say("step 4: the CONN domain is off or protected (CONN_PWR_CON 0x%08x STA1 0x%08x): not touched",
+		    a34w_rd(a34w_ap, SPM_CONN_PWR_CON), a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1));
+		return false;
+	}
+	if (!a34w_map_wf()) {
+		return false;
+	}
+	/* conn_infra woken for Wi-Fi, its version polled */
+	a34w_set(a34w_conn, HOST_WAKEPU_WF, 1u);
+	if (!a34w_poll_mask(a34w_conn, CONN_CFG_IP_VERSION, 0xffffffffu, CONN_HW_VER, 10, 1000, &v)) {
+		a34w_say("step 4: conn_infra did not wake for Wi-Fi (IP version 0x%08x)", v);
+		return false;
+	}
+	if (a34w_rd(a34w_conn, HOST_MAILBOX_DBG) == ROM_DONE && (a34w_rd(a34w_conn, WF_CPU_SW_RST_B) & 1u)) {
+		a34w_say("step 4: the WM MCU already runs (mailbox 0x%x): nothing to do", ROM_DONE);
+		a34w_clr(a34w_conn, HOST_WAKEPU_WF, 1u);
+		return true;
+	}
+	a34w_clr(a34w_conn, WF_CPU_SW_RST_B, 1u);              /* the WM MCU held */
+	a34w_clr(a34w_conn, CONN_CFG_WF_SLP_CTRL, 1u);         /* conn_infra <-> Wi-Fi sleep protection off */
+	v = a34w_rd(a34w_conn, CONN_RGU_WFSYS_ON_TOP_PWR_CTL);
+	a34w_wr(a34w_conn, CONN_RGU_WFSYS_ON_TOP_PWR_CTL, (v & 0x0000ff7fu) | 0x57460080u);    /* key 0x5746, on */
+	if (!a34w_poll_mask(a34w_conn, HOST_DBG_DUMMY_3, 1u << 30, 1u << 30, 10, 500, &v)) {
+		a34w_say("step 4: WFSYS power: no ack (DBG_DUMMY_3 0x%08x, WFSYS_ON_TOP_PWR_CTL 0x%08x)", v,
+		    a34w_rd(a34w_conn, CONN_RGU_WFSYS_ON_TOP_PWR_CTL));
+		return false;
+	}
+	if (!a34w_poll_mask(a34w_conn, CONN_CFG_WF_SLP_STATUS, 0xa0000000u, 0, 100, 500, &v)) {
+		a34w_say("step 4: Wi-Fi to conn_infra sleep protection still on (0x%08x)", v);
+		return false;
+	}
+	if (!a34w_poll_mask(a34w_wf, WF_TOP_SLPPROT_ON_STATUS, 1u << 23, 0, 100, 500, &v) ||
+	    !a34w_poll_mask(a34w_wf, WF_TOP_SLPPROT_ON_STATUS, 1u << 21, 0, 100, 500, &v)) {
+		a34w_say("step 4: WFDMA to conn_infra sleep protection still on (0x%08x)", v);
+		return false;
+	}
+	if (!a34w_poll_mask(a34w_wf, WF_TOP_CFG_VERSION, 0xffffffffu, WFSYS_VERSION, 10, 500, &v)) {
+		a34w_say("step 4: WFSYS version 0x%08x, not 0x%08x", v, WFSYS_VERSION);
+		return false;
+	}
+	a34w_say("step 4: WFSYS on: version 0x%08x", v);
+	/* bus-hang detection, then the WF MCU's debug controls (through the window shown debug_ctrl_ao) */
+	a34w_mask(a34w_wf, WF_MCU_CFG_LS_BUSHANG, 0xffu, 0x03u);
+	a34w_set(a34w_wf, WF_MCU_CFG_LS_BUSHANG, 0x90000000u);
+	a34w_wr(a34w_wf, WF_AP2WF_REMAP_1, WF_DEBUG_CTRL_AO);
+	a34w_set(a34w_wf, WF_MCUSYS_PWA_CTRL0, 0x8u);
+	a34w_set(a34w_wf, WF_MCUSYS_PWA_CTRL0, 0x200u);
+	a34w_clr(a34w_wf, WF_MCUSYS_PWA_CTRL0, 0x200u);
+	a34w_mask(a34w_wf, WF_MCUSYS_PWA_CTRL0, 0xffff0000u, 0x04f50000u);
+	a34w_set(a34w_wf, WF_MCUSYS_PWA_CTRL3, 0x10000u);
+	a34w_set(a34w_wf, WF_MCUSYS_PWA_CTRL0, 0x1cu);
+	a34w_set(a34w_conn, CONN_VDNR_AXI_DEBUG_CTRL0, 0x200u);
+	a34w_mask(a34w_conn, CONN_VDNR_AXI_DEBUG_CTRL0, 0xffff0000u, 0x30e00000u);
+	a34w_set(a34w_conn, CONN_VDNR_AXI_DEBUG_CTRL0, 0x4u);
+	a34w_set(a34w_conn, CONN_VDNR_AXI_DEBUG_CTRL0, 0x8u);
+	a34w_set(a34w_conn, CONN_VDNR_AXI_DEBUG_CTRL0, 0x10u);
+	a34w_clr(a34w_conn, CONN_VDNR_AXI_DEBUG_CTRL0, 0x200u);
+
+	/* soc5_0_wlanPowerOnInit(): the MCU's image into the EMI, before the MCU is let go */
+	if (!a34w_rom_emi_load()) {
+		return false;
+	}
+	t0 = a34w_ms();
+	a34w_set(a34w_conn, WF_CPU_SW_RST_B, 1u);
+	if (!a34w_poll_mask(a34w_conn, HOST_MAILBOX_DBG, 0xffffffffu, ROM_DONE, 1000, 1000, &v)) {
+		a34w_say("step 4: the WM MCU's ROM did not finish: mailbox 0x%08x (0x%x expected), bus timeout 0x%08x", v,
+		    ROM_DONE, a34w_rd(a34w_conn, HOST_WF_MCUSYS_BUS_TIMEOUT));
+		return false;
+	}
+	a34w_say("step 4: WM MCU ROM done (mailbox 0x%08x) %llu ms after its release", v,
+	    (unsigned long long)(a34w_ms() - t0));
+	a34w_clr(a34w_conn, HOST_WAKEPU_WF, 1u);
+	/* FW own, so that driver and firmware agree (asicConnac2xPwrOnWmMcu) */
+	v = a34w_rd(a34w_conn, HOST_LPCTL);
+	if ((v & LPCTL_OWNER_SYNC) == 0) {
+		a34w_wr(a34w_conn, HOST_LPCTL, LPCTL_SET_OWN);
+	}
+	a34w_say("step 4: LPCTL 0x%08x -> 0x%08x (firmware owns)", v, a34w_rd(a34w_conn, HOST_LPCTL));
+	return true;
+}
+
+/* ---- step 5: the host DMA, the RAM code, the firmware running ---- */
+
+static bool
+a34w_driver_own(void)
+{
+	uint64_t began = a34w_ms(), asked = 0;
+
+	while (a34w_ms() - began < 2048u) {
+		if (asked != 0 && (a34w_rd(a34w_conn, HOST_LPCTL) & LPCTL_OWNER_SYNC) == 0) {
+			a34w_say("step 5: driver own in %llu ms (LPCTL 0x%08x)", (unsigned long long)(a34w_ms() - began),
+			    a34w_rd(a34w_conn, HOST_LPCTL));
+			return true;
+		}
+		if (asked == 0 || a34w_ms() - asked >= 200u) {
+			a34w_wr(a34w_conn, HOST_LPCTL, LPCTL_CLR_OWN);
+			asked = a34w_ms() | 1u;
+		}
+		delay(100);
+	}
+	a34w_say("step 5: driver own NOT taken in 2 s (LPCTL 0x%08x)", a34w_rd(a34w_conn, HOST_LPCTL));
+	return false;
+}
+
+static volatile uint32_t *
+a34w_desc(uint32_t ring_off, uint32_t slot)
+{
+	return (volatile uint32_t *)(a34w_dma + ring_off + slot * 16u);
+}
+
+static void
+a34w_wfdma_init(void)
+{
+	uint32_t glo, v, wr;
+
+	/* asicConnac2xWfdmaControl(disable): DMA off, its idle waited for, the indices reset; interrupts off */
+	glo = a34w_rd(a34w_conn, WFDMA_GLO_CFG);
+	a34w_wr(a34w_conn, WFDMA_GLO_CFG, glo & ~(GLO_TX_DMA_EN | GLO_RX_DMA_EN | GLO_CHAIN_EN | GLO_OMIT_TX_INFO |
+	    GLO_OMIT_RX_INFO | GLO_OMIT_RX_INFO_PFET2));
+	(void)a34w_poll_mask(a34w_conn, WFDMA_GLO_CFG, GLO_TX_DMA_BUSY | GLO_RX_DMA_BUSY, 0, 100, 1000, &v);
+	a34w_wr(a34w_conn, WFDMA_RST_DTX_PTR, 0xffffffffu);
+	a34w_wr(a34w_conn, WFDMA_RST_DRX_PTR, 0xffffffffu);
+	a34w_wr(a34w_conn, WFDMA_INT_ENA_CLR, 0xffffffffu);
+
+	/* TX ring 17: every slot free (DMADONE); RX ring 0: every slot the DMA's, CPU index one behind */
+	for (uint32_t s = 0; s < RING_SLOTS; s++) {
+		volatile uint32_t *t = a34w_desc(DMA_TX17_DESC, s), *r = a34w_desc(DMA_RX0_DESC, s);
+
+		t[0] = 0;
+		t[1] = DESC_DMADONE;
+		t[2] = 0;
+		t[3] = 0;
+		r[0] = (uint32_t)A34W_DMA_PA + DMA_RX0_BUFS + s * SLOT_SIZE;
+		r[1] = DESC_SDLEN0(RX_BUF_SIZE);
+		r[2] = 0;
+		r[3] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a34w_tx_cidx = 0;
+	a34w_rx_cidx = RING_SLOTS - 1u;
+	a34w_wr(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0x0u, (uint32_t)A34W_DMA_PA + DMA_TX17_DESC);
+	a34w_wr(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0x8u, 0);
+	a34w_wr(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0x4u, RING_SLOTS);
+	a34w_wr(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x0u, (uint32_t)A34W_DMA_PA + DMA_RX0_DESC);
+	a34w_wr(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x8u, a34w_rx_cidx);
+	a34w_wr(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x4u, RING_SLOTS);
+
+	/* soc5_0asicConnac2xWfdmaManualPrefetch(): chain off, each ring's prefetch slot, as Android orders them */
+	a34w_clr(a34w_conn, WFDMA_GLO_CFG, GLO_CHAIN_EN);
+	wr = 0x00000004u;
+	a34w_wr(a34w_conn, WFDMA_RX_EXT_CTRL(0), wr);
+	wr += 0x00400000u;
+	for (uint32_t n = 2; n <= 5u; n++, wr += 0x00400000u) {
+		a34w_wr(a34w_conn, WFDMA_RX_EXT_CTRL(n), wr);
+	}
+	a34w_wr(a34w_conn, WFDMA_RX_EXT_CTRL(1), wr);
+	wr += 0x00400000u;
+	for (uint32_t n = 6; n <= 9u; n++, wr += 0x00400000u) {
+		a34w_wr(a34w_conn, WFDMA_RX_EXT_CTRL(n), wr);
+	}
+	for (uint32_t n = 0; n <= 2u; n++, wr += 0x00400000u) {
+		a34w_wr(a34w_conn, WFDMA_TX_EXT_CTRL(n), wr);
+	}
+	for (uint32_t n = 16; n <= 17u; n++, wr += 0x00400000u) {
+		a34w_wr(a34w_conn, WFDMA_TX_EXT_CTRL(n), wr);
+	}
+	for (uint32_t n = 8; n <= 10u; n++, wr += 0x00400000u) {
+		a34w_wr(a34w_conn, WFDMA_TX_EXT_CTRL(n), wr);
+	}
+	a34w_wr(a34w_conn, WFDMA_TX_EXT_CTRL(18), 0x04000004u);
+	wr += 0x00400000u;
+	a34w_wr(a34w_conn, WFDMA_TX_EXT_CTRL(19), wr);
+	a34w_set(a34w_conn, WFDMA_INT_RX_PRI_SEL, (1u << 1) | (0xfu << 6));
+	a34w_wr(a34w_conn, WFDMA_RST_DTX_PTR, 0xffffffffu);
+	a34w_wr(a34w_conn, WFDMA_RST_DRX_PTR, 0xffffffffu);
+	/* the reset cleared the CPU indices: the RX ring's again */
+	a34w_wr(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x8u, a34w_rx_cidx);
+
+	/* on (asicConnac2xWfdmaControl(enable), soc5_0asicConnac2xWpdmaConfig); interrupts stay masked: polled */
+	a34w_set(a34w_conn, WFDMA_GLO_CFG, GLO_ENABLE_BITS);
+	v = a34w_rd(a34w_conn, WFDMA_PAUSE_RX_Q_TH10);
+	a34w_wr(a34w_conn, WFDMA_PAUSE_RX_Q_TH10, (v & 0x0fff0000u) + 4u);
+	a34w_set(a34w_wf, WF_WFDMA_DUMMY_CR, 1u << 1);
+	a34w_say("step 5: WFDMA: GLO_CFG 0x%08x, TX17 at 0x%x (%u slots) cidx/didx %u/%u, RX0 at 0x%x cidx/didx %u/%u",
+	    a34w_rd(a34w_conn, WFDMA_GLO_CFG), (uint32_t)A34W_DMA_PA + DMA_TX17_DESC, RING_SLOTS,
+	    a34w_rd(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0x8u), a34w_rd(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0xcu),
+	    (uint32_t)A34W_DMA_PA + DMA_RX0_DESC, a34w_rd(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x8u),
+	    a34w_rd(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0xcu));
+}
+
+/* one frame into TX ring 17, and the DMA waited for until it has taken it */
+static bool
+a34w_tx(const uint8_t *frame, uint32_t length)
+{
+	uint32_t slot = a34w_tx_cidx, next = (slot + 1u) % RING_SLOTS, didx = 0;
+	volatile uint32_t *d = a34w_desc(DMA_TX17_DESC, slot);
+
+	if (length > SLOT_SIZE) {
+		return false;
+	}
+	memcpy((void *)(a34w_dma + DMA_TX17_BUFS + slot * SLOT_SIZE), frame, length);
+	d[0] = (uint32_t)A34W_DMA_PA + DMA_TX17_BUFS + slot * SLOT_SIZE;
+	d[2] = 0;
+	d[3] = 0;
+	d[1] = DESC_SDLEN0(length) | DESC_LS0;          /* DMADONE clear: the DMA's */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a34w_tx_cidx = next;
+	a34w_wr(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0x8u, next);
+	if (a34w_poll_mask(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0xcu, 0xfffu, next, 2000, 50, &didx)) {
+		return true;
+	}
+	a34w_say("TX ring 17: the DMA did not take slot %u (DMA index %u, GLO_CFG 0x%08x, INT_STA 0x%08x)", slot, didx,
+	    a34w_rd(a34w_conn, WFDMA_GLO_CFG), a34w_rd(a34w_conn, WFDMA_INT_STA));
+	return false;
+}
+
+/* the next frame the DMA put into RX ring 0 (copied to `frame`), or -1 after `wait_ms` */
+static int
+a34w_rx(uint8_t *frame, uint32_t room, uint32_t wait_ms)
+{
+	uint32_t slot = (a34w_rx_cidx + 1u) % RING_SLOTS, length;
+	volatile uint32_t *d = a34w_desc(DMA_RX0_DESC, slot);
+	uint64_t until = a34w_ms() + wait_ms;
+
+	while ((d[1] & DESC_DMADONE) == 0) {
+		if (a34w_ms() >= until) {
+			return -1;
+		}
+		delay(100);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	length = (d[1] >> 16) & 0x3fffu;
+	if (length > room) {
+		length = room;
+	}
+	if (length > SLOT_SIZE) {
+		length = SLOT_SIZE;
+	}
+	memcpy(frame, (const void *)(a34w_dma + DMA_RX0_BUFS + slot * SLOT_SIZE), length);
+	d[0] = (uint32_t)A34W_DMA_PA + DMA_RX0_BUFS + slot * SLOT_SIZE;
+	d[1] = DESC_SDLEN0(RX_BUF_SIZE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a34w_rx_cidx = slot;
+	a34w_wr(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x8u, slot);
+	return (int)length;
+}
+
+/* an INIT command on TX ring 17; its sequence number (0: not sent) */
+static uint8_t
+a34w_init_cmd(uint8_t cid, const void *payload, uint32_t payload_length)
+{
+	static uint8_t frame[INIT_CMD_HEADER_SIZE + 64u];
+	const uint32_t length = INIT_CMD_HEADER_SIZE + payload_length;
+	uint32_t dw;
+
+	if (payload_length > 64u) {
+		return 0;
+	}
+	bzero(frame, sizeof(frame));
+	dw = (length & 0xffffu) | (2u << 23);           /* TX byte count; packet format: command */
+	memcpy(frame + 0, &dw, 4);
+	dw = 1u << 16;                                  /* header format: command */
+	memcpy(frame + 4, &dw, 4);
+	frame[32] = (uint8_t)(length - TXD_SIZE);
+	frame[33] = (uint8_t)((length - TXD_SIZE) >> 8);
+	frame[36] = cid;
+	frame[37] = INIT_CMD_PACKET_TYPE_ID;
+	if (++a34w_seq == 0) {
+		a34w_seq = 1;
+	}
+	frame[39] = a34w_seq;
+	memcpy(frame + INIT_CMD_HEADER_SIZE, payload, payload_length);
+	return a34w_tx(frame, length) ? a34w_seq : 0;
+}
+
+/* the event answering sequence `seq` on RX ring 0: its EID, what follows its header in `body`; -1 if none */
+static int
+a34w_init_event(uint8_t seq, uint8_t *eid, uint8_t *body, uint32_t room, uint32_t wait_ms)
+{
+	uint8_t frame[256];
+	uint64_t until = a34w_ms() + wait_ms;
+	int got;
+
+	while (a34w_ms() < until && (got = a34w_rx(frame, sizeof(frame), (uint32_t)(until - a34w_ms()))) >= 0) {
+		if (got < (int)(INIT_RXD_SIZE + INIT_EVENT_HEADER_SIZE)) {
+			a34w_say("RX ring 0: a %d-byte frame (too short for an event)", got);
+			continue;
+		}
+		if (frame[INIT_RXD_SIZE + 5] != seq) {
+			a34w_say("RX ring 0: event 0x%02x of sequence %u (waiting for %u)", frame[INIT_RXD_SIZE + 4],
+			    frame[INIT_RXD_SIZE + 5], seq);
+			continue;
+		}
+		*eid = frame[INIT_RXD_SIZE + 4];
+		got -= (int)(INIT_RXD_SIZE + INIT_EVENT_HEADER_SIZE);
+		if ((uint32_t)got > room) {
+			got = (int)room;
+		}
+		memcpy(body, frame + INIT_RXD_SIZE + INIT_EVENT_HEADER_SIZE, (uint32_t)got);
+		return got;
+	}
+	return -1;
+}
+
+/* INIT_CMD_ID_ACCESS_REG, a query (wlanSetChipEcoInfo's way to read TOP_HVR/TOP_FVR) */
+static bool
+a34w_access_reg(uint32_t address, uint32_t *value)
+{
+	uint8_t cmd[12], answer[8], eid = 0;
+	uint8_t seq;
+
+	bzero(cmd, sizeof(cmd));
+	memcpy(cmd + 4, &address, 4);
+	seq = a34w_init_cmd(INIT_CMD_ID_ACCESS_REG, cmd, sizeof(cmd));
+	if (seq == 0 || a34w_init_event(seq, &eid, answer, sizeof(answer), 1000) < 8 || eid != INIT_EVENT_ID_ACCESS_REG) {
+		return false;
+	}
+	*value = a34w_le32(answer + 4);
+	return true;
+}
+
+/* the RAM code's regions (fw_dl.c: wlanImageSectionDownloadStage with dynamic memory mapping) */
+static bool
+a34w_ram_code_load(void)
+{
+	uint32_t size = 0, regions, at = 0, end;
+	uint8_t *file = a34w_file(FW_RAM_CODE, &size);
+	const uint8_t *tailer;
+	bool ok = true;
+
+	if (file == NULL) {
+		return false;
+	}
+	tailer = file + size - TAILER_SIZE;
+	regions = tailer[2];
+	if (regions == 0 || regions > 8u || size < TAILER_SIZE + regions * REGION_SIZE) {
+		a34w_say("step 5: %s: the tailer says %u regions", FW_RAM_CODE, regions);
+		kfree_data(file, size);
+		return false;
+	}
+	end = size - TAILER_SIZE - regions * REGION_SIZE;
+	a34w_say("step 5: %s: %u bytes, %u regions, chip 0x%02x, version %.10s of %.14s", FW_RAM_CODE, size, regions,
+	    tailer[0], (const char *)(tailer + 7), (const char *)(tailer + 17));
+	for (uint32_t i = 0; i < regions && ok; i++) {
+		const uint8_t *r = file + end + i * REGION_SIZE;
+		uint32_t address = a34w_le32(r + 16), length = a34w_le32(r + 20);
+		uint8_t feature = r[24];
+
+		if ((feature & FEATURE_NOT_DOWNLOAD) || length == 0) {
+			at += length;
+			continue;
+		}
+		if (at + length > end || (length & 3u) != 0) {
+			a34w_say("step 5: region %u (%u bytes at file offset 0x%x) does not fit the file", i, length, at);
+			ok = false;
+			break;
+		}
+		if (feature & FEATURE_DL_TO_EMI) {
+			uint32_t offset = address & EMI_ADDR_MASK;
+
+			if (offset + length > A34W_EMI_SIZE) {
+				a34w_say("step 5: region %u: EMI +0x%x..0x%x is past CONNSYS's memory", i, offset, offset + length);
+				ok = false;
+				break;
+			}
+			memcpy((void *)(a34w_emi + offset), file + at, length);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			a34w_say("step 5: region %u: %u bytes to 0x%08x: into the EMI at +0x%x", i, length, address, offset);
+		} else if (feature & FEATURE_ENCRYPTED) {
+			a34w_say("step 5: region %u (to 0x%08x) is encrypted (feature 0x%02x): it needs the DMA download, "
+			    "not written here", i, address, feature);
+			ok = false;
+			break;
+		} else {
+			if (length > WF_WINDOW_SIZE) {
+				ok = false;
+				break;
+			}
+			/* downloadImgByDynMemMap(): the window shown the region's address, the data written through it */
+			a34w_wr(a34w_wf, WF_AP2WF_REMAP_1, address);
+			for (uint32_t w = 0; w < length; w += 4u) {
+				*(volatile uint32_t *)(a34w_wf + WF_WINDOW + w) = a34w_le32(file + at + w);
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			a34w_say("step 5: region %u: %u bytes to 0x%08x: through the AP2WF window (feature 0x%02x)", i, length,
+			    address, feature);
+		}
+		at += length;
+	}
+	kfree_data(file, size);
+	return ok;
+}
+
+static bool
+a34w_step5(void)
+{
+	uint32_t hvr = 0, fvr = 0, sync = 0, v;
+	uint8_t start[8], result[4] = { 0xff, 0, 0, 0 }, eid = 0, seq;
+	uint64_t t0;
+	int got;
+
+	if (!a34w_conn_reachable()) {
+		a34w_say("step 5: the CONN domain is off or protected (CONN_PWR_CON 0x%08x STA1 0x%08x): not touched",
+		    a34w_rd(a34w_ap, SPM_CONN_PWR_CON), a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1));
+		return false;
+	}
+	if (!a34w_map_wf() || !a34w_driver_own()) {
+		return false;
+	}
+	sync = a34w_rd(a34w_conn, HOST_SW_SYNC0);
+	if ((sync & 3u) == 3u) {
+		a34w_say("step 5: the firmware already runs (CONN_ON_MISC 0x%08x): nothing to do", sync);
+		return true;
+	}
+	/* asicConnac2xCapInit() */
+	a34w_wr(a34w_conn, HOST_IRQ_ENA, 1u);
+	a34w_wr(a34w_conn, WFDMA_MCU2HOST_SW_INT_ENA, 0xffffu);
+	a34w_wfdma_init();
+
+	/* the ROM over the INIT channel: does TX ring 17 / RX ring 0 work at all */
+	if (!a34w_access_reg(TOP_HVR, &hvr) || !a34w_access_reg(TOP_FVR, &fvr)) {
+		a34w_say("step 5: the ROM did not answer ACCESS_REG (TX17 cidx/didx %u/%u, RX0 cidx/didx %u/%u, INT_STA 0x%08x)",
+		    a34w_rd(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0x8u),
+		    a34w_rd(a34w_conn, WFDMA_TX_RING(HW_TX_CMD_RING) + 0xcu),
+		    a34w_rd(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0x8u),
+		    a34w_rd(a34w_conn, WFDMA_RX_RING(HW_RX_EVENT_RING) + 0xcu), a34w_rd(a34w_conn, WFDMA_INT_STA));
+		return false;
+	}
+	a34w_say("step 5: the ROM answers: TOP_HVR 0x%08x TOP_FVR 0x%08x", hvr, fvr);
+
+	a34w_wr(a34w_ap, 0x3220u, 0);                   /* wlanConnacPccifon(): "Wi-Fi on" for the modem's PCCIF */
+	if (!a34w_ram_code_load()) {
+		return false;
+	}
+	bzero(start, sizeof(start));                    /* INIT_CMD_WIFI_START {u4Override 0, u4Address 0}: no RAM entry */
+	t0 = a34w_ms();
+	seq = a34w_init_cmd(INIT_CMD_ID_DYN_MEM_MAP_FW_FINISH, start, sizeof(start));
+	got = seq != 0 ? a34w_init_event(seq, &eid, result, sizeof(result), 3000) : -1;
+	if (got < 1 || eid != INIT_EVENT_ID_CMD_RESULT || result[0] != 0) {
+		a34w_say("step 5: FW_FINISH %s (event 0x%02x, status 0x%02x), mailbox 0x%08x, CONN_ON_MISC 0x%08x",
+		    seq == 0 ? "NOT SENT" : got < 0 ? "NOT ANSWERED" : "REFUSED", eid, result[0],
+		    a34w_rd(a34w_conn, HOST_MAILBOX_DBG), a34w_rd(a34w_conn, HOST_SW_SYNC0));
+		return false;
+	}
+	a34w_say("step 5: FW_FINISH answered in %llu ms", (unsigned long long)(a34w_ms() - t0));
+	if (!a34w_poll_mask(a34w_conn, HOST_SW_SYNC0, 3u, 3u, 500, 5000, &sync)) {
+		a34w_say("step 5: the firmware is NOT ready after 2.5 s: CONN_ON_MISC 0x%08x, mailbox 0x%08x", sync,
+		    a34w_rd(a34w_conn, HOST_MAILBOX_DBG));
+		return false;
+	}
+	v = a34w_rd(a34w_conn, SYSRAM_SW_WFDMA_OFFSET);
+	a34w_say("step 5: THE WI-FI FIRMWARE IS READY %llu ms after FW_FINISH: CONN_ON_MISC 0x%08x; its command mailbox "
+	    "(SW WFDMA) at EMI +0x%x", (unsigned long long)(a34w_ms() - t0), sync, v & EMI_ADDR_MASK);
+	return true;
+}
+
+/* ---- the thread: steps up to what is asked, one at a time ---- */
+
+static bool
+a34w_run_step(int step)
+{
+	switch (step) {
+	case 1:
+		return a34w_step1();
+	case 2:
+		return a34w_step2();
+	case 3:
+		return a34w_step3();
+	case 4:
+		return a34w_step4();
+	case 5:
+		return a34w_step5();
+	default:
+		return false;
+	}
+}
+
+static void
+a34w_thread(__unused void *arg, __unused wait_result_t result)
+{
+	for (;;) {
+		int step;
+
+		lck_mtx_lock(&a34w_run_mtx);
+		while (a34w_want <= a34w_done || a34w_failed != 0) {
+			a34w_busy = 0;
+			lck_mtx_sleep(&a34w_run_mtx, LCK_SLEEP_DEFAULT, (event_t)&a34w_chan, THREAD_UNINT);
+		}
+		a34w_busy = 1;
+		step = a34w_done + 1;
+		lck_mtx_unlock(&a34w_run_mtx);
+
+		if (!a34w_map()) {
+			lck_mtx_lock(&a34w_run_mtx);
+			a34w_failed = step;
+			lck_mtx_unlock(&a34w_run_mtx);
+			continue;
+		}
+		uint64_t t0 = a34w_ms();
+		bool ok = a34w_run_step(step);
+
+		a34w_say("step %d %s (%llu ms)%s", step, ok ? "done" : "FAILED: nothing more will be tried this boot",
+		    (unsigned long long)(a34w_ms() - t0), ok && step == (int)A34W_STEPS ? ": milestone 1 reached" : "");
+		lck_mtx_lock(&a34w_run_mtx);
+		if (ok) {
+			a34w_done = step;
+		} else {
+			a34w_failed = step;
+		}
+		lck_mtx_unlock(&a34w_run_mtx);
+	}
+}
+
+/* Asks for steps up to `step` (1..A34W_STEPS); the thread is started on the first request. */
+static int
+a34w_ask(int step)
+{
+	thread_t thread;
+
+	if (step < 1 || step > (int)A34W_STEPS) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&a34w_run_mtx);
+	if (a34w_failed != 0) {
+		lck_mtx_unlock(&a34w_run_mtx);
+		a34w_say("asked for step %d, but step %d failed this boot: not trying again", step, a34w_failed);
+		return EIO;
+	}
+	if (step > a34w_want) {
+		a34w_want = step;
+		a34w_busy = a34w_want > a34w_done;
+	}
+	if (!a34w_thread_started) {
+		if (kernel_thread_start(a34w_thread, NULL, &thread) != KERN_SUCCESS) {
+			lck_mtx_unlock(&a34w_run_mtx);
+			a34w_say("kernel_thread_start failed");
+			return ENOMEM;
+		}
+		thread_deallocate(thread);
+		a34w_thread_started = true;
+	}
+	thread_wakeup((event_t)&a34w_chan);
+	lck_mtx_unlock(&a34w_run_mtx);
+	return 0;
+}
+
+/* ---- sysctl kern.a34wifi: want (root writes N), done, busy, log ---- */
+
+SYSCTL_NODE(_kern, OID_AUTO, a34wifi, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "A34 Wi-Fi bring-up (docs/wifi-plan.md)");
+
+static int
+a34w_sysctl_want SYSCTL_HANDLER_ARGS
+{
+	int value = a34w_want, changed = 0;
+	int error;
+
+	(void)arg1;
+	(void)arg2;
+	(void)oidp;
+	error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+
+	if (error != 0 || !changed) {
+		return error;
+	}
+	return a34w_ask(value);
+}
+
+SYSCTL_PROC(_kern_a34wifi, OID_AUTO, want, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    a34w_sysctl_want, "I", "steps asked for (write N: 1..5)");
+SYSCTL_INT(_kern_a34wifi, OID_AUTO, done, CTLFLAG_RD | CTLFLAG_LOCKED, &a34w_done, 0, "steps done");
+SYSCTL_INT(_kern_a34wifi, OID_AUTO, busy, CTLFLAG_RD | CTLFLAG_LOCKED, &a34w_busy, 0, "working");
+SYSCTL_INT(_kern_a34wifi, OID_AUTO, failed, CTLFLAG_RD | CTLFLAG_LOCKED, &a34w_failed, 0, "the step that failed");
+
+static int
+a34w_sysctl_log SYSCTL_HANDLER_ARGS
+{
+	int error;
+
+	(void)arg1;
+	(void)arg2;
+	(void)oidp;
+	lck_mtx_lock(&a34w_log_mtx);
+	error = SYSCTL_OUT(req, a34w_log, a34w_log_len + 1u);
+	lck_mtx_unlock(&a34w_log_mtx);
+	return error;
+}
+
+SYSCTL_PROC(_kern_a34wifi, OID_AUTO, log, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0,
+    a34w_sysctl_log, "A", "the Wi-Fi bring-up's log");
+
+/* bsd/dev/sweet_ufs.c, at boot: a34wifi=N asks for steps up to N now; otherwise nothing */
+void
+a34_wifi_init(void)
+{
+	int step = 0;
+
+	if (!PE_parse_boot_argn("a34wifi", &step, sizeof(step)) || step <= 0) {
+		return;
+	}
+	if (step > (int)A34W_STEPS) {
+		step = (int)A34W_STEPS;
+	}
+	a34w_say("boot-arg a34wifi=%d", step);
+	(void)a34w_ask(step);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
