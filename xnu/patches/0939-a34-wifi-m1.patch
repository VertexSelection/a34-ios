+/* connsys_adie_clock_buffer_setting(bt_only = false), from connsys_low_power_setting_mt6877() */
+static void
+a34w_adie_clock_buffer(void)
+{
+	uint32_t x1 = 0, x2 = 0;
+	bool e1 = a34w_adie_id == 0x66358a00u;
+
+	if (!a34w_adie_top_ck(true)) {
+		return;
+	}
+	if (a34w_sema_get(SEMA_RFSPI)) {
+		if (a34w_spi_read(ATOP_RG_TOP_XTAL_01, &x1)) {
+			(void)a34w_spi_write(ATOP_RG_TOP_XTAL_01, (x1 & ~0xc180u) | 0xc180u);
+		}
+		if (a34w_spi_read(ATOP_RG_TOP_XTAL_02, &x2)) {
+			(void)a34w_spi_write(ATOP_RG_TOP_XTAL_02, (x2 & ~0xf0ff0080u) | (e1 ? 0xd0550080u : 0x50550080u));
+		}
+		a34w_sema_put(SEMA_RFSPI);
+	}
+	(void)a34w_adie_top_ck(false);
+}
+
+static void
+a34w_low_power_setting(void)
+{
+	a34w_adie_clock_buffer();
+	a34w_mask(a34w_conn, CONN_CFG_PWRCTRL0, 0xf000u, 0x1000u);
+	if (!a34w_rc_mode) {
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 7);
+		a34w_mask(a34w_conn, CONN_CFG_OSC_CTL_0, 0x00ffffffu, 0x00080706u);
+		a34w_clr(a34w_conn, CONN_CFG_OSC_CTL_1, 1u << 16);
+	} else {
+		a34w_wr(a34w_conn, CONN_CFG_RC_CTL_1_GPS, 0x02080706u);
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0_GPS, 1u << 15);
+		a34w_wr(a34w_conn, CONN_CFG_RC_CTL_1_BT, 0x02080706u);
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0_BT, 1u << 15);
+		a34w_wr(a34w_conn, CONN_CFG_RC_CTL_1_WF, 0x02080706u);
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0_WF, 1u << 15);
+		a34w_wr(a34w_conn, CONN_CFG_RC_CTL_1_TOP, 0x02080706u);
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0_TOP, 1u << 15);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_1, 1u << 3);
+		delay(30);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_1, 1u << 0);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_1, 1u << 1);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_1, 1u << 2);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 4);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 5);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 6);
+		a34w_set(a34w_conn, CONN_CFG_EMI_CTL_0, 1u << 0);
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 31);
+		a34w_clr(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 0);
+		a34w_mask(a34w_conn, CONN_CFG_OSC_CTL_0, 0x00ffffffu, 0x00080706u);
+		a34w_clr(a34w_conn, CONN_CFG_OSC_CTL_1, 1u << 16);
+		a34w_set(a34w_conn, CONN_CFG_RC_CTL_0, 1u << 30);
+		a34w_mask(a34w_conn, CONN_CFG_RC_CTL_1, 0xf0u, 0xd0u);
+		a34w_set(a34w_conn, CONN_CFG_EMI_CTL_0, 1u << 16);
+		a34w_set(a34w_conn, CONN_CFG_EMI_CTL_1, 1u << 1);
+	}
+	a34w_mask(a34w_conn, CONN_RGU_BGFSYS_ON_TOP_PWR_CTL, 0xffff0040u, 0x42540000u);
+	a34w_mask(a34w_conn, CONN_RGU_WFSYS_ON_TOP_PWR_CTL, 0xffff0040u, 0x57460000u);
+	a34w_set(a34w_conn, CONN_CFG_EMI_CTL_0, 1u << 18);
+	a34w_mask(a34w_conn, CONN_CFG_EMI_CTL_0, 0x7ff0u, 1023u << 4);
+	a34w_set(a34w_conn, CONN_CFG_EMI_CTL_0, 1u << 15);
+	a34w_clr(a34w_conn, CONN_CFG_EMI_CTL_0, 1u << 15);
+	a34w_mask(a34w_conn, CONN_BCRM_DCM_TOP_CTRL_0, 0xf80000u, 0x80000u);
+	a34w_mask(a34w_conn, CONN_BCRM_DCM_TOP_CTRL_1, 0x3e0u, 0x20u);
+	a34w_mask(a34w_conn, CONN_BCRM_DCM_TOP_CTRL_0, 0x3u, 0x3u);
+	a34w_mask(a34w_conn, CONN_BCRM_DCM_TOP_CTRL_0, 0x18u, 0x18u);
+	a34w_set(a34w_conn, CONN_BUS_LIGHT_SECURITY, (1u << 0) | (1u << 1) | (1u << 3) | (1u << 4));
+	a34w_mask(a34w_conn, CONN_BUS_OFF_TIMEOUT_CTRL, 0x7f80u, 0x12u << 7);
+	a34w_mask(a34w_conn, CONN_BUS_OFF_TIMEOUT_CTRL, 0x7u, 0x7u);
+	a34w_mask(a34w_conn, CONN_BUS_ON_TIMEOUT_CTRL, 0x7f80u, 0x2u << 7);
+	a34w_mask(a34w_conn, CONN_BUS_ON_TIMEOUT_CTRL, 0x7u, 0x7u);
+	a34w_set(a34w_conn, CONN_DEBUG_CTRL_AO, 1u << 9);
+	a34w_mask(a34w_conn, CONN_DEBUG_CTRL_AO, 0xffff0000u, 0x07f40000u);
+	a34w_set(a34w_conn, CONN_DEBUG_CTRL_AO, (1u << 2) | (1u << 3) | (1u << 4));
+	a34w_clr(a34w_conn, CONN_DEBUG_CTRL_AO, 1u << 9);
+	a34w_mask(a34w_ap, TOPRGU_WDT_SWSYSRST, 0xff001000u, 0x88000000u);       /* bit 12, key 0x88 */
+	a34w_set(a34w_conn, CONN_CLKGEN_BPLL_DIV_1, 1u);
+	a34w_set(a34w_conn, CONN_CLKGEN_BPLL_DIV_2, 1u);
+	a34w_set(a34w_conn, CONN_CLKGEN_WPLL_DIV_1, 1u);
+	a34w_set(a34w_conn, CONN_CLKGEN_WPLL_DIV_2, 1u);
+	a34w_clr(a34w_conn, CONN_CLKGEN_RFSPI_CK_CTRL, 1u << 7);
+	a34w_set(a34w_conn, CONN_CLKGEN_RFSPI_CK_CTRL, 1u << 6);
+	a34w_set(a34w_conn, CONN_CLKGEN_RFSPI_CK_CTRL, 1u << 4);
+	a34w_set(a34w_conn, CONN_HOST_SLP_CNT_CTL, 1u << 31);
+	a34w_set(a34w_conn, CONN_HOST_SLP_CNT_CTL, 1u << 0);
+	a34w_set(a34w_conn, CONN_CLKGEN_CKGEN_BUS, 0x3fu | (1u << 25) | (1u << 26) | (1u << 27));
+	a34w_set(a34w_conn, CONN_CFG_PWRCTRL0, 1u << 9);
+	a34w_wr(a34w_conn, CONN_RGU_DEBUG_SEL, 0x6u);
+	/* "CANNOT add code after HERE": bus clock to hardware control, then conn_infra may sleep */
+	a34w_clr(a34w_conn, CONN_CLKGEN_CKGEN_BUS, 1u << 23);
+	a34w_set(a34w_conn, CONN_CFG_PWRCTRL0, 1u << 0);
+}
