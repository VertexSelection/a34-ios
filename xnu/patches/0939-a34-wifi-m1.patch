+/* connsys_a_die_efuse_read_nolock() and connsys_a_die_thermal_cal_nolock() (the RF SPI semaphore held) */
+static void
+a34w_adie_efuse(void)
+{
+	uint32_t ctrl = 0, e[4] = { 0, 0, 0, 0 };
+	uint32_t tries = 0;
+
+	if (!a34w_spi_read(ATOP_EFUSE_CTRL, &ctrl)) {
+		return;
+	}
+	(void)a34w_spi_write(ATOP_EFUSE_CTRL, ctrl & ~(1u << 30));
+	(void)a34w_spi_read(ATOP_EFUSE_CTRL, &ctrl);
+	(void)a34w_spi_write(ATOP_EFUSE_CTRL, (ctrl & ~0x43ff00c0u) | (1u << 30));     /* address 0, kick */
+	(void)a34w_spi_read(ATOP_EFUSE_CTRL, &ctrl);
+	while ((ctrl & (1u << 30)) != 0 && tries < 70u) {
+		tries++;
+		delay(30);
+		(void)a34w_spi_read(ATOP_EFUSE_CTRL, &ctrl);
+	}
+	if ((ctrl & (1u << 29)) == 0) {
+		a34w_say("step 3: A-die efuse not valid (EFUSE_CTRL 0x%08x)", ctrl);
+		return;
+	}
+	for (uint32_t n = 0; n < 4u; n++) {
+		(void)a34w_spi_read(ATOP_EFUSE_RDATA(n), &e[n]);
+		a34w_wr(a34w_conn, SYSRAM_A_DIE_EFUSE(n), e[n]);
+	}
+	a34w_say("step 3: A-die efuse 0x%08x 0x%08x 0x%08x 0x%08x", e[0], e[1], e[2], e[3]);
+	if (e[1] & (1u << 7)) {
+		a34w_spi_field(ATOP_RG_TOP_THADC_BG, e[1], 12, 3, 4);
+		a34w_spi_field(ATOP_RG_TOP_THADC, e[1], 23, 0, 3);
+	}
+	if (e[1] & (1u << 15)) {
+		a34w_spi_field(ATOP_RG_TOP_THADC, e[1], 26, 13, 2);
+	}
+}
+
+/* connsys_a_die_cfg_mt6877() (26 MHz co-clock: conninfra.cfg has no TCXO, the device tree no tcxo_support) */
+static bool
+a34w_a_die_cfg(void)
+{
+	uint32_t id = 0;
+
+	a34w_wr(a34w_ap, GPIO_DIR6_SET, 0x00001000u);  /* CONN_WF_CTRL2 as a GPIO, high, until the end */
+	a34w_wr(a34w_ap, GPIO_DOUT6_SET, 0x00001000u);
+	a34w_mask(a34w_ap, GPIO_MODE25, 0x70000u, 0);
+	(void)a34w_adie_top_ck(true);                   /* (Android goes on if it stays busy: so do we) */
+	a34w_set(a34w_conn, CONN_CFG_ADIE_CTL, 1u);     /* A-die reset released */
+	if (!a34w_sema_get(SEMA_RFSPI)) {
+		return false;
+	}
+	if (!a34w_spi_read(ATOP_CHIP_ID, &id) || (id & 0xffff0000u) != 0x66350000u) {
+		a34w_say("step 3: A-die chip id 0x%08x: not an MT6635", id);
+		a34w_sema_put(SEMA_RFSPI);
+		return false;
+	}
+	a34w_adie_id = id;
+	a34w_say("step 3: A-die chip id 0x%08x: MT6635 %s", id,
+	    id == 0x66358a00u ? "E1" : id == 0x66358a10u ? "E2" : id == 0x66358a11u ? "E3" : "(unknown revision)");
+	a34w_wr(a34w_conn, SYSRAM_A_DIE_CHIP_ID, id);
+	(void)a34w_spi_write(ATOP_WRI_CTR2, 0x00007700u);
+	(void)a34w_spi_write(ATOP_SMCTK11, 0x00000021u);
+	a34w_mask(a34w_conn, CONN_RFSPI_FM_CTRL, (1u << 15) | 0xffu, 0);
+	a34w_wr(a34w_conn, CONN_THERM_AADDR, 0x50305a00u);
+	a34w_adie_efuse();
+	(void)a34w_spi_write(ATOP_RG_ENCAL_WBTAC_IF_SW, 0x80000000u);
+	(void)a34w_spi_write(ATOP_RG_WF0_TOP_01, 0x000e8002u);
+	(void)a34w_spi_write(ATOP_RG_WF1_TOP_01, 0x000e8002u);
+	(void)a34w_spi_write(ATOP_RG_TOP_XTAL_01, 0xf6e8fff5u);
+	(void)a34w_spi_write(ATOP_RG_TOP_XTAL_02, id == 0x66358a00u ? 0xd5555fffu : 0x55555fffu);
+	(void)a34w_spi_write(ATOP_RG_WF0_BG, 0x00002008u);
+	(void)a34w_spi_write(ATOP_RG_WF1_BG, 0x00002008u);
+	a34w_sema_put(SEMA_RFSPI);
+	a34w_mask(a34w_ap, GPIO_MODE25, 0x70000u, 0x10000u);   /* CONN_WF_CTRL2 back to CONN */
+	return true;
+}
+
+static void
+a34w_afe_wbg_cal(void)
+{
+	a34w_set(a34w_conn, CONN_AFE_DIG_EN_01, 1u);           /* RC calibration */
+	delay(60);
+	a34w_clr(a34w_conn, CONN_AFE_DIG_EN_01, 1u);
+	a34w_mask(a34w_conn, CONN_AFE_BT0_TX_03, 0x03c00000u, 0);      /* VCM to 0.6 V for the DACK */
+	a34w_mask(a34w_conn, CONN_AFE_WF0_TX_03, 0x03c00000u, 0);
+	a34w_mask(a34w_conn, CONN_AFE_WF1_TX_03, 0x03c00000u, 0);
+	a34w_set(a34w_conn, CONN_AFE_DIG_EN_03, 1u << 21);     /* BPLL up */
+	delay(30);
+	a34w_set(a34w_conn, CONN_AFE_DIG_EN_03, 1u << 20);     /* WPLL up */
+	delay(60);
+	a34w_set(a34w_conn, CONN_AFE_DIG_EN_01, (1u << 21) | (1u << 20) | (1u << 19));   /* TX calibration */
+	delay(800);
+	a34w_clr(a34w_conn, CONN_AFE_DIG_EN_01, (1u << 21) | (1u << 20) | (1u << 19));
+	a34w_clr(a34w_conn, CONN_AFE_DIG_EN_03, (1u << 21) | (1u << 20));
+	a34w_mask(a34w_conn, CONN_AFE_BT0_TX_03, 0x03c00000u, 4u << 22);
+	a34w_mask(a34w_conn, CONN_AFE_WF0_TX_03, 0x03c00000u, 4u << 22);
+	a34w_mask(a34w_conn, CONN_AFE_WF1_TX_03, 0x03c00000u, 4u << 22);
+	if (a34w_sema_get(SEMA_RFSPI)) {
+		(void)a34w_spi_write(ATOP_RG_ENCAL_WBTAC_IF_SW, 0x00000005u);
+		a34w_sema_put(SEMA_RFSPI);
+	}
+}
+
+static void
+a34w_subsys_pll_initial(void)
+{
+	a34w_mask(a34w_conn, CONN_AFE_PLL_STB_TIME, 0x7fff7fffu, 0x03140521u);
+	a34w_mask(a34w_conn, CONN_AFE_DIG_EN_02, 0xc0u, 1u << 6);       /* BT PLL */
+	a34w_mask(a34w_conn, CONN_AFE_DIG_EN_02, 0x03u, 3u);            /* WF PLL */
+	a34w_mask(a34w_conn, CONN_AFE_DIG_EN_02, 0x0cu, 1u << 2);       /* MCU PLL (BGF) */
+	a34w_mask(a34w_conn, CONN_AFE_DIG_EN_02, 0x30000u, 3u << 16);   /* MCU PLL (WF) */
+	a34w_mask(a34w_conn, CONN_AFE_DIG_TOP_01, 0x78000u, 0xdu << 15);
+}
