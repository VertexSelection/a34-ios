+static bool
+a34w_step3(void)
+{
+	uint64_t t0 = a34w_ms();
+
+	if (!a34w_conn_reachable()) {
+		a34w_say("step 3: the CONN domain is off or protected (CONN_PWR_CON 0x%08x STA1 0x%08x): not touched",
+		    a34w_rd(a34w_ap, SPM_CONN_PWR_CON), a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1));
+		return false;
+	}
+	a34w_emi_remap();
+	a34w_d_die_cfg();
+	a34w_spi_master_cfg();
+	if (!a34w_a_die_cfg()) {
+		return false;
+	}
+	a34w_afe_wbg_cal();
+	a34w_subsys_pll_initial();
+	if (a34w_sema_get(SEMA_COMMON_SYSRAM)) {
+		a34w_set(a34w_conn, SYSRAM_RADIO_STATUS, 1u << RADIO_WIFI);
+		a34w_sema_put(SEMA_COMMON_SYSRAM);
+	}
+	a34w_low_power_setting();
+	if (a34w_rc_mode) {     /* pmic_mng_common_power_low_power_mode(): RC mode only */
+		(void)a34w_pmic_update(PMIC_VCN18_CON0, PMIC_LP, PMIC_LP);
+		(void)a34w_pmic_update(PMIC_VCN13_CON0, PMIC_LP, PMIC_LP);
+	}
+	/* opfunc_vcn_control_internal(WIFI) -> consys_plt_pmic_wifi_power_ctrl_mt6877(1): VCN33_1, VCN33_2 at 3.3 V */
+	(void)a34w_ldo_on(&a34w_ldos[2], PMIC_VCN33_1_OP_EN_SET, PMIC_VCN33_1_OP_CFG_SET, 0x60u, false, VCN33_3V3, false);
+	(void)a34w_ldo_on(&a34w_ldos[3], PMIC_VCN33_2_OP_EN_SET, PMIC_VCN33_2_OP_CFG_SET, 0x40u, false, VCN33_3V3, false);
+	a34w_ldo_report("step 3");
+	if (!a34w_conninfra_wakeup()) {
+		return false;
+	}
+	a34w_say("step 3: conn_infra set up in %llu ms: A-die 0x%08x, radio status 0x%08x, PWRCTRL0 0x%08x, "
+	    "RC_CTL_0 0x%08x, OSC_CTL_0 0x%08x", (unsigned long long)(a34w_ms() - t0), a34w_rd(a34w_conn, SYSRAM_A_DIE_CHIP_ID),
+	    a34w_rd(a34w_conn, SYSRAM_RADIO_STATUS), a34w_rd(a34w_conn, CONN_CFG_PWRCTRL0),
+	    a34w_rd(a34w_conn, CONN_CFG_RC_CTL_0), a34w_rd(a34w_conn, CONN_CFG_OSC_CTL_0));
+	a34w_conninfra_sleep();
+	return true;
+}
