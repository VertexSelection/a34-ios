+static void a34w_say(const char *fmt, ...) __printflike(1, 2);
+
+static void
+a34w_say(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(line, sizeof(line) - 1, fmt, ap);
+	va_end(ap);
+	if (n < 0) {
+		return;
+	}
+	if ((size_t)n > sizeof(line) - 2) {
+		n = (int)sizeof(line) - 2;
+	}
+	line[n++] = '\n';
+	line[n] = '\0';
+	printf("A34 WIFI: %s", line);
+
+	lck_mtx_lock(&a34w_log_mtx);
+	if (a34w_log_len + (uint32_t)n + 1 > A34W_LOG_SIZE) {
+		/* drop the older half, at a line's start */
+		uint32_t cut = a34w_log_len / 2;
+
+		while (cut < a34w_log_len && a34w_log[cut - 1] != '\n') {
+			cut++;
+		}
+		memmove(a34w_log, a34w_log + cut, a34w_log_len - cut);
+		a34w_log_len -= cut;
+	}
+	memcpy(a34w_log + a34w_log_len, line, (size_t)n);
+	a34w_log_len += (uint32_t)n;
+	a34w_log[a34w_log_len] = '\0';
+	lck_mtx_unlock(&a34w_log_mtx);
+}
+
+static uint64_t
+a34w_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000u;
+}
+
+/* ---- registers ---- */
+
+static inline uint32_t
+a34w_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+a34w_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline void
+a34w_mask(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t value)
+{
+	a34w_wr(base, off, (a34w_rd(base, off) & ~mask) | (value & mask));
+}
+
+static inline void
+a34w_set(vm_offset_t base, uint32_t off, uint32_t bits)
+{
+	a34w_wr(base, off, a34w_rd(base, off) | bits);
+}
+
+static inline void
+a34w_clr(vm_offset_t base, uint32_t off, uint32_t bits)
+{
+	a34w_wr(base, off, a34w_rd(base, off) & ~bits);
+}
+
+/* CONSYS_REG_BIT_POLLING: bit `bit` of the register to `want`, `tries` reads `us` apart. */
+static bool
+a34w_poll(vm_offset_t base, uint32_t off, uint32_t bit, uint32_t want, uint32_t tries, uint32_t us)
+{
+	for (uint32_t i = 0; i <= tries; i++) {
+		if (((a34w_rd(base, off) >> bit) & 1u) == want) {
+			return true;
+		}
+		delay((int)us);
+	}
+	return false;
+}
+
+/* the CONN domain powered (both acks) and reachable (no bus protection): 0x18xxxxxx may be read */
+static bool
+a34w_conn_reachable(void)
+{
+	return (a34w_rd(a34w_ap, SPM_PWR_STATUS) & CONN_PWR_STA) != 0 &&
+	       (a34w_rd(a34w_ap, SPM_PWR_STATUS_2ND) & CONN_PWR_STA) != 0 &&
+	       (a34w_rd(a34w_ap, SPM_CONN_PWR_CON) & (PWR_ISO | PWR_CLK_DIS | PWR_RST_B)) == PWR_RST_B &&
+	       (a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1) & CONN_PROT_AP2CONN) == 0;
+}
+
+static bool
+a34w_map(void)
+{
+	if (a34w_ap != 0) {
+		return true;
+	}
+	a34w_ap = ml_io_map_unmappable(A34W_AP_PA, A34W_AP_SIZE, A34W_WIMG_IO);
+	a34w_iocfg = ml_io_map_unmappable(A34W_IOCFG_PA, A34W_IOCFG_SIZE, A34W_WIMG_IO);
+	a34w_conn = ml_io_map_unmappable(A34W_CONN_PA, A34W_CONN_SIZE, A34W_WIMG_IO);
+	if (a34w_ap == 0 || a34w_iocfg == 0 || a34w_conn == 0) {
+		a34w_say("registers not mapped (0x%lx 0x%lx 0x%lx)", (unsigned long)a34w_ap,
+		    (unsigned long)a34w_iocfg, (unsigned long)a34w_conn);
+		a34w_ap = 0;
+		return false;
+	}
+	return true;
+}
+
+/* ---- the PMIC (MT6359P) through the wrapper, one command at a time with the others ---- */
+
+static bool
+a34w_pmic_read(uint16_t reg, uint16_t *val)
+{
+	int err;
+
+	a34_pmic_lock();
+	err = ruby_pwrap_read(a34w_ap + PWRAP_OFF, reg, val);
+	a34_pmic_unlock();
+	return err == 0;
+}
+
+static bool
+a34w_pwrap_idle(void)
+{
+	for (uint32_t i = 0; i < PW_SPINS; i++) {
+		if (PW_FSM(a34w_rd(a34w_ap, PWRAP_OFF + PW_STA)) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Linux's pwrap_write16() for this wrapper (as a34_clocks.c's ck_pmic_write) */
+static bool
+a34w_pmic_write(uint16_t reg, uint16_t val)
+{
+	bool ok = false;
+
+	a34_pmic_lock();
+	if ((a34w_rd(a34w_ap, PWRAP_OFF + PW_STA) & PW_INIT_DONE) && a34w_pwrap_idle()) {
+		a34w_wr(a34w_ap, PWRAP_OFF + PW_WDATA, val);
+		a34w_wr(a34w_ap, PWRAP_OFF + PW_ACC, (1u << 29) | reg);
+		ok = a34w_pwrap_idle();
+	}
+	a34_pmic_unlock();
+	return ok;
+}
+
+static bool
+a34w_pmic_update(uint16_t reg, uint16_t mask, uint16_t val)
+{
+	uint16_t old = 0;
+
+	if (!a34w_pmic_read(reg, &old)) {
+		return false;
+	}
+	if ((old & mask) == (val & mask)) {
+		return true;
+	}
+	return a34w_pmic_write(reg, (uint16_t)((old & ~mask) | (val & mask)));
+}
+
+struct a34w_ldo {
+	const char *name;
+	uint16_t con0, mon, en_reg, en_bit, vosel_reg;
+};
+
+static const struct a34w_ldo a34w_ldos[] = {
+	{ "VCN18", PMIC_VCN18_CON0, PMIC_VCN18_MON, PMIC_VCN18_CON0, PMIC_EN, PMIC_VCN18_ANA_CON0 },
+	{ "VCN13", PMIC_VCN13_CON0, PMIC_VCN13_MON, PMIC_VCN13_CON0, PMIC_EN, PMIC_VCN13_ANA_CON0 },
+	{ "VCN33_1 (Wi-Fi)", PMIC_VCN33_1_CON0, PMIC_VCN33_1_MON, PMIC_VCN33_1_MULTI_SW, PMIC_MULTI_SW_EN,
+	  PMIC_VCN33_1_ANA_CON0 },
+	{ "VCN33_2 (Wi-Fi)", PMIC_VCN33_2_CON0, PMIC_VCN33_2_MON, PMIC_VCN33_2_MULTI_SW, PMIC_MULTI_SW_EN,
+	  PMIC_VCN33_2_ANA_CON0 },
+};
+
+static void
+a34w_ldo_report(const char *when)
+{
+	for (unsigned i = 0; i < sizeof(a34w_ldos) / sizeof(a34w_ldos[0]); i++) {
+		const struct a34w_ldo *l = &a34w_ldos[i];
+		uint16_t con0 = 0xdead, mon = 0xdead, en = 0xdead, vosel = 0xdead;
+		bool ok = a34w_pmic_read(l->con0, &con0) && a34w_pmic_read(l->mon, &mon) &&
+		    a34w_pmic_read(l->en_reg, &en) && a34w_pmic_read(l->vosel_reg, &vosel);
+
+		a34w_say("%s: %s: %s (sw enable %u, LP %u, CON0 0x%04x, MON 0x%04x, VOSEL %u)", when, l->name,
+		    ok ? ((mon & 1u) ? "on" : "off") : "NOT READ", (en & l->en_bit) ? 1u : 0u,
+		    (con0 & PMIC_LP) ? 1u : 0u, con0, mon, (vosel & VOSEL_MASK) >> VOSEL_SHIFT);
+	}
+}
+
+/*
+ * One LDO on as mt6877_pmic.c leaves it: in RC mode the PMRC_EN bits given (hardware on/off by
+ * SRCLKEN) and, for VCN18/VCN13, the software enable too; in legacy mode HW_OP_EN/CFG bit 0
+ * and the software enable. SW_LP 0, the voltage first.
+ */
+static bool
+a34w_ldo_on(const struct a34w_ldo *l, uint16_t op_en_set, uint16_t op_cfg_set, uint16_t rc_bits,
+    bool legacy_cfg, int vosel, bool sw_enable_in_rc)
+{
+	uint16_t mon = 0;
+	bool ok = true;
+
+	if (a34w_rc_mode) {
+		for (uint32_t b = 7; b >= 4; b--) {
+			if (rc_bits & (1u << b)) {
+				ok = ok && a34w_pmic_write(op_en_set, (uint16_t)(1u << b));
+			}
+		}
+	} else {
+		ok = ok && a34w_pmic_write(op_en_set, 1u);
+		if (legacy_cfg) {
+			ok = ok && a34w_pmic_write(op_cfg_set, 1u);
+		}
+	}
+	(void)op_cfg_set;
+	ok = ok && a34w_pmic_update(l->con0, PMIC_LP, 0);
+	if (vosel >= 0) {
+		ok = ok && a34w_pmic_update(l->vosel_reg, VOSEL_MASK, (uint16_t)((uint32_t)vosel << VOSEL_SHIFT));
+	}
+	if (!a34w_rc_mode || sw_enable_in_rc) {
+		ok = ok && a34w_pmic_update(l->en_reg, l->en_bit, l->en_bit);
+		delay(300);             /* (the LDOs' soft-start; Linux waits its ramp delay the same way) */
+		ok = ok && a34w_pmic_read(l->mon, &mon) && (mon & 1u) != 0;
+	}
+	if (!ok) {
+		a34w_say("%s did not come on (MON 0x%04x)", l->name, mon);
+	}
+	return ok;
+}
+
+/* ---- conn_infra's semaphores and the RF SPI to the A-die (mt6877_pos.c) ---- */
+
+static bool
+a34w_sema_get(uint32_t index)
+{
+	for (uint32_t i = 0; i < 1000u; i++) {          /* CONN_SEMA_TIMEOUT: 1 ms */
+		if (a34w_rd(a34w_conn, CONN_SEMA_M2_OWN_STA(index)) & 1u) {
+			return true;
+		}
+		delay(1);
+	}
+	a34w_say("semaphore %u not taken", index);
+	return false;
+}
+
+static void
+a34w_sema_put(uint32_t index)
+{
+	a34w_wr(a34w_conn, CONN_SEMA_M2_OWN_REL(index), 1u);
+}
+
+static bool
+a34w_spi_read(uint32_t addr, uint32_t *data)
+{
+	if (!a34w_poll(a34w_conn, CONN_RFSPI_STA, RFSPI_TOP_BUSY, 0, 100, 50)) {
+		a34w_say("RF SPI busy before reading 0x%03x (STA 0x%08x)", addr, a34w_rd(a34w_conn, CONN_RFSPI_STA));
+		return false;
+	}
+	a34w_wr(a34w_conn, CONN_RFSPI_TOP_ADDR, RFSPI_TOP_READ | addr);
+	a34w_wr(a34w_conn, CONN_RFSPI_TOP_WDAT, 0);
+	delay(1);
+	if (!a34w_poll(a34w_conn, CONN_RFSPI_STA, RFSPI_TOP_BUSY, 0, 100, 50)) {
+		a34w_say("RF SPI: no answer reading 0x%03x (STA 0x%08x)", addr, a34w_rd(a34w_conn, CONN_RFSPI_STA));
+		return false;
+	}
+	*data = a34w_rd(a34w_conn, CONN_RFSPI_TOP_RDAT);
+	return true;
+}
+
+static bool
+a34w_spi_write(uint32_t addr, uint32_t data)
+{
+	if (!a34w_poll(a34w_conn, CONN_RFSPI_STA, RFSPI_TOP_BUSY, 0, 100, 50)) {
+		a34w_say("RF SPI busy before writing 0x%03x (STA 0x%08x)", addr, a34w_rd(a34w_conn, CONN_RFSPI_STA));
+		return false;
+	}
+	a34w_wr(a34w_conn, CONN_RFSPI_TOP_ADDR, RFSPI_TOP_WRITE | addr);
+	a34w_wr(a34w_conn, CONN_RFSPI_TOP_WDAT, data);
+	delay(1);
+	if (!a34w_poll(a34w_conn, CONN_RFSPI_STA, RFSPI_TOP_BUSY, 0, 100, 50)) {
+		a34w_say("RF SPI: no answer writing 0x%03x (STA 0x%08x)", addr, a34w_rd(a34w_conn, CONN_RFSPI_STA));
+		return false;
+	}
+	return true;
+}
+
+/* consys_spi_write_offset_range_nolock(): bits [reg_off, reg_off + size) of an A-die register from value's [value_off ...) */
+static void
+a34w_spi_field(uint32_t addr, uint32_t value, uint32_t reg_off, uint32_t value_off, uint32_t size)
+{
+	uint32_t data = 0, mask = ((1u << size) - 1u) << reg_off;
+
+	if (!a34w_spi_read(addr, &data)) {
+		return;
+	}
+	value = ((value >> value_off) & ((1u << size) - 1u)) << reg_off;
+	(void)a34w_spi_write(addr, (data & ~mask) | value);
+}
+
+/* connsys_adie_top_ck_en_ctl_mt6877() */
+static bool
+a34w_adie_top_ck(bool on)
+{
+	a34w_mask(a34w_conn, CONN_WT_SLP_TOP_CK_0, 1u, on ? 1u : 0u);
+	if (!a34w_poll(a34w_conn, CONN_WT_SLP_TOP_CK_0, 1, 0, 100, 5)) {
+		a34w_say("A-die top_ck_en %s: still busy (0x%08x)", on ? "on" : "off",
+		    a34w_rd(a34w_conn, CONN_WT_SLP_TOP_CK_0));
+		return false;
+	}
+	return true;
+}
+
+/* conninfra wakeup (consys_conninfra_wakeup_mt6877): force on, then the IP version polled */
+static bool
+a34w_conninfra_wakeup(void)
+{
+	a34w_wr(a34w_conn, CONN_HOST_WAKEPU_TOP, 1u);
+	for (uint32_t i = 0; i < 10u; i++) {
+		if (a34w_rd(a34w_conn, CONN_CFG_IP_VERSION) == CONN_HW_VER) {
+			return true;
+		}
+		delay(1000);
+	}
+	a34w_say("conn_infra did not wake (IP version 0x%08x)", a34w_rd(a34w_conn, CONN_CFG_IP_VERSION));
+	return false;
+}
+
+static void
+a34w_conninfra_sleep(void)
+{
+	a34w_wr(a34w_conn, CONN_HOST_WAKEPU_TOP, 0);
+}
+
+/* ---- step 1: what the boot loader left, read only ---- */
+
+static bool
+a34w_step1(void)
+{
+	uint32_t pwr_con = a34w_rd(a34w_ap, SPM_CONN_PWR_CON);
+
+	a34w_rc_mode = (a34w_rd(a34w_ap, RC_CENTRAL_CFG1) & 1u) != 0;
+	a34w_say("step 1: SPM POWERON_CONFIG_EN 0x%08x CONN_PWR_CON 0x%08x PWR_STATUS 0x%08x/0x%08x OTHER 0x%08x",
+	    a34w_rd(a34w_ap, SPM_POWERON_CONFIG_EN), pwr_con, a34w_rd(a34w_ap, SPM_PWR_STATUS),
+	    a34w_rd(a34w_ap, SPM_PWR_STATUS_2ND), a34w_rd(a34w_ap, SPM_OTHER_PWR_STATUS));
+	a34w_say("step 1: bus protection PROTECTEN 0x%08x STA1 0x%08x (CONN: 0x%x), TOPRGU SWSYSRST 0x%08x",
+	    a34w_rd(a34w_ap, INFRA_PROTECTEN), a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1),
+	    CONN_PROT_STEP1 | CONN_PROT_STEP2, a34w_rd(a34w_ap, TOPRGU_WDT_SWSYSRST));
+	a34w_say("step 1: SRCLKEN_RC CENTRAL_CFG1 0x%08x: %s mode; GPIO_MODE24 0x%08x MODE25 0x%08x",
+	    a34w_rd(a34w_ap, RC_CENTRAL_CFG1), a34w_rc_mode ? "RC" : "legacy",
+	    a34w_rd(a34w_ap, GPIO_MODE24), a34w_rd(a34w_ap, GPIO_MODE25));
+	a34w_ldo_report("step 1");
+	if (a34w_conn_reachable()) {
+		bool awake = a34w_conninfra_wakeup();
+
+		a34w_say("step 1: CONN domain is on: conn_infra %s, IP version 0x%08x, A-die id in sysram 0x%08x",
+		    awake ? "awake" : "NOT awake", a34w_rd(a34w_conn, CONN_CFG_IP_VERSION),
+		    awake ? a34w_rd(a34w_conn, SYSRAM_A_DIE_CHIP_ID) : 0u);
+		a34w_conninfra_sleep();
+	} else {
+		a34w_say("step 1: CONN domain is off or protected (as expected after LK): 0x18xxxxxx not read");
+	}
+	return true;
+}
+
+/* ---- step 2: conn_infra on (consys_hw_pwr_on, parts 1 and 2) ---- */
+
+static bool
+a34w_step2(void)
+{
+	uint32_t v;
+
+	if (a34w_conn_reachable() && a34w_conninfra_wakeup()) {
+		a34w_say("step 2: conn_infra already on (IP version 0x%08x): nothing to do", CONN_HW_VER);
+		return true;
+	}
+
+	/* PMIC: VCN18 1.8 V, then VCN13 1.3 V (consys_plt_pmic_common_power_ctrl_mt6877) */
+	if (!a34w_ldo_on(&a34w_ldos[0], PMIC_VCN18_OP_EN_SET, PMIC_VCN18_OP_CFG_SET, 0xf0u, true, -1, true) ||
+	    !a34w_ldo_on(&a34w_ldos[1], PMIC_VCN13_OP_EN_SET, PMIC_VCN13_OP_CFG_SET, 0xf0u, true, VCN13_1V3, true)) {
+		a34w_ldo_report("step 2");
+		return false;
+	}
+	a34w_ldo_report("step 2");
+
+	/* pins between the D-die and the A-die, aux 1; 2 mA; TOP_DATA/BT_DATA pulled up (consys_set_if_pinmux_mt6877) */
+	a34w_mask(a34w_ap, GPIO_MODE24, 0x77770000u, 0x11110000u);
+	a34w_mask(a34w_ap, GPIO_MODE25, 0x07777777u, 0x01111111u);
+	a34w_mask(a34w_iocfg, IOCFG_RT_DRV_CFG0, 0x38000000u, 0);
+	a34w_wr(a34w_iocfg, IOCFG_RT_PD_CFG0_CLR, (1u << 14) | (1u << 9));
+	a34w_wr(a34w_iocfg, IOCFG_RT_PU_CFG0_SET, (1u << 14) | (1u << 9));
+	a34w_say("step 2: pins: GPIO_MODE24 0x%08x MODE25 0x%08x IOCFG_RT DRV 0x%08x",
+	    a34w_rd(a34w_ap, GPIO_MODE24), a34w_rd(a34w_ap, GPIO_MODE25), a34w_rd(a34w_iocfg, IOCFG_RT_DRV_CFG0));
+
+	/* the CONN MTCMOS (spm_mtcmos_ctrl_conn_pwr(STA_POWER_ON)), SPM writes enabled first */
+	v = a34w_rd(a34w_ap, SPM_POWERON_CONFIG_EN);
+	if ((v & 1u) == 0) {
+		a34w_wr(a34w_ap, SPM_POWERON_CONFIG_EN, (SPM_PROJECT_CODE << 16) | 1u);
+	}
+	a34w_set(a34w_ap, SPM_CONN_PWR_CON, PWR_ON);
+	a34w_set(a34w_ap, SPM_CONN_PWR_CON, PWR_ON_2ND);
+	if (!a34w_poll(a34w_ap, SPM_PWR_STATUS, 1, 1, 1000, 10) || !a34w_poll(a34w_ap, SPM_PWR_STATUS_2ND, 1, 1, 1000, 10)) {
+		a34w_say("step 2: CONN MTCMOS: no power ack (CONN_PWR_CON 0x%08x PWR_STATUS 0x%08x/0x%08x)",
+		    a34w_rd(a34w_ap, SPM_CONN_PWR_CON), a34w_rd(a34w_ap, SPM_PWR_STATUS), a34w_rd(a34w_ap, SPM_PWR_STATUS_2ND));
+		return false;
+	}
+	a34w_clr(a34w_ap, SPM_CONN_PWR_CON, PWR_CLK_DIS);
+	delay(1);
+	a34w_clr(a34w_ap, SPM_CONN_PWR_CON, PWR_ISO);
+	/* TOPRGU's CONNSYS software reset (WDT_SWSYSRST bit 9, key 0x88), as the manual flow of mt6877_pos.c */
+	v = a34w_rd(a34w_ap, TOPRGU_WDT_SWSYSRST);
+	if (v & (1u << 9)) {
+		a34w_wr(a34w_ap, TOPRGU_WDT_SWSYSRST, (v & ~0xff000200u) | 0x88000000u);
+	}
+	a34w_set(a34w_ap, SPM_CONN_PWR_CON, PWR_RST_B);
+	delay(500);
+	a34w_say("step 2: CONN MTCMOS on: CONN_PWR_CON 0x%08x PWR_STATUS 0x%08x/0x%08x OTHER 0x%08x, SWSYSRST 0x%08x -> 0x%08x",
+	    a34w_rd(a34w_ap, SPM_CONN_PWR_CON), a34w_rd(a34w_ap, SPM_PWR_STATUS), a34w_rd(a34w_ap, SPM_PWR_STATUS_2ND),
+	    a34w_rd(a34w_ap, SPM_OTHER_PWR_STATUS), v, a34w_rd(a34w_ap, TOPRGU_WDT_SWSYSRST));
+
+	/* bus protection released (spm_mtcmos_ctrl_conn_bus_prot(STA_RELEASE_BUS)): step 2, then step 1 */
+	a34w_wr(a34w_ap, INFRA_PROTECTEN_CLR, CONN_PROT_STEP2);
+	a34w_wr(a34w_ap, INFRA_PROTECTEN_CLR, CONN_PROT_STEP1);
+	for (uint32_t i = 0; i < 100u && (a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1) & CONN_PROT_AP2CONN); i++) {
+		delay(500);
+	}
+	a34w_say("step 2: bus protection released: PROTECTEN 0x%08x STA1 0x%08x", a34w_rd(a34w_ap, INFRA_PROTECTEN),
+	    a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1));
+	if (a34w_rd(a34w_ap, INFRA_PROTECTEN_STA1) & CONN_PROT_AP2CONN) {
+		a34w_say("step 2: AP-to-CONNSYS protection still on (STA1 bits 13/19): CONNSYS not read");
+		return false;
+	}
+	delay(5000);            /* "Wait 5ms (apply this for CONNSYS XO clock ready)" */
+
+	/* consys_polling_chipid_mt6877(): 10 tries, 1 ms apart */
+	for (uint32_t i = 0; i < 10u; i++) {
+		v = a34w_rd(a34w_conn, CONN_CFG_IP_VERSION);
+		if (v == CONN_HW_VER) {
+			a34w_say("step 2: conn_infra IP version 0x%08x (expected 0x%08x): CONNSYS is on", v, CONN_HW_VER);
+			return true;
+		}
+		delay(1000);
+	}
+	a34w_say("step 2: conn_infra IP version 0x%08x, not 0x%08x", v, CONN_HW_VER);
+	return false;
+}
+
+/* ---- step 3: conn_infra set up (consys_hw_pwr_on, part 3), then Wi-Fi's rails ---- */
+
+static void
+a34w_emi_remap(void)
+{
+	/* consys_emi_set_remapping_reg_mt6877(): the EMI base's bits [35:16]; the peripherals at 0x10000000 */
+	a34w_mask(a34w_conn, CONN_HOST_REMAP_MCU_EMI, 0xfffffu, (uint32_t)(A34W_EMI_PA >> 16));
+	a34w_mask(a34w_conn, CONN_HOST_REMAP_WF_PERI, 0xfffffu, 0x01000u);
+	a34w_mask(a34w_conn, CONN_HOST_REMAP_BT_PERI, 0xfffffu, 0x01000u);
+	a34w_mask(a34w_conn, CONN_HOST_REMAP_GPS_PERI, 0xfffffu, 0x01000u);
+	a34w_say("step 3: EMI at 0x%llx (%u KB), remap 0x%08x, WF peripherals 0x%08x",
+	    (unsigned long long)A34W_EMI_PA, A34W_EMI_SIZE >> 10, a34w_rd(a34w_conn, CONN_HOST_REMAP_MCU_EMI),
+	    a34w_rd(a34w_conn, CONN_HOST_REMAP_WF_PERI));
+}
+
+static void
+a34w_d_die_cfg(void)
+{
+	for (uint32_t off = 0; off < CONN_SYSRAM_SIZE; off += 4u) {
+		a34w_wr(a34w_conn, CONN_SYSRAM + off, 0);
+	}
+	a34w_wr(a34w_conn, CONN_BUS_EMI_PATH_START, 0x04000000u);
+	a34w_wr(a34w_conn, CONN_BUS_EMI_PATH_END, 0x43ffffffu);
+	a34w_wr(a34w_conn, SYSRAM_D_DIE_EFUSE, a34w_rd(a34w_conn, CONN_CFG_EFUSE));
+	a34w_wr(a34w_conn, CONN_RGU_SYSRAM_HWCTL_PDN, 0);
+	a34w_wr(a34w_conn, CONN_RGU_SYSRAM_HWCTL_SLP, 1);
+	a34w_wr(a34w_conn, CONN_RGU_CO_EXT_MEM_HWCTL_PDN, 0);
+	a34w_wr(a34w_conn, CONN_RGU_CO_EXT_MEM_HWCTL_SLP, 1);
+}
+
+static void
+a34w_spi_master_cfg(void)
+{
+	/* the addresses of the A-die's registers the sleep controller drives (Wi-Fi on: not "BT only") */
+	a34w_mask(a34w_conn, CONN_WT_WF_CK_ADDR, 0x0fff0fffu, (0xaf4u << 16) | 0xa04u);
+	a34w_mask(a34w_conn, CONN_WT_WF_WAKE_ADDR, 0x0fff0fffu, (0x0a0u << 16) | 0x090u);
+	a34w_mask(a34w_conn, CONN_WT_WF_ZPS_ADDR, 0x0fff0fffu, (0x09cu << 16) | 0x08cu);
+	a34w_mask(a34w_conn, CONN_WT_BT_CK_ADDR, 0xfffu, 0xa08u);
+	a34w_mask(a34w_conn, CONN_WT_BT_WAKE_ADDR, 0xfffu, 0x094u);
+	a34w_mask(a34w_conn, CONN_WT_TOP_CK_ADDR, 0xfffu, 0x02cu);
+	a34w_mask(a34w_conn, CONN_WT_GPS_CK_ADDR, 0x0fff0fffu, (0xafcu << 16) | 0xa0cu);
+	a34w_mask(a34w_conn, CONN_WT_WF_B0_CMD_ADDR, 0xfffu, 0x0f0u);
+	a34w_mask(a34w_conn, CONN_WT_WF_B1_CMD_ADDR, 0xfffu, 0x0f4u);
+	a34w_mask(a34w_conn, CONN_WT_GPS_RFBUF_ADR, 0xfffu, 0x0fcu);
+	a34w_mask(a34w_conn, CONN_WT_GPS_L5_EN_ADDR, 0xfffu, 0x0f8u);
+	a34w_mask(a34w_conn, CONN_WT_SLP_CTL, 0x1fu, 0x8u);
+
+	static const uint16_t bg_addr[8] = { 0xa03c, 0xa03c, 0xaa18, 0xaa18, 0xa0c8, 0xaa00, 0xa0b4, 0xa34c };
+	static const uint32_t bg_on[8] = { 0, 0, 0x74e0fff5u, 0x76e8fff5u, 0, 0xffffffffu, 0x00000019u, 0x00010400u };
+	static const uint32_t bg_off[8] = { 0x57400000u, 0x57400000u, 0x44e0fff5u, 0x44e0fff5u, 0x00000001u, 0,
+		                            0x00040019u, 0x00410440u };
+	for (uint32_t n = 1; n <= 8u; n++) {
+		a34w_mask(a34w_conn, CONN_WT_BG_ADDR(n), 0xffffu, bg_addr[n - 1u]);
+		a34w_wr(a34w_conn, CONN_WT_BG_ON(n), bg_on[n - 1u]);
+		a34w_wr(a34w_conn, CONN_WT_BG_OFF(n), bg_off[n - 1u]);
+	}
+}
