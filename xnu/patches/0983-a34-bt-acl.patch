+/* (0983) the ACL path: what went each way, completed, outstanding; said every 10 s with traffic */
+static void
+br_acl_count(const uint8_t *p, uint32_t n, bool out)
+{
+	if (p[0] == 0x02 && n >= 5) {
+		bool sig = n >= 9 && (p[2] & 0x30) != 0x10 && p[7] == 0x01 && p[8] == 0x00;
+
+		if (br_acl.start_ms == 0) {
+			br_acl.start_ms = bt_ms();
+			br_acl.last_done_ms = bt_ms();
+		}
+		if (out) {
+			br_acl.out_pkts++;
+			br_acl.out_bytes += n;
+			br_acl.sig_out += sig ? 1u : 0u;
+			br_acl.outstanding++;
+		} else {
+			br_acl.in_pkts++;
+			br_acl.in_bytes += n;
+			br_acl.sig_in += sig ? 1u : 0u;
+		}
+	} else if (!out && n >= 4 && p[0] == 0x04 && p[1] == 0x13) {    /* Number Of Completed Packets */
+		uint32_t handles = p[3], done = 0;
+
+		for (uint32_t k = 0; k < handles && 4 + 4 * k + 3 < n; k++) {
+			done += (uint32_t)(p[4 + 4 * k + 2] | (p[4 + 4 * k + 3] << 8));
+		}
+		br_acl.completed += done;
+		br_acl.outstanding -= (int32_t)done;
+		br_acl.last_done_ms = bt_ms();
+		br_acl.stall_said = false;
+	} else if (!out && n >= 13 && p[0] == 0x04 && p[1] == 0x0e && p[4] == 0x05 && p[5] == 0x10 && p[6] == 0) {
+		br_acl.buffers = (uint16_t)(p[10] | (p[11] << 8));        /* Read_Buffer_Size: Total_Num_ACL_Data_Packets */
+	} else if (!out && n >= 7 && p[0] == 0x04 && p[1] == 0x05) {     /* Disconnection Complete */
+		printf("A34 BT: br: Disconnection Complete: status %#x, handle %#x, reason %#x; ACL outstanding %d\n", p[3],
+		    (unsigned)(p[4] | ((p[5] & 0x0f) << 8)), p[6], br_acl.outstanding);
+		br_acl.outstanding = 0;                         /* (its packets are the controller's to forget) */
+		br_ring_pending = true;
+	}
+}
+
+static void
+br_acl_say(void)
+{
+	uint32_t now = bt_ms();
+
+	if (br_acl.start_ms == 0) {
+		return;
+	}
+	if (!br_acl.stall_said && br_acl.buffers != 0 && br_acl.outstanding >= (int32_t)br_acl.buffers &&
+	    now - br_acl.last_done_ms > 2000) {
+		br_acl.stall_said = true;
+		printf("A34 BT: br: ACL stalled: all %u of the controller's buffers out, none completed for %u ms\n",
+		    br_acl.buffers, now - br_acl.last_done_ms);
+	}
+	if (now - br_acl.start_ms < 10000) {
+		return;
+	}
+	printf("A34 BT: br: ACL in %u s: out %u packets (%u bytes, %u L2CAP signalling), in %u (%u bytes, %u signalling); "
+	    "the controller completed %u, %d outstanding of %u buffers\n", (now - br_acl.start_ms) / 1000, br_acl.out_pkts,
+	    br_acl.out_bytes, br_acl.sig_out, br_acl.in_pkts, br_acl.in_bytes, br_acl.sig_in, br_acl.completed,
+	    br_acl.outstanding, br_acl.buffers);
+	br_acl.out_pkts = br_acl.out_bytes = br_acl.in_pkts = br_acl.in_bytes = br_acl.completed = 0;
+	br_acl.sig_out = br_acl.sig_in = 0;
+	br_acl.start_ms = (br_acl.outstanding != 0) ? now : 0;
+}
+
+/*
+ * (0983) one packet from the controller on its way to bluetoothd: counted, logged, fixed up, delivered. nested: it
+ * came while the kernel waited for an answer of its own (bt_command), so nothing here sends a command again.
+ */
+static void
+br_event_in(uint8_t *a, uint32_t n, bool nested)
+{
+	br_answered(a, n);
+	br_acl_count(a, n, false);
+	if (n >= 4 && a[0] == 0x04 && a[1] == 0x3e && (a[3] == 0x02 || a[3] == 0x0d)) {
+		br_le_heard(a, n);                              /* (counted every 10 s, not each in the log) */
+	} else {
+		br_dump("br<", a, n);
+	}
+	if (!nested && n >= 7 && a[0] == 0x04 && a[1] == 0x0e && a[4] == 0x03 && a[5] == 0x0c && a[6] == 0) {
+		/* HCI_Reset done: the phone's address again before whoever reset it is told (0970) */
+		uint8_t reset[BT_PKT_MAX];
+
+		memcpy(reset, a, n);
+		(void)bt_addr_apply("after an HCI_Reset");
+		memcpy(a, reset, n);
+	}
+	if (!nested) {
+		br_scan_event(a, n);                            /* (0975) */
+	}
+	n = br_xl_event(a, n);                                  /* (0976) */
+	if (n != 0) {
+		n = br_dup_report(a, n);                        /* (0979) */
+	}
+	if (n != 0) {
+		br_quirks(a, n);
+		a34_btsk_deliver(a, n);
+		bt_deliver(a, n);
+	}
+}
