+/*
+ * A34 (1005): the panel's level along Samsung's own curve. 1004 made DBV
+ * linear in nits and the user found the slider changed "a very small
+ * amount": Samsung's DBV is not linear in luminance -- its platform levels
+ * 0..255 (a perceptual scale) map to DBV through S6E3FC5_SDC_BRIGHTNESS
+ * (a34x_s6e3fc5_sdc_param_brightness.h, Samsung's GPL panel driver), which
+ * puts level 128 at DBV 0x1A5. Samsung's driver has no nits table for this
+ * panel. CoreBrightness's level (0..1 of 65536) is taken as Samsung's
+ * platform level 0..255, so the slider spans the panel's whole normal range,
+ * 0x002 (about 2 nits) to 0x3FF; DBV comes from these 17 points of
+ * Samsung's table (every 16th level and 255; within 4 DBV of the table).
+ * CoreAnimation is told other nits (blNits16, a34blmin..a34blmax), kept
+ * above its luma boost and overdrive-fix limits.
+ */
+static const uint16_t sweet_fb_bl_ui_dbv[17] = {
+	0x002, 0x01e, 0x047, 0x077, 0x0ac, 0x0e5, 0x122, 0x162, 0x1a5, 0x1e9, 0x230, 0x27a, 0x2c5, 0x312, 0x361, 0x3b2, 0x3ff
+};
+
+static uint32_t
+sweet_fb_bl_dbv(uint32_t level)
+{
+	/* the platform level in 1/256 steps: level * 255 / 65536, times 256 */
+	uint32_t ui256 = (uint32_t)(((uint64_t)(level > SWEET_FB_BL_MAX ? SWEET_FB_BL_MAX : level) * 255 * 256) /
+	    SWEET_FB_BL_MAX);
+	uint32_t i = ui256 / (16 * 256), lo, hi, x0, x1, dbv;
+
+	if (i >= 15) {
+		i = 15;         /* the last segment is 240..255 */
+	}
+	x0 = i * 16 * 256;
+	x1 = (i == 15 ? 255 : (i + 1) * 16) * 256;
+	lo = sweet_fb_bl_ui_dbv[i];
+	hi = sweet_fb_bl_ui_dbv[i + 1];
+	dbv = lo + (uint32_t)(((uint64_t)(hi - lo) * (ui256 - x0) + (x1 - x0) / 2) / (x1 - x0));
+	return dbv < SWEET_FB_BL_DBV_MIN ? SWEET_FB_BL_DBV_MIN : (dbv > SWEET_FB_BL_DBV_MAX ? SWEET_FB_BL_DBV_MAX : dbv);
+}
