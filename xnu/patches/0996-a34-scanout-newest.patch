+/*
+ * A34 (0996): without waiting, whether the GPU is done with a surface: the
+ * driver's 0x7c mark gone (or stale), every queued job that names it done.
+ * AppleCLCD's kick picks the newest such scan-out frame at each TE.
+ */
+bool
+a34_mali_surface_done(SweetSurface *surface)
+{
+	uint64_t mark = __atomic_load_n(&surface->gpuPendingSince, __ATOMIC_ACQUIRE), busy = surface->gpuBusySeq, stale;
+	bool done = true;
+
+	if (mark != 0) {
+		nanoseconds_to_absolutetime(A34_PENDING_STALE_NS, &stale);
+		if (mach_absolute_time() - mark < stale) {
+			return false;
+		}
+	}
+	if (gA34MaliQLock == NULL || busy == 0) {
+		return true;
+	}
+	IOLockLock(gA34MaliQLock);
+	done = a34_q_done() >= busy;
+	IOLockUnlock(gA34MaliQLock);
+	return done;
+}
+
+/* A34 (0996): asleep until the next queued job is done, `us` at most (the kick waiting for a frame to be drawn). */
+void
+a34_mali_progress_wait(uint32_t us)
+{
+	uint64_t deadline;
+
+	if (gA34MaliQLock == NULL) {
+		IODelay(us);
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)us * 1000ull, &deadline);
+	deadline += mach_absolute_time();
+	IOLockLock(gA34MaliQLock);
+	(void)IOLockSleepDeadline(gA34MaliQLock, &gA34MaliQDone, deadline, THREAD_UNINT);
+	IOLockUnlock(gA34MaliQLock);
+}
