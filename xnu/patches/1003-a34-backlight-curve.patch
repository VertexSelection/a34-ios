+#define SWEET_FB_BL_SAY         24u     /* requests logged one by one, then a line every 2 s at most */
+
+uint32_t
+AppleCLCD::blNits16(uint32_t level)
+{
+	uint64_t l = level > SWEET_FB_BL_MAX ? SWEET_FB_BL_MAX : level;
+	uint64_t span = (uint64_t)(fBLMax > fBLMin ? fBLMax - fBLMin : 0) << 16;
+
+	return (uint32_t)(((uint64_t)fBLMin << 16) + span * l / SWEET_FB_BL_MAX * l / SWEET_FB_BL_MAX);
+}
+
+/* A34 (1003): a level CoreBrightness set (on CoreBrightness's thread); a summary line every 2 s at most */
+void
+AppleCLCD::blLevel(uint32_t level, const char *who)
+{
+	uint64_t now = mach_absolute_time(), every;
+
+	if (level == fBLValue) {
+		return;
+	}
+	fBLValue = level;
+	nanoseconds_to_absolutetime(2ull * NSEC_PER_SEC, &every);
+	if (fBLSaidAt == 0 || now - fBLSaidAt >= every) {
+		uint32_t n16 = blNits16(level);
+
+		fBLSaidAt = now;
+		IOLog("A34 BL: level %u of %u from %s: %u.%02u nits on the curve (%u..%u)\n", level, SWEET_FB_BL_MAX, who,
+		    n16 >> 16, (uint32_t)(((uint64_t)(n16 & 0xffffu) * 100) >> 16), fBLMin, fBLMax);
+	}
+}
 
