+/*
+ * ---- (1011) RX reordering ----
+ * With a block ack agreement (the firmware takes the AP's ADDBA itself and says so with
+ * EVENT_ID_RX_ADDBA: TID, window, starting sequence number) the AP's A-MPDUs can arrive with
+ * frames out of order or retried late; they go up in sequence order, as que_mgt.c does it: a
+ * frame inside the window is held until the ones before it have come, one beyond it moves the
+ * window on (handing up what it passes), an old one is dropped; a hole is given up after 100 ms.
+ * The sequence number is in RX group 4 (frame control, TA, sequence control), the TID in RXD DW2.
+ */
+#define REORDER_SLOTS                   64u
+#define REORDER_HOLD_MS                 100u
+
+struct a34w_reorder {
+	bool active;
+	uint16_t head;                  /* the sequence number to hand up next */
+	uint16_t size;                  /* the window (ADDBA's buffer size, at most 64) */
+	uint16_t held;
+	uint64_t since;                 /* when the oldest frame held now came */
+	uint8_t *frames;                /* REORDER_SLOTS frames of FRAME_MOST bytes, made at the first ADDBA */
+	uint16_t length[REORDER_SLOTS];
+	bool have[REORDER_SLOTS];
+};
+static struct a34w_reorder a34w_ro[8];
+static uint64_t a34w_ro_late, a34w_ro_timeouts, a34w_ro_reordered;
+
+static void
+a34w_up(const uint8_t *eth, uint32_t length)
+{
+	if (a34w_eth_input != NULL && a34w_joined) {
+		a34w_eth_input(eth, length);
+	}
+}
+
+/* the held frame of sequence number r->head, if any, up; the head on */
+static void
+a34w_ro_step(struct a34w_reorder *r)
+{
+	uint32_t slot = r->head % REORDER_SLOTS;
+
+	if (r->have[slot]) {
+		a34w_up(r->frames + slot * FRAME_MOST, r->length[slot]);
+		r->have[slot] = false;
+		r->held--;
+	}
+	r->head = (uint16_t)((r->head + 1u) & 0xfffu);
+}
+
+/* everything held from the head on that is in order, up */
+static void
+a34w_ro_release(struct a34w_reorder *r)
+{
+	while (r->have[r->head % REORDER_SLOTS]) {
+		a34w_ro_step(r);
+	}
+	r->since = r->held != 0 ? a34w_ms() : 0;
+}
+
+static void
+a34w_ro_start(uint32_t tid, uint16_t ssn, uint32_t size)
+{
+	struct a34w_reorder *r = &a34w_ro[tid & 7u];
+
+	if (r->frames == NULL) {
+		r->frames = kalloc_data(REORDER_SLOTS * FRAME_MOST, Z_WAITOK);
+		if (r->frames == NULL) {
+			return;
+		}
+	}
+	while (r->active && r->held != 0) {             /* (an agreement again: what is held goes up first) */
+		a34w_ro_step(r);
+	}
+	bzero(r->have, sizeof(r->have));
+	r->held = 0;
+	r->since = 0;
+	r->head = ssn & 0xfffu;
+	r->size = (uint16_t)(size == 0 || size > REORDER_SLOTS ? REORDER_SLOTS : size);
+	r->active = true;
+}
+
+static void
+a34w_ro_stop(uint32_t tid)
+{
+	struct a34w_reorder *r = &a34w_ro[tid & 7u];
+
+	while (r->active && r->held != 0) {
+		a34w_ro_step(r);
+	}
+	r->active = false;
+}
+
+/* (link lost) nothing held goes up any more */
+static void
+a34w_ro_reset(void)
+{
+	for (uint32_t t = 0; t < 8u; t++) {
+		bzero(a34w_ro[t].have, sizeof(a34w_ro[t].have));
+		a34w_ro[t].held = 0;
+		a34w_ro[t].active = false;
+	}
+}
+
+/*
+ * `follows`: a later subframe of an A-MSDU (RXD DW3 payload format 1 or 2), with the sequence number
+ * of the first: it goes up as it is, after or (rarely, if the first is held) before its first
+ * (we tell the firmware no A-MSDU in A-MPDU, so these should not come under an agreement at all).
+ */
+static void
+a34w_ro_in(uint32_t tid, uint16_t sn, bool follows, const uint8_t *eth, uint32_t length)
+{
+	struct a34w_reorder *r = &a34w_ro[tid & 7u];
+	uint32_t d = (uint32_t)(sn - r->head) & 0xfffu, slot = sn % REORDER_SLOTS;
+
+	if (follows && (d >= 2048u || r->have[slot])) {
+		a34w_up(eth, length);
+		return;
+	}
+	if (d >= 2048u) {                               /* behind the window: late or a retry already handed up */
+		a34w_ro_late++;
+		return;
+	}
+	if (d >= r->size) {                             /* beyond it: the window moves on, what it passes goes up */
+		uint16_t to = (uint16_t)((sn - r->size + 1u) & 0xfffu);
+
+		while (r->head != to) {
+			a34w_ro_step(r);
+		}
+	}
+	if (r->have[slot]) {
+		a34w_ro_late++;                         /* (the same frame twice) */
+		return;
+	}
+	if (sn != r->head) {
+		a34w_ro_reordered++;
+	}
+	memcpy(r->frames + slot * FRAME_MOST, eth, length);
+	r->length[slot] = (uint16_t)length;
+	r->have[slot] = true;
+	r->held++;
+	if (r->since == 0) {
+		r->since = a34w_ms();
+	}
+	a34w_ro_release(r);
+}
+
+/* (the thread, every 2 ms) a hole held for longer than REORDER_HOLD_MS is given up */
+static void
+a34w_ro_timeouts_check(void)
+{
+	for (uint32_t t = 0; t < 8u; t++) {
+		struct a34w_reorder *r = &a34w_ro[t];
+
+		if (r->active && r->held != 0 && a34w_ms() - r->since >= REORDER_HOLD_MS) {
+			while (!r->have[r->head % REORDER_SLOTS]) {
+				r->head = (uint16_t)((r->head + 1u) & 0xfffu);
+			}
+			a34w_ro_timeouts++;
+			a34w_ro_release(r);
+		}
+	}
+}
