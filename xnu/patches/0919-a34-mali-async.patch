+	if (gA34MaliQLock == NULL) {
+		return;
+	}
+	IOLockLock(gA34MaliQLock);
+	fClosing = true;
+	gA34MaliQTail = NULL;
+	for (link = &gA34MaliQHead; (j = *link) != NULL;) {
+		if (j->client == this) {
+			*link = j->next;
+			j->next = dropped;
+			dropped = j;
+			gA34MaliQDepth--;
+		} else {
+			gA34MaliQTail = j;
+			link = &j->next;
+		}
+	}
+	while (gA34MaliQRunning != NULL && gA34MaliQRunning->client == this) {
+		(void)IOLockSleep(gA34MaliQLock, &gA34MaliQDone, THREAD_UNINT);
+	}
+	fDoneSeq = fLastSeq;
+	fAsync = false;
+	IOLockWakeup(gA34MaliQLock, &gA34MaliQDone, false);     /* (the order is done further now, and its waiters are) */
+	IOLockUnlock(gA34MaliQLock);
+	while ((j = dropped) != NULL) {
+		dropped = j->next;
+		a34_qjob_free(j);
+		release();                      /* (the caller holds the client) */
 	}
 }
 
