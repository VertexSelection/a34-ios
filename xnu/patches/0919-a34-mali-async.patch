+/*
+ * A34 (0919): queued jobs.
+ *
+ * A client that asks for it (SET_MODE 0x7a, async = 1; boot-arg
+ * a34maliasync=0 refuses) has its SUBMITs queued: SUBMIT checks the
+ * request, copies bo_handles in, queues the job and returns at once, the
+ * job's number (the client's own count from 1) in in_syncs. One kernel
+ * thread (worker()) takes the jobs of every such client in the order they
+ * were queued and runs each as a synchronous SUBMIT runs: gA34MaliLock held
+ * for the cache upkeep before, a34_mali_submit() (start, wait, recover) and
+ * the upkeep and accounts after. That call waits as it always did: polled
+ * every 10 us for the first half millisecond of a job, then asleep 200 us
+ * at a time; between jobs the lock is free, and with no job queued the
+ * thread sleeps. (Not the GPU's JOB interrupt, INTID 487. It could be
+ * taken: RubyGICInterruptController registers a level SPI for a service
+ * that carries IOInterruptControllers/IOInterruptSpecifiers, as SweetKPD
+ * does. But it is a level interrupt that the handler has to quiet at the
+ * GPU, JOB_INT_MASK is 0 and every reset and recovery would have to keep
+ * it, the GIC's line 487 has never been programmed here, and a mistake in
+ * any of that is an interrupt storm, a phone that hangs. Polling adds at
+ * most 10 us to a job and is what the phone has run so far.)
+ *
+ * Other clients' SUBMITs stay synchronous and take the lock as before;
+ * every job of one client is either queued or not (SET_MODE back to 0
+ * waits for its queue), so the order within a client holds.
+ *
+ * Two locks. gA34MaliLock: the GPU, its address space and the handle
+ * tables, held for the whole of a job. gA34MaliQLock: the queue, each
+ * client's job numbers, and of each buffer the last queued job that names
+ * it (busySeq) and its MADVISE state; never held across a job, taken after
+ * gA34MaliLock where both are, and nobody sleeps on the queue with
+ * gA34MaliLock held (the worker needs it to get anywhere). A queuing
+ * client's SUBMIT, WAIT_BO, MADVISE and WAIT_SEQ take only gA34MaliQLock:
+ * they do not wait for the job that is running.
+ *
+ * Every queued job has a place in one order of all of them (gseq). "Done up
+ * to": one less than the place of the job running or first in the queue,
+ * or the last place given out when there is none. A buffer or surface is
+ * busy while the queue is not done up to its busySeq: GEM_CLOSE and client
+ * close wait for that before the pages leave the GPU's tables (a closing
+ * client's queued jobs are dropped, the running one waited for), WAIT_BO
+ * answers by it, and so does the CPU's side of a surface
+ * (a34_mali_surface_idle(): IOSurfaceLock and AppleCLCD's copy wait for the
+ * jobs that name the surface).
+ */
+class RedwoodMaliUserClient;
+
+struct a34_qjob {
+	struct a34_qjob *next;
+	RedwoodMaliUserClient *client;  /* held until the job is done or dropped */
+	uint32_t *handles;              /* SUBMIT's bo_handles, copied in (NULL: all) */
+	uint32_t nhandles;
+	uint32_t depth;                 /* jobs ahead of it when it was queued */
+	bool all;                       /* the list could not be read: every buffer counts as named */
+	bool failed;
+	uint64_t seq;                   /* the client's number for it (WAIT_SEQ) */
+	uint64_t gseq;                  /* its place in the order of every client's queued jobs */
+	uint64_t queued;                /* mach time it was queued */
+	struct a34_mali_job job;
+};
+
+static IOLock *gA34MaliQLock;
+static struct a34_qjob *gA34MaliQHead, *gA34MaliQTail, *gA34MaliQRunning;
+static uint64_t gA34MaliQSeq;                   /* the last place given out */
+static uint32_t gA34MaliQDepth;                 /* jobs queued and not yet running */
+static uint32_t gA34MaliAsync = 1;              /* boot-arg a34maliasync=0: SET_MODE is refused, every SUBMIT synchronous */
+static volatile SInt32 gA34MaliWaiters;         /* threads waiting for gA34MaliLock, the worker not counted */
+static int gA34MaliQWork, gA34MaliQDone;        /* what the worker, and who waits for jobs, sleep on */
+static void a34_mali_worker(void *arg, wait_result_t result) __attribute__((noreturn));  /* (RedwoodMaliUserClient::worker()) */
+
+/*
+ * gA34MaliLock for everything but the worker's next job. The lock is not
+ * fair: the worker, back for its next job a microsecond after it let go,
+ * would take it again before a thread it has just woken has run. So such
+ * threads are counted, and the worker lets them go first (worker()).
+ */
+static void
+a34_gpu_lock(void)
+{
+	OSIncrementAtomic(&gA34MaliWaiters);
+	IOLockLock(gA34MaliLock);
+	OSDecrementAtomic(&gA34MaliWaiters);
+}
+
+/* The queue's lock, where gA34MaliLock is held too (a34maliasync=0: there is none, and nothing is queued). */
+static void
+a34_q_lock(void)
+{
+	if (gA34MaliQLock != NULL) {
+		IOLockLock(gA34MaliQLock);
+	}
+}
+
+static void
+a34_q_unlock(void)
+{
+	if (gA34MaliQLock != NULL) {
+		IOLockUnlock(gA34MaliQLock);
+	}
+}
+
+/* With the queue lock held: every queued job up to this place in the order is done (or was dropped). */
+static uint64_t
+a34_q_done(void)
+{
+	if (gA34MaliQRunning != NULL) {
+		return gA34MaliQRunning->gseq - 1;
+	}
+	if (gA34MaliQHead != NULL) {
+		return gA34MaliQHead->gseq - 1;
+	}
+	return gA34MaliQSeq;
+}
+
+/*
+ * With the queue lock held (let go of while asleep): until the queue is done
+ * up to `gseq`, for at most `ns` (0: only look; A34_FOREVER: no limit).
+ * THREAD_AWAKENED: it is; THREAD_TIMED_OUT; THREAD_INTERRUPTED (only with
+ * THREAD_ABORTSAFE: the thread is to go).
+ */
+static int
+a34_q_wait(uint64_t gseq, uint64_t ns, UInt32 interruptible)
+{
+	uint64_t deadline = 0;
+	int res;
+
+	if (ns != 0 && ns != A34_FOREVER) {
+		nanoseconds_to_absolutetime(ns, &deadline);
+		deadline += mach_absolute_time();
+	}
+	while (a34_q_done() < gseq) {
+		if (ns == 0) {
+			return THREAD_TIMED_OUT;
+		}
+		if (ns == A34_FOREVER) {
+			res = IOLockSleep(gA34MaliQLock, &gA34MaliQDone, interruptible);
+		} else {
+			res = IOLockSleepDeadline(gA34MaliQLock, &gA34MaliQDone, deadline, interruptible);
+		}
+		if (res != THREAD_AWAKENED) {
+			return a34_q_done() >= gseq ? THREAD_AWAKENED : (res == THREAD_TIMED_OUT ? THREAD_TIMED_OUT : THREAD_INTERRUPTED);
+		}
+	}
+	return THREAD_AWAKENED;
+}
+
+static void
+a34_qjob_free(struct a34_qjob *j)
+{
+	if (j->handles != NULL) {
+		IOFreeData(j->handles, j->nhandles * sizeof(uint32_t));
+	}
+	IODelete(j, struct a34_qjob, 1);
+}
+
+/*
+ * SweetSurface.h: before the CPU reads or writes a surface the GPU uses
+ * (IOSurfaceLock, AppleCLCD's copy to the panel): wait, at most `ms`, for
+ * the queued jobs that name it, or the CPU sees a picture half drawn.
+ * False: they were not done in that time (said in the log a few times).
+ */
+bool
+a34_mali_surface_idle(SweetSurface *surface, uint32_t ms)
+{
+	static uint32_t said;
+	uint64_t busy = surface->gpuBusySeq;
+	bool idle = true;
+
+	if (gA34MaliQLock == NULL || busy == 0) {
+		return true;
+	}
+	IOLockLock(gA34MaliQLock);
+	if (a34_q_done() < busy) {
+		idle = a34_q_wait(busy, (uint64_t)ms * NSEC_PER_MSEC, THREAD_UNINT) == THREAD_AWAKENED;
+	}
+	IOLockUnlock(gA34MaliQLock);
+	if (!idle && said < 8) {
+		said++;
+		IOLog("A34 MALI UC: surface %u: the jobs that name it were not done in %u ms; the CPU goes on\n", surface->id, ms);
+	}
+	return idle;
+}
