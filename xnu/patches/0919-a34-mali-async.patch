+/*
+ * With the lock held: one job chain run to its end, with the cache upkeep
+ * before and after it, the accounts and what the log gets; what SUBMIT
+ * answers. The buffers it names are marked (markListed(), runQueued()) or
+ * `all`; t0: the mach time the marking began. A34 (0919): the same for a
+ * synchronous SUBMIT (q NULL, in the caller's thread) and a queued job (in
+ * the worker's).
+ */
+IOReturn
+RedwoodMaliUserClient::runChain(struct a34_mali_job *job, bool all, uint64_t t0, const struct a34_qjob *q)
+{
+	uint64_t ticks, cleaned, flushed;
+	uint32_t n = ++fSubmits;
+	IOReturn ret = kIOReturnSuccess;
+	bool done;
+
+	/* A34 (0915): only what the CPU and this job can both touch (upkeep()) */
+	cleaned = upkeep(true, all);            /* the program's writes to memory for the GPU */
+	ticks = mach_absolute_time() - t0;
+	done = a34_mali_submit(job);
+	t0 = mach_absolute_time();
+	flushed = upkeep(false, all);           /* and no stale lines over what the GPU wrote */
+	ticks += mach_absolute_time() - t0;
+	if (q != NULL) {
+		uint64_t waited = mach_absolute_time() - q->queued;
+
+		fWinQJobs++;
+		fWinQDepth += q->depth;
+		if (q->depth > fWinQDepthMax) {
+			fWinQDepthMax = q->depth;
+		}
+		fWinQWait += waited;
+		if (waited > fWinQWaitMax) {
+			fWinQWaitMax = waited;
+		}
+	}
+	upkeepLog(n, job->requirements, cleaned, flushed, ticks, job->ns);
+	if (!done) {
+		fFailed++;
+		IOLog("A34 MALI UC: %s: job chain %u at 0x%llx (%s) failed after %llu us: JOB_INT 0x%08x JS_STATUS 0x%08x MMU_INT 0x%08x\n",
+		    fName, n, (unsigned long long)job->jc, (job->requirements & PANFROST_JD_REQ_FS) ? "fragment" : "vertex/tiler/compute",
+		    (unsigned long long)(job->ns / 1000), job->job_raw, job->js_status, job->mmu_raw);
+		if (job->mmu_raw != 0) {
+			describeFault(job->fault_va);
+		}
+		ret = a34_mali_ready() ? kIOReturnIOError : kIOReturnNotReady;
+	}
+	return ret;
+}
+
+/* A34 (0919). The worker's: a queued job run as a SUBMIT is. Takes the lock itself. */
+void
+RedwoodMaliUserClient::runQueued(struct a34_qjob *j)
+{
+	IOLockLock(gA34MaliLock);       /* (not a34_gpu_lock(): the worker is who those go before) */
+	if (fBos != NULL && fOpen && !fClosed) {
+		uint64_t t0 = mach_absolute_time();
+
+		for (uint32_t i = 0; !j->all && i < j->nhandles; i++) {
+			struct a34_bo *b = lookup(j->handles[i]);
+
+			if (b != NULL) {
+				b->state |= A34_BO_LISTED;
+			}
+		}
+		j->failed = runChain(&j->job, j->all, t0, j) != kIOReturnSuccess;
+	} else {
+		j->failed = true;
+	}
+	IOLockUnlock(gA34MaliLock);
+}
+
+/*
+ * A34 (0919): the thread that runs the queued jobs of every client, one at a
+ * time in the order they were queued, asleep while there is none.
+ */
+void
+RedwoodMaliUserClient::worker(__unused void *arg, __unused wait_result_t result)
+{
+	for (;;) {
+		struct a34_qjob *j;
+		RedwoodMaliUserClient *c;
+
+		IOLockLock(gA34MaliQLock);
+		while (gA34MaliQHead == NULL) {
+			(void)IOLockSleep(gA34MaliQLock, &gA34MaliQWork, THREAD_UNINT);
+		}
+		j = gA34MaliQHead;
+		gA34MaliQHead = j->next;
+		if (gA34MaliQHead == NULL) {
+			gA34MaliQTail = NULL;
+		}
+		j->next = NULL;
+		gA34MaliQDepth--;
+		gA34MaliQRunning = j;
+		IOLockUnlock(gA34MaliQLock);
+		/* whoever waits for the GPU's lock to make, map or close a buffer goes first (a34_gpu_lock()): 1 ms at most */
+		for (uint32_t waits = 0; gA34MaliWaiters > 0 && waits < 100; waits++) {
+			IODelay(10);
+		}
+		c = j->client;
+		c->runQueued(j);
+		IOLockLock(gA34MaliQLock);
+		c->fDoneSeq = j->seq;
+		if (j->failed) {
+			if (c->fFailFirst == 0) {
+				c->fFailFirst = j->seq;
+			}
+			c->fFailLast = j->seq;
+		}
+		gA34MaliQRunning = NULL;
+		IOLockWakeup(gA34MaliQLock, &gA34MaliQDone, false);
+		IOLockUnlock(gA34MaliQLock);
+		a34_qjob_free(j);
+		c->release();
+	}
+}
+
+static void
+a34_mali_worker(void *arg, wait_result_t result)
+{
+	RedwoodMaliUserClient::worker(arg, result);
+}
+
+/*
+ * A34 (0919): SUBMIT of a client that queues. The request is checked and
+ * bo_handles copied in here, in the caller's thread; the job runs later, in
+ * the worker's. Back at once, the job's number in in_syncs. Takes only the
+ * queue's lock.
+ */
+IOReturn
+RedwoodMaliUserClient::enqueue(struct a34_submit *req)
+{
+	struct a34_qjob *j;
+	uint32_t n = req->bo_handle_count;
+	uint64_t seq = 0;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (req->jc == 0 || (req->requirements & ~(PANFROST_JD_REQ_FS | PANFROST_JD_REQ_CYCLE_COUNT)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	j = IONewZero(struct a34_qjob, 1);
+	if (j == NULL) {
+		return kIOReturnNoMemory;
+	}
+	j->all = true;
+	if (req->bo_handles != 0 && n != 0 && n <= A34_SUBMIT_BOS_MAX) {
+		j->handles = (uint32_t *)IOMallocData(n * sizeof(uint32_t));
+		if (j->handles != NULL) {
+			j->nhandles = n;
+			if (copyin(req->bo_handles, j->handles, n * sizeof(uint32_t)) == 0) {
+				j->all = false;
+			}
+		}
+	}
+	j->client = this;
+	j->job.jc = req->jc;
+	j->job.requirements = req->requirements;
+	retain();                       /* the job's hold on the client, until it is done or dropped */
+
+	IOLockLock(gA34MaliQLock);
+	while (fOpen && !fClosed && !fClosing && fAsync && fLastSeq - fDoneSeq >= A34_QUEUE_MAX) {
+		/* the program is far ahead of the GPU: it waits here */
+		if (IOLockSleep(gA34MaliQLock, &gA34MaliQDone, THREAD_ABORTSAFE) != THREAD_AWAKENED) {
+			ret = kIOReturnAborted;
+			break;
+		}
+	}
+	if (ret == kIOReturnSuccess && (fBos == NULL || !fOpen || fClosed || fClosing)) {
+		ret = kIOReturnNotOpen;
+	} else if (ret == kIOReturnSuccess && !fAsync) {
+		ret = kIOReturnNotPermitted;    /* (SET_MODE 0 from another thread meanwhile) */
+	}
+	if (ret == kIOReturnSuccess) {
+		seq = j->seq = ++fLastSeq;
+		j->gseq = ++gA34MaliQSeq;
+		j->queued = mach_absolute_time();
+		j->depth = gA34MaliQDepth + (gA34MaliQRunning != NULL ? 1 : 0);
+		/* what it names is busy until it is done: GEM_CLOSE, WAIT_BO, IOSurfaceLock and the panel's copy wait for that */
+		if (j->all) {
+			fBusyAllSeq = j->gseq;
+			for (uint32_t i = 0; i < A34_BOS; i++) {
+				if (fBos[i].surface != NULL) {
+					fBos[i].surface->gpuBusySeq = j->gseq;
+				}
+			}
+		} else {
+			for (uint32_t i = 0; i < j->nhandles; i++) {
+				uint32_t h = j->handles[i];
+
+				if (h != 0 && h <= A34_BOS && a34_bo_used(&fBos[h - 1])) {
+					struct a34_bo *b = &fBos[h - 1];
+
+					b->busySeq = j->gseq;
+					if (b->surface != NULL) {
+						b->surface->gpuBusySeq = j->gseq;
+					}
+				}
+			}
+		}
+		if (gA34MaliQTail != NULL) {
+			gA34MaliQTail->next = j;
+		} else {
+			gA34MaliQHead = j;
+		}
+		gA34MaliQTail = j;
+		gA34MaliQDepth++;
+		IOLockWakeup(gA34MaliQLock, &gA34MaliQWork, true);
+	}
+	IOLockUnlock(gA34MaliQLock);
+	if (ret != kIOReturnSuccess) {
+		a34_qjob_free(j);
+		release();
+		return ret;
+	}
+	req->in_syncs = seq;            /* (j is the worker's now, and may be gone) */
+	return kIOReturnSuccess;
+}
+
+/* A34 (0919): request 0x7a. */
+IOReturn
+RedwoodMaliUserClient::setMode(struct a34_set_mode *req)
+{
+	IOReturn ret = kIOReturnSuccess;
+	bool say = false;
+
+	if (gA34MaliAsync == 0 || gA34MaliQLock == NULL) {
+		return kIOReturnUnsupported;
+	}
+	if (req->async > 1 || req->pad != 0) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gA34MaliQLock);
+	if (fBos == NULL || !fOpen || fClosed || fClosing) {
+		ret = kIOReturnNotOpen;
+	} else if (req->async != 0) {
+		say = !fAsync;
+		fAsync = true;
+	} else {
+		/* back to synchronous: once its queue is empty, so that its jobs stay in their order */
+		while (fDoneSeq < fLastSeq && !fClosing) {
+			if (IOLockSleep(gA34MaliQLock, &gA34MaliQDone, THREAD_ABORTSAFE) != THREAD_AWAKENED) {
+				ret = kIOReturnAborted;
+				break;
+			}
+		}
+		if (ret == kIOReturnSuccess) {
+			say = fAsync;
+			fAsync = false;
+		}
+	}
+	req->async = fAsync ? 1 : 0;
+	IOLockUnlock(gA34MaliQLock);
+	if (say && fModeSaid < 4) {
+		fModeSaid++;
+		IOLog("A34 MALI UC: %s: SUBMIT is %s from now on\n", fName, req->async ? "queued (jobs run by the kernel's thread)" :
+		    "synchronous again");
+	}
+	return ret;
+}
+
+/* A34 (0919): request 0x7b. */
+IOReturn
+RedwoodMaliUserClient::waitSeq(struct a34_wait_seq *req)
+{
+	uint64_t target, deadline = 0;
+	IOReturn ret = kIOReturnSuccess;
+	int res;
+
+	if (gA34MaliQLock == NULL) {
+		return kIOReturnUnsupported;
+	}
+	if (req->timeout_ns != 0 && req->timeout_ns != A34_FOREVER) {
+		/* (more than a day is a day: no overflow of the mach time) */
+		nanoseconds_to_absolutetime(req->timeout_ns < 86400ull * NSEC_PER_SEC ? req->timeout_ns : 86400ull * NSEC_PER_SEC,
+		    &deadline);
+		deadline += mach_absolute_time();
+	}
+	IOLockLock(gA34MaliQLock);
+	target = (req->seq == 0 || req->seq > fLastSeq) ? fLastSeq : req->seq;
+	while (fDoneSeq < target) {
+		if (req->timeout_ns == 0) {
+			ret = kIOReturnTimeout;
+			break;
+		}
+		if (req->timeout_ns == A34_FOREVER) {
+			res = IOLockSleep(gA34MaliQLock, &gA34MaliQDone, THREAD_ABORTSAFE);
+		} else {
+			res = IOLockSleepDeadline(gA34MaliQLock, &gA34MaliQDone, deadline, THREAD_ABORTSAFE);
+		}
+		if (res != THREAD_AWAKENED && fDoneSeq < target) {
+			ret = res == THREAD_TIMED_OUT ? kIOReturnTimeout : kIOReturnAborted;
+			break;
+		}
+	}
+	req->status = 0;
+	if (ret == kIOReturnSuccess && fFailFirst != 0 && fFailFirst <= target) {
+		/* told once: the failures up to here; one after it is for a later wait */
+		req->status = 1;
+		if (fFailLast <= target) {
+			fFailFirst = fFailLast = 0;
+		} else {
+			fFailFirst = fFailLast;
+		}
+	}
+	IOLockUnlock(gA34MaliQLock);
+	return ret;
+}
+
+/*
+ * A34 (0919): the requests about one buffer that a client that queues makes
+ * all the time (Mesa: WAIT_BO, MADVISE and SET_LABEL_BO for every buffer
+ * that goes into or comes out of its cache; MMAP_BO, GET_BO_OFFSET and
+ * QUERY_BO_INFO for every new one), with only the queue's lock: behind
+ * gA34MaliLock each would wait for the job that is running. They read and
+ * write numbers of the handle and nothing it points to; a handle cannot go
+ * while the queue's lock is held (closeBo()).
+ *
+ * WAIT_BO: until the queued jobs that name the buffer are done (not every
+ * job of the client: Mesa asks it of the oldest buffer in its cache before
+ * it uses it again). timeout_ns <= 0: only asked, kIOReturnBusy if not;
+ * else waited for, A34_WAIT_BO_NS at most.
+ */
+IOReturn
+RedwoodMaliUserClient::requestQueued(uint32_t selector, union a34_request *r)
+{
+	struct a34_bo *b;
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t handle;
+	uint64_t busy;
+	int res;
+
+	switch (selector) {
+	case kA34PanfrostWaitBO:
+		handle = r->wait.handle;
+		break;
+	case kA34PanfrostMadvise:
+		handle = r->madvise.handle;
+		break;
+	case kA34PanfrostSetLabelBO:
+		handle = r->label.handle;
+		break;
+	case kA34PanfrostMmapBO:
+		handle = r->mmapbo.handle;
+		break;
+	case kA34PanfrostGetBOOffset:
+		handle = r->offset.handle;
+		break;
+	case kA34PanfrostQueryBOInfo:
+		handle = r->info.handle;
+		break;
+	default:
+		return kIOReturnUnsupported;
+	}
+	IOLockLock(gA34MaliQLock);
+	if (fBos == NULL || !fOpen || fClosed || fClosing) {
+		ret = kIOReturnNotOpen;
+	} else if (handle == 0 || handle > A34_BOS || !a34_bo_used(&fBos[handle - 1])) {
+		ret = kIOReturnNotFound;
+	} else {
+		b = &fBos[handle - 1];
+		switch (selector) {
+		case kA34PanfrostWaitBO:
+			busy = b->busySeq > fBusyAllSeq ? b->busySeq : fBusyAllSeq;
+			if (a34_q_done() < busy) {
+				/* (b is not looked at after this: the lock is let go of in there) */
+				res = a34_q_wait(busy, r->wait.timeout_ns <= 0 ? 0 : A34_WAIT_BO_NS, THREAD_ABORTSAFE);
+				if (res != THREAD_AWAKENED) {
+					ret = r->wait.timeout_ns <= 0 ? kIOReturnBusy : res == THREAD_TIMED_OUT ? kIOReturnTimeout :
+					    kIOReturnAborted;
+				}
+			}
+			break;
+		case kA34PanfrostMadvise:       /* nothing is ever purged: kept for the cache upkeep (upkeep()) */
+			if (r->madvise.madv > PANFROST_MADV_DONTNEED) {
+				ret = kIOReturnBadArgument;
+			} else {
+				b->madv = r->madvise.madv;
+				r->madvise.retained = 1;
+			}
+			break;
+		case kA34PanfrostMmapBO:
+			if (r->mmapbo.flags != 0 || (b->flags & PANFROST_BO_HEAP) != 0) {
+				ret = kIOReturnBadArgument;
+			} else {
+				r->mmapbo.offset = (uint64_t)handle << 12;
+			}
+			break;
+		case kA34PanfrostGetBOOffset:
+			r->offset.offset = b->va;
+			break;
+		case kA34PanfrostQueryBOInfo:
+			r->info.extra_flags = b->surface != NULL ? DRM_PANFROST_BO_IS_IMPORTED : 0;
+			r->info.create_flags = b->flags;
+			r->info.pad = 0;
+			break;
+		default:                        /* SET_LABEL_BO: labels are not kept */
+			break;
+		}
+	}
+	IOLockUnlock(gA34MaliQLock);
+	return ret;
+}
