+/*
+ * A34 (0919): the client is going. Nothing more of it is queued, what is
+ * queued and not running is dropped, and its job that is running is waited
+ * for: after this no job of it uses the GPU or its buffers.
+ */
+void
+RedwoodMaliUserClient::dropQueued(void)
+{
+	struct a34_qjob *dropped = NULL, **link, *j;
