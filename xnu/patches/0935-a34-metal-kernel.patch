+void
+AppleCLCD::presentTaken(uint8_t *rec, SweetSurface *presenting[SWEET_FB_LAYERS])
+{
+	present(rec);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+	IOLockLock(fLock);
+	fPresentingSwapID = 0;
+	sweet_fb_hold_stats[1]++;
+	IOLockWakeup(fLock, &fPendingSwapID, false);
+	IOLockUnlock(fLock);
+	sweet_fb_unhold(presenting);
