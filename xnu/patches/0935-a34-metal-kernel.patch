+/*
+ * With fLock held: the swap waiting, taken for present(), or NULL (no memory).
+ * A34 (0927): the swap is the one being copied now; its surfaces stay held
+ * until that is done. (A34 (0935): moved here from vsyncFired(), for nowFired().)
+ */
+uint8_t *
+AppleCLCD::takePending(SweetSurface *presenting[SWEET_FB_LAYERS])
+{
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+
+	if (rec != NULL) {
+		memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		fPresentingSwapID = fPendingSwapID;
+		fPendingSwapID = 0;
+		memcpy(presenting, fPendingHeld, sizeof(fPendingHeld));
+		bzero(fPendingHeld, sizeof(fPendingHeld));
+	}
+	return rec;
+}
