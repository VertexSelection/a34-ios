+/*
+ * A34 (0935, from the Metal agent's research/metal/kernel/a34metal-kernel.patch,
+ * after HackiOS's MiniIOMobileFramebuffer.cpp, MIT): with boot-arg
+ * a34metalprops=1 a program may put Metal's two discovery properties on this
+ * service, or take them off (an empty string), at run time
+ * (IORegistryEntrySetCFProperties(), userland/a34metal's metal_props). Only
+ * MetalPluginName and MetalPluginClassName, only strings. For tests: from then
+ * on every program that asks Metal for a device loads the plug-in (which still
+ * decides which programs it serves); a34metal=1 (0920) has it from boot.
+ */
+static bool gA34MetalProps;
+
+IOReturn
+IOAcceleratorES::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator *keys;
+	OSObject *next;
+	char who[32] = "?";
+
+	proc_selfname(who, sizeof(who));
+	if (!gA34MetalProps) {
+		static unsigned said;
+
+		if (said++ < 4) {
+			IOLog("SWEET FB: IOAcceleratorES: %s asks to set properties; boot-arg a34metalprops=1 was not given\n", who);
+		}
+		return kIOReturnUnsupported;
+	}
+	if (dict == NULL || dict->getCount() == 0) {
+		return kIOReturnBadArgument;
+	}
+	keys = OSCollectionIterator::withCollection(dict);
+	if (keys == NULL) {
+		return kIOReturnNoMemory;
+	}
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol *key = OSDynamicCast(OSSymbol, next);
+
+		if (key == NULL || (!key->isEqualTo("MetalPluginName") && !key->isEqualTo("MetalPluginClassName")) ||
+		    OSDynamicCast(OSString, dict->getObject(key)) == NULL) {
+			IOLog("SWEET FB: IOAcceleratorES: refusing what %s sent: only the strings MetalPluginName and "
+			    "MetalPluginClassName\n", who);
+			keys->release();
+			return kIOReturnBadArgument;
+		}
+	}
+	keys->reset();
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol *key = OSDynamicCast(OSSymbol, next);
+		OSString *value = key != NULL ? OSDynamicCast(OSString, dict->getObject(key)) : NULL;
+
+		if (value == NULL) {
+			continue;
+		}
+		if (value->getLength() == 0) {
+			removeProperty(key);
+			IOLog("SWEET FB: IOAcceleratorES: %s removed by %s\n", key->getCStringNoCopy(), who);
+		} else if (setProperty(key, value)) {
+			IOLog("SWEET FB: IOAcceleratorES: %s = %s, set by %s\n", key->getCStringNoCopy(), value->getCStringNoCopy(),
+			    who);
+		} else {
+			keys->release();
+			return kIOReturnNoMemory;
+		}
+	}
+	keys->release();
+	return kIOReturnSuccess;
+}
