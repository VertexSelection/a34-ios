+/* A34 (0938): the DSI as found, once: what decides a frame's transfer time (MediaTek's values in the comments) */
+static void
+sweet_fb_dsi_dump(const char *when)
+{
+	static const uint16_t regs[] = {
+		0x010, 0x014, 0x018,    /* CON_CTRL ([27] WAIT_FIFO_FULL, MediaTek sets it on MT6877), MODE_CTRL, TXRX_CTRL */
+		0x01c, 0x02c, 0x038,    /* PSCTRL (DSC: PS_SEL 5, PS_WC 1080), VACT_NL (2340), SIZE_CON (2340 << 16 | 360) */
+		0x050, 0x054, 0x058, 0x05c,     /* HSA/HBP/HFP/BLLP word counts */
+		0x060, 0x064, 0x06c,    /* CMDQ_CON, HSTX_CKL_WC, CMD_TYPE1_HS ([16] HS between lines) */
+		0x090, 0x0a0,           /* MEM_CONTI (0x3c), TIME_CON0 */
+		0x104, 0x108, 0x110, 0x114, 0x118, 0x11c,      /* PHY_LCCON, LD0CON, PHY_TIMECON0-3 */
+		0xc00, 0xc04,           /* SHADOW_DEBUG ([1] BYPASS_SHADOW), its next word */
+	};
+	char line[420];
+	size_t n = 0;
+
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]) && n < sizeof(line); i++) {
+		n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%08x", regs[i], a34_dsi_rd(regs[i]));
+	}
+	IOLog("A34 FB 120: DSI %s:%s\n", when, line);
+}
 
