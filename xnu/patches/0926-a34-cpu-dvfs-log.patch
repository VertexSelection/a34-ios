+/*
+ * A34 (0926): the firmware's log (OFFS_LOG_S, 150 entries of struct
+ * cpu_dvfs_log): timestamp low and high, then a word per cluster: [3:2]
+ * on, [7:4] limit, [11:8] base, [15:12] the OPP it runs at
+ * (opp_idx_log: what Android's Ripi thread takes as the cluster's OPP),
+ * [24:21] the OPP asked for. Read only.
+ */
+#define LOG_ON(w)               (((w) >> 2) & 3u)
+#define LOG_LIMIT(w)            (((w) >> 4) & 0xfu)
+#define LOG_BASE(w)             (((w) >> 8) & 0xfu)
+#define LOG_OPP(w)              (((w) >> 12) & 0xfu)
+#define LOG_ASKED(w)            (((w) >> 21) & 0xfu)
+
+/* The newest entry (the largest timestamp) and how many entries have one; false: none. */
+static bool
+ck_log_newest(uint32_t w[5], uint32_t *count)
+{
+	uint64_t best = 0;
+	uint32_t best_off = 0, n, k;
+
+	*count = 0;
+	for (n = 0; n < CS_LOG_N; n++) {
+		uint32_t off = CS_LOG + 20u * n;
+		uint64_t ts = ((uint64_t)ck_cs(off + 4u) << 32) | ck_cs(off);
+
+		if (ts != 0) {
+			(*count)++;
+		}
+		if (ts > best) {
+			best = ts;
+			best_off = off;
+		}
+	}
+	if (best == 0) {
+		return false;
+	}
+	for (k = 0; k < 5; k++) {
+		w[k] = ck_cs(best_off + 4u * k);
+	}
+	return true;
+}
+
+static void
+ck_log_say(const char *when)
+{
+	uint32_t w[5], count;
+
+	if (!ck_log_newest(w, &count)) {
+		printf("A34 CLOCKS: CPU DVFS log%s: no entry; Vproc words %u %u %u %u, %u notices\n", when, ck_cs(CS_CUR_VPROC),
+		    ck_cs(CS_CUR_VPROC + 4u), ck_cs(CS_CUR_VPROC + 8u), ck_cs(CS_CUR_VPROC + 12u), ck_notices);
+		return;
+	}
+	printf("A34 CLOCKS: CPU DVFS log%s: %u entries, newest at %llu: LL OPP %u (asked %u, limits %u..%u, on %u), "
+	    "L OPP %u (asked %u, limits %u..%u, on %u), CCI OPP %u; Vproc words %u %u %u %u; %u notices\n", when, count,
+	    ((unsigned long long)w[1] << 32) | w[0], LOG_OPP(w[2]), LOG_ASKED(w[2]), LOG_LIMIT(w[2]), LOG_BASE(w[2]),
+	    LOG_ON(w[2]), LOG_OPP(w[3]), LOG_ASKED(w[3]), LOG_LIMIT(w[3]), LOG_BASE(w[3]), LOG_ON(w[3]), LOG_OPP(w[4]),
+	    ck_cs(CS_CUR_VPROC), ck_cs(CS_CUR_VPROC + 4u), ck_cs(CS_CUR_VPROC + 8u), ck_cs(CS_CUR_VPROC + 12u), ck_notices);
+}
