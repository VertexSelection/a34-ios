-class IO80211Controller : public IOService
+/* the baseline's (SweetNetwork.cpp), word for word: one class, defined there */
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+class IO80211Controller : public IONetworkController
 {
 	OSDeclareDefaultStructors(IO80211Controller);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
 };
 
-OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+OSDefineMetaClassAndStructors(IO80211Controller, IONetworkController);
+
+/* IOService's start, not SweetNetwork's (which looks for mac-address-wifi0 in its provider, the platform here) */
+bool
+IO80211Controller::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	return true;
+}
 
