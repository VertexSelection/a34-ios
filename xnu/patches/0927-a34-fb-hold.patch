+static uint64_t sweet_fb_hold_stats[8];
+static uint64_t sweet_fb_hold_last[8];
+static SInt32 sweet_fb_touch_last[2];
+#define SWEET_FB_SWAP_WAIT_MS           1000    /* longer than present()'s 500 ms wait for GPU jobs */
+#define SWEET_FB_HOLD_LOG_TICKS         600     /* vsyncs: 10 s */
+
+/* The surfaces of a swap's enabled layers, retained and marked held. */
+static void
+sweet_fb_hold(const uint8_t *rec, SweetSurface *held[SWEET_FB_LAYERS])
+{
+	uint32_t mask, id;
+
+	memcpy(&mask, rec + 0x104, 4);
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		held[layer] = NULL;
+		memcpy(&id, rec + 0x54 + 4 * layer, 4);
+		if ((mask & (1u << layer)) != 0 && id != 0) {
+			held[layer] = sweet_surface_copy(id);
+			if (held[layer] != NULL) {
+				OSIncrementAtomic(&held[layer]->displayHeld);
+			}
+		}
+	}
+}
+
+static void
+sweet_fb_unhold(SweetSurface *held[SWEET_FB_LAYERS])
+{
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if (held[layer] != NULL) {
+			OSDecrementAtomic(&held[layer]->displayHeld);
+			held[layer]->release();
+			held[layer] = NULL;
+		}
+	}
+}
+
+/* Every 10 s from the vsync work loop, when anything happened. */
