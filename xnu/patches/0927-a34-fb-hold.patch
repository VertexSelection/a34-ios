+	for (unsigned i = 0; i < 8; i++) {
+		d[i] = sweet_fb_hold_stats[i] - (i == 7 ? 0 : sweet_fb_hold_last[i]);
+		sweet_fb_hold_last[i] = sweet_fb_hold_stats[i];
+		any = any || (i != 7 && d[i] != 0);
+	}
+	sweet_fb_hold_stats[7] = 0;
+	absolutetime_to_nanoseconds(d[7], &ms);
+	if (!any && t[0] == sweet_fb_touch_last[0] && t[1] == sweet_fb_touch_last[1]) {
+		return;
+	}
+	IOLog("A34 FB HOLD: 10 s: %llu swaps, %llu copied, %llu replaced before their copy; SwapWait asked %llu "
+	    "(busy %llu), waited %llu (timed out %llu, longest %llu ms); GPU jobs naming a surface the display "
+	    "holds %d, IOSurfaceLocks of one %d\n", (unsigned long long)d[0], (unsigned long long)d[1],
+	    (unsigned long long)d[2], (unsigned long long)d[3], (unsigned long long)d[4], (unsigned long long)d[5],
+	    (unsigned long long)d[6], (unsigned long long)(ms / NSEC_PER_MSEC), (int)(t[0] - sweet_fb_touch_last[0]),
+	    (int)(t[1] - sweet_fb_touch_last[1]));
+	sweet_fb_touch_last[0] = t[0];
+	sweet_fb_touch_last[1] = t[1];
+}
