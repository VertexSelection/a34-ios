+/*
+ * A34 (0927): SwapWait(id, options): done when the display no longer needs
+ * that swap (see the top of the file). Options bit 0: only asked.
+ */
+IOReturn
+AppleCLCD::swapWait(uint32_t id, uint32_t options)
+{
+	uint64_t deadline, t0;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(fLock);
+	bool busy = id != 0 && (id == fPendingSwapID || id == fPresentingSwapID);
+	if ((options & 1u) != 0) {
+		sweet_fb_hold_stats[3]++;
+		if (busy) {
+			sweet_fb_hold_stats[4]++;
+			ret = kIOReturnBusy;
+		}
+	} else if (busy) {
+		sweet_fb_hold_stats[5]++;
+		t0 = mach_absolute_time();
+		clock_interval_to_deadline(SWEET_FB_SWAP_WAIT_MS, kMillisecondScale, &deadline);
+		while (id == fPendingSwapID || id == fPresentingSwapID) {
+			int res = IOLockSleepDeadline(fLock, &fPendingSwapID, deadline, THREAD_ABORTSAFE);
+
+			if (res != THREAD_AWAKENED && (id == fPendingSwapID || id == fPresentingSwapID)) {
+				ret = res == THREAD_TIMED_OUT ? kIOReturnTimeout : kIOReturnAborted;
+				if (res == THREAD_TIMED_OUT) {
+					sweet_fb_hold_stats[6]++;
+				}
+				break;
+			}
+		}
+		if (mach_absolute_time() - t0 > sweet_fb_hold_stats[7]) {
+			sweet_fb_hold_stats[7] = mach_absolute_time() - t0;
+		}
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
