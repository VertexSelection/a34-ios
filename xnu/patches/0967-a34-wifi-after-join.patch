+/* ---- (0967) a line for each of the first frames either way: what it is, never what it says ---- */
+
+static void
+a34w_trace(const char *way, const uint8_t *e, uint32_t length, const char *how)
+{
+	uint32_t type, at = 14, l4;
+	const uint8_t *ip = e + 14;
+	char what[96] = "";
+
+	if (a34w_trace_left == 0 || length < 14u) {
+		return;
+	}
+	a34w_trace_left--;
+	type = (uint32_t)(e[12] << 8 | e[13]);
+	if (type == 0x0800u && length >= at + 20u) {
+		l4 = 14u + 4u * (ip[0] & 0xfu);
+		if ((ip[9] == 17u || ip[9] == 6u) && length >= l4 + 4u) {
+			uint32_t sport = (uint32_t)(e[l4] << 8 | e[l4 + 1u]), dport = (uint32_t)(e[l4 + 2u] << 8 | e[l4 + 3u]);
+			const char *dhcp = "";
+
+			if (ip[9] == 17u && (sport == 67u || sport == 68u) && length >= l4 + 8u + 240u) {
+				const uint8_t *o = e + l4 + 8u + 240u, *oend = e + length;
+
+				for (; o + 2 <= oend && o[0] != 255u; o += o[0] == 0 ? 1 : 2 + o[1]) {
+					if (o[0] == 53u && o[1] == 1u && o + 3 <= oend) {
+						static const char *const kinds[9] = { "?", "DISCOVER", "OFFER", "REQUEST", "DECLINE",
+							                              "ACK", "NAK", "RELEASE", "INFORM" };
+						dhcp = o[2] < 9u ? kinds[o[2]] : "?";
+						break;
+					}
+				}
+			}
+			snprintf(what, sizeof(what), "IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s%s", ip[9] == 6u ? "TCP" : "UDP",
+			    ip[12], ip[13], ip[14], ip[15], sport, ip[16], ip[17], ip[18], ip[19], dport, dhcp[0] ? " DHCP " : "", dhcp);
+		} else {
+			snprintf(what, sizeof(what), "IPv4 protocol %u %u.%u.%u.%u -> %u.%u.%u.%u", ip[9], ip[12], ip[13], ip[14], ip[15],
+			    ip[16], ip[17], ip[18], ip[19]);
+		}
+	} else if (type == 0x0806u && length >= 42u) {
+		snprintf(what, sizeof(what), "ARP %s %u.%u.%u.%u -> %u.%u.%u.%u", e[21] == 1u ? "request" : "reply", e[28], e[29],
+		    e[30], e[31], e[38], e[39], e[40], e[41]);
+	} else {
+		snprintf(what, sizeof(what), "type 0x%04x", type);
+	}
+	a34w_say("%s %u bytes, to %02x:%02x:%02x:%02x:%02x:%02x: %s%s", way, length, e[0], e[1], e[2], e[3], e[4], e[5], what, how);
+}
+
+static void
+a34w_hex_line(char *out, size_t room, const uint8_t *p, uint32_t n)
+{
+	size_t at = 0;
+
+	out[0] = '\0';
+	for (uint32_t i = 0; i < n && at + 4u < room; i++) {
+		at += (size_t)snprintf(out + at, room - at, "%02x%s", p[i], i + 1u < n ? " " : "");
+	}
+}
