 }
 
+/* (0967) the link is gone: the interface told, and a join again in 3 s (5 times a boot at most) */
+static void
+a34w_lost(const char *why)
+{
+	if (a34w_joined && a34w_link_change != NULL) {
+		a34w_link_change(false);
+	}
+	a34w_joined = false;
+	a34w_unjoin(false);                             /* the firmware's side of it undone, as Android's disconnect */
+	memcpy(a34w_kicked, a34w_target.bssid, 6);
+	a34w_kicked_at = a34w_ms();
+	if (a34w_auto_rejoins < 5u) {
+		a34w_auto_rejoins++;
+		a34w_auto_rejoin_at = a34w_ms() + 3000u;
+		a34w_say("LEFT the network (%s): joining again in 3 s (%u of 5 this boot; that BSS scores 20 dB less for 5 min)",
+		    why, a34w_auto_rejoins);
+	} else {
+		a34w_say("LEFT the network (%s): not joining again by itself any more ('a34wifi join' does)", why);
+	}
+}
