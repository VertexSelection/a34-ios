+/*
+ * (0967) An action frame from the AP (to us or to everybody): said in the log, decoded where it
+ * matters. An ADDBA request reaching the host is declined (status 37, as Linux's mac80211 does
+ * for a station without aggregation): left unanswered, an AP tears the agreement -- or us -- down.
+ */
+static bool a34w_mgmt_tx(const uint8_t *frame, uint32_t length, const char *what);
+
+static void
+a34w_action_in(const uint8_t *f, uint32_t length)
+{
+	static const char *const categories[] = { "spectrum management", "QoS", "DLS", "block ack", "public",
+		                                  "radio measurement", "fast BSS transition", "HT", "SA query",
+		                                  "protected dual of public", "WNM", "unprotected WNM", "TDLS", "mesh",
+		                                  "multihop", "self-protected", "DMG", "-", "fast session transfer",
+		                                  "robust AV streaming", "unprotected DMG", "VHT" };
+	uint8_t category = length > 24u ? f[24] : 0xffu, action = length > 25u ? f[25] : 0xffu;
+	char bytes[3 * 24 + 4];
+
+	a34w_hex_line(bytes, sizeof(bytes), f + 24, length - 24u > 24u ? 24u : length - 24u);
+	if (a34w_actions_said < 48u) {
+		a34w_actions_said++;
+		a34w_say("the AP sent an action frame%s: category %u (%s), action %u, %u bytes: %s",
+		    (f[4] & 1u) ? " to everybody" : "", category, category < sizeof(categories) / sizeof(categories[0]) ?
+		    categories[category] : category == 127u ? "vendor" : "?", action, length, bytes);
+	}
+	if (category == 3u && action == 0u && length >= 33u && (f[4] & 1u) == 0) {      /* ADDBA Request */
+		uint8_t r[24 + 9];
+
+		bzero(r, sizeof(r));
+		r[0] = 0xd0;                            /* Action */
+		memcpy(r + 4, a34w_target.bssid, 6);
+		memcpy(r + 10, a34w_mac, 6);
+		memcpy(r + 16, a34w_target.bssid, 6);
+		r[24] = 3;                              /* block ack */
+		r[25] = 1;                              /* ADDBA Response */
+		r[26] = f[26];                          /* dialog token */
+		r[27] = 37;                             /* status: request declined */
+		r[29] = f[27];                          /* the BA parameter set as asked */
+		r[30] = f[28];
+		a34w_say("the AP asks for a block ack agreement (TID %u, %u frames): declined", (f[27] >> 2) & 0xfu,
+		    (unsigned)((f[27] | f[28] << 8) >> 6));
+		(void)a34w_mgmt_tx(r, sizeof(r), "ADDBA Response (declined)");
+	} else if (category == 10u && action == 7u && length >= 31u) {             /* BSS Transition Management Request */
+		a34w_say("the AP asks us to move (BSS transition request: token %u, mode 0x%02x, disassociation in %u beacons, "
+		    "valid %u)", f[26], f[27], (unsigned)(f[28] | f[29] << 8), f[30]);
+	}
+}
