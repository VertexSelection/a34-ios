+/*
+ * A34 (0939): why 0937/0938 changed nothing. LK leaves DSI_CON_CTRL =
+ * 0x01000000: bit 24, DSI_CM_MODE_WAIT_DATA_EVERY_LINE_EN, which MediaTek's
+ * mtk_dsi.c sets only for "LP mode per line" (ext->params->lp_perline_en)
+ * and clears otherwise -- this panel's driver never sets lp_perline_en, so
+ * Android runs it with the bit clear, and on MT6877 sets bit 27
+ * (DSI_CM_WAIT_FIFO_FULL_EN, need_wait_fifo) in mtk_dsi_enable(). LP after
+ * every line is 331 byte clocks a line: 7.69 ms a frame (mtk_dsi_get_line_time()),
+ * what we measure; kept in HS 272: 6.32 ms. 0x6C bit 16 cannot help while
+ * the DSI waits in LP each line.
+ * Boot-arg a34dsicon (bits): 1 clears bit 24, 2 sets bit 27. Applied at start,
+ * the link idle; the first SWEET_FB_CON_WATCH transfers are watched for
+ * DSI_INTSTA BUFFER_UNDERRUN (bit 12) or INP_UNFINISH (bit 14) -- the display
+ * pipe not keeping up with a link kept in HS (Android runs the display clock
+ * at 416 MHz for it; LK's is not known) -- and CON_CTRL goes back to LK's
+ * value if one is seen.
+ */
+#define SWEET_FB_DSI_CON_CTRL   0x010u
+#define SWEET_FB_CM_WAIT_EVERY_LINE (1u << 24)
+#define SWEET_FB_CM_WAIT_FIFO_FULL  (1u << 27)
+#define SWEET_FB_UNDERRUN       ((1u << 12) | (1u << 14))
+#define SWEET_FB_CON_WATCH      16u
+static uint32_t sweet_fb_con_was, sweet_fb_con_watch;   /* LK's CON_CTRL; transfers left to watch */
+
+/* After a transfer (both kick paths): a34dsicon's guard, and its first transfer time, said once. */
+static void
+sweet_fb_con_check(uint64_t xfer)
+{
+	uint32_t sta;
+	uint64_t ns;
+
+	if (sweet_fb_con_watch == 0) {
+		return;
+	}
+	sta = a34_dsi_rd(SWEET_FB_DSI_INTSTA);
+	absolutetime_to_nanoseconds(xfer, &ns);
+	if ((sta & SWEET_FB_UNDERRUN) != 0) {
+		a34_dsi_wr(SWEET_FB_DSI_CON_CTRL, sweet_fb_con_was);
+		a34_dsi_wr(SWEET_FB_DSI_INTSTA, ~SWEET_FB_UNDERRUN);
+		sweet_fb_con_watch = 0;
+		IOLog("A34 FB 120: a34dsicon: DSI_INTSTA 0x%08x (underrun/unfinished input) after a %llu us transfer: CON_CTRL "
+		    "back to 0x%08x\n", sta, (unsigned long long)(ns / NSEC_PER_USEC), sweet_fb_con_was);
+		return;
+	}
+	if (sweet_fb_con_watch-- == SWEET_FB_CON_WATCH) {
+		IOLog("A34 FB 120: a34dsicon: the first transfer with CON_CTRL 0x%08x took %llu us\n",
+		    a34_dsi_rd(SWEET_FB_DSI_CON_CTRL), (unsigned long long)(ns / NSEC_PER_USEC));
+	} else if (sweet_fb_con_watch == 0) {
+		IOLog("A34 FB 120: a34dsicon: %u transfers without an underrun; the last took %llu us\n", SWEET_FB_CON_WATCH,
+		    (unsigned long long)(ns / NSEC_PER_USEC));
 	}
-	IOLog("A34 FB 120: DSI %s:%s\n", when, line);
 }
 
