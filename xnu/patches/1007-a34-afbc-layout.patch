+
+IOReturn
+sweet_surface_set_layout(SweetSurface *s, uint32_t layout, uint32_t header, uint32_t body, uint32_t header_row,
+    uint32_t *size)
+{
+	uint64_t length, cols, rows, end;
+
+	*size = 0;
+	if (s->scanPA == 0 || s->memory == NULL) {
+		return kIOReturnUnsupported;    /* (only the pool's buffers are scanned out) */
+	}
+	length = s->memory->getLength();
+	if (length <= s->offset) {
+		return kIOReturnUnsupported;
+	}
+	*size = (uint32_t)(length - s->offset);
+	if (layout == SWEET_SURFACE_LINEAR) {
+		__atomic_store_n(&s->scanLayout, SWEET_SURFACE_LINEAR, __ATOMIC_RELEASE);
+		return kIOReturnSuccess;
+	}
+	if (layout != SWEET_SURFACE_AFBC) {
+		return kIOReturnBadArgument;
+	}
+	if (!sweet_surface_afbc_on()) {
+		return kIOReturnUnsupported;
+	}
+	cols = (s->width + SWEET_SURFACE_AFBC_W - 1) / SWEET_SURFACE_AFBC_W;
+	rows = (s->height + SWEET_SURFACE_AFBC_H - 1) / SWEET_SURFACE_AFBC_H;
+	end = (uint64_t)body + cols * rows * SWEET_SURFACE_AFBC_SLOT;
+	if (header_row != cols * SWEET_SURFACE_AFBC_HDR || (header & 127u) != 0 || (body & 127u) != 0 ||
+	    (uint64_t)header + cols * rows * SWEET_SURFACE_AFBC_HDR > body) {
+		return kIOReturnBadArgument;
+	}
+	if (end > length - s->offset) {
+		return kIOReturnNoSpace;
+	}
+	if (__atomic_load_n(&s->scanLayout, __ATOMIC_ACQUIRE) == SWEET_SURFACE_AFBC && s->scanHeader == header &&
+	    s->scanBody == body) {
+		return kIOReturnSuccess;
+	}
+	s->scanHeader = header;
+	s->scanBody = body;
+	__atomic_store_n(&s->scanLayout, SWEET_SURFACE_AFBC, __ATOMIC_RELEASE);
+	if (sweet_scan_afbc_said++ < 8) {
+		IOLog("SWEET SURF: surface %u (%ux%u) is AFBC 32x8: headers at +%u, %llu bytes a row, bodies at +%u to +%llu of "
+		    "%llu\n", s->id, s->width, s->height, header, cols * SWEET_SURFACE_AFBC_HDR, body, end,
+		    (unsigned long long)(length - s->offset));
+	}
+	return kIOReturnSuccess;
+}
