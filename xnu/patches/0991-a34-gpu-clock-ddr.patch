+/* A34 (0991): the GPU's clock as MFGPLL1's CON1 makes it, kHz (0: MFG0 off or not mapped). */
+uint32_t
+a34_clocks_gpu_khz(void)
+{
+	if (ck_gpupll == 0 || ck_top == 0 || !ck_mfg0_on()) {
+		return 0;
+	}
+	return ck_mfgpll_khz(ruby_rd32(ck_gpupll, MFGPLL1_CON1));
