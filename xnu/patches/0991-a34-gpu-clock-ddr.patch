+/*
+ * A34 (0991), with the lock held: a job's GPU time into the 10 s window, and
+ * the GPU line once it is full: busy time by slot (fragment chains: the
+ * bandwidth side; vertex/tiler/compute), the longest, the idle time with a
+ * job ready, the clock and the DDR OPP.
+ */
+static void
+gpuWindow(const struct a34_mali_job *job, uint64_t now)
+{
+	uint64_t win;
+	int slot = (job->requirements & PANFROST_JD_REQ_FS) ? 0 : 1;
+
+	gA34MaliLastEnd = now;
+	if (gA34MaliWinStart == 0) {
+		gA34MaliWinStart = now;
+	}
+	gA34MaliWinN[slot]++;
+	gA34MaliWinNs[slot] += job->ns;
+	if (job->ns > gA34MaliWinMost[slot]) {
+		gA34MaliWinMost[slot] = job->ns;
+	}
+	absolutetime_to_nanoseconds(now - gA34MaliWinStart, &win);
+	if (win < A34_GPU_WINDOW_NS) {
+		return;
+	}
+	uint32_t r[4];
+	uint64_t idle;
+	int ddr = a34_ddr_state(r);
+
+	absolutetime_to_nanoseconds(gA34MaliWinIdle, &idle);
+	IOLog("A34 MALI: %llu s: GPU busy %llu ms at %u MHz: vertex/tiler %u x %llu us (most %llu), fragment %u x %llu us "
+	    "(most %llu); idle with a job ready %llu ms; DDR OPP %d\n", (unsigned long long)(win / NSEC_PER_SEC),
+	    (unsigned long long)((gA34MaliWinNs[0] + gA34MaliWinNs[1]) / NSEC_PER_MSEC), a34_clocks_gpu_khz() / 1000u,
+	    gA34MaliWinN[1], (unsigned long long)(gA34MaliWinN[1] != 0 ? gA34MaliWinNs[1] / 1000u / gA34MaliWinN[1] : 0),
+	    (unsigned long long)(gA34MaliWinMost[1] / 1000u), gA34MaliWinN[0],
+	    (unsigned long long)(gA34MaliWinN[0] != 0 ? gA34MaliWinNs[0] / 1000u / gA34MaliWinN[0] : 0),
+	    (unsigned long long)(gA34MaliWinMost[0] / 1000u), (unsigned long long)(idle / NSEC_PER_MSEC), ddr);
+	gA34MaliWinStart = now;
+	gA34MaliWinN[0] = gA34MaliWinN[1] = 0;
+	gA34MaliWinNs[0] = gA34MaliWinNs[1] = gA34MaliWinMost[0] = gA34MaliWinMost[1] = 0;
+	gA34MaliWinIdle = 0;
+}
