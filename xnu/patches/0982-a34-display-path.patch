+/*
+ * A34 (0982): the kick's thread, after a start: until the DSI is idle again;
+ * *xfer from `started` to then (0938-0981 measured from 50 us after the start:
+ * this reads ~0.05-0.1 ms longer). a34fbsleep=1: asleep until SWEET_FB_SPIN_US
+ * before the last transfer's length is up, then polled (it polled all 7.6 ms
+ * of every transfer, and up to SWEET_FB_TE_WAKE_US before every TE: ~10 ms
+ * of a processor a frame, on a thread above the programs'). a34fbstage=N:
+ * one transfer in N watched stage by stage instead (stageSample()).
+ */
+bool
+AppleCLCD::xferWait(uint64_t started, uint64_t *xfer)
+{
+	uint64_t polled, ticks = 0, spin;
+	bool ok;
+
+	if (fStageEvery != 0 && fRdma != NULL && ++fStageN >= fStageEvery) {
+		fStageN = 0;
+		return stageSample(started, xfer);
+	}
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_SPIN_US * NSEC_PER_USEC, &spin);
+	if (fSleepWaits && fXferLast > spin + spin) {
+		uint64_t now = mach_absolute_time(), ns;
+
+		if (now - started < fXferLast - spin) {
+			absolutetime_to_nanoseconds(fXferLast - spin - (now - started), &ns);
+			IODelay((unsigned)(ns / NSEC_PER_USEC));
+		}
+	} else {
+		IODelay(50);
+	}
+	polled = mach_absolute_time();
+	ok = a34_dsi_wait_idle(&ticks, fTEBit ? SWEET_FB_TE_XFER_MS : 1000);
+	sweet_fb_path_stats[12] += mach_absolute_time() - polled;
+	*xfer = mach_absolute_time() - started;
+	return ok;
+}
