+/*
+ * A34 (0982): a34fbstage=N. Which stage of the display path ends a frame
+ * last: every SWEET_FB_STAGE_US (asleep between) the row OVL0_2L and OVL0
+ * blend (ADDCON_DBG), RDMA0's lines in and out, until the DSI is idle. RDMA0's
+ * lines in far ahead of its lines out (its FIFO full) and the OVLs ahead of
+ * it: the DSI link sets the pace; in and out together, or an underrun bit:
+ * what comes before it does. Only reads; the line goes out at once.
+ */
+bool
+AppleCLCD::stageSample(uint64_t started, uint64_t *xfer)
+{
+	uint64_t now = started, limit, half, last[4] = { 0, 0, 0, 0 }, at = 0, us[6];
+	uint32_t rows[4], mid[4] = { 0, 0, 0, 0 }, top = fHeight > 0 ? fHeight - 1 : 0, sta;
+	bool busy = true;
+
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_STAGE_MS * NSEC_PER_MSEC, &limit);
+	half = fXferLast != 0 ? fXferLast / 2 : 0;
+	while (busy && now - started < limit) {
+		IODelay(SWEET_FB_STAGE_US);
+		now = mach_absolute_time();
+		busy = a34_dsi_busy() != 0;
+		rows[0] = fOvl[0] != NULL ? (fOvl[0][SWEET_FB_OVL_ADDCON_DBG / 4] >> 16) & 0x1fffu : 0;
+		rows[1] = fOvl[1] != NULL ? (fOvl[1][SWEET_FB_OVL_ADDCON_DBG / 4] >> 16) & 0x1fffu : 0;
+		rows[2] = fRdma[SWEET_FB_RDMA_IN_LINES / 4] & 0x1fffu;
+		rows[3] = fRdma[SWEET_FB_RDMA_OUT_LINES / 4] & 0x1fffu;
+		for (unsigned i = 0; i < 4; i++) {
+			if (last[i] == 0 && rows[i] >= top) {
+				last[i] = now - started;        /* the first look that found it at the last row */
+			}
+		}
+		if (at == 0 && half != 0 && now - started >= half) {
+			at = now - started;
+			memcpy(mid, rows, sizeof(mid));
+		}
+	}
+	sta = fRdma[SWEET_FB_RDMA_INT_STA / 4];
+	*xfer = now - started;
+	absolutetime_to_nanoseconds(*xfer, &us[0]);
+	for (unsigned i = 0; i < 4; i++) {
+		absolutetime_to_nanoseconds(last[i], &us[1 + i]);
+	}
+	absolutetime_to_nanoseconds(at, &us[5]);
+	IOLog("A34 FB STAGE: DSI idle %llu us after the start; last row at: OVL0_2L %llu, OVL0 %llu, RDMA0 in %llu, out %llu us; "
+	    "at %llu us rows %u/%u/%u/%u; RDMA0 INT_STATUS 0x%x\n", us[0] / 1000, us[1] / 1000, us[2] / 1000, us[3] / 1000,
+	    us[4] / 1000, us[5] / 1000, mid[0], mid[1], mid[2], mid[3], sta);
+	return !busy;
+}
