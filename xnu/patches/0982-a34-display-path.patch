+		                         0x0d4, 0x0d8, 0x0dc, 0x0e8, 0x1a0 };
+	static const uint16_t ovl[] = { 0x00c, 0x0c0, 0x0c8, 0x0d0, 0x1e0, 0x1f4, 0x1f8, 0x1fc };
+	char line[180];
+	size_t n;
+
+	n = (size_t)snprintf(line, sizeof(line), "A34 FB STAGE: RDMA0");
+	for (unsigned i = 0; i < sizeof(rdma) / sizeof(rdma[0]); i++) {
+		if (n > 150) {
+			IOLog("%s\n", line);   /* (lines under 200 characters) */
+			n = (size_t)snprintf(line, sizeof(line), "A34 FB STAGE: RDMA0");
+		}
+		n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%x", rdma[i], fRdma[rdma[i] / 4]);
+	}
+	IOLog("%s\n", line);
+	for (unsigned o = 0; o < 2; o++) {
+		if (fOvl[o] == NULL) {
+			continue;
+		}
+		n = (size_t)snprintf(line, sizeof(line), "A34 FB STAGE: %s", o == 0 ? "OVL0_2L" : "OVL0");
+		for (unsigned i = 0; i < sizeof(ovl) / sizeof(ovl[0]) && n < 160; i++) {
+			n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%x", ovl[i], fOvl[o][ovl[i] / 4]);
+		}
+		IOLog("%s\n", line);
+	}
+}
