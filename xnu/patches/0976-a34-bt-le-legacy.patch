+/*
+ * (0976) bluetoothd's legacy scanning carried by the extended commands, once the controller has refused
+ * LE_Set_Scan_Parameters while not scanning: the commands rewritten on the way out, their answers and the
+ * advertising reports on the way back.
+ */
+static bool br_xl;                              /* scanning goes through the extended commands */
+static uint16_t br_xl_from, br_xl_to;           /* a rewritten command in flight: its legacy and extended opcodes */
+static uint8_t br_xl_params[7];                 /* bluetoothd's last LE_Set_Scan_Parameters */
+
+/* pkt (a legacy scan command) as its extended form into out; its length, or 0 when it is not one */
+static uint32_t
+br_xl_command(const uint8_t *pkt, uint32_t n, uint8_t *out)
+{
+	uint16_t op = (uint16_t)(pkt[1] | (pkt[2] << 8));
+
+	if (op == 0x200b && n >= 11) {          /* type, interval, window, own address type, filter policy */
+		const uint8_t o[12] = { 0x01, 0x41, 0x20, 8, pkt[9], pkt[10], 0x01, pkt[4], pkt[5], pkt[6], pkt[7], pkt[8] };
+
+		memcpy(out, o, sizeof(o));
+		return sizeof(o);
+	}
+	if (op == 0x200c && n >= 6) {           /* enable, filter duplicates; no duration, no period */
+		const uint8_t o[10] = { 0x01, 0x42, 0x20, 6, pkt[4], pkt[5], 0, 0, 0, 0 };
+
+		memcpy(out, o, sizeof(o));
+		return sizeof(o);
+	}
+	return 0;
+}
+
+/* LE_Set_Scan_Parameters refused while not scanning: the same through LE_Set_Extended_Scan_Parameters */
+static bool
+br_xl_start(void)
+{
+	static uint8_t ans[BT_PKT_MAX];
+	uint8_t legacy[11] = { 0x01, 0x0b, 0x20, 7 }, ext[12];
+	uint32_t got;
+
+	memcpy(legacy + 4, br_xl_params, sizeof(br_xl_params));
+	(void)br_xl_command(legacy, sizeof(legacy), ext);
+	got = bt_command(ext, sizeof(ext), 0x0e, ans, 500);
+	printf("A34 BT: br: LE_Set_Scan_Parameters refused while not scanning; LE_Set_Extended_Scan_Parameters %s\n",
+	    got >= 7 && ans[6] == 0 ? "taken: bluetoothd's scanning goes through the extended commands from now on" :
+	    "refused too");
+	return got >= 7 && ans[6] == 0;
+}
+
+/* an LE Extended Advertising Report as a legacy one (its legacy PDUs only); the new length, 0 if none is left */
+static uint32_t
+br_xl_report(uint8_t *p, uint32_t n)
+{
+	static uint8_t out[BT_PKT_MAX];
+	uint32_t at = 5, o = 5, kept = 0, count = n > 4 ? p[4] : 0;
+
+	for (uint32_t i = 0; i < count && at + 24 <= n; i++) {
+		uint32_t type = (uint32_t)(p[at] | (p[at + 1] << 8)), dl = p[at + 23];
+		int legacy = -1;
+
+		if (at + 24 + dl > n) {
+			break;
+		}
+		switch (type & 0x7f) {
+		case 0x13: legacy = 0; break;   /* ADV_IND */
+		case 0x15: legacy = 1; break;   /* ADV_DIRECT_IND */
+		case 0x12: legacy = 2; break;   /* ADV_SCAN_IND */
+		case 0x10: legacy = 3; break;   /* ADV_NONCONN_IND */
+		case 0x1b:                      /* SCAN_RSP to ADV_IND */
+		case 0x1a: legacy = 4; break;   /* SCAN_RSP to ADV_SCAN_IND */
+		default: break;
+		}
+		if (legacy >= 0 && dl <= 31 && o + 10 + dl <= 3 + 255) {
+			out[o++] = (uint8_t)legacy;
+			out[o++] = p[at + 2];                           /* address type */
+			memcpy(out + o, p + at + 3, 6);                 /* address */
+			o += 6;
+			out[o++] = (uint8_t)dl;
+			memcpy(out + o, p + at + 24, dl);
+			o += dl;
+			out[o++] = p[at + 13];                          /* RSSI */
+			kept++;
+		}
+		at += 24 + dl;
+	}
+	if (kept == 0) {
+		return 0;
+	}
+	out[0] = 0x04;
+	out[1] = 0x3e;
+	out[2] = (uint8_t)(o - 3);
+	out[3] = 0x02;
+	out[4] = (uint8_t)kept;
+	memcpy(p, out, o);
+	return o;
+}
+
+/* (0976) an event before bluetoothd sees it: the translation's side. The length to deliver, 0 to drop it. */
+static uint32_t
+br_xl_event(uint8_t *p, uint32_t n)
+{
+	uint16_t op;
+
+	if (n >= 5 && p[0] == 0x04 && p[1] == 0x3e && p[3] == 0x0d) {
+		return br_xl ? br_xl_report(p, n) : n;
+	}
+	if (n < 7 || p[0] != 0x04 || p[1] != 0x0e) {
+		return n;
+	}
+	op = (uint16_t)(p[4] | (p[5] << 8));
+	if (br_xl_to != 0 && op == br_xl_to) {                  /* the answer under bluetoothd's opcode */
+		p[4] = (uint8_t)br_xl_from;
+		p[5] = (uint8_t)(br_xl_from >> 8);
+		br_xl_to = 0;
+	} else if (op == 0x200b && p[6] == 0x0c && !br_xl && !br_scan.on && br_xl_start()) {
+		br_xl = true;
+		p[6] = 0;
+	} else if (op == 0x0c03 && p[6] == 0) {                 /* HCI_Reset: legacy again */
+		br_xl = false;
+		br_xl_to = 0;
+	}
+	return n;
+}
