diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 2302386..b7faff9 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -198,6 +198,57 @@ a34_dsi_wait_idle(uint64_t *ticks)
 	return true;
 }
 
+extern "C" uint32_t a34_dsi_rd(uint32_t off);
+extern "C" uint32_t a34_mutex_rd(uint32_t off);
+
+/*
+ * A34 (0910): the first time a frame transfer does not finish, log the DSI,
+ * the display mutex, RDMA0 and both OVLs once, to see what the pipe waits on.
+ */
+static void
+a34_disp_dump(const char *why)
+{
+	static bool done;
+	static const uint16_t dsi[] = { 0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x1c,
+		                        0x104, 0x160, 0x164, 0x168, 0x16c, 0x170, 0x174, 0x178, 0x17c };
+	char line[400];
+	size_t n;
+
+	if (done) {
+		return;
+	}
+	done = true;
+	n = 0;
+	for (unsigned i = 0; i < sizeof(dsi) / sizeof(dsi[0]) && n < sizeof(line); i++) {
+		n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%08x", dsi[i], a34_dsi_rd(dsi[i]));
+	}
+	IOLog("A34 DISP %s: DSI%s\n", why, line);
+	n = 0;
+	for (uint32_t off = 0; off <= 0x3c && n < sizeof(line); off += 4) {
+		n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%08x", off, a34_mutex_rd(off));
+	}
+	IOLog("A34 DISP %s: MUTEX%s\n", why, line);
+	static const struct { const char *name; uint32_t pa; } blk[] = {
+		{ "RDMA0", 0x14007000u }, { "OVL0", 0x14005000u }, { "OVL0_2L", 0x14006000u },
+	};
+	for (unsigned b = 0; b < sizeof(blk) / sizeof(blk[0]); b++) {
+		volatile uint32_t *r = (volatile uint32_t *)ml_io_map(blk[b].pa, 0x1000);
+		if (r == NULL) {
+			continue;
+		}
+		n = 0;
+		for (uint32_t off = 0; off <= 0x4c && n < sizeof(line); off += 4) {
+			n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%08x", off, r[off / 4]);
+		}
+		IOLog("A34 DISP %s: %s%s\n", why, blk[b].name, line);
+		n = 0;
+		for (uint32_t off = 0x200; off <= 0x24c && n < sizeof(line); off += 4) {
+			n += (size_t)snprintf(line + n, sizeof(line) - n, " %x=%08x", off, r[off / 4]);
+		}
+		IOLog("A34 DISP %s: %s+%s\n", why, blk[b].name, line);
+	}
+}
