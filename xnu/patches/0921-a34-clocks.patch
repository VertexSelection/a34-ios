+/*
+ * A34 (0921): the GPU's clock in MHz as its own cycle counter sees it over
+ * 2 ms of the processor's clock; 0: it did not count. (Low if the clock is
+ * gated while the GPU is idle.) Only while no job runs.
+ */
+static uint32_t
+am_gpu_mhz(void)
+{
+	uint64_t c[2], t[2], ns;
+	uint32_t hi, lo;
+
+	am_wr(am_gpu, GPU_CMD, GPU_CMD_CYCLE_COUNT_START);
+	delay(5);
+	for (unsigned i = 0; i < 2; i++) {
+		if (i == 1) {
+			delay(2000);
+		}
+		do {
+			hi = am_rd(am_gpu, GPU_CYCLE_COUNT_HI);
+			lo = am_rd(am_gpu, GPU_CYCLE_COUNT_LO);
+		} while (am_rd(am_gpu, GPU_CYCLE_COUNT_HI) != hi);
+		t[i] = mach_absolute_time();
+		c[i] = ((uint64_t)hi << 32) | lo;
+	}
+	am_wr(am_gpu, GPU_CMD, GPU_CMD_CYCLE_COUNT_STOP);
+	absolutetime_to_nanoseconds(t[1] - t[0], &ns);
