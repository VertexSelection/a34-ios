+/* (0975) the last packets of the bridge, said when bluetoothd leaves */
+#define BR_RING                 24u
+static struct {
+	char dir[4];
+	uint16_t n;
+	uint8_t b[14];
+	uint32_t ms;
+} br_ring[BR_RING];
+static uint32_t br_ring_at;
+static volatile bool br_ring_pending;
+
+static void
+br_ring_say(void)
+{
+	uint32_t now = bt_ms(), shown = 0;
+
+	for (uint32_t k = 0; k < BR_RING; k++) {
+		uint32_t i = (br_ring_at + k) % BR_RING, m;
+		char text[3 * 14 + 1];
+
+		if (br_ring[i].n == 0) {
+			continue;
+		}
+		if (shown++ == 0) {
+			printf("A34 BT: br: the last packets before bluetoothd left (newest last):\n");
+		}
+		m = br_ring[i].n < 14 ? br_ring[i].n : 14;
+		for (uint32_t j = 0; j < m; j++) {
+			snprintf(text + 3 * j, 4, " %02x", br_ring[i].b[j]);
+		}
+		text[3 * m] = 0;
+		printf("A34 BT: br:   -%u ms %s %u:%s%s\n", now - br_ring[i].ms, br_ring[i].dir, br_ring[i].n, text,
+		    br_ring[i].n > m ? " ..." : "");
+	}
+	bzero(br_ring, sizeof(br_ring));
+	br_ring_at = 0;
+}
