+/*
+ * (0975) The controller's LE scanning as the enables answered with success left it. A command it refuses while
+ * scanning (LE_Set_Random_Address, LE_Set_Scan_Parameters, LE_Set_Extended_Scan_Parameters) is sent with scanning
+ * off around it: off now (br_scan_command), on again with the same parameters when its answer comes, before
+ * bluetoothd sees that answer (br_scan_event). An enable or disable refused (0x0C) because scanning already is so is
+ * answered as done.
+ */
+static struct {
+	bool on, ext;                   /* the controller scans; enabled with the extended command */
+	uint8_t params[6];              /* that enable command's parameters (2 legacy, 6 extended) */
+	uint16_t want_op;               /* an enable command in flight ... */
+	uint8_t want[6];                /* ... and its parameters */
+	uint16_t resume_op;             /* scanning off for this command: on again once it is answered */
+} br_scan;
+
+static bool
+br_scan_set(bool on, uint16_t around)
+{
+	static uint8_t ans[BT_PKT_MAX];
+	static uint32_t said;
+	uint8_t cmd[10] = { 0x01, 0x0c, 0x20, 2, 0, 0, 0, 0, 0, 0 };
+	uint32_t len = 6, got;
+
+	if (br_scan.ext) {
+		cmd[1] = 0x42;
+		cmd[3] = 6;
+		len = 10;
+	}
+	if (on) {
+		memcpy(cmd + 4, br_scan.params, cmd[3]);
+	}
+	got = bt_command(cmd, len, 0x0e, ans, 500);
+	if (got < 7 || ans[6] != 0) {
+		printf("A34 BT: br: scanning %s %04x: %s %#x\n", on ? "back on after" : "off for", around,
+		    got < 7 ? "no answer" : "status", got < 7 ? 0u : ans[6]);
+		return false;
+	}
+	br_scan.on = on;
+	if (on && said++ < 8) {
+		printf("A34 BT: br: command %04x sent with scanning off around it (the controller refuses it while it scans)\n",
+		    around);
+	}
+	return true;
+}
+
+static void
+br_scan_command(const uint8_t *pkt, uint32_t n)
+{
+	uint16_t op;
+
+	if (pkt[0] != 0x01 || n < 4) {
+		return;
+	}
+	op = (uint16_t)(pkt[1] | (pkt[2] << 8));
+	if ((op == 0x200c && n >= 6) || (op == 0x2042 && n >= 10)) {
+		br_scan.want_op = op;
+		bzero(br_scan.want, sizeof(br_scan.want));
+		memcpy(br_scan.want, pkt + 4, op == 0x200c ? 2 : 6);
+	} else if ((op == 0x2005 || op == 0x200b || op == 0x2041) && br_scan.on && br_scan.resume_op == 0 &&
+	    br_scan_set(false, op)) {
+		br_scan.resume_op = op;
+	}
+}
+
+static void
+br_scan_event(uint8_t *p, uint32_t n)
+{
+	static uint32_t said;
+	uint16_t op;
+
+	if (n < 7 || p[0] != 0x04 || p[1] != 0x0e) {
+		return;
+	}
+	op = (uint16_t)(p[4] | (p[5] << 8));
+	if (op == 0x0c03 && p[6] == 0) {                                /* HCI_Reset: not scanning */
+		bzero(&br_scan, sizeof(br_scan));
+	} else if (op != 0 && op == br_scan.want_op) {
+		bool on = br_scan.want[0] != 0;
+
+		br_scan.want_op = 0;
+		if (p[6] == 0x0c && on == br_scan.on) {
+			if (said++ < 8) {
+				printf("A34 BT: br: scanning already %s: %04x answered as done\n", on ? "on" : "off", op);
+			}
+			p[6] = 0;
+		}
+		if (p[6] == 0) {
+			br_scan.on = on;
+			br_scan.ext = op == 0x2042;
+			if (on) {
+				memcpy(br_scan.params, br_scan.want, sizeof(br_scan.params));
+			}
+		}
+	} else if (op != 0 && op == br_scan.resume_op) {
+		br_scan.resume_op = 0;
+		(void)br_scan_set(true, op);
+	}
+}
