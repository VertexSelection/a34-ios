+/*
+ * A34 (0915): a surface the GPU uses (RedwoodMali request 0x7e) is
+ * cacheable memory for every processor and the GPU is not coherent. No job
+ * cleans or invalidates it any more (that cost seconds a frame); the CPU's
+ * side of it is kept right where the CPU uses it instead, the way
+ * IOSurface asks programs to: IOSurfaceLock before CPU access
+ * (sweet_surface_cpu_begin: forget the caches' lines if a job has named the
+ * surface since they last did), IOSurfaceUnlock after it, unless read-only
+ * (sweet_surface_cpu_end: what the CPU wrote, to memory). AppleCLCD's copy
+ * to the panel clean+invalidates the rows it reads (SweetFramebuffer.cpp),
+ * and a new GPU buffer of a surface starts with all of it clean
+ * (sweet_surface_cpu_whole). A program's own memory as a surface
+ * (wrapped) is written by its owner without a lock: RedwoodMali keeps
+ * cleaning and invalidating those around every job that names them.
+ */
+extern "C" void a34_mali_cpu_flush(uintptr_t va, uint64_t size);       /* bsd/dev/a34_mali.c: dc civac */
+extern "C" void a34_mali_cpu_clean(uintptr_t va, uint64_t size);       /* bsd/dev/a34_mali.c: dc cvac */
+
+SInt64 sweet_surface_sync_stats[4];
+
+/* The kernel range of a surface the GPU uses whose CPU side is kept at lock and unlock, or false. */
+static bool
+sweet_surface_gpu_range(SweetSurface *s, uintptr_t *va, uint64_t *size)
+{
+	if (s->gpuShared <= 0 || s->wrapped || s->memory == NULL) {
+		return false;
+	}
+	*size = s->memory->getLength();
+	*va = s->kernelAddress();
+	return *va != 0 && *size != 0;
+}
+
+static void
+sweet_surface_sync_count(unsigned which, uint64_t bytes, uint64_t began)
+{
+	OSAddAtomic64(1, &sweet_surface_sync_stats[which]);
+	OSAddAtomic64((SInt64)bytes, &sweet_surface_sync_stats[2]);
+	OSAddAtomic64((SInt64)(mach_absolute_time() - began), &sweet_surface_sync_stats[3]);
+}
+
+void
+sweet_surface_cpu_begin(SweetSurface *s)
+{
+	SInt32 writes = s->gpuWrites;   /* (counted after a job ended: a later one makes this differ again) */
+	uintptr_t va;
+	uint64_t size, began;
+
+	if (writes == s->cpuSeen || !sweet_surface_gpu_range(s, &va, &size)) {
+		return;
+	}
+	began = mach_absolute_time();
+	a34_mali_cpu_flush(va, size);
+	s->cpuSeen = writes;
+	sweet_surface_sync_count(0, size, began);
+}
+
+void
+sweet_surface_cpu_end(SweetSurface *s)
+{
+	uintptr_t va;
+	uint64_t size, began;
+
+	if (!sweet_surface_gpu_range(s, &va, &size)) {
+		return;
+	}
+	began = mach_absolute_time();
+	a34_mali_cpu_clean(va, size);
+	sweet_surface_sync_count(1, size, began);
+}
+
+void
+sweet_surface_cpu_whole(SweetSurface *s)
+{
+	SInt32 writes = s->gpuWrites;
+	uintptr_t va = s->kernelAddress();
+	uint64_t size = s->memory != NULL ? s->memory->getLength() : 0;
+
+	if (va != 0 && size != 0) {
+		a34_mali_cpu_flush(va, size);
+		s->cpuSeen = writes;
+	}
+}
