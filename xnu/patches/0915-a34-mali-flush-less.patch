+/*
+ * With the lock held. A34 (0915, replacing 0911's and 0914's flush of every
+ * buffer and every named surface around every job): the CPU's caches and
+ * this client's buffers around a job, `before` it or after it; the bytes
+ * taken. The GPU is not coherent and the CPU's mappings are cacheable, so:
+ *
+ *   - a buffer of the program's own that it has never mapped (render
+ *     targets, varyings, scratch) was cleaned when it was made and the CPU
+ *     never touches it: nothing (on its first mapping it is
+ *     clean+invalidated once, clientMemoryForType());
+ *   - a mapped one (command and descriptor pools, uploads, read-backs):
+ *     cleaned before every job, named or not, because Mesa's screen-wide
+ *     pools of blend, preload and precompiled shaders and their descriptors
+ *     are used by address and never named (pan_blend_cso.c, pan_fb_preload.c,
+ *     pan_precomp.c); clean+invalidated after a job that names it, since the
+ *     GPU writes only what the job names; none of it while it sits in
+ *     Mesa's cache (MADVISE DONTNEED: no job uses it);
+ *   - the tiler heap: never (the GPU's alone);
+ *   - a surface (0x7e) that is a program's memory (wrapped: its owner writes
+ *     it without a lock) or that this client has mapped (Mesa's own CPU
+ *     access, no lock either): clean before and clean+invalidate after a
+ *     job that names it;
+ *   - any other surface: nothing here; a named one only counts the job
+ *     (gpuWrites, after it ended), and SweetSurface keeps the CPU's side at
+ *     IOSurfaceLock/Unlock, AppleCLCD before its copy.
+ *
+ * `all`: the list could not be read, every buffer counts as named.
+ */
+uint64_t
+RedwoodMaliUserClient::upkeep(bool before, bool all)
+{
+	uint64_t bytes = 0;
+
+	for (uint32_t i = 0; i < A34_BOS; i++) {
+		struct a34_bo *b = &fBos[i];
+		bool listed = all || (b->state & A34_BO_LISTED) != 0;
+		uintptr_t va;
+
+		if (!before) {
+			b->state &= ~A34_BO_LISTED;
+		}
+		if (b->mem != NULL) {
+			if ((b->flags & PANFROST_BO_HEAP) != 0 || (b->state & A34_BO_MAPPED) == 0 ||
+			    (b->state & A34_BO_DONTNEED) != 0 || (!before && !listed)) {
+				continue;
+			}
+			va = (uintptr_t)b->mem->getBytesNoCopy();
+		} else if (b->surface != NULL && listed) {
+			if (!before) {
+				OSIncrementAtomic(&b->surface->gpuWrites);
 			}
+			if (!b->surface->wrapped && (b->state & A34_BO_MAPPED) == 0) {
+				continue;
+			}
+			va = b->kva;
+		} else {
+			continue;
+		}
+		if (before) {
+			a34_mali_cpu_clean(va, b->backed);
+		} else {
+			a34_mali_cpu_flush(va, b->backed);
 		}
+		bytes += b->backed;
+	}
+	return bytes;
+}
