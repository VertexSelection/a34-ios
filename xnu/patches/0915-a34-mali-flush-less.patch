+/*
+ * With the lock held. A34 (0915): job n's cache upkeep for the log: a line
+ * for each of the first A34_LOGGED_SUBMITS jobs, then a summary per
+ * A34_UPKEEP_WINDOW jobs (no more than one per A34_UPKEEP_WINDOW_NS), with
+ * what SweetSurface did at IOSurfaceLock/Unlock so far.
+ */
+void
+RedwoodMaliUserClient::upkeepLog(uint32_t n, uint32_t requirements, uint64_t before, uint64_t after, uint64_t ticks,
+    uint64_t jobNs)
+{
+	uint64_t ns, now = mach_absolute_time(), window;
+
+	absolutetime_to_nanoseconds(ticks, &ns);
+	if (n <= A34_LOGGED_SUBMITS) {
+		IOLog("A34 MALI UC: %s: job chain %u (%s, %u buffers): %llu KB cleaned before, %llu KB flushed after, "
+		    "%llu us of cache upkeep, job %llu us\n", fName, n,
+		    (requirements & PANFROST_JD_REQ_FS) ? "fragment" : "vertex/tiler/compute", fBoCount,
+		    (unsigned long long)(before >> 10), (unsigned long long)(after >> 10), (unsigned long long)(ns / 1000),
+		    (unsigned long long)(jobNs / 1000));
+	}
+	if (fWinJobs == 0) {
+		fWinStarted = now;
+	}
+	fWinJobs++;
+	fWinUpkeep += ticks;
+	if (ticks > fWinUpkeepMax) {
+		fWinUpkeepMax = ticks;
+	}
+	fWinJobNs += jobNs;
+	fWinBytes += before + after;
+	absolutetime_to_nanoseconds(now - fWinStarted, &window);
+	if (fWinJobs >= A34_UPKEEP_WINDOW && window >= A34_UPKEEP_WINDOW_NS) {
+		uint64_t all, most, surf;
+
+		absolutetime_to_nanoseconds(fWinUpkeep, &all);
+		absolutetime_to_nanoseconds(fWinUpkeepMax, &most);
+		absolutetime_to_nanoseconds((uint64_t)sweet_surface_sync_stats[3], &surf);
+		IOLog("A34 MALI UC: %s: %u jobs in %llu ms: cache upkeep %llu us a job (most %llu us), %llu KB a job; "
+		    "jobs %llu us each; surfaces at lock/unlock so far: %lld invalidated, %lld cleaned, %lld MB, %llu ms\n",
+		    fName, fWinJobs, (unsigned long long)(window / NSEC_PER_MSEC), (unsigned long long)(all / 1000 / fWinJobs),
+		    (unsigned long long)(most / 1000), (unsigned long long)((fWinBytes >> 10) / fWinJobs),
+		    (unsigned long long)(fWinJobNs / 1000 / fWinJobs), (long long)sweet_surface_sync_stats[0],
+		    (long long)sweet_surface_sync_stats[1], (long long)(sweet_surface_sync_stats[2] >> 20),
+		    (unsigned long long)(surf / NSEC_PER_MSEC));
+		fWinJobs = 0;
+		fWinUpkeep = fWinUpkeepMax = fWinJobNs = fWinBytes = 0;
 	}
 }
 
