+/*
+ * A34 (0915): clean only (dc cvac): what the processor wrote goes to memory,
+ * lines stay valid. For memory the GPU is about to read but not write. No
+ * state: callable without the lock (SweetSurface's unlock).
+ */
+void
+a34_mali_cpu_clean(uintptr_t va, uint64_t size)
+{
+	uint64_t ctr;
+	vm_offset_t line, p, end = (vm_offset_t)va + (vm_size_t)size;
+
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	line = (vm_offset_t)4 << ((ctr >> 16) & 0xf);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (p = (vm_offset_t)va & ~(line - 1); p < end; p += line) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
