+/* ---- the address (0970) ---- */
+
+#define BT_ADDR_FILE            "/a34/bt-address"
+static uint8_t bt_addr[6];                      /* as written, most significant byte first; all 0: none */
+static bool bt_addr_ok;
+static uint32_t bt_addr_want = 1;               /* a34btaddr */
+
+/* "C2:11:22:33:44:55" (most significant first) into a[6] */
+static bool
+bt_addr_parse(const uint8_t *text, uint32_t n, uint8_t a[6])
+{
+	uint32_t i = 0, k = 0, v = 0, digits = 0;
+
+	for (; i < n && k < 6; i++) {
+		uint8_t c = text[i];
+
+		if (c >= '0' && c <= '9') {
+			v = (v << 4) | (uint32_t)(c - '0');
+		} else if ((c | 0x20) >= 'a' && (c | 0x20) <= 'f') {
+			v = (v << 4) | (uint32_t)((c | 0x20) - 'a' + 10);
+		} else if (c == ':' || c == '-' || c == '\n' || c == ' ') {
+			if (digits == 0) {
+				continue;
+			}
+			if (digits != 2) {
+				return false;
+			}
+			a[k++] = (uint8_t)v;
+			v = 0;
+			digits = 0;
+			continue;
+		} else {
+			return false;
+		}
+		if (++digits > 2) {
+			return false;
+		}
+	}
+	if (k < 6 && digits == 2) {
+		a[k++] = (uint8_t)v;
+	}
+	return k == 6;
+}
+
+/*
+ * A random static address (Core 5.3 Vol 6 B 1.3.2.1: the two top bits 1, not all ones, not all zeros), whose
+ * low three bytes (the LAP of a BR/EDR address) are not the reserved inquiry codes 0x9E8B00-0x9E8B3F.
+ */
+static bool
+bt_addr_usable(const uint8_t a[6])
+{
+	uint32_t lap = ((uint32_t)a[3] << 16) | ((uint32_t)a[4] << 8) | a[5];
+	bool ones = true, zeros = true;
+
+	for (int i = 0; i < 6; i++) {
+		ones &= a[i] == 0xff;
+		zeros &= a[i] == 0;
+	}
+	return (a[0] & 0xc0) == 0xc0 && !ones && !zeros && !(lap >= 0x9e8b00 && lap <= 0x9e8b3f);
+}
+
+static int
+bt_file_put(const char *path, const char *text, int n)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0, error;
+
+	error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0644, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)text, n, 0, UIO_SYSSPACE, IO_SYNC | IO_NOAUTH,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FWRITE, ctx);
+	return error != 0 ? error : (resid != 0 ? EIO : 0);
+}
+
+/* the phone's address: from /a34/bt-address, else made now and kept there */
+static void
+bt_addr_load(void)
+{
+	char text[24];
+	uint8_t *data;
+	uint32_t size = 0;
+	int error, tries = 0;
+
+	if (bt_addr_ok) {
+		return;
+	}
+	if ((data = bt_file_any(BT_ADDR_FILE, &size)) != NULL) {
+		bool parsed = bt_addr_parse(data, size, bt_addr);
+
+		kfree_data(data, size);
+		if (parsed && bt_addr_usable(bt_addr)) {
+			bt_addr_ok = true;
+			printf("A34 BT: address %02x:%02x:%02x:%02x:%02x:%02x from " BT_ADDR_FILE "\n", bt_addr[0], bt_addr[1],
+			    bt_addr[2], bt_addr[3], bt_addr[4], bt_addr[5]);
+			return;
+		}
+		printf("A34 BT: " BT_ADDR_FILE " does not hold a random static address (C0-FF:..): a new one\n");
+	}
+	do {
+		read_random(bt_addr, sizeof(bt_addr));
+		bt_addr[0] |= 0xc0;
+	} while (!bt_addr_usable(bt_addr) && ++tries < 8);
+	bt_addr_ok = bt_addr_usable(bt_addr);
+	snprintf(text, sizeof(text), "%02X:%02X:%02X:%02X:%02X:%02X\n", bt_addr[0], bt_addr[1], bt_addr[2], bt_addr[3],
+	    bt_addr[4], bt_addr[5]);
+	error = bt_file_put(BT_ADDR_FILE, text, 18);
+	printf("A34 BT: address %02x:%02x:%02x:%02x:%02x:%02x made now (random static), %s " BT_ADDR_FILE " (%d)\n",
+	    bt_addr[0], bt_addr[1], bt_addr[2], bt_addr[3], bt_addr[4], bt_addr[5], error == 0 ? "kept in" : "NOT kept in",
+	    error);
+}
+
+/* MediaTek's "set address", then Read_BD_ADDR to see it took: true when the controller has the phone's address */
+static bool
+bt_addr_apply(const char *when)
+{
+	static const uint8_t read_addr[4] = { 0x01, 0x09, 0x10, 0x00 };
+	uint8_t cmd[10] = { 0x01, 0x1a, 0xfc, 0x06 }, a[BT_PKT_MAX];
+	uint32_t n;
+	bool same;
+
+	if (!bt_addr_want || !bt_addr_ok) {
+		return false;
+	}
+	for (int i = 0; i < 6; i++) {
+		cmd[4 + i] = bt_addr[5 - i];                                   /* low byte first */
+	}
+	n = bt_command(cmd, sizeof(cmd), 0x0e, a, 1000);
+	if (n < 7 || a[6] != 0) {
+		printf("A34 BT: address (%s): 0xFC1A %s\n", when, n < 7 ? "not answered" : "refused");
+		return false;
+	}
+	n = bt_command(read_addr, sizeof(read_addr), 0x0e, a, 1000);
+	same = n >= 13 && a[6] == 0;
+	for (int i = 0; same && i < 6; i++) {
+		same = a[7 + i] == bt_addr[5 - i];
+	}
+	printf("A34 BT: address (%s): %02x:%02x:%02x:%02x:%02x:%02x %s\n", when, bt_addr[0], bt_addr[1], bt_addr[2],
+	    bt_addr[3], bt_addr[4], bt_addr[5], same ? "set" : "NOT taken (Read_BD_ADDR differs)");
+	return same;
+}
