 sweet_surface_layout(SweetSurface *s, OSDictionary *props)
@@ -492,7 +571,17 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 		    s->bytesPerElement == 4 && s->elementWidth == 1 && s->elementHeight == 1 &&
 		    props->getObject("IOSurfacePlaneInfo") == NULL && props->getObject("IOSurfaceAddress") == NULL &&
 		    (uint64_t)s->bytesPerRow + sweet_surface_row_align <= UINT32_MAX) {
-			s->bytesPerRow = (s->bytesPerRow + sweet_surface_row_align - 1) & ~(sweet_surface_row_align - 1);
+			/* A34 (0934): only for the programs of a34surfrowfixnames */
+			char name[SWEET_SURFACE_NAME];
+			uint32_t rounded = (s->bytesPerRow + sweet_surface_row_align - 1) & ~(sweet_surface_row_align - 1);
+			bool fix;
+
+			proc_selfname(name, sizeof(name));
+			fix = sweet_surface_row_fix_for(name);
+			sweet_surface_row_fix_say(name, fix, s->bytesPerRow, fix ? rounded : s->bytesPerRow);
+			if (fix) {
+				s->bytesPerRow = rounded;
+			}
 		}
 	}
 	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
@@ -628,12 +717,15 @@ IOCoreSurfaceRoot::start(IOService *provider)
 		sweet_surface_row_align = align;
 	}
 	(void)PE_parse_boot_argn("a34surfrowfix", &sweet_surface_row_fix, sizeof(sweet_surface_row_fix));
+	(void)PE_parse_boot_arg_str("a34surfrowfixnames", sweet_surface_row_fix_names,
+	    (int)sizeof(sweet_surface_row_fix_names));         /* A34 (0934) */
 	(void)PE_parse_boot_argn("a34surfuse", &sweet_surface_use_on, sizeof(sweet_surface_use_on));
 	setProperty(kIOUserClientClassKey, "IOSurfaceRootUserClient");
 	registerService();
 	IOLog("SWEET SURF: IOCoreSurfaceRoot registered: rows and offsets aligned to %u bytes (a34surfalign), "
-	    "rows the creator gives %s (a34surfrowfix), use counts %s (a34surfuse)\n", sweet_surface_row_align,
-	    sweet_surface_row_fix ? "rounded up to that for 32-bit single-plane surfaces" : "kept",
+	    "rows the creator gives %s%s%s (a34surfrowfix), use counts %s (a34surfuse)\n", sweet_surface_row_align,
+	    sweet_surface_row_fix ? "rounded up to that for 32-bit single-plane surfaces of " : "kept",
+	    sweet_surface_row_fix ? sweet_surface_row_fix_names : "", sweet_surface_row_fix ? " (a34surfrowfixnames)" : "",
 	    sweet_surface_use_on ? "kept: IOSurfaceIsInUse works" : "ignored");
 	return true;
 }
