+/*
+ * A34 (0911): buffers are cacheable for the CPU and the GPU is not coherent:
+ * clean+invalidate every buffer of this client (the tiler heap is the
+ * GPU's alone) around each job.
+ */
+void
+RedwoodMaliUserClient::flushBuffers(void)
+{
+	if (fBos == NULL) {
+		return;
+	}
+	for (uint32_t i = 0; i < A34_BOS; i++) {
+		struct a34_bo *b = &fBos[i];
+		if (b->mem != NULL && (b->flags & PANFROST_BO_HEAP) == 0) {
+			a34_mali_cpu_flush((uintptr_t)b->mem->getBytesNoCopy(), b->backed);
+		}
+	}
+}
