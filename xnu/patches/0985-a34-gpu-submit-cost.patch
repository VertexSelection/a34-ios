+/*
+ * A34 (0985): A34Mali.cpp's thread that runs queued jobs could not be bound
+ * to its little core (a34malicpu above the processors there are: boot 0962
+ * had cpus=1), or there is only one processor. Its spin would then hold the
+ * processor the programs need: on boot 0962 the thread a SUBMIT woke went
+ * first and spun through the jobs queued, and every SUBMIT took ~1.4 ms.
+ * Unless a34malispin was given, jobs are from now on waited for asleep,
+ * AM_NAP_US at a time. True: so.
+ */
+bool
+a34_mali_spin_unbound(bool bind_failed)
+{
+	if (am_spin_given || am_spin_us == 0 || (!bind_failed && ml_get_max_cpu_number() > 0)) {
+		return false;
+	}
+	am_nap_only = true;
+	return true;
