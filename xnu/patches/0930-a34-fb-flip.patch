+/* A34 (0930): whether present() will cover the whole panel with the swap's bottom layer (copied as present() does). */
+bool
+AppleCLCD::fullFrame(const uint8_t *rec, uint32_t mask)
+{
+	uint32_t id = get32(rec, 0x54);
+	SweetSurface *s;
+	bool full = false;
+
+	if ((mask & 1u) == 0 || id == 0) {
+		return false;
+	}
+	s = sweet_surface_copy(id);
+	if (s != NULL && s != fSurface && s->kernelAddress() != 0 && (s->bytesPerElement == 4 || s->bytesPerElement == 0) &&
+	    s->elementWidth == 1 && s->elementHeight == 1 && s->memory != NULL) {
+		int32_t r[6];
+
+		layerRect(rec, 0, s, r);
+		uint64_t last = (uint64_t)s->wrapDelta + (uint64_t)s->offset + (uint64_t)(r[1] + r[5] - 1) * s->bytesPerRow +
+		    (uint64_t)(r[0] + r[4]) * 4;
+		full = r[2] == 0 && r[3] == 0 && r[4] == (int32_t)fWidth && r[5] == (int32_t)fHeight &&
+		    last <= s->memory->getLength();
+	}
+	OSSafeReleaseNULL(s);
+	return full;
+}
