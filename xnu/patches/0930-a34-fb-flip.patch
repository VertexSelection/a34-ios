+/*
+ * A34 (0930): two pictures and the panel's TE, after HackiOS's fb_flip
+ * (MiniIOMobileFramebuffer.cpp, APSL 2.0: "no frame copied into the
+ * picture the panel is scanning out"; two pictures of the boot framebuffer
+ * drawn in turn, OVL0's address switched), for a command-mode panel.
+ *
+ * What tore: the panel (s6e3fc5, DSI command mode, its own 60 Hz scan of
+ * its own memory) is written by each transfer (7.6 ms) whenever the kick
+ * started it, wherever the panel's scan was: where the scan overtook the
+ * write, the screen showed the frame before below that row and the new one
+ * above it (the Settings photos: rows twice, ~50 px apart). The panel says
+ * when its scan starts with its TE pin; Android's trigger loop
+ * (mtk_crtc_start_trig_loop) waits for that event before the mutex and
+ * DSI start. A transfer started at the TE stays ahead of the scan (2340
+ * rows in 7.6 ms against 16.7 ms). And with one picture, a copy into it
+ * while a late transfer read it mixed two frames in memory.
+ *
+ * a34fbte=1: the kick waits for TE_RDY in DSI_INTSTA (cleared, then
+ * polled; it sleeps until SWEET_FB_TE_WAKE_US before the TE it expects
+ * from the period measured at start) and starts the transfer at once. The
+ * DSI listens to the TE pin only with EXT_TE_EN in DSI_TXRX_CTRL (Android
+ * writes 0x0001023c after the panel's init); without it there is no TE,
+ * and a34fbte=2 sets it. No TE in SWEET_FB_TE_MAX_MS: started anyway.
+ *
+ * a34fbflip=1: picture 1 at SWEET_FB_SECOND (inside LK's reservation, the
+ * buffer LK's OVL0 layer 1 read), same rows. A frame whose bottom layer
+ * covers the panel is drawn into the picture that is neither being sent
+ * nor about to be; one that does not is drawn into the latest picture,
+ * after its transfer. The kick, with the DSI idle, takes the queued
+ * picture, points every OVL0_2L/OVL0 layer that read picture 0 at it (on
+ * the MT6877 the layer registers are not shadowed: BYPASS_SHADOW), and
+ * only then starts the transfer. No picture is written while a transfer
+ * reads it. A swap is still done when its copy is (0927). Kernel text
+ * (the console unmuted, a panic) is drawn into picture 0 and shows only
+ * while picture 0 is the one shown.
+ */
+void
+AppleCLCD::flipStart(void)
+{
+	static const uint32_t ovlPA[2] = { SWEET_FB_OVL0_2L, SWEET_FB_OVL0 };
+	static const char *const ovlName[2] = { "OVL0_2L", "OVL0" };
+	uint32_t flip = 0, te = 0, txrx, size = fRowBytes * fHeight;
+	bool cmdMode = (a34_dsi_rd(SWEET_FB_DSI_MODE_CTRL) & 3u) == 0;
+
+	fShown = 0;
+	fQueued = fTaken = fWriting = -1;
+	fBufVA[0] = fPixels;
+	fBufPA[0] = fPhys;
+	fDraw = fPixels;
+	fDrawPA = fPhys;
+	(void)PE_parse_boot_argn("a34fbflip", &flip, sizeof(flip));
+	(void)PE_parse_boot_argn("a34fbte", &te, sizeof(te));
+	for (unsigned o = 0; o < 2; o++) {
+		fOvl[o] = (volatile uint32_t *)ml_io_map(ovlPA[o], 0x1000);
+		fOvlFlip[o] = 0;
+		if (fOvl[o] == NULL) {
+			continue;
+		}
+		uint32_t en = fOvl[o][SWEET_FB_OVL_SRC_CON / 4];
+		for (unsigned n = 0; n < 4; n++) {
+			if ((en & (1u << n)) != 0 && fOvl[o][SWEET_FB_OVL_ADDR(n) / 4] == (uint32_t)fPhys) {
+				fOvlFlip[o] |= 1u << n;
+			}
+		}
+		IOLog("A34 FB FLIP: %s EN 0x%08x SRC_CON 0x%08x, layer addresses 0x%08x 0x%08x 0x%08x 0x%08x: layers 0x%x "
+		    "read picture 0\n", ovlName[o], fOvl[o][SWEET_FB_OVL_EN / 4], en, fOvl[o][SWEET_FB_OVL_ADDR(0) / 4],
+		    fOvl[o][SWEET_FB_OVL_ADDR(1) / 4], fOvl[o][SWEET_FB_OVL_ADDR(2) / 4], fOvl[o][SWEET_FB_OVL_ADDR(3) / 4],
+		    fOvlFlip[o]);
+	}
+	txrx = a34_dsi_rd(SWEET_FB_DSI_TXRX_CTRL);
+	IOLog("A34 FB FLIP: DSI MODE_CTRL 0x%08x TXRX_CTRL 0x%08x (EXT_TE_EN %u) INTEN 0x%08x INTSTA 0x%08x (TE_RDY %u)\n",
+	    a34_dsi_rd(SWEET_FB_DSI_MODE_CTRL), txrx, (txrx & SWEET_FB_EXT_TE_EN) != 0, a34_dsi_rd(SWEET_FB_DSI_INTEN),
+	    a34_dsi_rd(SWEET_FB_DSI_INTSTA), (a34_dsi_rd(SWEET_FB_DSI_INTSTA) & SWEET_FB_TE_RDY) != 0);
+	fFlipLock = IOLockAlloc();
+	if (fFlipLock == NULL || !cmdMode || txrx == 0xdeadbeefu) {
+		if (flip != 0 || te != 0) {
+			IOLog("A34 FB FLIP: a34fbflip/a34fbte not done (%s)\n", fFlipLock == NULL ? "no lock" :
+			    "the DSI is not a command-mode one here");
+		}
+		return;
+	}
+	if (flip != 0) {
+		if (fPhys != SWEET_FB_LK_FB || SWEET_FB_SECOND + size > SWEET_FB_LK_FB_END || (fOvlFlip[0] | fOvlFlip[1]) == 0) {
+			IOLog("A34 FB FLIP: not flipping: picture 0 at 0x%llx, %u bytes, no OVL layer reads it or picture 1 "
+			    "would not fit in LK's reservation\n", fPhys, size);
+		} else {
+			fBufVA[1] = (uintptr_t)ml_io_map_wcomb((vm_offset_t)SWEET_FB_SECOND,
+			    (vm_size_t)(((uint64_t)size + 0x3fffu) & ~(uint64_t)0x3fffu));
+			fBufPA[1] = SWEET_FB_SECOND;
+			fFlip = fBufVA[1] != 0;
+		}
+	}
+	if (te != 0) {
+		if ((txrx & SWEET_FB_EXT_TE_EN) == 0 && te >= 2) {
+			a34_dsi_wr(SWEET_FB_DSI_TXRX_CTRL, txrx | SWEET_FB_EXT_TE_EN);
+			txrx = a34_dsi_rd(SWEET_FB_DSI_TXRX_CTRL);
+		}
+		if ((txrx & SWEET_FB_EXT_TE_EN) == 0) {
+			IOLog("A34 FB FLIP: no TE: EXT_TE_EN is clear in DSI_TXRX_CTRL 0x%08x (a34fbte=2 sets it)\n", txrx);
+		} else {
+			uint64_t w1 = 0, w2 = 0, first;
+
+			fTE = true;
+			fTELast = 0;
+			fTEPeriod = 0;
+			if (teWait(&w1)) {
+				first = fTELast;
+				if (teWait(&w2)) {
+					fTEPeriod = fTELast - first;
+				}
+			}
+			if (fTEPeriod == 0) {
+				fTE = false;
+				IOLog("A34 FB FLIP: no TE seen in %u ms with EXT_TE_EN set (TXRX_CTRL 0x%08x): transfers not timed "
+				    "by it\n", SWEET_FB_TE_MAX_MS, txrx);
+			} else {
+				uint64_t ns;
+
+				absolutetime_to_nanoseconds(fTEPeriod, &ns);
+				IOLog("A34 FB FLIP: the panel's TE every %llu us: transfers start at it\n",
+				    (unsigned long long)(ns / NSEC_PER_USEC));
+			}
+		}
+	}
+	fNewPath = fFlip || fTE;
+	IOLog("A34 FB FLIP: %s, %s (a34fbflip=%u, a34fbte=%u)\n", fFlip ? "two pictures, at 0x74180000 and 0x74b54000" :
+	    "one picture", fTE ? "transfers at the TE" : "transfers at once", flip, te);
+}
+
+/* A34 (0930): the kick's thread: until the panel's next TE (up to SWEET_FB_TE_MAX_MS); false if none came. */
+bool
+AppleCLCD::teWait(uint64_t *waited)
+{
+	uint64_t t0 = mach_absolute_time(), now, limit, wake, second;
+
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_TE_MAX_MS * NSEC_PER_MSEC, &limit);
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_TE_WAKE_US * NSEC_PER_USEC, &wake);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	if (fTELast != 0 && fTEPeriod != 0 && t0 - fTELast < second) {
+		uint64_t next = fTELast + ((t0 - fTELast) / fTEPeriod + 1) * fTEPeriod, ns;
+
+		if (next - t0 > wake + wake) {
+			absolutetime_to_nanoseconds(next - t0 - wake, &ns);
+			IOSleep((unsigned)(ns / NSEC_PER_MSEC));
+		}
+	}
+	a34_dsi_wr(SWEET_FB_DSI_INTSTA, ~SWEET_FB_TE_RDY);
+	for (;;) {
+		now = mach_absolute_time();
+		if ((a34_dsi_rd(SWEET_FB_DSI_INTSTA) & SWEET_FB_TE_RDY) != 0) {
+			break;
+		}
+		if (now - t0 > limit) {
+			*waited = now - t0;
+			return false;
+		}
+	}
+	*waited = now - t0;
+	fTELast = now;
+	return true;
+}
+
+/*
+ * A34 (0930): the kick (its own work loop) with fNewPath: the DSI idle, the
+ * queued picture taken, the TE, the OVL layers pointed at it, the start, the
+ * transfer waited for.
+ */
+void
+AppleCLCD::kickFlip(void)
+{
+	uint64_t wait = 0, xfer = 0, tew = 0;
+	int32_t t;
+
+	if (!a34_dsi_wait_idle(&wait)) {
+		a34_kick_stats[5]++;
+		a34_disp_dump("busy for 1 s before a start");
+		if (a34_dsi_lock()) {
+			a34_dsi_recover();
+			a34_dsi_unlock();
+		}
+	}
+	IOLockLock(fFlipLock);
+	t = fQueued;
+	if (t < 0 || t == fWriting) {
+		IOLockUnlock(fFlipLock);
+		return;
+	}
+	fQueued = -1;
+	fTaken = t;
+	IOLockUnlock(fFlipLock);
+	if (fTE) {
+		sweet_fb_flip_stats[7]++;
+		if (!teWait(&tew)) {
+			sweet_fb_flip_stats[9]++;
+		}
+		sweet_fb_flip_stats[8] += tew;
+	}
+	if (!a34_dsi_lock()) {
+		a34_kick_stats[5]++;
+		IOLockLock(fFlipLock);
+		fTaken = -1;
+		if (fQueued < 0) {
+			fQueued = t;            /* (sent by the next kick) */
+		}
+		IOLockWakeup(fFlipLock, &fTaken, false);
+		IOLockUnlock(fFlipLock);
+		return;
+	}
+	uint64_t again = 0;
+	(void)a34_dsi_wait_idle(&again);        /* (the console may have started one meanwhile) */
+	if (t != fShown) {
+		for (unsigned o = 0; o < 2; o++) {
+			for (unsigned n = 0; n < 4; n++) {
+				if ((fOvlFlip[o] & (1u << n)) != 0) {
+					fOvl[o][SWEET_FB_OVL_ADDR(n) / 4] = (uint32_t)fBufPA[t];
+				}
+			}
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		sweet_fb_flip_stats[5]++;
+		IOLockLock(fFlipLock);
+		fShown = t;
+		IOLockUnlock(fFlipLock);
+	}
+	a34_dsi_trigger();
+	a34_dsi_unlock();
+	sweet_fb_flip_stats[6]++;
+	IODelay(50);
+	if (!a34_dsi_wait_idle(&xfer)) {
+		a34_kick_stats[5]++;
+		a34_disp_dump("transfer did not finish in 1 s");
+		if (a34_dsi_lock()) {
+			a34_dsi_recover();
+			a34_dsi_trigger();
+			a34_dsi_unlock();
+			IODelay(50);
+			(void)a34_dsi_wait_idle(&again);
+		}
+	}
+	a34_kick_stats[0]++;
+	a34_kick_stats[1] += wait;
+	a34_kick_stats[2] += xfer;
+	if (wait > a34_kick_stats[3]) {
+		a34_kick_stats[3] = wait;
+	}
+	if (xfer > a34_kick_stats[4]) {
+		a34_kick_stats[4] = xfer;
+	}
+	IOLockLock(fFlipLock);
+	fTaken = -1;
+	IOLockWakeup(fFlipLock, &fTaken, false);
+	IOLockUnlock(fFlipLock);
+}
+
+/*
+ * A34 (0930): present()'s, with fNewPath: the picture this frame is drawn
+ * into. `full`: its bottom layer covers the panel and there are two
+ * pictures: the one neither being sent nor about to be (a queued one is
+ * drawn over, replaced). Otherwise the latest picture (the queued one, else
+ * the one sent last), after its transfer.
+ */
+int32_t
+AppleCLCD::drawTarget(bool full)
+{
+	int32_t t;
+
+	IOLockLock(fFlipLock);
+	if (full) {
+		t = fTaken >= 0 ? (fTaken ^ 1) : (fQueued >= 0 ? fQueued : (fShown ^ 1));
+		sweet_fb_flip_stats[0]++;
+	} else {
+		if (fTaken >= 0 && fQueued < 0) {
+			uint64_t t0 = mach_absolute_time(), deadline, waited;
+
+			clock_interval_to_deadline(SWEET_FB_DRAW_WAIT_MS, kMillisecondScale, &deadline);
+			while (fTaken >= 0 && fQueued < 0) {
+				if (IOLockSleepDeadline(fFlipLock, &fTaken, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+					break;
+				}
+			}
+			waited = mach_absolute_time() - t0;
+			sweet_fb_flip_stats[3]++;
+			if (waited > sweet_fb_flip_stats[4]) {
+				sweet_fb_flip_stats[4] = waited;
+			}
+		}
+		t = fQueued >= 0 ? fQueued : (fTaken >= 0 ? fTaken : fShown);
+		sweet_fb_flip_stats[1]++;
+	}
+	if (fQueued == t) {
+		fQueued = -1;                   /* (drawn over: not to be taken while it is) */
+		sweet_fb_flip_stats[2]++;
+	}
+	fWriting = t;
+	IOLockUnlock(fFlipLock);
+	return t;
+}
