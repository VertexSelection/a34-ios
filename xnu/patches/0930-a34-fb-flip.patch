+/* A34 (0930): present()'s: the frame is in picture `target`, for the kick to send. */
+void
+AppleCLCD::drawDone(int32_t target)
+{
+	IOLockLock(fFlipLock);
+	fWriting = -1;
+	fQueued = target;
+	IOLockUnlock(fFlipLock);
+}
