+/*
+ * A34 (0930): a layer's rectangle as present() copies it: r = source x, y,
+ * panel x, y, width, height, after the defaults, the shift from the
+ * presented size to the panel's and the clipping (moved from present()).
+ */
+void
+AppleCLCD::layerRect(const uint8_t *rec, uint32_t layer, const SweetSurface *s, int32_t r[6])
+{
+	const uint8_t *a = rec + 0x64 + 16 * layer;
+	const uint8_t *b = rec + 0xc4 + 16 * layer;
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+	int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (sx < 0 || sy < 0) {
+		sx = sy = 0;
+	}
+	if (dx < 0 || dy < 0) {
+		dx = dy = 0;
+	}
+	/* Logical (presented) display coordinates -> panel coordinates. */
+	dx -= fOffX;
+	dy -= fOffY;
+	if (dx < 0) {
+		sx -= dx;
+		w += dx;
+		dx = 0;
+	}
+	if (dy < 0) {
+		sy -= dy;
+		h += dy;
+		dy = 0;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fWidth - dx) {
+		w = (int32_t)fWidth - dx;
+	}
+	if (h > (int32_t)fHeight - dy) {
+		h = (int32_t)fHeight - dy;
+	}
+	r[0] = sx;
+	r[1] = sy;
+	r[2] = dx;
+	r[3] = dy;
+	r[4] = w;
+	r[5] = h;
+}
