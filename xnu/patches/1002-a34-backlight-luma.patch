+/*
+ * A34 (1002): the display's backlight, as iOS looks for it. CoreBrightness
+ * (backboardd, CBDisplayContaineriOS) only makes its display module for a
+ * service matching IOPropertyMatch { backlight-control = true } that conforms
+ * to AppleARMBacklight; QuartzCore (CADeviceHasBacklight) asks for the same
+ * service. Without it nobody ever commits a brightness to CoreAnimation
+ * (-[CAWindowServerDisplay commitBrightness:]), so its display's SDR nits stay
+ * 0 -- and below CA_LUMA_BOOST_NITS_MAX (20 nits) QuartzCore draws every frame
+ * once more through its luma boost pipeline (..._TlubA2Xhf_Isrc), on the
+ * iPhone X at full strength below 2 nits. A real iPhone at a normal brightness
+ * (above 20 nits) skips it. After the y2sios/z3sios ports (MIT,
+ * MiniIOMobileFramebuffer.cpp AppleARMBacklight). The panel's own brightness
+ * is not changed (yet): what iOS sets here and as IOMFBBrightnessLevel on the
+ * framebuffer is kept and logged ("A34 BL:"). Boot-arg a34fbbl=0: not published.
+ */
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	uint32_t fValue;                        /* IODisplayParameters brightness value, 0..SWEET_FB_BL_MAX */
+	uint32_t fRequests;
+	void publishParameters(void);
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static void sweet_fb_backlight_publish(AppleCLCD *fb);
