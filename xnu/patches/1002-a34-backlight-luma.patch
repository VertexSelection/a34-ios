+/*
+ * A34 (1002): AppleARMBacklight (above). IODisplayParameters = { brightness =
+ * { min 0, max SWEET_FB_BL_MAX, value } }, which CoreBrightness reads, and
+ * backlight-marketing-table, the nits (16.16) at each slider step 0..100 % that
+ * it reads off the same service on the iPhone X: here our own curve,
+ * 2 nits + (SWEET_FB_BL_NITS - 2) * step^2. Halfway is about 126 nits.
+ */
+#define SWEET_FB_BL_MAX         65536u
+#define SWEET_FB_BL_NITS        500u
+#define SWEET_FB_BL_STEPS       101u
+#define SWEET_FB_BL_SAY         24u     /* requests logged one by one, then every 64th */
+
+void
+AppleARMBacklight::publishParameters(void)
+{
+	OSDictionary *parameters = OSDictionary::withCapacity(1), *brightness = OSDictionary::withCapacity(3);
+
+	if (parameters != NULL && brightness != NULL) {
+		sweet_fb_set_number(brightness, "min", 0);
+		sweet_fb_set_number(brightness, "max", SWEET_FB_BL_MAX);
+		sweet_fb_set_number(brightness, "value", fValue);
+		parameters->setObject("brightness", brightness);
+		setProperty("IODisplayParameters", parameters);
+	}
+	OSSafeReleaseNULL(brightness);
+	OSSafeReleaseNULL(parameters);
+}
+
+/*
+ * What CoreBrightness sets here: brightness / backlight-level (0..max, or
+ * { value = N }), IODisplayParameters.brightness, brightness-nits and the like.
+ * Numbers under those names are kept (read back as set); anything else is
+ * logged and refused.
+ */
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	static const char * const kept[] = { "brightness", "backlight-level", "brightness-nits", "brightness-nits-cap",
+		                             "DisplayBrightness" };
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator *keys;
+	OSObject *next;
+	bool refused = false;
+	char who[32] = "?";
+
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	proc_selfname(who, sizeof(who));
+	fRequests++;
+	keys = OSCollectionIterator::withCollection(dict);
+	if (keys == NULL) {
+		return kIOReturnNoMemory;
+	}
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol *key = OSDynamicCast(OSSymbol, next);
+		OSObject *value = key != NULL ? dict->getObject(key) : NULL;
+		OSNumber *number = OSDynamicCast(OSNumber, value);
+		OSDictionary *inner = OSDynamicCast(OSDictionary, value);
+		bool level = false, known = false;
+
+		if (key == NULL) {
+			continue;
+		}
+		if (key->isEqualTo("IODisplayParameters") && inner != NULL) {
+			inner = OSDynamicCast(OSDictionary, inner->getObject("brightness"));
+			number = inner != NULL ? OSDynamicCast(OSNumber, inner->getObject("value")) : NULL;
+			level = known = number != NULL;
+		} else {
+			if (number == NULL && inner != NULL) {
+				number = OSDynamicCast(OSNumber, inner->getObject("value"));
+			}
+			for (unsigned i = 0; i < sizeof(kept) / sizeof(kept[0]) && number != NULL; i++) {
+				if (key->isEqualTo(kept[i])) {
+					known = true;
+					level = i < 2;
+					setProperty(key, number);
+				}
+			}
+		}
+		if (level) {
+			uint64_t v = number->unsigned64BitValue();
+
+			fValue = v > SWEET_FB_BL_MAX ? SWEET_FB_BL_MAX : (uint32_t)v;
+			publishParameters();
+		}
+		refused |= !known;
+		if (fRequests <= SWEET_FB_BL_SAY || (fRequests % 64) == 0) {
+			IOLog("A34 BL: backlight request %u from %s: %s = %s%llu%s\n", fRequests, who, key->getCStringNoCopy(),
+			    number != NULL ? "" : "(not a number) ", number != NULL ? number->unsigned64BitValue() : 0ULL,
+			    known ? (level ? " (the level, of 65536)" : "") : ", refused");
+		}
+	}
+	keys->release();
+	return refused ? kIOReturnUnsupported : kIOReturnSuccess;
+}
+
+static void
+sweet_fb_backlight_publish(AppleCLCD *fb)
+{
+	AppleARMBacklight *backlight = OSTypeAlloc(AppleARMBacklight);
+	uint32_t table[SWEET_FB_BL_STEPS];
+	OSData *marketing;
+
+	for (uint32_t i = 0; i < SWEET_FB_BL_STEPS; i++) {
+		table[i] = (uint32_t)((2ULL << 16) + (uint64_t)(SWEET_FB_BL_NITS - 2) * 65536ULL * i * i /
+		    ((SWEET_FB_BL_STEPS - 1) * (SWEET_FB_BL_STEPS - 1)));
+	}
+	marketing = OSData::withBytes(table, sizeof(table));
+	if (backlight != NULL && marketing != NULL && backlight->init()) {
+		backlight->fValue = SWEET_FB_BL_MAX / 2;
+		backlight->setName("backlight");
+		backlight->setProperty("backlight-control", kOSBooleanTrue);
+		backlight->setProperty("backlight-marketing-table", marketing);
+		backlight->publishParameters();
+		if (backlight->attach(fb)) {
+			backlight->registerService();
+			IOLog("A34 BL: AppleARMBacklight published (IODisplayParameters 0..%u, marketing table 2..%u nits); "
+			    "CA's luma boost needs a brightness under 20 nits now (a34fbbl=0: off)\n", SWEET_FB_BL_MAX,
+			    SWEET_FB_BL_NITS);
+		}
+	}
+	OSSafeReleaseNULL(marketing);
+	OSSafeReleaseNULL(backlight);
+}
+
+/*
+ * A34 (1002): CoreBrightness sets IORegistryEntrySetCFProperty(the
+ * framebuffer, "IOMFBBrightnessLevel", nits in 16.16) once it has the
+ * backlight. Kept (and readable) and logged; anything else is refused as
+ * before (IOService's answer).
+ */
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSNumber *level = dict != NULL ? OSDynamicCast(OSNumber, dict->getObject("IOMFBBrightnessLevel")) : NULL;
+	char who[32] = "?";
+
+	proc_selfname(who, sizeof(who));
+	if (level == NULL || dict->getCount() != 1) {
+		static unsigned said;
+
+		if (said++ < 4) {
+			IOLog("A34 BL: framebuffer properties from %s refused (%u keys; only IOMFBBrightnessLevel is taken)\n", who,
+			    dict != NULL ? dict->getCount() : 0);
+		}
+		return kIOReturnUnsupported;
+	}
+	fBLLevel = level->unsigned32BitValue();
+	fBLLevels++;
+	setProperty("IOMFBBrightnessLevel", level);
+	if (fBLLevels <= SWEET_FB_BL_SAY || (fBLLevels % 64) == 0) {
+		IOLog("A34 BL: IOMFBBrightnessLevel %u from %s: %u.%03u nits (the panel is not changed)\n", fBLLevels, who,
+		    fBLLevel >> 16, (uint32_t)(((uint64_t)(fBLLevel & 0xffffu) * 1000) >> 16));
+	}
+	return kIOReturnSuccess;
+}
