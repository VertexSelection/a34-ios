+/* ---- the bridge to iOS's bluetoothd (0971) ---- */
+
+#define BR_TXQ                  16384u
+static LCK_MTX_DECLARE(br_lock, &bt_lck_grp);
+static uint8_t br_txq[BR_TXQ];
+static unsigned br_txq_count;
+static uint32_t br_txq_dropped, br_log_max = 600, br_said;
+static kern_ctl_ref br_ctl_ref;
+
+/* what bluetoothd wrote (the Skywalk channel's TX, or the control socket): queued, cut into packets by the bridge */
+void
+a34_bt_host_send(const uint8_t *bytes, unsigned length)
+{
+	lck_mtx_lock(&br_lock);
+	if (length <= BR_TXQ - br_txq_count) {
+		memcpy(br_txq + br_txq_count, bytes, length);
+		br_txq_count += length;
+	} else {
+		br_txq_dropped += length;
+	}
+	lck_mtx_unlock(&br_lock);
+	thread_wakeup(&bt_sleep_chan);
+}
+
+static void
+br_dump(const char *dir, const uint8_t *b, uint32_t n)
+{
+	static uint32_t data_said;
+
+	if (b[0] == 2 || b[0] == 3 || b[0] == 5) {             /* data: only the first few */
+		if (data_said++ >= 32) {
+			return;
+		}
+	} else if (br_said++ >= br_log_max) {
+		return;
+	}
+	bt_dump(dir, b, n, &(uint32_t){ 0 });
+}
+
+/* an event from the controller, before bluetoothd sees it: the answers Apple's stack does not take as they are */
+static void
+br_quirks(uint8_t *p, uint32_t n)
+{
+	static bool commands_said;
+	static uint32_t unknown_said;
+	uint16_t op;
+
+	if (n >= 7 && p[0] == 0x04 && p[1] == 0x0e) {
+		op = (uint16_t)(p[4] | (p[5] << 8));
+		if (op == 0x0c5b && p[6] != 0) {                       /* Write_Default_Erroneous_Data_Reporting */
+			p[6] = 0;
+		} else if (op == 0x1002 && p[6] == 0 && n >= 7 + 1 + 28) {
+			/* Read_Local_Supported_Commands (octet k at p[7 + k]): the MT6631 left the LE commands out (HackiOS) */
+			if (!commands_said) {
+				commands_said = true;
+				printf("A34 BT: br: supported commands octets 24-28: %02x %02x %02x %02x %02x%s\n", p[7 + 24],
+				    p[7 + 25], p[7 + 26], p[7 + 27], p[7 + 28], p[7 + 25] == 0 ? " (LE ones added)" : "");
+			}
+			if (p[7 + 25] == 0) {
+				static const uint8_t le_commands[4] = { 0xf7, 0xff, 0xff, 0x7f };
+
+				for (unsigned i = 0; i < 4; i++) {
+					p[7 + 25 + i] |= le_commands[i];
+				}
+				p[7 + 24] |= 0x60;
+			}
+		} else if (p[6] == 0x01 && unknown_said++ < 32) {
+			printf("A34 BT: br: the controller does not know command %04x\n", op);
+		}
+	} else if (n >= 7 && p[0] == 0x04 && p[1] == 0x0f && p[3] == 0x01) {
+		op = (uint16_t)(p[5] | (p[6] << 8));
+		if (op == 0x0c5b) {                                   /* (as a Command Status) */
+			p[1] = 0x0e;
+			p[2] = 4;
+			p[3] = 1;
+			p[4] = 0x5b;
+			p[5] = 0x0c;
+			p[6] = 0;
+		} else if (unknown_said++ < 32) {
+			printf("A34 BT: br: the controller does not know command %04x\n", op);
+		}
+	}
+}
+
+/* Apple's (Broadcom's) vendor command, answered here: Command Complete, status 0, and what its parser reads */
+static void
+br_vsc(const uint8_t *cmd, uint32_t n)
+{
+	static uint32_t said;
+	uint16_t op = (uint16_t)(cmd[1] | (cmd[2] << 8));
+	uint8_t sub = n > 4 ? cmd[4] : 0, ev[7 + 64];
+	unsigned extra = 0;
+
+	if (op == 0xfd1b) {
+		extra = 64;                                             /* BD_VSC_FACTORY_CAL_READ_TABLE */
+	} else if (op == 0xfce2 && (sub == 0x15 || sub == 0x36)) {
+		extra = 16;                                             /* OLYMPIC antenna preference, retain LE duplicates */
+	} else if (op == 0xfd48) {
+		extra = 1;
+	}
+	bzero(ev, sizeof(ev));
+	ev[0] = 0x04;
+	ev[1] = 0x0e;
+	ev[2] = (uint8_t)(4 + extra);
+	ev[3] = 1;
+	ev[4] = cmd[1];
+	ev[5] = cmd[2];
+	ev[6] = 0;
+	if (op == 0xfd1b) {
+		ev[7] = 0x51;
+	}
+	if (said++ < 64) {
+		printf("A34 BT: br: vendor command %04x (%u bytes, first %02x) answered here, %u byte(s) of data\n", op, n - 4, sub,
+		    extra);
+	}
+	br_dump("br=", ev, 7 + extra);
+	bt_deliver(ev, 7 + extra);
+	a34_btsk_deliver(ev, 7 + extra);
+}
+
+/* bluetoothd's packets out, whole; true if any went */
+static bool
+br_drain(void)
+{
+	static uint8_t pkt[BT_PKT_MAX];
+	bool did = false;
+
+	for (;;) {
+		unsigned have, n;
+
+		lck_mtx_lock(&br_lock);
+		have = br_txq_count;
+		if (have == 0) {
+			lck_mtx_unlock(&br_lock);
+			break;
+		}
+		if (br_txq[0] < 1 || br_txq[0] > 5 || br_txq[0] == 4) {
+			printf("A34 BT: br: %u bytes from bluetoothd begin with %02x, not a packet a host sends: dropped\n", have, br_txq[0]);
+			br_txq_count = 0;
+			lck_mtx_unlock(&br_lock);
+			break;
+		}
+		n = bt_h4_length(br_txq, have);
+		if (n > BT_PKT_MAX) {
+			printf("A34 BT: br: a packet of %u bytes from bluetoothd: dropped with the %u bytes queued\n", n, have);
+			br_txq_count = 0;
+			lck_mtx_unlock(&br_lock);
+			break;
+		}
+		if (n == 0 || n > have) {
+			lck_mtx_unlock(&br_lock);
+			break;
+		}
+		memcpy(pkt, br_txq, n);
+		memmove(br_txq, br_txq + n, have - n);
+		br_txq_count = have - n;
+		lck_mtx_unlock(&br_lock);
+		did = true;
+		bt_deliver(pkt, n);                                     /* (the raw channel sees bluetoothd's side too) */
+		if (pkt[0] == 0x01 && (pkt[2] >> 2) == 0x3f) {
+			br_vsc(pkt, n);
+			continue;
+		}
+		br_dump("br>", pkt, n);
+		(void)bt_btif_write(pkt, n);
+	}
+	return did;
+}
+
+/*
+ * What is heard over LE, every 10 s while anything is: advertising reports (legacy 0x3e/0x02 and extended
+ * 0x3e/0x0d), devices (a few dozen told apart by address, which is never said), Apple's (manufacturer data of company
+ * 0x004c) and Apple's "proximity pairing" adverts (type 0x07: AirPods and Beats, with their model bytes).
+ */
+static struct {
+	uint32_t reports, apple, proximity, start_ms;
+	uint32_t addrs[48], naddrs, apple_addrs[16], napple;
+	int best_rssi;
+	uint8_t model[2];
+	int model_rssi;
+} br_le;
+
+static void
+br_le_one(const uint8_t *addr, const uint8_t *data, uint32_t len, int rssi)
+{
+	uint32_t h = ((uint32_t)addr[0] | ((uint32_t)addr[1] << 8) | ((uint32_t)addr[2] << 16)) ^ ((uint32_t)addr[3] << 24) ^
+	    ((uint32_t)addr[4] << 4) ^ ((uint32_t)addr[5] << 12);
+	bool apple = false, seen = false;
+
+	br_le.reports++;
+	if (rssi != 127 && rssi > br_le.best_rssi) {
+		br_le.best_rssi = rssi;
+	}
+	for (uint32_t i = 0; i < br_le.naddrs; i++) {
+		seen |= br_le.addrs[i] == h;
+	}
+	if (!seen && br_le.naddrs < 48) {
+		br_le.addrs[br_le.naddrs++] = h;
+	}
+	for (uint32_t at = 0; at + 1 < len; ) {
+		uint32_t l = data[at];
+
+		if (l == 0 || at + 1 + l > len) {
+			break;
+		}
+		if (data[at + 1] == 0xff && l >= 3 && data[at + 2] == 0x4c && data[at + 3] == 0x00) {
+			apple = true;
+			if (l >= 8 && data[at + 4] == 0x07) {                   /* proximity pairing: 07 len prefix model(2) ... */
+				br_le.proximity++;
+				if (rssi != 127 && (br_le.model_rssi == 0 || rssi > br_le.model_rssi)) {
+					br_le.model[0] = data[at + 7];
+					br_le.model[1] = data[at + 8];
+					br_le.model_rssi = rssi;
+				}
+			}
+		}
+		at += 1 + l;
+	}
+	if (apple) {
+		br_le.apple++;
+		seen = false;
+		for (uint32_t i = 0; i < br_le.napple; i++) {
+			seen |= br_le.apple_addrs[i] == h;
+		}
+		if (!seen && br_le.napple < 16) {
+			br_le.apple_addrs[br_le.napple++] = h;
+		}
+	}
+}
+
+static void
+br_le_heard(const uint8_t *p, uint32_t n)
+{
+	uint32_t count, at;
+
+	if (n < 5 || p[0] != 0x04 || p[1] != 0x3e) {
+		return;
+	}
+	count = p[4];
+	at = 5;
+	if (p[3] == 0x02) {                                             /* LE Advertising Report */
+		for (uint32_t i = 0; i < count && at + 9 <= n; i++) {
+			uint32_t dl = p[at + 8];
+
+			if (at + 9 + dl + 1 > n) {
+				break;
+			}
+			br_le_one(p + at + 2, p + at + 9, dl, (int8_t)p[at + 9 + dl]);
+			at += 10 + dl;
+		}
+	} else if (p[3] == 0x0d) {                                      /* LE Extended Advertising Report */
+		for (uint32_t i = 0; i < count && at + 24 <= n; i++) {
+			uint32_t dl = p[at + 23];
+
+			if (at + 24 + dl > n) {
+				break;
+			}
+			br_le_one(p + at + 3, p + at + 24, dl, (int8_t)p[at + 13]);
+			at += 24 + dl;
+		}
+	}
+	if (br_le.start_ms == 0) {
+		br_le.start_ms = bt_ms() | 1;
+	}
+}
+
+static void
+br_le_say(void)
+{
+	if (br_le.start_ms == 0 || bt_ms() - br_le.start_ms < 10000) {
+		return;
+	}
+	printf("A34 BT: LE heard in %u s: %u reports from %u devices (best %d dBm); Apple: %u reports from %u devices; "
+	    "proximity pairing (AirPods/Beats): %u%s",
+	    (bt_ms() - br_le.start_ms) / 1000, br_le.reports, br_le.naddrs, br_le.best_rssi, br_le.apple, br_le.napple,
+	    br_le.proximity, br_le.proximity ? "" : "\n");
+	if (br_le.proximity) {
+		printf(", strongest at %d dBm, model bytes %02x %02x\n", br_le.model_rssi, br_le.model[0], br_le.model[1]);
+	}
+	bzero(&br_le, sizeof(br_le));
+	br_le.best_rssi = -128;
+}
+
+/* the kernel control bluetoothd's H4BC transport connects to */
+static errno_t
+br_ctl_connect(__unused kern_ctl_ref ref, struct sockaddr_ctl *sac, __unused void **unitinfo)
+{
+	char name[32] = "";
+
+	proc_selfname(name, sizeof(name));
+	lck_mtx_lock(&br_lock);
+	br_txq_count = 0;                                               /* a new user: nothing half-written from the last */
+	lck_mtx_unlock(&br_lock);
+	printf("A34 BT: br: com.apple.uart.sk.bluetooth connected by %s[%d], unit %u\n", name, proc_selfpid(), sac->sc_unit);
+	return 0;
+}
+
+static errno_t
+br_ctl_disconnect(__unused kern_ctl_ref ref, u_int32_t unit, __unused void *unitinfo)
+{
+	printf("A34 BT: br: com.apple.uart.sk.bluetooth unit %u disconnected\n", unit);
+	return 0;
+}
+
+static errno_t
+br_ctl_send(__unused kern_ctl_ref ref, __unused u_int32_t unit, __unused void *unitinfo, mbuf_t m, __unused int flags)
+{
+	for (mbuf_t part = m; part != NULL; part = mbuf_next(part)) {
+		a34_bt_host_send(mbuf_data(part), (unsigned)mbuf_len(part));
+	}
+	mbuf_freem(m);
+	return 0;
+}
+
+static errno_t
+br_ctl_setopt(__unused kern_ctl_ref ref, __unused u_int32_t unit, __unused void *unitinfo, int opt, void *data, size_t len)
+{
+	static uint32_t said;
+
+	if (said++ < 16) {
+		const uint32_t *w = data;
+
+		if (len >= 12 && w != NULL) {
+			printf("A34 BT: br: setsockopt %#x, %zu bytes (%#x %#x %#x): taken\n", (unsigned)opt, len, w[0], w[1], w[2]);
+		} else {
+			printf("A34 BT: br: setsockopt %#x, %zu bytes: taken\n", (unsigned)opt, len);
+		}
+	}
+	return 0;
+}
+
+static errno_t
+br_ctl_getopt(__unused kern_ctl_ref ref, __unused u_int32_t unit, __unused void *unitinfo, int opt, void *data, size_t *len)
+{
+	uuid_t uuid;
+	bool have = (unsigned)opt == 0x40105412u && data != NULL && *len >= sizeof(uuid_t) && a34_btsk_uuid(uuid);
+	static uint32_t said;
+
+	if (said++ < 16) {
+		printf("A34 BT: br: getsockopt %#x, room for %zu bytes: %s\n", (unsigned)opt, *len, have ? "the channel's UUID" : "nothing");
+	}
+	if (have) {
+		memcpy(data, uuid, sizeof(uuid_t));
+		*len = sizeof(uuid_t);
+	} else {
+		*len = 0;
+	}
+	return 0;
+}
+
+static bool
+br_ctl_register(void)
+{
+	struct kern_ctl_reg reg;
+	errno_t error;
+
+	bzero(&reg, sizeof(reg));
+	strlcpy(reg.ctl_name, "com.apple.uart.sk.bluetooth", sizeof(reg.ctl_name));
+	reg.ctl_flags = CTL_FLAG_REG_SOCK_STREAM;        /* (any user: bluetoothd is mobile; a datagram socket is refused) */
+	reg.ctl_sendsize = 65536;
+	reg.ctl_recvsize = 65536;
+	reg.ctl_connect = br_ctl_connect;
+	reg.ctl_disconnect = br_ctl_disconnect;
+	reg.ctl_send = br_ctl_send;
+	reg.ctl_setopt = br_ctl_setopt;
+	reg.ctl_getopt = br_ctl_getopt;
+	error = ctl_register(&reg, &br_ctl_ref);
+	printf("A34 BT: br: kernel control com.apple.uart.sk.bluetooth %s (%d)\n", error == 0 ? "registered" : "NOT REGISTERED", error);
+	return error == 0;
+}
