+static int
+br_node_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	switch (cmd) {
+	case TIOCGETA: {
+		struct termios *t = (struct termios *)(void *)data;
+
+		bzero(t, sizeof(*t));
+		t->c_cflag = CS8 | CREAD | CLOCAL | HUPCL;
+		t->c_ispeed = t->c_ospeed = 3000000;
+		return 0;
+	}
+	case TIOCMGET:
+		*(int *)(void *)data = TIOCM_CTS | TIOCM_DSR | TIOCM_CAR | TIOCM_RTS | TIOCM_DTR;
+		return 0;
+	case FIONREAD:
+		*(int *)(void *)data = 0;
+		return 0;
+	case TIOCSETA: case TIOCSETAW: case TIOCSETAF: case TIOCEXCL: case TIOCNXCL: case TIOCSDTR: case TIOCCDTR:
+	case TIOCMBIS: case TIOCMBIC: case TIOCMSET: case TIOCFLUSH: case TIOCSBRK: case TIOCCBRK: case TIOCDRAIN:
+	case FIONBIO: case FIOASYNC:
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+br_node_select(__unused dev_t dev, __unused int which, __unused void *wql, __unused struct proc *p)
+{
+	return 1;
+}
+
+static const struct cdevsw br_cdevsw = {
+	.d_open = br_node_open, .d_close = br_node_close, .d_read = br_node_read, .d_write = br_node_write,
+	.d_ioctl = br_node_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = br_node_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+br_nodes(void)
+{
+	static const char *const names[] = { "btwake", "btreset", "btpoweroff" };
+	int major = cdevsw_add(-1, &br_cdevsw);
+	bool made = major >= 0;
+
+	for (unsigned i = 0; made && i < sizeof(names) / sizeof(names[0]); i++) {
+		made = devfs_make_node(makedev(major, i), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "%s", names[i]) != NULL;
+	}
+	printf("A34 BT: br: /dev/btwake, /dev/btreset, /dev/btpoweroff %s (major %d)\n", made ? "made" : "NOT MADE", major);
+}
+
+/* everything bluetoothd looks for; the registry's service last, so that whoever finds it finds the rest there */
+static void
+br_start(void)
+{
+	bool node = false;
+
+	a34_btsk_init();
+	br_nodes();
+	if (!br_ctl_register()) {
+		return;
+	}
+	for (unsigned tries = 0; tries < 40 && !(node = a34_bt_registry(bt_addr)); tries++) {
+		bt_sleep_ms(250);
+	}
+	printf("A34 BT: br: bridge to bluetoothd %s\n", node ? "up: waiting for bluetoothd" : "up, but the registry's service could not be made");
+}
+
+static void
+bt_idle(uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bt_sleep_chan, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
