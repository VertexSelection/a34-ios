diff --git a/bsd/dev/a34_btsk.c b/bsd/dev/a34_btsk.c
new file mode 100644
index 0000000..05798bf
--- /dev/null
+++ b/bsd/dev/a34_btsk.c
@@ -0,0 +1,353 @@
+/*
+ * A34 (0971): the Skywalk channel iOS's bluetoothd reaches its Bluetooth controller by.
+ *
+ * Ported from HackiOS's bsd/dev/redwood_btsk.c (github.com/oosexgang/hakios-xnu-kernel, branch mtk, commit
+ * c36d664; Apple Public Source License 2.0, as the XNU it extends), where it carried iOS 16.5's bluetoothd to an
+ * MT6631; iOS 16.7.16's bluetoothd opens the same way (docs/bluetooth-plan.md, section 3). Its HCI transport
+ * "H4BC" connects a stream socket to the kernel control com.apple.uart.sk.bluetooth (a34_bt.c), sets a channel
+ * specification (option 0x800c5414) and asks for a channel's UUID (option 0x40105412), then os_channel_create()s
+ * the channel, syncs its rings and waits for them on a kqueue. On an iPhone the other end is IOSkywalkFamily, a
+ * kernel pipe (NEXUS_TYPE_KERNEL_PIPE) whose "driver" is the Bluetooth UART's; here it is the MediaTek controller
+ * behind BTIF (a34_bt.c), made by bsd/skywalk/nexus/kpipe/nx_kpipe_loopback.c's pattern:
+ *   user TX ring  -> sync_tx -> the H4 bytes of each slot to a34_bt_host_send (whole packets made there)
+ *   controller    -> a34_btsk_deliver -> a queue -> sync_rx fills the user's RX ring (a byte stream: the user parses H4)
+ * Changes from HackiOS: logging to the console (a34btlog lines), and the controller's bytes are queued only while a
+ * channel is connected -- the queue starts empty at each connection, so a bluetoothd that restarts does not first
+ * read what was meant for the one before it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <libkern/libkern.h>
+#include <sys/systm.h>
+#include <sys/random.h>
+#include <skywalk/os_skywalk_private.h>
+
+extern void a34_bt_host_send(const uint8_t *bytes, unsigned length);  /* a34_bt.c: what bluetoothd writes */
+
+void a34_btsk_init(void);
+bool a34_btsk_uuid(uuid_t out);
+void a34_btsk_deliver(const uint8_t *bytes, unsigned length);
+bool a34_btsk_connected(void);
+
+static LCK_GRP_DECLARE(btsk_lck_grp, "a34_btsk");
+static LCK_MTX_DECLARE(btsk_lock, &btsk_lck_grp);
+
+#define BTSK_RXQ        32768u
+static uint8_t btsk_rxq[BTSK_RXQ];
+static unsigned btsk_rxq_head, btsk_rxq_count;
+static uint32_t btsk_rxq_dropped;
+
+static nexus_controller_t btsk_ncd;
+static uuid_t btsk_dom_uuid, btsk_prov_uuid, btsk_nx_uuid;
+static bool btsk_ready, btsk_up;
+static uintptr_t btsk_nx_ctx;
+static kern_channel_ring_t btsk_txring, btsk_rxring;
+static kern_pbufpool_t btsk_tx_pp, btsk_rx_pp;
+static uint32_t btsk_said;
+
+#define SAY(...) do { if (btsk_said < 200) { btsk_said++; printf("A34 BT: channel: " __VA_ARGS__); } } while (0)
+
+static errno_t
+btsk_dom_init(__unused kern_nexus_domain_provider_t domprov)
+{
+	return 0;
+}
+
+static void
+btsk_dom_fini(__unused kern_nexus_domain_provider_t domprov)
+{
+}
+
+static errno_t
+btsk_pre_connect(__unused kern_nexus_provider_t nxprov, proc_t p, kern_nexus_t nexus, nexus_port_t port,
+    kern_channel_t channel, void **ch_ctx)
+{
+	errno_t error = kern_nexus_get_pbufpool(nexus, &btsk_tx_pp, &btsk_rx_pp);
+
+	*ch_ctx = channel;
+	SAY("pre_connect by pid %d, port %u: buffer pools %s (%d)\n", proc_pid(p), port,
+	    btsk_tx_pp != NULL && btsk_rx_pp != NULL ? "there" : "MISSING", error);
+	return 0;
+}
+
+static errno_t
+btsk_connected(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_t channel)
+{
+	lck_mtx_lock(&btsk_lock);
+	btsk_rxq_head = 0;
+	btsk_rxq_count = 0;
+	btsk_up = true;
+	lck_mtx_unlock(&btsk_lock);
+	SAY("connected: bluetoothd's packets now go to the controller and back\n");
+	return 0;
+}
+
+static void
+btsk_pre_disconnect(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_t channel)
+{
+	lck_mtx_lock(&btsk_lock);
+	btsk_up = false;
+	lck_mtx_unlock(&btsk_lock);
+	SAY("pre_disconnect\n");
+}
+
+static void
+btsk_disconnected(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_t channel)
+{
+	SAY("disconnected (%u bytes from the controller were dropped on a full queue)\n", btsk_rxq_dropped);
+}
+
+static errno_t
+btsk_ring_init(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_t channel,
+    kern_channel_ring_t ring, boolean_t is_tx_ring, void **ring_ctx)
+{
+	lck_mtx_lock(&btsk_lock);
+	if (is_tx_ring) {
+		btsk_txring = ring;
+	} else {
+		btsk_rxring = ring;
+	}
+	lck_mtx_unlock(&btsk_lock);
+	*ring_ctx = ring;
+	SAY("%s ring made\n", is_tx_ring ? "TX" : "RX");
+	return 0;
+}
+
+static void
+btsk_ring_fini(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, kern_channel_ring_t ring)
+{
+	lck_mtx_lock(&btsk_lock);
+	if (ring == btsk_txring) {
+		btsk_txring = NULL;
+	} else if (ring == btsk_rxring) {
+		btsk_rxring = NULL;
+	}
+	lck_mtx_unlock(&btsk_lock);
+}
+
+static errno_t
+btsk_slot_init(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_ring_t ring,
+    channel_slot_t slot, __unused uint32_t slot_id, struct kern_slot_prop **slot_prop_addr, void **pslot_ctx)
+{
+	*slot_prop_addr = NULL;
+	*pslot_ctx = slot;
+	return 0;
+}
+
+static void
+btsk_slot_fini(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, __unused kern_channel_ring_t ring,
+    __unused channel_slot_t slot, __unused uint32_t slot_id)
+{
+}
+
+/* the user's packets (H4 bytes, a slot at a time) to the controller */
+static errno_t
+btsk_sync_tx(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, kern_channel_ring_t ring, __unused uint32_t flags)
+{
+	kern_channel_slot_t slot = kern_channel_get_next_slot(ring, NULL, NULL), last = NULL;
+
+	while (slot != NULL) {
+		kern_packet_t ph = kern_channel_slot_get_packet(ring, slot);
+
+		if (ph != 0) {
+			kern_buflet_t buf = kern_packet_get_next_buflet(ph, NULL);
+
+			if (buf != NULL) {
+				uint8_t *base = kern_buflet_get_data_address(buf);
+				uint16_t length = kern_buflet_get_data_length(buf), offset = kern_buflet_get_data_offset(buf);
+
+				if (base != NULL && length > 0) {
+					a34_bt_host_send(base + offset, length);
+				}
+			}
+			(void)kern_channel_slot_detach_packet(ring, slot, ph);
+			if (btsk_tx_pp != NULL) {
+				kern_pbufpool_free(btsk_tx_pp, ph);
+			}
+		}
+		last = slot;
+		slot = kern_channel_get_next_slot(ring, slot, NULL);
+	}
+	if (last != NULL) {
+		kern_channel_advance_slot(ring, last);
+	}
+	(void)kern_channel_reclaim(ring);
+	return 0;
+}
+
+/* the controller's bytes into the user's ring */
+static errno_t
+btsk_sync_rx(__unused kern_nexus_provider_t nxprov, __unused kern_nexus_t nexus, kern_channel_ring_t ring, __unused uint32_t flags)
+{
+	kern_channel_slot_t slot, last = NULL;
+
+	(void)kern_channel_reclaim(ring);
+	slot = kern_channel_get_next_slot(ring, NULL, NULL);
+	lck_mtx_lock(&btsk_lock);
+	while (slot != NULL && btsk_rxq_count > 0 && btsk_rx_pp != NULL) {
+		kern_packet_t ph = 0;
+		kern_buflet_t buf;
+		uint8_t *base;
+		unsigned room, n = btsk_rxq_count;
+
+		if (kern_pbufpool_alloc_nosleep(btsk_rx_pp, 1, &ph) != 0 || ph == 0) {
+			SAY("no packet for an RX slot\n");
+			break;
+		}
+		buf = kern_packet_get_next_buflet(ph, NULL);
+		base = buf != NULL ? kern_buflet_get_data_address(buf) : NULL;
+		room = buf != NULL ? kern_buflet_get_data_limit(buf) : 0;
+		if (base == NULL || room == 0) {
+			kern_pbufpool_free(btsk_rx_pp, ph);
+			break;
+		}
+		if (n > room) {
+			n = room;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			base[i] = btsk_rxq[(btsk_rxq_head + i) % BTSK_RXQ];
+		}
+		btsk_rxq_head = (btsk_rxq_head + n) % BTSK_RXQ;
+		btsk_rxq_count -= n;
+		(void)kern_buflet_set_data_offset(buf, 0);
+		(void)kern_buflet_set_data_length(buf, (uint16_t)n);
+		(void)kern_packet_finalize(ph);
+		if (kern_channel_slot_attach_packet(ring, slot, ph) != 0) {
+			kern_pbufpool_free(btsk_rx_pp, ph);
+			break;
+		}
+		last = slot;
+		slot = kern_channel_get_next_slot(ring, slot, NULL);
+	}
+	lck_mtx_unlock(&btsk_lock);
+	if (last != NULL) {
+		kern_channel_advance_slot(ring, last);
+	}
+	return 0;
+}
+
+/* what the controller sent (whole H4 packets), while a channel is connected; wakes the user's ring */
+void
+a34_btsk_deliver(const uint8_t *bytes, unsigned length)
+{
+	kern_channel_ring_t ring;
+
+	lck_mtx_lock(&btsk_lock);
+	if (!btsk_ready || !btsk_up) {
+		lck_mtx_unlock(&btsk_lock);
+		return;
+	}
+	if (length > BTSK_RXQ - btsk_rxq_count) {
+		btsk_rxq_dropped += length;     /* (a whole packet or nothing: the user's H4 parser must not lose its place) */
+		lck_mtx_unlock(&btsk_lock);
+		return;
+	}
+	for (unsigned i = 0; i < length; i++) {
+		btsk_rxq[(btsk_rxq_head + btsk_rxq_count) % BTSK_RXQ] = bytes[i];
+		btsk_rxq_count++;
+	}
+	ring = btsk_rxring;
+	lck_mtx_unlock(&btsk_lock);
+	if (ring != NULL) {
+		(void)kern_channel_notify(ring, 0);
+	}
+}
+
+bool
+a34_btsk_connected(void)
+{
+	return btsk_up;
+}
+
+/* the channel's UUID, for bluetoothd's getsockopt; false until the nexus is made */
+bool
+a34_btsk_uuid(uuid_t out)
+{
+	if (!btsk_ready) {
+		return false;
+	}
+	uuid_copy(out, btsk_nx_uuid);
+	return true;
+}
+
+void
+a34_btsk_init(void)
+{
+	nexus_attr_t nxa = NULL;
+	errno_t error;
+	struct kern_nexus_domain_provider_init dom_init = {
+		.nxdpi_version = KERN_NEXUS_DOMAIN_PROVIDER_CURRENT_VERSION,
+		.nxdpi_flags = 0,
+		.nxdpi_init = btsk_dom_init,
+		.nxdpi_fini = btsk_dom_fini,
+	};
+	struct kern_nexus_provider_init prov_init = {
+		.nxpi_version = KERN_NEXUS_DOMAIN_PROVIDER_CURRENT_VERSION,
+		.nxpi_flags = NXPIF_VIRTUAL_DEVICE,
+		.nxpi_pre_connect = btsk_pre_connect,
+		.nxpi_connected = btsk_connected,
+		.nxpi_pre_disconnect = btsk_pre_disconnect,
+		.nxpi_disconnected = btsk_disconnected,
+		.nxpi_ring_init = btsk_ring_init,
+		.nxpi_ring_fini = btsk_ring_fini,
+		.nxpi_slot_init = btsk_slot_init,
+		.nxpi_slot_fini = btsk_slot_fini,
+		.nxpi_sync_tx = btsk_sync_tx,
+		.nxpi_sync_rx = btsk_sync_rx,
+		.nxpi_tx_doorbell = NULL,
+	};
+	struct kern_nexus_init nx_init = {
+		.nxi_version = KERN_NEXUS_CURRENT_VERSION,
+		.nxi_flags = 0,
+		.nxi_tx_pbufpool = NULL,
+		.nxi_rx_pbufpool = NULL,
+	};
+
+	if (btsk_ready) {
+		return;
+	}
+	read_random(&btsk_nx_ctx, sizeof(btsk_nx_ctx));
+	error = kern_nexus_register_domain_provider(NEXUS_TYPE_KERNEL_PIPE, (const uint8_t *)"a34_bt", &dom_init, sizeof(dom_init),
+	    &btsk_dom_uuid);
+	if (error != 0) {
+		printf("A34 BT: channel: domain provider: %d\n", error);
+		return;
+	}
+	if ((error = kern_nexus_controller_create(&btsk_ncd)) != 0) {
+		printf("A34 BT: channel: controller: %d\n", error);
+		return;
+	}
+	if ((error = kern_nexus_attr_create(&nxa)) != 0) {
+		printf("A34 BT: channel: attr: %d\n", error);
+		return;
+	}
+	(void)kern_nexus_attr_set(nxa, NEXUS_ATTR_ANONYMOUS, 1);
+	(void)kern_nexus_attr_set(nxa, NEXUS_ATTR_TX_RINGS, 1);
+	(void)kern_nexus_attr_set(nxa, NEXUS_ATTR_RX_RINGS, 1);
+	(void)kern_nexus_attr_set(nxa, NEXUS_ATTR_TX_SLOTS, 64);
+	(void)kern_nexus_attr_set(nxa, NEXUS_ATTR_RX_SLOTS, 64);
+	(void)kern_nexus_attr_set(nxa, NEXUS_ATTR_SLOT_BUF_SIZE, 2048);
+	error = kern_nexus_controller_register_provider(btsk_ncd, btsk_dom_uuid, (const uint8_t *)"com.apple.nexus.a34_bt", &prov_init,
+	    sizeof(prov_init), nxa, &btsk_prov_uuid);
+	kern_nexus_attr_destroy(nxa);
+	if (error != 0) {
+		printf("A34 BT: channel: provider: %d\n", error);
+		return;
+	}
+	error = kern_nexus_controller_alloc_provider_instance(btsk_ncd, btsk_prov_uuid, (const void *)btsk_nx_ctx, NULL, &btsk_nx_uuid, &nx_init);
+	if (error != 0) {
+		printf("A34 BT: channel: instance: %d\n", error);
+		return;
+	}
+	lck_mtx_lock(&btsk_lock);
+	btsk_ready = true;
+	lck_mtx_unlock(&btsk_lock);
+	{
+		uuid_string_t text;
+
+		uuid_unparse_upper(btsk_nx_uuid, text);
+		printf("A34 BT: channel: the Skywalk kernel pipe %s is up\n", text);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/A34Bluetooth.cpp b/iokit/Kernel/arm/A34Bluetooth.cpp
new file mode 100644
index 0000000..274a85b
--- /dev/null
+++ b/iokit/Kernel/arm/A34Bluetooth.cpp
@@ -0,0 +1,67 @@
+/*
+ * A34 (0971): the Bluetooth controller as iOS looks for it in the registry.
+ *
+ * bluetoothd finds its controller's address (FindLocalMacAddress: "No bluetooth on this device." without a non-zero
+ * one) and transport in the service named "marconi-bt" or, failing that, "bluetooth"; MobileBluetooth's
+ * BTSessionAttachWithQueue -- how Settings' Bluetooth pane reaches bluetoothd -- answers error 9 without one of them
+ * (docs/bluetooth-plan.md, section 3). An iPhone X's device tree has /arm-io/uart1/bluetooth; this phone's controller
+ * is in CONNSYS and our tree has no such node, so the service is made here once a34_bt.c has the controller up and
+ * its address set. Only local-mac-address is published: without transport-encoding bluetoothd takes 3 (H4BC), which
+ * is what this kernel serves.
+ *
+ * After HackiOS's iokit/Kernel/RedwoodBluetooth.cpp (github.com/oosexgang/hakios-xnu-kernel, branch mtk, c36d664;
+ * Apple Public Source License 2.0).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+
+class A34Bluetooth : public IOService
+{
+	OSDeclareDefaultStructors(A34Bluetooth);
+};
+
+OSDefineMetaClassAndStructors(A34Bluetooth, IOService);
+
+extern "C" bool a34_bt_registry(const uint8_t *address);
+
+static A34Bluetooth * a34_bt_node;
+
+/* The service "bluetooth" with this address (6 bytes, most significant first); true once it is in the registry. */
+bool
+a34_bt_registry(const uint8_t *address)
+{
+	IOService * platform = IOService::getPlatform();
+	A34Bluetooth * made;
+	OSData * data;
+
+	if (a34_bt_node != NULL) {
+		return true;
+	}
+	if (platform == NULL || (made = OSTypeAlloc(A34Bluetooth)) == NULL) {
+		return false;
+	}
+	if (!made->init() || !made->attach(platform)) {
+		made->release();
+		return false;
+	}
+	made->setName("bluetooth");
+	if ((data = OSData::withBytes(address, 6)) != NULL) {
+		made->setProperty("local-mac-address", data);
+		data->release();
+	}
+	if (!made->start(platform)) {
+		made->detach(platform);
+		made->release();
+		return false;
+	}
+	made->registerService();
+	a34_bt_node = made;
+	IOLog("A34 BT: the service \"bluetooth\" is in the registry, local-mac-address %02x:%02x:%02x:%02x:%02x:%02x\n",
+	    address[0], address[1], address[2], address[3], address[4], address[5]);
+	return true;
+}
+#endif /* SWEET */
