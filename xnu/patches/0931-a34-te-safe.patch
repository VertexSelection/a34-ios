+/*
+ * A34 (0931): whether the panel's TE reaches the DSI, before anything uses
+ * it (AppleCLCD::start only; never the console's path): TE_RDY counted for
+ * SWEET_FB_TE_PROBE_MS with DSI_TXRX_CTRL as found and, if its EXT_TE_EN is
+ * clear, again with it set, then TXRX_CTRL put back. No transfer is
+ * started: the DSI must be idle, the console's kicks only try the display
+ * lock held here, and the kick work loop does not exist yet.
+ */
+void
+AppleCLCD::teProbe(uint32_t *asFound, uint32_t *withBit, bool *bitFound)
+{
+	uint64_t idle = 0, period = 0, period2 = 0, ns;
+	uint32_t txrx, after;
+	bool idleAfter;
+
+	*asFound = *withBit = 0;
+	*bitFound = false;
+	if (!a34_dsi_lock()) {
+		IOLog("A34 FB FLIP: TE probe: the display lock is held: not probed\n");
+		return;
+	}
+	if (!a34_dsi_wait_idle(&idle, SWEET_FB_TE_PROBE_MS)) {
+		a34_dsi_unlock();
+		IOLog("A34 FB FLIP: TE probe: the DSI busy for %u ms: not probed\n", SWEET_FB_TE_PROBE_MS);
+		return;
+	}
+	txrx = a34_dsi_rd(SWEET_FB_DSI_TXRX_CTRL);
+	*bitFound = (txrx & SWEET_FB_EXT_TE_EN) != 0;
+	*asFound = teCount(SWEET_FB_TE_PROBE_MS, &period);
+	if (!*bitFound) {
+		a34_dsi_wr(SWEET_FB_DSI_TXRX_CTRL, txrx | SWEET_FB_EXT_TE_EN);
+		*withBit = teCount(SWEET_FB_TE_PROBE_MS, &period2);
+		a34_dsi_wr(SWEET_FB_DSI_TXRX_CTRL, txrx);
+	}
+	after = a34_dsi_rd(SWEET_FB_DSI_TXRX_CTRL);
+	idleAfter = a34_dsi_wait_idle(&idle, SWEET_FB_TE_PROBE_MS);
+	a34_dsi_unlock();
+	fTEPeriod = period != 0 ? period : period2;
+	absolutetime_to_nanoseconds(fTEPeriod, &ns);
+	IOLog("A34 FB FLIP: TE probe: TXRX_CTRL 0x%08x (EXT_TE_EN %u): %u TE in %u ms as found, %u with EXT_TE_EN set%s; "
+	    "TE period %llu us; TXRX_CTRL 0x%08x after, the DSI %s\n", txrx, *bitFound, *asFound, SWEET_FB_TE_PROBE_MS,
+	    *withBit, *bitFound ? " (it was)" : "", (unsigned long long)(ns / NSEC_PER_USEC), after,
+	    idleAfter ? "idle" : "BUSY");
+}
