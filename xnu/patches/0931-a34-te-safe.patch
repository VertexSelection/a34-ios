+/*
+ * A34 (0931): the kick's: EXT_TE_EN, set by us (a34fbte=2), cleared again
+ * because a transfer did not end with it (no TE: the frame waits for one);
+ * the pipe reset and the frame started again; TE no longer used.
+ */
+void
+AppleCLCD::teBitOff(const char *why)
+{
+	if (a34_dsi_lock()) {
+		a34_dsi_wr(SWEET_FB_DSI_TXRX_CTRL, a34_dsi_rd(SWEET_FB_DSI_TXRX_CTRL) & ~SWEET_FB_EXT_TE_EN);
+		a34_dsi_recover();
+		a34_dsi_trigger();
+		a34_dsi_unlock();
+	}
+	fTEBit = false;
+	fTEBitWanted = false;
+	fTE = false;
+	IOLog("A34 FB FLIP: %s with EXT_TE_EN set: it is cleared, the pipe reset, TE no longer used\n", why);
 }
 
