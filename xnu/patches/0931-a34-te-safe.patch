+/*
+ * A34 (0931): TE_RDY rises in `ms` milliseconds (bounded by mach time; a
+ * rise within 2 ms of the last one is the same TE and only cleared);
+ * *period: the mean time between them, 0 with fewer than two.
+ */
+uint32_t
+AppleCLCD::teCount(uint32_t ms, uint64_t *period)
+{
+	uint64_t t0 = mach_absolute_time(), now, limit, dead, first = 0, last = 0;
+	uint32_t n = 0;
+
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &limit);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &dead);
+	*period = 0;
+	a34_dsi_wr(SWEET_FB_DSI_INTSTA, ~SWEET_FB_TE_RDY);
+	for (now = t0; now - t0 < limit; now = mach_absolute_time()) {
+		if ((a34_dsi_rd(SWEET_FB_DSI_INTSTA) & SWEET_FB_TE_RDY) == 0) {
+			continue;
+		}
+		a34_dsi_wr(SWEET_FB_DSI_INTSTA, ~SWEET_FB_TE_RDY);
+		if (n != 0 && now - last < dead) {
+			continue;
+		}
+		if (n == 0) {
+			first = now;
+		}
+		last = now;
+		n++;
+	}
+	if (n >= 2) {
+		*period = (last - first) / (n - 1);
+	}
+	return n;
+}
