+static void
+cs_ph11_status(void)
+{
+	if (cs_sema_get(SEMA_SYSRAM)) {
+		setb(cs_sysram, 0x2834, 1u << 0);                                   /* RADIO_STATUS: Bluetooth */
+		cs_sema_put(SEMA_SYSRAM);
+	}
+}
