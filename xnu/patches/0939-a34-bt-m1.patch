+/* ---- ph12: Bluetooth's voltage raise (consys_plt_pmic_raise_voltage_mt6877, vcn13_1_37v) ---- */
+
+static void
+cs_ph12_raise(void)
+{
+	(void)cs_pmic_field(PMIC_VS2_ELR0, 0x7f, 0x35);                         /* VS2 1.4625 V */
+	(void)cs_pmic_write(PMIC_VS2_VOTER_SET, 0x10);                          /* ... voted for by CONNSYS (bit 4) */
+	(void)cs_pmic_field(PMIC_VS2_CON1, 0x7f, 0x2e);                         /* VS2 asleep 1.375 V */
+	(void)cs_pmic_field(PMIC_VCN13_ANA_CON0, 0x0f, 0x7);                    /* VCN13 +70 mV: 1.37 V */
+	delay(50);
+}
+
+/* ---- ph13: conn_infra settings (connsys_low_power_setting_mt6877, first on, RC mode) ---- */
+
+static void
+cs_ph13_settings(void)
+{
+	uint32_t x1 = 0, x2 = 0;
+
+	/* the A-die clock buffer for Bluetooth only (E2/E3 table; E1 differs in XTAL_02) */
+	cs_top_ck(true);
+	if (cs_sema_get(SEMA_RFSPI)) {
+		if (cs_spi_read(ATOP_XTAL_01, &x1)) {
+			(void)cs_spi_write(ATOP_XTAL_01, (x1 & ~0x0000c180u) | 0x00000100u);
+		}
+		if (cs_spi_read(ATOP_XTAL_02, &x2)) {
+			(void)cs_spi_write(ATOP_XTAL_02, (x2 & ~0xf0ff0080u) | (cs_adie_id == 0x66358a00u ? 0xf0ff0000u : 0x70ff0000u));
+		}
+		cs_sema_put(SEMA_RFSPI);
+	}
+	cs_top_ck(false);
+	field(cs_cfg, 0x200, 0xf000u, 0x1000u);                                 /* PWRCTRL0 sleep-ready mask */
+	/* RC mode: the per-subsystem RC oscillator controls */
+	wr(cs_cfg, 0x394, 0x02080706u);
+	clrb(cs_cfg, 0x390, 1u << 15);
+	wr(cs_cfg, 0x3a4, 0x02080706u);
+	clrb(cs_cfg, 0x3a0, 1u << 15);
+	wr(cs_cfg, 0x3b4, 0x02080706u);
+	clrb(cs_cfg, 0x3b0, 1u << 15);
+	wr(cs_cfg, 0x3c4, 0x02080706u);
+	clrb(cs_cfg, 0x3c0, 1u << 15);
+	setb(cs_cfg, 0x388, 1u << 3);
+	delay(30);
+	setb(cs_cfg, 0x388, (1u << 0) | (1u << 1) | (1u << 2));
+	setb(cs_cfg, 0x380, (1u << 4) | (1u << 5) | (1u << 6));
+	setb(cs_cfg, 0x400, 1u << 0);
+	clrb(cs_cfg, 0x380, 1u << 31);
+	clrb(cs_cfg, 0x380, 1u << 0);
+	field(cs_cfg, 0x300, 0x00ffffffu, 0x00080706u);
+	clrb(cs_cfg, 0x304, 1u << 16);
+	setb(cs_cfg, 0x380, 1u << 30);
+	field(cs_cfg, 0x388, 0xf0u, 0xd0u);
+	setb(cs_cfg, 0x400, 1u << 16);
+	setb(cs_cfg, 0x404, 1u << 1);
+	/* common */
+	field(cs_rgu, 0x020, 0xffff0040u, 0x42540000u);                         /* (keyed writes) */
+	field(cs_rgu, 0x010, 0xffff0040u, 0x57460000u);
+	setb(cs_cfg, 0x400, 1u << 18);
+	field(cs_cfg, 0x400, 0x00007ff0u, 1023u << 4);                          /* ddr_en timeout */
+	setb(cs_cfg, 0x400, 1u << 15);
+	clrb(cs_cfg, 0x400, 1u << 15);
+	field(cs_bcrm, 0x03c, 0x00f80000u, 0x00080000u);                        /* bus DCM */
+	field(cs_bcrm, 0x040, 0x000003e0u, 0x00000020u);
+	field(cs_bcrm, 0x03c, 0x3u, 0x3u);
+	field(cs_bcrm, 0x03c, 0x18u, 0x18u);
+	setb(cs_buscr, 0x238, (1u << 0) | (1u << 1) | (1u << 3) | (1u << 4));   /* light security */
+	field(cs_buscr, 0x300, 0x00007f80u, 0x12u << 7);                        /* conn_infra off/on bus timeouts */
+	field(cs_buscr, 0x300, 0x7u, 0x7u);
+	field(cs_buscr, 0x31c, 0x00007f80u, 0x02u << 7);
+	field(cs_buscr, 0x31c, 0x7u, 0x7u);
+	setb(cs_vdnr, 0x000, 1u << 9);                                          /* VDNR debug-ctrl bus timeout */
+	field(cs_vdnr, 0x000, 0xffff0000u, 0x07f40000u);
+	setb(cs_vdnr, 0x000, (1u << 2) | (1u << 3) | (1u << 4));
+	clrb(cs_vdnr, 0x000, 1u << 9);
+	wr(cs_toprgu, TOPRGU_SWSYSRST, (rd(cs_toprgu, TOPRGU_SWSYSRST) & ~0xff001000u) | 0x88000000u);
+	setb(cs_clkgen, 0x000, 1u << 0);                                        /* bus BPLL/WPLL dividers */
+	setb(cs_clkgen, 0x004, 1u << 0);
+	setb(cs_clkgen, 0x008, 1u << 0);
+	setb(cs_clkgen, 0x00c, 1u << 0);
+	clrb(cs_clkgen, 0x048, 1u << 7);                                        /* RF-SPI clock: BPLL / 13 */
+	setb(cs_clkgen, 0x048, 1u << 6);
+	setb(cs_clkgen, 0x048, 1u << 4);
+	field(cs_hc, 0x380, 1u << 31, 1u << 31);                                /* sleep counter */
+	field(cs_hc, 0x380, 1u << 0, 1u << 0);
+	setb(cs_clkgen, 0xa00, (1u << 0) | (1u << 1) | (1u << 2) | (1u << 3) | (1u << 4) | (1u << 5) |
+	    (1u << 25) | (1u << 26) | (1u << 27));                              /* coex, PTA, UART-PTA clocks */
+	setb(cs_cfg, 0x200, 1u << 9);
+	wr(cs_rgu, 0x204, 0x6);
+	clrb(cs_clkgen, 0xa00, 1u << 23);                                       /* bus clock: hardware control */
+	printf("A34 CONNSYS: ph13: PWRCTRL0 %#x, bus timeouts %#x/%#x, OSC %#x, RC_CTL %#x/%#x; XTAL %#x %#x\n",
+	    rd(cs_cfg, 0x200), rd(cs_buscr, 0x300), rd(cs_buscr, 0x31c), rd(cs_cfg, 0x300), rd(cs_cfg, 0x380),
+	    rd(cs_cfg, 0x388), x1, x2);
+	if (cs_deep) {
+		setb(cs_cfg, 0x200, 1u << 0);                               /* conn_infra may sleep (last) */
+	}
+}
+
+/* ---- ph15: VCN33_1 for Bluetooth (consys_pmic_vcn33_1_power_ctl_mt6877, RC mode) ---- */
+
+static void
+cs_ph15_vcn33(void)
+{
+	uint16_t mon = 0;
+
+	(void)cs_pmic_write(PMIC_VCN33_1_OP_EN_SET, 1u << 6);
+	(void)cs_pmic_write(PMIC_VCN33_1_OP_CFG_SET, 0);
+	(void)cs_pmic_write(PMIC_VCN33_1_OP_EN_SET, 1u << 5);
+	(void)cs_pmic_write(PMIC_VCN33_1_OP_CFG_SET, 0);
+	(void)cs_pmic_field(PMIC_VCN33_1_CON0, 1u << 1, 0);
+	(void)cs_pmic_field(PMIC_VCN33_1_ANA_CON0, 0x0f00u, 0x0d00u);          /* 3.3 V */
+	if (cs_vcn33) {
+		(void)cs_pmic_field(PMIC_VCN33_1_CON0, 1u << 0, 1u << 0);       /* also on by software (non-RC path) */
+		delay(300);
+	}
+	(void)cs_pmic_read(PMIC_VCN33_1_MON, &mon);
+	printf("A34 CONNSYS: ph15: VCN33_1 3.3 V for Bluetooth: %s (MON %#x)\n", (mon & 1u) ? "on" : "off for now", mon);
+}
+
+int
+a34_connsys_on(void)
+{
+	uint64_t emi = 0;
+	uint32_t v;
+
+	if (cs_up) {
+		return 0;
+	}
+	if (cs_tried) {
+		return EIO;
+	}
+	cs_tried = true;
+	if (PE_parse_boot_argn("a34btemi", &emi, sizeof(emi)) && emi != 0) {
+		cs_emi_pa = emi;
+	}
+	(void)PE_parse_boot_argn("a34btmpu", &cs_mpu, sizeof(cs_mpu));
+	(void)PE_parse_boot_argn("a34btvcn33", &cs_vcn33, sizeof(cs_vcn33));
+	(void)PE_parse_boot_argn("a34btlp", &cs_lp, sizeof(cs_lp));
+	(void)PE_parse_boot_argn("a34btdeep", &cs_deep, sizeof(cs_deep));
+	(void)PE_parse_boot_argn("a34btforce", &cs_force, sizeof(cs_force));
+	if ((cs_emi_pa & 0xfffffu) != 0 || cs_emi_pa + CS_EMI_SIZE > 0x100000000ull || cs_emi_pa < 0x40000000ull) {
+		printf("A34 CONNSYS: a34btemi=%#llx is not 1 MB aligned in DRAM below 4 GB\n", cs_emi_pa);
+		return EINVAL;
+	}
+	if (!cs_map()) {
+		printf("A34 CONNSYS: registers could not be mapped\n");
+		return ENOMEM;
+	}
+	printf("A34 CONNSYS: power on for Bluetooth: EMI %#llx + %#x, MPU %u, VCN33 by software %u, LDO low power %u, "
+	    "deep sleep %u\n", cs_emi_pa, CS_EMI_SIZE, cs_mpu, cs_vcn33, cs_lp, cs_deep);
+	if ((rd(cs_spm, SPM_PWR_STATUS) & (1u << 1)) && !cs_force) {
+		printf("A34 CONNSYS: the CONN domain is already on (PWR_STATUS %#x, CONN_PWR_CON %#x): stopping "
+		    "(a34btforce=1 goes on anyway)\n", rd(cs_spm, SPM_PWR_STATUS), rd(cs_spm, SPM_CONN_PWR_CON));
+		return EBUSY;
+	}
+	if (cs_mpu) {
+		cs_emi_mpu();
+	}
+	if (!cs_ph1_pmic()) {
+		printf("A34 CONNSYS: ph1: VCN18/VCN13 did not come on\n");
+		return EIO;
+	}
+	cs_ph2_pinmux();
+	printf("A34 CONNSYS: ph2: pinmux: GPIO_MODE24 %#x, GPIO_MODE25 %#x\n", rd(cs_gpio, 0x480), rd(cs_gpio, 0x490));
+	if (!cs_ph3_mtcmos()) {
+		return EIO;
+	}
+	/* ph4: the first access to CONNSYS's own bus */
+	printf("A34 CONNSYS: ph4: reading conn_infra's version\n");
+	for (int i = 0; i < 10 && (v = rd(cs_cfg, 0x000)) != 0x02060002u; i++) {
+		delay(1000);
+	}
+	v = rd(cs_cfg, 0x000);
+	printf("A34 CONNSYS: ph4: conn_infra version %#x (%s), host CSR clock detect %#x\n", v,
+	    v == 0x02060002u ? "as expected" : "NOT 0x02060002", rd(cs_hc, 0x000));
+	if (v != 0x02060002u) {
+		return EIO;
+	}
+	field(cs_hc, 0x1c4, 0x000fffffu, (uint32_t)(cs_emi_pa >> 16));         /* ph5: CONNSYS's memory */
+	field(cs_hc, 0x1d4, 0x000fffffu, 0x01000u);                             /* WF/BT/GPS peripherals: 0x1000_0000 */
+	field(cs_hc, 0x1d8, 0x000fffffu, 0x01000u);
+	field(cs_hc, 0x1dc, 0x000fffffu, 0x01000u);
+	printf("A34 CONNSYS: ph5: EMI remap %#x\n", rd(cs_hc, 0x1c4));
+	cs_ph6_ddie();
+	cs_ph7_sleep_ctl();
+	printf("A34 CONNSYS: ph6-7: D-die and sleep controller set (efuse %#x)\n", rd(cs_sysram, 0x2820));
+	if (!cs_ph8_adie()) {
+		cs_top_ck(false);
+		return EIO;
+	}
+	cs_ph9_afe_cal();
+	cs_ph10_pll();
+	cs_ph11_status();
+	printf("A34 CONNSYS: ph9-11: AFE calibrated, PLLs %#x, radio status %#x\n", rd(cs_afe, 0x004), rd(cs_sysram, 0x2834));
+	cs_ph12_raise();
+	cs_ph13_settings();
+	if (cs_lp) {
+		(void)cs_pmic_field(PMIC_VCN18_CON0, 1u << 1, 1u << 1);         /* ph14 */
+		(void)cs_pmic_field(PMIC_VCN13_CON0, 1u << 1, 1u << 1);
+	}
+	cs_ph15_vcn33();
+	cs_up = true;
+	printf("A34 CONNSYS: up (conn_infra %s)\n", cs_deep ? "may sleep now: a34_bt.c wakes it" : "kept awake");
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
