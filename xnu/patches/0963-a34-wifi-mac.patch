+/*
+ * (0963) The station's address. This phone's efuse holds none (00:00:00:00:00:00 on the
+ * phone); Android takes Samsung's from /efs, which is never read here. Instead every phone keeps
+ * its own on its iOS root: /a34/wifi/mac, one line "xx:xx:xx:xx:xx:xx", a random locally
+ * administered unicast address that userland/a34wifi writes once (when the file is not there)
+ * and never changes, so two A34s on one network do not share one. Without the file: the
+ * efuse's, if it ever has one, else a random one for this boot only.
+ */
+#define A34W_MAC_FILE                   "mac"
+
+static int
+a34w_hex(uint8_t c)
+{
+	return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+/* "xx:xx:xx:xx:xx:xx" (':' or '-'), then nothing but white space; locally administered, unicast, not all zero */
+static bool
+a34w_mac_parse(const uint8_t *text, uint32_t length, uint8_t mac[6])
+{
+	uint32_t at = 0;
+
+	while (at < length && (text[at] == ' ' || text[at] == '\t')) {
+		at++;
+	}
+	for (unsigned i = 0; i < 6u; i++) {
+		int hi, lo;
+
+		if (i != 0u) {
+			if (at >= length || (text[at] != ':' && text[at] != '-')) {
+				return false;
+			}
+			at++;
+		}
+		if (at + 2u > length || (hi = a34w_hex(text[at])) < 0 || (lo = a34w_hex(text[at + 1u])) < 0) {
+			return false;
+		}
+		mac[i] = (uint8_t)(hi << 4 | lo);
+		at += 2u;
+	}
+	for (; at < length; at++) {
+		if (text[at] != ' ' && text[at] != '\t' && text[at] != '\r' && text[at] != '\n') {
+			return false;
+		}
+	}
+	return (mac[0] & 3u) == 2u;     /* locally administered (bit 1), unicast (bit 0 clear): so never all zero */
+}
+
+/* `efuse`: the chip's own address, or NULL; leaves the one to use in a34w_mac and says where it came from */
+static const char *
+a34w_mac_choose(const uint8_t *efuse)
+{
+	uint32_t size = 0;
+	uint8_t *text = a34w_file(A34W_MAC_FILE, 12u, "userland/a34wifi writes it once", &size);
+	uint8_t kept[6];
+
+	if (text != NULL) {
+		bool good = size <= 64u && a34w_mac_parse(text, size, kept);
+
+		kfree_data(text, (vm_size_t)size);
+		if (good) {
+			memcpy(a34w_mac, kept, 6);
+			return "this phone's, kept in " A34W_FW_DIR A34W_MAC_FILE;
+		}
+		a34w_say("step 6: " A34W_FW_DIR A34W_MAC_FILE " (%u bytes) is not one line \"xx:xx:xx:xx:xx:xx\" with a "
+		    "locally administered unicast address: not used", size);
+	}
+	if (efuse != NULL) {
+		memcpy(a34w_mac, efuse, 6);
+		return "the chip's";
+	}
+	read_random(a34w_mac, 6);
+	a34w_mac[0] = (uint8_t)((a34w_mac[0] & 0xfcu) | 0x02u);
+	return "random, for this boot only: 'a34wifi mac' keeps one";
+}
