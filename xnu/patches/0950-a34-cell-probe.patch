+/* ---- a34cell=2: first contact (starts the modem LK loaded; no power or voltage change) ---- */
+
+#define AC_AP_CCIF_PA           0x10209000ull
+#define AC_MD_CCIF_PA           0x1020A000ull
+#define CCIF_BUSY               0x04u
+#define CCIF_RCHNUM             0x10u
+#define CCIF_ACK                0x14u
+#define CCIF_CHDATA             0x100u
+#define CCIF_SRAM_SIZE          512u
+#define CCIF_D2H_SRAM           15u
+#define AC_INFRA_CG1_CLR        0x08Cu
+#define AC_INFRA_CG3_CLR        0x0C4u
+#define AC_INFRA_CG3_STA        0x0C8u
+#define AC_INFRA_RST_SET        0x150u
+#define AC_INFRA_RST_CLR        0x154u
+#define AC_CCIF_CLK_REQUEST     14u
+#define AC_MD_KERNEL_BOOT_UP    0u
+#define AC_MD_INIT_CHK_ID       0x5555FFFFu
+#define AC_MD_PATTERN           0x49434343u
+
+static void
+ac_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb st" ::: "memory");
+}
+
+static void
+ac_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ac_tag_base, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * Android's order (ccci_fsm.c fsm_routine_start, ccci_hif_ccif.c ccif_start/ccci_reset_ccif_hw,
+ * md_sys1_platform.c md_cd_let_md_go), minus the power cycle: LK has powered the modem and its
+ * boot ROM check passed (checked first); no regulator, MTCMOS or clock-mux is changed here.
+ *   1. SMC CCIF_CLK_REQUEST; the six CCIF clock gates opened (infracfg_ao CG1 clr bits 23, 26,
+ *      12, 13; CG3 clr bits 10, 29).
+ *   2. CCIF reset (infracfg_ao +0x150/+0x154 bit 8), both CCIF SRAMs cleared.
+ *   3. SMC MD_POWER_CONFIG / MD_KERNEL_BOOT_UP ("make boot vector take effect").
+ *   4. Wait up to 30 s for the modem's first handshake: D2H_SRAM (bit 15) in AP_CCIF RCHNUM, the
+ *      CCCI header at CHDATA (channel 0, data[1] = MD_INIT_START_BOOT 0, reserved 0x5555FFFF)
+ *      and its feature query behind it (head/tail 0x49434343, 64 feature bytes), acknowledged.
+ * Not yet: the AP's runtime data answer (stage 1b proper), so the modem then waits and times
+ * out; the transmitter is never switched on by a modem that has not finished its handshake and
+ * read its NVRAM.
+ */
+/* SMC answer as hex and signed (ATF SiP: 0 ok, -1 not supported, -2 bad parameters, ...). */
+static void
+ac_smc_log(const char *what, const uint64_t r[4])
+{
+	printf("A34 CELL: SMC %s: a0 0x%llx (%lld) a1 0x%llx a2 0x%llx a3 0x%llx\n", what, r[0],
+	    (long long)r[0], r[1], r[2], r[3]);
+}
+
+/* Polls (base+off & mask) == want for up to ms milliseconds. */
+static bool
+ac_wait(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 100; i++) {
+		if ((ac_rd32(base, off) & mask) == want)
+			return true;
+		delay(10);
+	}
+	return false;
+}
+
+#define AC_TOPCKGEN_PA          0x10000000ull
+#define AC_SPM_POWERON_CONFIG   0x000u
+#define AC_SPM_POWER_ON_VAL1    0x008u
+#define AC_SPM_PROJECT_CODE     0x0B160001u
+#define AC_INFRA_PROT_SET       0x2A0u
+#define AC_INFRA_PROT_CLR       0x2A4u
+#define AC_INFRA_PROT_STA1      0x228u
+#define AC_INFRA_VDNR_SET       0xB84u
+#define AC_INFRA_VDNR_CLR       0xB88u
+#define AC_INFRA_VDNR_STA1      0xB90u
+#define AC_MD1_PROT_STEP1       (1u << 7)
+#define AC_MD1_PROT_STEP2       ((1u << 2) | (1u << 16) | (1u << 24))
+#define AC_PWR_RST_B            (1u << 0)
+#define AC_PWR_ON               (1u << 2)
+#define AC_MD_CHECK_FLAG        2u
+#define AC_MD_FLIGHT_MODE_SET   7u
+#define AC_UPDATE_MD_SEC_SMEM   11u     /* modem_secure_base.h */
+
+/*
+ * Android's way to start the modem LK left in its boot ROM (Samsung A34 kernel,
+ * eccci/fsm/ccci_fsm.c fsm_routine_start, md_sys1_platform.c md_start_platform /
+ * md_cd_power_off / md_cd_power_on / md_cd_let_md_go, clk-mt6877-pg.c MD1 MTCMOS), in its order:
+ *   1. SMC CCIF_CLK_REQUEST; CCIF clocks, reset, SRAM; shared memory and rings (a34_ccci.c)
+ *   2. first start only: BROM check (MD_CHECK_DONE, MD_CHECK_FLAG), then the modem powered OFF:
+ *      bus protection set (infracfg_ao 0x2A0 bit 7, then 0xB84 bits 2/16/24, acks 0x228/0xB90),
+ *      MD1_PWR_CON PWR_ON=0, MD_BUCK_ISO bits 0,1 set, PWR_RST_B=0; SMC MD_FLIGHT_MODE_SET(1);
+ *      topckgen +0 bits 8,9 set (md1 clock mux off)
+ *   3. powered ON: topckgen bits 8,9 cleared; srclken-o1 (SPM 0x10006000 = 0x0B160001, then
+ *      0x10006008 |= 0x8000, power-flow-config 0x2); SMC MD_FLIGHT_MODE_SET(0); MD_BUCK_ISO bits
+ *      cleared, PWR_RST_B=1, PWR_ON=1, PWR_STATUS bit 0; bus protection released (0xB88, 0x2A4)
+ *   4. SMC MD_POWER_CONFIG/MD_KERNEL_BOOT_UP ("make boot vector take effect")
+ * Not done: Android's md1_pmic_setting_on (vmodem/vsram 825 mV, vdigrf 700 mV): LK has set
+ * exactly these for the boot ROM ("latch vmodem 825000 uV" in its log) and nothing here turns
+ * them off, so no voltage is touched. Steps not in this platform's power-flow-config 0x2 are
+ * skipped as Android skips them (srcclkena, DPSW, PLL work-around).
+ */
+static void
+ac_first_contact(void)
+{
+	uint64_t r[4];
+	vm_offset_t infra = ml_io_map((vm_offset_t)AC_INFRA_PA, PAGE_SIZE);
+	vm_offset_t ap = ml_io_map((vm_offset_t)AC_AP_CCIF_PA, PAGE_SIZE);
+	vm_offset_t md = ml_io_map((vm_offset_t)AC_MD_CCIF_PA, PAGE_SIZE);
+	vm_offset_t spm = ml_io_map((vm_offset_t)AC_SPM_PA, PAGE_SIZE);
+	vm_offset_t top = ml_io_map((vm_offset_t)AC_TOPCKGEN_PA, PAGE_SIZE);
+
+	if (!infra || !ap || !md || !spm || !top)
+		return;
+	printf("A34 CELL: first contact (a34cell=%u): Android's start sequence, then the modem let go\n", ac_mode);
+
+	/* 1. CCIF */
+	ac_smc(AC_CCIF_CLK_REQUEST, 0, r);
+	ac_smc_log("CCIF_CLK_REQUEST", r);
+	ac_wr32(infra, AC_INFRA_CG1_CLR, (1u << 23) | (1u << 26) | (1u << 12) | (1u << 13));
+	ac_wr32(infra, AC_INFRA_CG3_CLR, (1u << 10) | (1u << 29));
+	uint32_t cg1 = ac_rd32(infra, AC_INFRA_CG1_STA), cg3 = ac_rd32(infra, AC_INFRA_CG3_STA);
+	printf("A34 CELL: CCIF clock gates now CG1 0x%08x CG3 0x%08x (bits 23/26/12/13, 10/29 should be 0)\n",
+	    cg1, cg3);
+	if ((cg1 >> 23 & 1) || (cg1 >> 26 & 1)) {
+		printf("A34 CELL: CCIF clocks still gated: stopping before touching CCIF\n");
+		AC_NOTE("contact=noclk");
+		return;
+	}
+	ac_wr32(infra, AC_INFRA_RST_SET, 1u << 8);
+	ac_wr32(infra, AC_INFRA_RST_CLR, 1u << 8);
+	for (uint32_t o = 0; o < CCIF_SRAM_SIZE; o += 4) {
+		ac_wr32(ap, CCIF_CHDATA + o, 0);
+		ac_wr32(md, CCIF_CHDATA + o, 0);
+	}
+	printf("A34 CELL: CCIF reset, SRAM cleared (AP RCHNUM 0x%08x BUSY 0x%08x)\n",
+	    ac_rd32(ap, CCIF_RCHNUM), ac_rd32(ap, CCIF_BUSY));
+	/* shared memory and rings before the modem runs, as Android's ccif_start (a34_ccci.c) */
+	bool staged = a34_ccci_prepare(ap, md);
+	if (!staged)
+		printf("A34 CELL: shared memory not prepared: the modem is let go for its handshake only\n");
+
+	/* 2. BROM check, then off */
+	ac_smc(AC_MD_POWER_CONFIG, 3, r);
+	ac_smc_log("MD_CHECK_DONE", r);
+	ac_smc(AC_MD_POWER_CONFIG, AC_MD_CHECK_FLAG, r);
+	ac_smc_log("MD_CHECK_FLAG", r);
+	ac_wr32(infra, AC_INFRA_PROT_SET, AC_MD1_PROT_STEP1);
+	bool p1 = ac_wait(infra, AC_INFRA_PROT_STA1, AC_MD1_PROT_STEP1, AC_MD1_PROT_STEP1, 10);
+	ac_wr32(infra, AC_INFRA_VDNR_SET, AC_MD1_PROT_STEP2);
+	bool p2 = ac_wait(infra, AC_INFRA_VDNR_STA1, AC_MD1_PROT_STEP2, AC_MD1_PROT_STEP2, 10);
+	printf("A34 CELL: MD1 bus protection set: step 1 %s, step 2 %s\n", p1 ? "acked" : "NO ACK", p2 ? "acked" : "NO ACK");
+	if (!p1 || !p2) {
+		ac_wr32(infra, AC_INFRA_VDNR_CLR, AC_MD1_PROT_STEP2);
+		ac_wr32(infra, AC_INFRA_PROT_CLR, AC_MD1_PROT_STEP1);
+		printf("A34 CELL: bus protection not acknowledged: released again, the modem left as it was\n");
+		AC_NOTE("contact=noprot");
+		return;
+	}
+	ac_wr32(spm, AC_SPM_POWERON_CONFIG, AC_SPM_PROJECT_CODE);
+	ac_wr32(spm, AC_SPM_MD1_PWR_CON, ac_rd32(spm, AC_SPM_MD1_PWR_CON) & ~AC_PWR_ON);
+	bool off = ac_wait(spm, AC_SPM_PWR_STATUS, 1, 0, 10);
+	ac_wr32(spm, AC_SPM_MD_BUCK_ISO, ac_rd32(spm, AC_SPM_MD_BUCK_ISO) | 1u);
+	ac_wr32(spm, AC_SPM_MD_BUCK_ISO, ac_rd32(spm, AC_SPM_MD_BUCK_ISO) | 2u);
+	ac_wr32(spm, AC_SPM_MD1_PWR_CON, ac_rd32(spm, AC_SPM_MD1_PWR_CON) & ~AC_PWR_RST_B);
+	ac_smc(AC_MD_FLIGHT_MODE_SET, 1, r);
+	ac_smc_log("MD_FLIGHT_MODE_SET(1)", r);
+	ac_wr32(top, 0, ac_rd32(top, 0) | (1u << 8) | (1u << 9));
+	printf("A34 CELL: MD1 powered off%s: PWR_CON 0x%08x STATUS 0x%08x/0x%08x BUCK_ISO 0x%08x topckgen 0x%08x\n",
+	    off ? "" : " (status bit still set)", ac_rd32(spm, AC_SPM_MD1_PWR_CON), ac_rd32(spm, AC_SPM_PWR_STATUS),
+	    ac_rd32(spm, AC_SPM_PWR_STATUS_2ND), ac_rd32(spm, AC_SPM_MD_BUCK_ISO), ac_rd32(top, 0));
+
+	/* 3. on: step 1 PMIC (md1_pmic_setting_on), then the clocks and the power domain */
+	a34_ccci_md_pmic("before power on", true);
+	ac_wr32(top, 0, ac_rd32(top, 0) & ~((1u << 8) | (1u << 9)));
+	ac_wr32(spm, AC_SPM_POWERON_CONFIG, AC_SPM_PROJECT_CODE);
+	ac_wr32(spm, AC_SPM_POWER_ON_VAL1, ac_rd32(spm, AC_SPM_POWER_ON_VAL1) | 0x8000u);
+	ac_smc(AC_MD_FLIGHT_MODE_SET, 0, r);
+	ac_smc_log("MD_FLIGHT_MODE_SET(0)", r);
+	ac_wr32(spm, AC_SPM_MD_BUCK_ISO, ac_rd32(spm, AC_SPM_MD_BUCK_ISO) & ~1u);
+	ac_wr32(spm, AC_SPM_MD_BUCK_ISO, ac_rd32(spm, AC_SPM_MD_BUCK_ISO) & ~2u);
+	ac_wr32(spm, AC_SPM_MD1_PWR_CON, ac_rd32(spm, AC_SPM_MD1_PWR_CON) | AC_PWR_RST_B);
+	ac_wr32(spm, AC_SPM_MD1_PWR_CON, ac_rd32(spm, AC_SPM_MD1_PWR_CON) | AC_PWR_ON);
+	bool on = ac_wait(spm, AC_SPM_PWR_STATUS, 1, 1, 10) && ac_wait(spm, AC_SPM_PWR_STATUS_2ND, 1, 1, 10);
+	ac_wr32(infra, AC_INFRA_VDNR_CLR, AC_MD1_PROT_STEP2);
+	ac_wr32(infra, AC_INFRA_PROT_CLR, AC_MD1_PROT_STEP1);
+	printf("A34 CELL: MD1 powered on%s: PWR_CON 0x%08x STATUS 0x%08x/0x%08x BUCK_ISO 0x%08x topckgen 0x%08x POWER_ON_VAL1 0x%08x\n",
+	    on ? "" : " (STATUS bit not set!)", ac_rd32(spm, AC_SPM_MD1_PWR_CON), ac_rd32(spm, AC_SPM_PWR_STATUS),
+	    ac_rd32(spm, AC_SPM_PWR_STATUS_2ND), ac_rd32(spm, AC_SPM_MD_BUCK_ISO), ac_rd32(top, 0),
+	    ac_rd32(spm, AC_SPM_POWER_ON_VAL1));
+	if (!on) {
+		AC_NOTE("contact=nopower");
+		return;
+	}
+
+	/* 4. let go */
+	ac_smc(AC_MD_POWER_CONFIG, AC_MD_KERNEL_BOOT_UP, r);
+	ac_smc_log("MD_KERNEL_BOOT_UP (ret, boot_status_0, boot_status_1, boot_slave)", r);
+	/* md_cd_start under MTK_TC10_FEATURE_MD1_SEC (Samsung's build): right after let_md_go the
+	 * kernel asks ATF to update the modem's secure shared memory (UPDATE_MD_SEC_SMEM, 11). */
+	ac_smc(AC_UPDATE_MD_SEC_SMEM, 0, r);
+	ac_smc_log("UPDATE_MD_SEC_SMEM (size)", r);
+	ac_boot_status();
+
+	uint32_t seen = 0;
+	for (int i = 0; i < 3000; i++) {
+		uint32_t ch = ac_rd32(ap, CCIF_RCHNUM);
+		if (ch & ~seen) {
+			printf("A34 CELL: CCIF from the modem: RCHNUM 0x%08x after %d ms\n", ch, i * 10);
+			seen |= ch;
+		}
+		if (ch & (1u << CCIF_D2H_SRAM)) {
+			uint32_t h[4], f[56];
+			for (int k = 0; k < 4; k++)
+				h[k] = ac_rd32(ap, CCIF_CHDATA + 4u * (uint32_t)k);
+			for (int k = 0; k < 56; k++)
+				f[k] = ac_rd32(ap, CCIF_CHDATA + 16u + 4u * (uint32_t)k);
+			ac_wr32(ap, CCIF_ACK, ch & 0xFFFFu);
+			bool hs1 = h[1] == 0 && (h[2] & 0xFFFF) == 0 && h[3] == AC_MD_INIT_CHK_ID;
+			printf("A34 CELL: %s: header %08x %08x %08x %08x; feature query head 0x%08x tail 0x%08x\n",
+			    hs1 ? "HS1 -- the modem is running and asks for the AP's features" : "SRAM message",
+			    h[0], h[1], h[2], h[3], f[0], f[17]);
+			char hex[64 * 2 + 1];
+			const uint8_t *fb = (const uint8_t *)&f[1];
+			for (int k = 0; k < 64; k++)
+				snprintf(hex + 2 * k, 3, "%02x", fb[k]);
+			printf("A34 CELL: modem feature set: %s\n", hex);
+			AC_NOTE("contact=%s", hs1 ? "hs1" : "sram");
+			ac_smc(AC_MD_POWER_CONFIG, AC_MD_BOOT_STATUS, r);
+			printf("A34 CELL: MD boot status now 0x%llx 0x%llx\n", r[1], r[2]);
+			if (hs1 && ac_mode >= 3 && staged)
+				a34_ccci_hs1(ap, md, f);        /* 0951: the answer, the rings, the ports */
+			return;
+		}
+		if (ch)
+			ac_wr32(ap, CCIF_ACK, ch & 0xFFFFu);
+		ac_sleep_ms(10);
+	}
+	ac_smc(AC_MD_POWER_CONFIG, AC_MD_BOOT_STATUS, r);
+	printf("A34 CELL: no handshake in 30 s (RCHNUM seen 0x%08x); MD boot status 0x%llx 0x%llx\n",
+	    seen, r[1], r[2]);
+	AC_NOTE("contact=none");
+}
+
+/* ---- 5. the md1img partition ---- */
+
+#define MD_MAGIC        0x58881688u
+#define MD_EXT_MAGIC    0x58891689u
+
+/* Where md1drdi's data sits in the md1img partition (for bsd/dev/a34_ccci.c's DRDI check). */
+static uint64_t ac_drdi_off;
+static uint32_t ac_drdi_size;
+
+bool a34_cell_md1img_drdi(uint64_t *off, uint32_t *size);
+bool
+a34_cell_md1img_drdi(uint64_t *off, uint32_t *size)
+{
+	*off = ac_drdi_off;
+	*size = ac_drdi_size;
+	return ac_drdi_size != 0;
+}
+
+static void
+ac_md1img(void)
+{
+	uint8_t h[512];
+	uint64_t part = 0, off = 0;
+	int nsec = 0;
+	char platform[20] = "", build[70] = "", ver[70] = "";
+	const uint32_t tsz = 4096;
+	uint8_t *t = kalloc_data(tsz, Z_WAITOK);
+
+	if (!t)
+		return;
+	if (sweet_ufs_read_part("md1img", 0, h, sizeof(h), &part) != 0) {
+		printf("A34 CELL: md1img: cannot read\n");
+		AC_NOTE("md1img=unreadable");
+		kfree_data(t, tsz);
+		return;
+	}
+	for (int i = 0; i < 48; i++) {
+		if (i > 0 && sweet_ufs_read_part("md1img", off, h, sizeof(h), NULL) != 0)
+			break;
+		if (le32(h) != MD_MAGIC)
+			break;
+		uint32_t dsize = le32(h + 4);
+		char name[36];
+		ac_printable(name, sizeof(name), h + 8, 32);
+		uint32_t hsz = 512, align = 16, last = 0;
+		if (le32(h + 48) == MD_EXT_MAGIC) {
+			hsz = le32(h + 52);
+			last = le32(h + 64);
+			align = le32(h + 68);
+			if (hsz < 64 || hsz > 4096)
+				hsz = 512;
+			if (align == 0 || align > 4096)
+				align = 16;
+		}
+		nsec++;
+		printf("A34 CELL: md1img 0x%08llx %-24s %u bytes\n", off, name, dsize);
+		if (strcmp(name, "md1drdi") == 0 && !ac_drdi_size) {
+			ac_drdi_off = off + hsz;
+			ac_drdi_size = dsize;
+		}
+		if (strcmp(name, "md1rom") == 0 && dsize >= tsz) {
+			/* CHECK_HEADER sits at the end of md1rom's data (v6: platform at +24,
+			 * build time at +40, build version at +104). */
+			uint64_t tail = off + hsz + dsize - tsz;
+			if (sweet_ufs_read_part("md1img", tail, t, tsz, NULL) == 0) {
+				for (int k = (int)tsz - 168; k >= 0; k -= 4) {
+					if (memcmp(t + k, "CHECK_HEADER", 12) == 0) {
+						ac_printable(platform, sizeof(platform), t + k + 24, 16);
+						ac_printable(build, sizeof(build), t + k + 40, 64);
+						ac_printable(ver, sizeof(ver), t + k + 104, 64);
+						printf("A34 CELL: md1rom CHECK_HEADER v%u: platform %s, built %s, %s\n",
+						    le32(t + k + 12), platform, build, ver);
+						break;
+					}
+				}
+			}
+		}
+		off += (uint64_t)hsz + dsize;
+		off = (off + align - 1) / align * align;
+		if (last || off + 512 > part)
+			break;
+	}
+	kfree_data(t, tsz);
+	printf("A34 CELL: md1img: %d sections, partition %llu MiB\n", nsec, part >> 20);
+	AC_NOTE("md1img=%dsec,%s", nsec, platform[0] ? platform : "?");
+}
+
+static void
+ac_partitions(void)
+{
+	static const char *const names[] = {
+		"md1img", "md_udc", "nvcfg", "nvdata", "nvram", "protect1", "protect2", "proinfo",
+	};
+
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		uint64_t first = 0, n = 0;
+		if (sweet_ufs_part_bounds(names[i], &first, &n) == 0)
+			printf("A34 CELL: partition %-9s first block 0x%llx, %llu KiB (bounds only; never "
+			    "written, contents not read)\n", names[i], first, n * 4);
+		else
+			printf("A34 CELL: partition %-9s not found\n", names[i]);
+	}
+}
+
+static void
+ac_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	uint64_t deadline;
+	clock_interval_to_deadline(3, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&ac_mode, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+	/* Parts can be left out, to find which one matters (defaults: everything):
+	 *   a34cellfdt=0    LK's device tree and tag table not read
+	 *   a34cellsmc=0    no secure-monitor queries
+	 *   a34cellparts=N  0: no partition I/O at all, 1: GPT bounds only, 2: and md1img's headers */
+	uint32_t want_fdt = 1, want_smc = 1, want_parts = 2;
+	(void)PE_parse_boot_argn("a34cellfdt", &want_fdt, (int)sizeof(want_fdt));
+	(void)PE_parse_boot_argn("a34cellsmc", &want_smc, (int)sizeof(want_smc));
+	(void)PE_parse_boot_argn("a34cellparts", &want_parts, (int)sizeof(want_parts));
+	printf("A34 CELL: stage 0 probe (a34cell=%u fdt=%u smc=%u parts=%u): read only, nothing is written\n",
+	    ac_mode, want_fdt, want_smc, want_parts);
+	strlcpy(ac_state, "stage0", sizeof(ac_state));
+	if (want_fdt)
+		ac_lk_fdt();
+	bool on = ac_md1_power();
+	ac_ccif_clocks();
+	bool brom = false;
+	if (on && want_smc) {
+		ac_boot_status();
+		brom = ac_brom_check();
+	}
+	else
+		printf("A34 CELL: no boot status query (MD1 %s, a34cellsmc=%u)\n", on ? "on" : "off", want_smc);
+	if (want_parts >= 1)
+		ac_partitions();
+	if (want_parts >= 2)
+		ac_md1img();
+	if (ac_mode >= 2) {
+		if (ac_lk_md == 1 && on && brom)
+			ac_first_contact();
+		else
+			printf("A34 CELL: a34cell=2 needs a modem LK loaded (%d), MD1 on (%d) and BROM PASS (%d): "
+			    "not started\n", ac_lk_md, on, brom);
+	}
+	printf("A34 CELL: summary: %s\n", ac_state);
+	if (ac_lk_md != 1)
+		printf("A34 CELL: the modem cannot be started from this boot: LK loads and verifies "
+		    "md1img only on a normal (non-recovery) boot (docs/cellular-plan.md, stage 1)\n");
+}
+
+void
+a34_cell_init(void)
+{
+	thread_t t;
+
+	(void)PE_parse_boot_argn("a34cell", &ac_mode, (int)sizeof(ac_mode));
+	if (ac_mode == 0)
+		return;
+	if (kernel_thread_start(ac_thread, NULL, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+}
+#else
+void a34_cell_init(void);
+void
+a34_cell_init(void)
+{
+}
+#endif
diff --git a/bsd/dev/a34_cellfs.c b/bsd/dev/a34_cellfs.c
new file mode 100644
index 0000000..8910512
--- /dev/null
+++ b/bsd/dev/a34_cellfs.c
@@ -0,0 +1,1368 @@
+/*
+ * A34 (0951): the modem's file server, in the kernel and read only.
+ *
+ * What Android's ccci_fsd (inside /vendor/bin/ccci_mdinit) does for the modem's NVRAM, on CCCI
+ * channels 14/15 (queue 4): the modem opens, reads, writes, lists files of its drives
+ * (Z: nvdata/md, X: protect1/md, Y: protect2/md, V: nvdata/md_cmn, P: nvcfg; others have no
+ * partition here). Wire protocol as read out of ccci_mdinit (docs/cellular-plan.md, stage 1c).
+ *
+ * Rules (non-negotiable): the files are read in place, from the phone's own partitions, through
+ * sweet_ufs_read_part() (read-only list) and a34_ext4ro.c (no write path), and handed only to the
+ * modem. Their contents are never logged (names, sizes and counts only), never copied anywhere
+ * but into the reply to the modem, never written back: what the modem writes, deletes or renames
+ * lives in a RAM overlay for this session. The flash backup/restore operations (BIN_REGION,
+ * RESTORE) and OTP are refused with the values Android's server returns when they fail.
+ *
+ * One exception, approved for diagnosis (boot-arg a34cellmdtrace=1, off by default): the
+ * printable text the modem writes during this boot into its own boot trace and mini dump
+ * (Z:/nv_boot_trace, X:/nv_mini_dump) is logged as "A34 CELL MDTRACE:" lines, every run of 6 or
+ * more digits and every hex-like run of 8 or more characters masked with '#'. Nothing read from
+ * the flash and no other file is ever logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/kalloc.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include "a34_ccci.h"
+#include "a34_ext4ro.h"
+
+#define SLOTS           5
+#define SLOT_SIZE       0x40dcu
+#define STREAM_MAX      0x40c8u
+#define MAX_ARGS        6
+#define NHANDLES        129
+#define OV_FILES        128
+#define OV_BYTES_MAX    (8u << 20)
+#define KEY_MAX         192
+
+/* FS error codes (Android's server's numbers) */
+#define E_PARAM         (-2)
+#define E_DRIVE         (-4)
+#define E_TOO_MANY      (-5)
+#define E_NO_MORE       (-6)
+#define E_NOT_FOUND     (-9)
+#define E_HANDLE        (-10)
+#define E_OTP           (-12)
+#define E_ACCESS        (-16)
+#define E_GENERAL       (-18)
+#define E_PATH          (-19)
+
+static char *
+last_char(char *s, int c)
+{
+	char *r = NULL;
+
+	for (; *s; s++)
+		if (*s == c)
+			r = s;
+	return r;
+}
+
+static uint32_t
+g32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* ---- the file systems ---- */
+
+static struct fsys {
+	const char *part;
+	bool tried, ok;
+	struct ext4ro fs;
+	uint8_t *scratch;
+} fsy[4] = { { "nvdata" }, { "protect1" }, { "protect2" }, { "nvcfg" } };
+
+static int
+part_read(void *ctx, uint64_t off, void *buf, uint32_t len)
+{
+	return sweet_ufs_read_part((const char *)ctx, off, buf, len, NULL);
+}
+
+static struct ext4ro *
+fs_of(int i)
+{
+	struct fsys *f = &fsy[i];
+
+	if (!f->tried) {
+		f->tried = true;
+		f->scratch = kalloc_data(3 * EXT4RO_MAX_BLOCK, Z_WAITOK);
+		int e = f->scratch ? ext4ro_mount(&f->fs, part_read, (void *)(uintptr_t)f->part, f->scratch) : -12;
+		f->ok = e == 0;
+		printf("A34 CELL FS: %s %s (block %u)\n", f->part, f->ok ? "mounted read only" : "not readable", f->ok ? f->fs.bsize : 0);
+	}
+	return f->ok ? &f->fs : NULL;
+}
+
+/* ---- paths: UCS-2 from the modem -> "D:/rest" key, file system and its path ---- */
+
+struct path {
+	char key[KEY_MAX];      /* "Z:/NVRAM/NVD_DATA/X" (the overlay's name) */
+	int fsi;                /* -1: a drive without a partition here */
+	char fspath[KEY_MAX];   /* "/md/NVRAM/NVD_DATA/X" inside the file system */
+};
+
+static int
+conv_path(const uint8_t *u, uint32_t ulen, struct path *p)
+{
+	uint32_t n = 0;
+
+	for (uint32_t i = 0; i + 1 < ulen + 1 && 2 * i < ulen; i++) {
+		char c = (char)u[2 * i];
+		if (c == 0)
+			break;
+		if (n + 1 >= KEY_MAX)
+			return -49;
+		p->key[n++] = c == '\\' ? '/' : c;
+	}
+	p->key[n] = 0;
+	for (uint32_t i = 0; i + 1 < n; i++)
+		if (p->key[i] == '.' && p->key[i + 1] == '.')
+			return E_ACCESS;
+	if (n < 2 || p->key[1] != ':')
+		return E_PATH;
+	static const struct { char d; int fsi; const char *pre; } map[] = {
+		{ 'Z', 0, "/md" }, { 'X', 1, "/md" }, { 'Y', 2, "/md" }, { 'V', 0, "/md_cmn" }, { 'P', 3, "" },
+		{ 'W', -1, "" }, { 'U', -1, "" }, { 'T', -1, "" }, { 'S', -1, "" }, { 'R', -1, "" },
+		{ 'Q', -1, "" }, { 'O', -1, "" },
+	};
+	for (size_t i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
+		if (map[i].d == p->key[0]) {
+			p->fsi = map[i].fsi;
+			snprintf(p->fspath, sizeof(p->fspath), "%s%s", map[i].pre, p->key + 2);
+			if (!p->fspath[0])
+				strlcpy(p->fspath, "/", sizeof(p->fspath));
+			/* trailing '/' off */
+			size_t l = strlen(p->fspath);
+			while (l > 1 && p->fspath[l - 1] == '/')
+				p->fspath[--l] = 0;
+			l = strlen(p->key);
+			while (l > 3 && p->key[l - 1] == '/')
+				p->key[--l] = 0;
+			return 0;
+		}
+	}
+	return E_PATH;
+}
+
+/* ---- the RAM overlay ---- */
+
+static struct ofile {
+	bool used, deleted, isdir;
+	char key[KEY_MAX];
+	uint8_t *data;
+	uint32_t size, cap;
+} ov[OV_FILES];
+static uint32_t ov_bytes;
+
+static int
+ov_find(const char *key)
+{
+	for (int i = 0; i < OV_FILES; i++)
+		if (ov[i].used && strcmp(ov[i].key, key) == 0)
+			return i;
+	return -1;
+}
+
+/* Deleted, or under a deleted directory. */
+static bool
+ov_gone(const char *key)
+{
+	for (int i = 0; i < OV_FILES; i++) {
+		if (!ov[i].used || !ov[i].deleted)
+			continue;
+		size_t l = strlen(ov[i].key);
+		if (strncmp(ov[i].key, key, l) == 0 && (key[l] == 0 || key[l] == '/'))
+			return true;
+	}
+	return false;
+}
+
+static int
+ov_new(const char *key)
+{
+	int i = ov_find(key);
+
+	if (i >= 0) {
+		ov[i].deleted = false;
+		return i;
+	}
+	for (i = 0; i < OV_FILES; i++) {
+		if (!ov[i].used) {
+			memset(&ov[i], 0, sizeof(ov[i]));
+			ov[i].used = true;
+			strlcpy(ov[i].key, key, sizeof(ov[i].key));
+			return i;
+		}
+	}
+	return -1;
+}
+
+static bool
+ov_reserve(struct ofile *o, uint32_t size)
+{
+	if (size <= o->cap)
+		return true;
+	uint32_t cap = (size + 4095) & ~4095u;
+	if (ov_bytes - o->cap + cap > OV_BYTES_MAX)
+		return false;
+	uint8_t *d = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (!d)
+		return false;
+	if (o->data) {
+		memcpy(d, o->data, o->size);
+		kfree_data(o->data, o->cap);
+	}
+	ov_bytes = ov_bytes - o->cap + cap;
+	o->data = d;
+	o->cap = cap;
+	return true;
+}
+
+static void
+ov_drop_data(struct ofile *o)
+{
+	if (o->data) {
+		kfree_data(o->data, o->cap);
+		ov_bytes -= o->cap;
+	}
+	o->data = NULL;
+	o->size = o->cap = 0;
+}
+
+/* ---- what a path is ---- */
+
+struct node {
+	int ov;                 /* overlay index or -1 */
+	uint32_t ino;           /* disk inode, 0 if none */
+	bool isdir, ro;
+	uint64_t size;
+	uint32_t mtime, atime, ctime;
+};
+
+static int
+resolve(const struct path *p, struct node *n)
+{
+	memset(n, 0, sizeof(*n));
+	n->ov = ov_find(p->key);
+	if (n->ov >= 0 && !ov[n->ov].deleted) {
+		n->isdir = ov[n->ov].isdir;
+		n->size = ov[n->ov].size;
+		return 0;
+	}
+	n->ov = -1;
+	if (ov_gone(p->key) || p->fsi < 0)
+		return E_NOT_FOUND;
+	struct ext4ro *fs = fs_of(p->fsi);
+	struct ext4ro_stat st;
+	if (!fs || ext4ro_lookup(fs, p->fspath, false, &n->ino) || ext4ro_stat(fs, n->ino, &st))
+		return E_NOT_FOUND;
+	n->isdir = (st.mode & 0xF000) == 0x4000;
+	n->ro = (st.mode & 0222) == 0 && (st.mode & 0444) != 0;
+	n->size = st.size;
+	n->mtime = st.mtime;
+	n->atime = st.atime;
+	n->ctime = st.ctime;
+	return 0;
+}
+
+/* Copies a disk file into the overlay (before the modem's first write to it). In RAM only. */
+static int
+ov_from_disk(const struct path *p, const struct node *n)
+{
+	int i = ov_new(p->key);
+	if (i < 0)
+		return E_TOO_MANY;
+	struct ofile *o = &ov[i];
+	if (n->ino && !n->isdir && n->size) {
+		if (n->size > (4u << 20) || !ov_reserve(o, (uint32_t)n->size))
+			return E_GENERAL;
+		long r = ext4ro_pread(fs_of(p->fsi), n->ino, 0, o->data, (uint32_t)n->size);
+		if (r != (long)n->size)
+			return E_GENERAL;
+		o->size = (uint32_t)n->size;
+	}
+	return i;
+}
+
+/* ---- handles ---- */
+
+struct entry {
+	char name[64];
+	uint32_t ino;
+	int ov;
+};
+
+static struct hnd {
+	bool used, search;
+	struct path p;
+	struct node n;
+	uint32_t pos, flags;
+	/* search */
+	struct entry *ents;
+	uint32_t nents, next;
+} hd[NHANDLES];
+
+static int
+h_new(void)
+{
+	for (int i = 1; i < NHANDLES; i++)
+		if (!hd[i].used) {
+			memset(&hd[i], 0, sizeof(hd[i]));
+			hd[i].used = true;
+			return i;
+		}
+	return E_TOO_MANY;
+}
+
+static void
+h_free(int h)
+{
+	if (hd[h].ents)
+		kfree_data(hd[h].ents, hd[h].nents * sizeof(struct entry) + sizeof(struct entry));
+	memset(&hd[h], 0, sizeof(hd[h]));
+}
+
+static struct hnd *
+h_get(uint32_t h, bool search)
+{
+	if (h == 0 || h >= NHANDLES || !hd[h].used || hd[h].search != search)
+		return NULL;
+	return &hd[h];
+}
+
+/* ---- the reply ---- */
+
+static uint8_t reply_buf[16 + STREAM_MAX + 64];
+static uint32_t rlen, rargc;
+
+static void
+rep_init(uint32_t op)
+{
+	uint32_t v = op | 0xFFFF0000u;
+	memcpy(reply_buf + 16, &v, 4);
+	rlen = 8;               /* op, argc */
+	rargc = 0;
+}
+
+static bool
+rep_arg(const void *d, uint32_t len)
+{
+	uint32_t padded = (len + 3) & ~3u;
+	if (16 + rlen + 4 + padded > 16 + STREAM_MAX)
+		return false;
+	memcpy(reply_buf + 16 + rlen, &len, 4);
+	if (len)
+		memcpy(reply_buf + 16 + rlen + 4, d, len);
+	if (padded > len)
+		memset(reply_buf + 16 + rlen + 4 + len, 0, padded - len);
+	rlen += 4 + padded;
+	rargc++;
+	return true;
+}
+
+static void
+rep_s32(int32_t v)
+{
+	(void)rep_arg(&v, 4);
+}
+
+static void
+rep_send(const struct ccci_hdr *req, uint32_t slot)
+{
+	struct ccci_hdr h;
+	uint32_t total = 16 + rlen, op;
+
+	memcpy(reply_buf + 16 + 4, &rargc, 4);
+	memcpy(&op, reply_buf + 16, 4);
+	h = *req;
+	h.reserved = slot;
+	if (total - 20 <= 0xd80) {
+		h.data0 = req->data0 & 0x7FFFFFFFu;
+		h.data1 = total;
+		(void)a34_ccci_send(CH_FS_TX, &h, reply_buf + 16, rlen);
+		return;
+	}
+	/* fragments: header | op | up to 3456 bytes of the stream after op */
+	uint8_t frag[4 + 3456];
+	uint32_t done = 4;
+	while (done < rlen) {
+		uint32_t n = rlen - done > 3456 ? 3456 : rlen - done;
+		bool more = done + n < rlen;
+		h.data0 = (req->data0 & 0x7FFFFFFFu) | (more ? 0x80000000u : 0);
+		h.data1 = 20 + n;
+		memcpy(frag, &op, 4);
+		memcpy(frag + 4, reply_buf + 16 + done, n);
+		(void)a34_ccci_send(CH_FS_TX, &h, frag, 4 + n);
+		done += n;
+	}
+}
+
+/* ---- counters (logged; never data) ---- */
+
+static struct {
+	uint32_t ops, opens, open_missing, reads, written_files, refused, errors;
+	uint64_t read_bytes, write_bytes;
+} cnt;
+static uint32_t verbose_left = 400;
+
+static uint32_t mdtrace_on, mdtrace_fsop;      /* defined with the trace code below */
+
+void
+a34_cellfs_report(void)
+{
+	printf("A34 CELL FS: %u requests: %u opens (%u not found), %u reads (%llu bytes), %llu bytes written to RAM in %u files, %u refused, %u errors; overlay %u KiB\n",
+	    cnt.ops, cnt.opens, cnt.open_missing, cnt.reads, cnt.read_bytes, cnt.write_bytes, cnt.written_files,
+	    cnt.refused, cnt.errors, ov_bytes >> 10);
+	if (mdtrace_on == 1)
+		printf("A34 CELL MDTRACE: %u file-operation lines skipped so far\n", mdtrace_fsop);
+}
+
+/* ---- operations ---- */
+
+struct args {
+	uint32_t n;
+	const uint8_t *p[MAX_ARGS];
+	uint32_t len[MAX_ARGS];
+};
+
+static uint32_t
+arg_u32(const struct args *a, uint32_t i)
+{
+	return i < a->n && a->len[i] >= 4 ? g32(a->p[i]) : 0;
+}
+
+static int
+open_path(const struct path *p, uint32_t flags)
+{
+	struct node n;
+	int r = resolve(p, &n);
+	bool create = flags & 0x30000u;
+
+	cnt.opens++;
+	if (r && !create) {
+		cnt.open_missing++;
+		if (verbose_left) {
+			verbose_left--;
+			printf("A34 CELL FS: open %s: not found\n", p->key);
+		}
+		return r;
+	}
+	int h = h_new();
+	if (h < 0)
+		return h;
+	hd[h].p = *p;
+	hd[h].flags = flags;
+	if (r || (flags & 0x20000u)) {          /* create, or create-always (truncate): in RAM */
+		int i = ov_new(p->key);
+		if (i < 0) {
+			h_free(h);
+			return E_TOO_MANY;
+		}
+		if (flags & 0x20000u)
+			ov_drop_data(&ov[i]);
+		resolve(p, &n);
+	}
+	hd[h].n = n;
+	if (verbose_left) {
+		verbose_left--;
+		printf("A34 CELL FS: open %s -> handle %d, %llu bytes%s\n", p->key, h, n.size,
+		    n.ov >= 0 ? " (RAM)" : "");
+	}
+	return h;
+}
+
+static int32_t
+do_read(struct hnd *x, uint32_t len, uint8_t *out, uint32_t *nread)
+{
+	*nread = 0;
+	if (x->n.isdir)
+		return E_ACCESS;
+	uint64_t size = x->n.ov >= 0 ? ov[x->n.ov].size : x->n.size;
+	if (x->pos >= size)
+		return 0;
+	if (len > size - x->pos)
+		len = (uint32_t)(size - x->pos);
+	if (x->n.ov >= 0) {
+		memcpy(out, ov[x->n.ov].data + x->pos, len);
+	} else {
+		long r = ext4ro_pread(fs_of(x->p.fsi), x->n.ino, x->pos, out, len);
+		if (r < 0)
+			return E_GENERAL;
+		len = (uint32_t)r;
+	}
+	x->pos += len;
+	*nread = len;
+	cnt.reads++;
+	cnt.read_bytes += len;
+	return 0;
+}
+
+/* ---- the modem's own boot trace text (a34cellmdtrace=1) ---- */
+
+static uint32_t mdtrace_on = 2;         /* 2: boot-arg not read yet */
+static uint32_t mdtrace_left = 128u << 10;
+/* mdtrace_fsop: the modem's own FS_OP trace lines, counted, not logged */
+
+static bool
+is_hexch(char c)
+{
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+}
+
+/* Masks digit runs >= 6 and hex-like runs >= 8 (with a digit in them) in s[0..n). */
+static void
+mdtrace_mask(char *s, uint32_t n)
+{
+	for (uint32_t i = 0; i < n;) {
+		uint32_t j = i, digits = 0;
+		while (j < n && s[j] >= '0' && s[j] <= '9')
+			j++;
+		if (j - i >= 6) {
+			memset(s + i, '#', j - i);
+			i = j;
+			continue;
+		}
+		j = i;
+		while (j < n && is_hexch(s[j])) {
+			digits += s[j] >= '0' && s[j] <= '9';
+			j++;
+		}
+		if (j - i >= 8 && digits) {
+			memset(s + i, '#', j - i);
+			i = j;
+			continue;
+		}
+		i = j > i ? j : i + 1;
+	}
+}
+
+static bool
+has_fsop(const char *s, uint32_t n)
+{
+	static const char pat[] = "[OP:FS_OP_";
+	const uint32_t m = sizeof(pat) - 1;
+	for (uint32_t i = 0; i + m <= n; i++)
+		if (memcmp(s + i, pat, m) == 0)
+			return true;
+	return false;
+}
+
+static void
+mdtrace(const char *key, const uint8_t *d, uint32_t len)
+{
+	if (mdtrace_on == 2) {
+		uint32_t v = 0;
+		(void)PE_parse_boot_argn("a34cellmdtrace", &v, (int)sizeof(v));
+		mdtrace_on = v ? 1 : 0;
+	}
+	if (!mdtrace_on || !mdtrace_left ||
+	    (strcmp(key, "Z:/nv_boot_trace") != 0 && strcmp(key, "X:/nv_mini_dump") != 0))
+		return;
+	char line[164];
+	uint32_t n = 0;
+	for (uint32_t i = 0; i <= len && mdtrace_left; i++) {
+		bool pr = i < len && d[i] >= 0x20 && d[i] < 0x7f;
+		if (pr && n < sizeof(line) - 1) {
+			line[n++] = (char)d[i];
+			continue;
+		}
+		if (n >= 4) {
+			line[n] = 0;
+			if (has_fsop(line, n)) {
+				mdtrace_fsop++;
+			} else {
+				mdtrace_mask(line, n);
+				printf("A34 CELL MDTRACE: %c %s\n", key[0], line);
+				mdtrace_left = mdtrace_left > n ? mdtrace_left - n : 0;
+			}
+		}
+		n = 0;
+		if (pr)
+			line[n++] = (char)d[i];
+	}
+	if (!mdtrace_left)
+		printf("A34 CELL MDTRACE: (128 KiB logged, %u file-operation lines skipped; the rest is not)\n",
+		    mdtrace_fsop);
+}
+
+static int32_t
+do_write(struct hnd *x, const uint8_t *d, uint32_t len)
+{
+	if (x->flags & 0x100u)
+		return E_ACCESS;        /* opened read only */
+	if (x->n.ov < 0) {
+		int i = ov_from_disk(&x->p, &x->n);
+		if (i < 0)
+			return i;
+		x->n.ov = i;
+		cnt.written_files++;
+		if (verbose_left) {
+			verbose_left--;
+			printf("A34 CELL FS: %s now in RAM (the modem writes to it; the flash stays as it is)\n", x->p.key);
+		}
+	}
+	struct ofile *o = &ov[x->n.ov];
+	if (!ov_reserve(o, x->pos + len))
+		return E_GENERAL;
+	memcpy(o->data + x->pos, d, len);
+	mdtrace(x->p.key, d, len);
+	x->pos += len;
+	if (x->pos > o->size)
+		o->size = x->pos;
+	cnt.write_bytes += len;
+	return 0;
+}
+
+/* DOS date/time as Android's server makes it (month field from the day: its bug, kept). */
+static uint32_t
+dos_time(uint32_t t)
+{
+	uint32_t days = t / 86400, s = t % 86400;
+	/* civil from days (1970-01-01) */
+	int64_t z = (int64_t)days + 719468, era = z / 146097, doe = z - era * 146097;
+	int64_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365, y = yoe + era * 400;
+	int64_t doy = doe - (365 * yoe + yoe / 4 - yoe / 100), mp = (5 * doy + 2) / 153;
+	uint32_t d = (uint32_t)(doy - (153 * mp + 2) / 5 + 1), m = (uint32_t)(mp < 10 ? mp + 3 : mp - 9);
+	if (m <= 2)
+		y++;
+	uint32_t year = y >= 1980 ? (uint32_t)(y - 1980) : 0;
+	return (s % 60) | ((s / 60) % 60) << 5 | (s / 3600) << 11 | d << 16 | (d & 0xF) << 21 | year << 25;
+}
+
+static void
+fill_entry(uint8_t e[52], const struct node *n)
+{
+	memset(e, 0, 52);
+	e[11] = (uint8_t)((n->isdir ? 0x10 : 0) | (n->ro ? 0x01 : 0));
+	uint32_t at = dos_time(n->atime), mt = dos_time(n->mtime), sz = (uint32_t)n->size;
+	memcpy(e + 14, &at, 4);
+	memcpy(e + 22, &mt, 4);
+	memcpy(e + 28, &sz, 4);
+}
+
+static bool
+fs_glob(const char *pat, const char *s)
+{
+	if (!*pat)
+		return !*s;
+	if (*pat == '*') {
+		for (;; s++) {
+			if (fs_glob(pat + 1, s))
+				return true;
+			if (!*s)
+				return false;
+		}
+	}
+	if (!*s)
+		return false;
+	return (*pat == '?' || *pat == *s) && fs_glob(pat + 1, s + 1);
+}
+
+struct collect {
+	struct hnd *x;
+	const char *pat;
+	uint32_t cap;
+};
+
+static int
+collect_fn(void *ctx, const char *name, uint32_t len, uint32_t ino, uint8_t type)
+{
+	struct collect *c = ctx;
+	char nm[64];
+	(void)type;
+	if (len >= sizeof(nm) || (len == 1 && name[0] == '.') || (len == 2 && name[0] == '.' && name[1] == '.'))
+		return 0;
+	memcpy(nm, name, len);
+	nm[len] = 0;
+	if (!fs_glob(c->pat, nm) || c->x->nents >= c->cap)
+		return 0;
+	struct entry *e = &c->x->ents[c->x->nents++];
+	strlcpy(e->name, nm, sizeof(e->name));
+	e->ino = ino;
+	e->ov = -1;
+	return 0;
+}
+
+/* Name of entry k of a search as a node (and its overlay/disk state). false: skip it. */
+static bool
+entry_node(struct hnd *x, uint32_t k, struct node *n, struct path *p)
+{
+	*p = x->p;
+	size_t l = strlen(p->key);
+	snprintf(p->key + l, sizeof(p->key) - l, "/%s", x->ents[k].name);
+	l = strlen(p->fspath);
+	snprintf(p->fspath + l, sizeof(p->fspath) - l, "%s%s", l > 1 ? "/" : "", x->ents[k].name);
+	return resolve(p, n) == 0;
+}
+
+static void
+find_reply(struct hnd *x, int32_t ret_ok, uint32_t maxlen)
+{
+	uint8_t e[52];
+	struct node n;
+	struct path p;
+
+	while (x->next < x->nents) {
+		uint32_t k = x->next++;
+		if (!entry_node(x, k, &n, &p))
+			continue;
+		uint8_t attr = (uint8_t)((n.isdir ? 0x10 : 0) | (n.ro ? 0x01 : 0));
+		if ((x->ents[k].ino ? 0 : 0) || (x->n.mtime & 0))      /* (no-op) */
+			continue;
+		if ((x->flags & 0xFF) & ~attr)                          /* attr must be within the file's */
+			continue;
+		if (attr & ((x->flags >> 8) & 0xFF))                    /* and none of the mask's */
+			continue;
+		fill_entry(e, &n);
+		uint16_t name[256];
+		uint32_t nl = (uint32_t)strlen(x->ents[k].name), c = 0;
+		uint32_t keep = maxlen > 0 ? maxlen - 1 : 0;
+		for (; c < nl && c < keep && c < 255; c++)
+			name[c] = (uint16_t)(uint8_t)x->ents[k].name[c];
+		e[12] = c == nl ? 1 : 0;
+		name[c] = 0;
+		rep_s32(ret_ok);
+		(void)rep_arg(e, 52);
+		(void)rep_arg(name, c ? 2 * c + 2 : 0);
+		return;
+	}
+	rep_s32(E_NO_MORE);
+	(void)rep_arg(e, 0);
+	(void)rep_arg(e, 0);
+}
+
+static int32_t
+find_first(const uint8_t *u, uint32_t ulen, uint8_t attr, uint8_t mask, uint32_t maxlen)
+{
+	struct path p;
+	int r = conv_path(u, ulen, &p);
+	if (r)
+		return r;
+	/* split the last component off as the pattern */
+	char *slash = last_char(p.key, '/'), pat[64];
+	if (!slash)
+		return E_PATH;
+	strlcpy(pat, slash + 1, sizeof(pat));
+	*slash = 0;
+	char *fslash = last_char(p.fspath, '/');
+	if (fslash && fslash != p.fspath)
+		*fslash = 0;
+	else if (fslash)
+		fslash[1] = 0;
+	int h = h_new();
+	if (h < 0)
+		return h;
+	struct hnd *x = &hd[h];
+	x->search = true;
+	x->p = p;
+	x->flags = attr | (uint32_t)mask << 8;
+	struct node dn;
+	if (resolve(&p, &dn) == 0 && dn.ino && p.fsi >= 0) {
+		struct collect c = { x, pat, 2048 };
+		x->ents = kalloc_data((c.cap + 1) * sizeof(struct entry), Z_WAITOK | Z_ZERO);
+		if (x->ents)
+			(void)ext4ro_readdir(fs_of(p.fsi), dn.ino, collect_fn, &c);
+	}
+	if (!x->ents)
+		x->ents = kalloc_data(sizeof(struct entry), Z_WAITOK | Z_ZERO);
+	/* files the modem created in this directory this session */
+	size_t dl = strlen(p.key);
+	uint32_t cap = x->nents;
+	for (int i = 0; i < OV_FILES && x->ents; i++) {
+		if (!ov[i].used || ov[i].deleted || strncmp(ov[i].key, p.key, dl) || ov[i].key[dl] != '/' ||
+		    strchr(ov[i].key + dl + 1, '/') || !fs_glob(pat, ov[i].key + dl + 1))
+			continue;
+		bool known = false;
+		for (uint32_t k = 0; k < x->nents; k++)
+			if (strcmp(x->ents[k].name, ov[i].key + dl + 1) == 0)
+				known = true;
+		if (known || x->nents >= 2048)
+			continue;
+		if (x->nents >= cap) {          /* grow by copying into a bigger list */
+			uint32_t ncap = x->nents + 16;
+			struct entry *ne = kalloc_data((ncap + 1) * sizeof(struct entry), Z_WAITOK | Z_ZERO);
+			if (!ne)
+				break;
+			memcpy(ne, x->ents, x->nents * sizeof(struct entry));
+			kfree_data(x->ents, (cap ? cap : 0) * sizeof(struct entry) + sizeof(struct entry));
+			x->ents = ne;
+			cap = ncap;
+		}
+		strlcpy(x->ents[x->nents].name, ov[i].key + dl + 1, sizeof(x->ents[0].name));
+		x->ents[x->nents].ov = i;
+		x->nents++;
+	}
+	(void)maxlen;
+	return h;
+}
+
+static uint64_t
+folder_size(const struct path *dir, int depth, uint32_t bsize, bool clusters)
+{
+	struct hnd tmp;
+	struct collect c;
+	uint64_t total = 0;
+	struct node dn;
+
+	if (depth > 6 || resolve(dir, &dn) || !dn.ino || dir->fsi < 0)
+		return 0;
+	memset(&tmp, 0, sizeof(tmp));
+	tmp.p = *dir;
+	c.x = &tmp;
+	c.pat = "*";
+	c.cap = 2048;
+	tmp.ents = kalloc_data((c.cap + 1) * sizeof(struct entry), Z_WAITOK | Z_ZERO);
+	if (!tmp.ents)
+		return 0;
+	(void)ext4ro_readdir(fs_of(dir->fsi), dn.ino, collect_fn, &c);
+	for (uint32_t k = 0; k < tmp.nents; k++) {
+		struct node n;
+		struct path p;
+		if (!entry_node(&tmp, k, &n, &p))
+			continue;
+		if (n.isdir)
+			total += folder_size(&p, depth + 1, bsize, clusters);
+		else
+			total += clusters ? (n.size + bsize - 1) / bsize : n.size;
+	}
+	kfree_data(tmp.ents, (c.cap + 1) * sizeof(struct entry));
+	return total;
+}
+
+static void
+handle_request(const uint8_t *req, uint32_t total, uint32_t slot)
+{
+	struct ccci_hdr h;
+	struct args a;
+	uint32_t op, argc, off = 8;
+	struct path p;
+	int r;
+
+	memcpy(&h, req, 16);
+	if (total < 24) {
+		cnt.errors++;
+		return;
+	}
+	const uint8_t *s = req + 16;
+	op = g32(s);
+	argc = g32(s + 4);
+	cnt.ops++;
+	rep_init(op);
+	memset(&a, 0, sizeof(a));
+	if (argc > MAX_ARGS) {
+		rep_s32(E_PARAM);
+		rep_send(&h, slot);
+		cnt.errors++;
+		return;
+	}
+	for (uint32_t i = 0; i < argc; i++) {
+		if (16 + off + 4 > total) {
+			argc = 0xFFFF;
+			break;
+		}
+		uint32_t l = g32(s + off);
+		if (l == 0 || 16 + off + 4 + l > total || off + 4 + ((l + 3) & ~3u) > STREAM_MAX + 4) {
+			argc = 0xFFFF;
+			break;
+		}
+		a.p[i] = s + off + 4;
+		a.len[i] = l;
+		off += 4 + ((l + 3) & ~3u);
+	}
+	if (argc == 0xFFFF) {
+		rep_s32(E_PARAM);
+		rep_send(&h, slot);
+		cnt.errors++;
+		return;
+	}
+	a.n = argc;
+
+	switch (op) {
+	case 0x1001:                            /* OPEN */
+	case 0x1011:                            /* OPEN with hint */
+		if (a.n < 2) {
+			rep_s32(E_PARAM);
+			break;
+		}
+		r = conv_path(a.p[0], a.len[0], &p);
+		rep_s32(r ? r : open_path(&p, arg_u32(&a, 1)));
+		if (op == 0x1011)
+			(void)rep_arg(a.n > 2 ? a.p[2] : (const uint8_t *)"\0\0\0\0\0\0\0\0", 8);
+		break;
+	case 0x1002: {                          /* SEEK */
+		struct hnd *x = h_get(arg_u32(&a, 0), false);
+		int32_t o = (int32_t)arg_u32(&a, 1);
+		uint32_t wh = arg_u32(&a, 2);
+		if (!x) {
+			rep_s32(E_HANDLE);
+			break;
+		}
+		int64_t base = wh == 0 ? 0 : wh == 1 ? x->pos : wh == 2 ?
+		    (int64_t)(x->n.ov >= 0 ? ov[x->n.ov].size : x->n.size) : -1;
+		if (base < 0 || base + o < 0) {
+			rep_s32(E_PARAM);
+			break;
+		}
+		x->pos = (uint32_t)(base + o);
+		rep_s32((int32_t)x->pos);
+		break;
+	}
+	case 0x1003: {                          /* READ */
+		struct hnd *x = h_get(arg_u32(&a, 0), false);
+		uint32_t len = arg_u32(&a, 1), nread = 0;
+		static uint8_t data[STREAM_MAX];
+		if (len > STREAM_MAX - 0x40)
+			len = STREAM_MAX - 0x40;
+		int32_t ret = x ? do_read(x, len, data, &nread) : E_HANDLE;
+		rep_s32(ret);
+		(void)rep_arg(&nread, 4);
+		(void)rep_arg(data, nread);
+		break;
+	}
+	case 0x1004: {                          /* WRITE: RAM only */
+		struct hnd *x = h_get(arg_u32(&a, 0), false);
+		uint32_t len = arg_u32(&a, 2), w = 0;
+		if (a.n < 3 || len > a.len[1]) {
+			rep_s32(E_PARAM);
+			(void)rep_arg(&w, 4);
+			break;
+		}
+		int32_t ret = x ? (len ? do_write(x, a.p[1], len) : E_GENERAL) : E_HANDLE;
+		w = ret == 0 ? len : 0;
+		rep_s32(ret);
+		(void)rep_arg(&w, 4);
+		break;
+	}
+	case 0x1005: {                          /* CLOSE */
+		struct hnd *x = h_get(arg_u32(&a, 0), false);
+		if (x)
+			h_free((int)arg_u32(&a, 0));
+		rep_s32(x ? 0 : E_HANDLE);
+		break;
+	}
+	case 0x1006:                            /* CLOSEALL */
+	case 0x1017:                            /* SHUTDOWN */
+		for (int i = 1; i < NHANDLES; i++)
+			if (hd[i].used)
+				h_free(i);
+		if (op == 0x1006)
+			rep_s32(0);
+		break;
+	case 0x1007:                            /* CREATEDIR: RAM */
+	case 0x1008:                            /* REMOVEDIR: RAM */
+	case 0x100F:                            /* DELETE: RAM */
+	case 0x1018: {                          /* XDELETE: RAM */
+		if (a.n < 1) {
+			rep_s32(E_PARAM);
+			break;
+		}
+		r = conv_path(a.p[0], a.len[0], &p);
+		if (!r && op == 0x1018 && (arg_u32(&a, 1) & ~0x1cu))
+			r = E_PARAM;            /* Android's XDELETE takes only the 0x04/0x08/0x10 bits */
+		if (!r) {
+			struct node n;
+			bool exists = resolve(&p, &n) == 0;
+			if (op == 0x1007) {
+				/* mkdir: as Android's (EEXIST is a general failure there) */
+				int i = exists ? -1 : ov_new(p.key);
+				if (exists)
+					r = E_GENERAL;
+				else if (i < 0)
+					r = E_TOO_MANY;
+				else
+					ov[i].isdir = true;
+			} else if (!exists) {
+				r = E_NOT_FOUND;        /* unlink/rmdir of nothing: ENOENT, as Android's */
+			} else {
+				int i = ov_new(p.key);
+				if (i < 0) {
+					r = E_TOO_MANY;
+				} else {
+					ov_drop_data(&ov[i]);
+					ov[i].deleted = true;
+				}
+			}
+		}
+		if (verbose_left) {
+			verbose_left--;
+			printf("A34 CELL FS: %s %s -> %d (in RAM only)\n", op == 0x1007 ? "mkdir" : "delete", p.key, r);
+		}
+		rep_s32(r);
+		break;
+	}
+	case 0x1009: {                          /* GETFILESIZE */
+		struct hnd *x = h_get(arg_u32(&a, 0), false);
+		uint32_t sz = x ? (uint32_t)(x->n.ov >= 0 ? ov[x->n.ov].size : x->n.size) : 0;
+		rep_s32(x ? 0 : E_HANDLE);
+		(void)rep_arg(&sz, 4);
+		break;
+	}
+	case 0x100A: {                          /* GETFOLDERSIZE */
+		r = a.n ? conv_path(a.p[0], a.len[0], &p) : E_PARAM;
+		struct ext4ro *fs = !r && p.fsi >= 0 ? fs_of(p.fsi) : NULL;
+		rep_s32(r ? r : fs ? (int32_t)folder_size(&p, 0, fs->bsize, arg_u32(&a, 1) == 2) : 0);
+		break;
+	}
+	case 0x100B:                            /* RENAME: RAM */
+	case 0x100C: {                          /* MOVE: RAM */
+		struct path d;
+		struct node n;
+		if (a.n < 2 || conv_path(a.p[0], a.len[0], &p) || conv_path(a.p[1], a.len[1], &d) ||
+		    resolve(&p, &n)) {
+			rep_s32(E_NOT_FOUND);
+			break;
+		}
+		int src = n.ov >= 0 ? n.ov : ov_from_disk(&p, &n);
+		int dst = src >= 0 ? ov_new(d.key) : -1;
+		if (dst < 0) {
+			rep_s32(E_GENERAL);
+			break;
+		}
+		ov_drop_data(&ov[dst]);
+		if (ov[src].size && ov_reserve(&ov[dst], ov[src].size)) {
+			memcpy(ov[dst].data, ov[src].data, ov[src].size);
+			ov[dst].size = ov[src].size;
+		}
+		ov[dst].isdir = n.isdir;
+		if (!(op == 0x100C && (arg_u32(&a, 2) & 1))) {
+			ov_drop_data(&ov[src]);
+			ov[src].deleted = true;
+		}
+		rep_s32(0);
+		break;
+	}
+	case 0x100D: {                          /* COUNT */
+		struct hnd *x;
+		uint8_t star[8] = { 0 };
+		r = a.n ? conv_path(a.p[0], a.len[0], &p) : E_PARAM;
+		if (r) {
+			rep_s32(r);
+			break;
+		}
+		/* count = entries of the directory: a search for "*" in it */
+		uint16_t pat[KEY_MAX + 4];
+		uint32_t n = 0;
+		for (; p.key[n] && n < KEY_MAX; n++)
+			pat[n] = (uint16_t)(uint8_t)p.key[n];
+		pat[n++] = '/';
+		pat[n++] = '*';
+		pat[n] = 0;
+		int hh = find_first((const uint8_t *)pat, 2 * n, 0, 0, 0);
+		(void)star;
+		if (hh < 0) {
+			rep_s32(hh);
+			break;
+		}
+		x = &hd[hh];
+		int32_t c = (int32_t)x->nents;
+		h_free(hh);
+		rep_s32(c);
+		break;
+	}
+	case 0x100E: {                          /* GETDISKINFO (nvdata) */
+		uint8_t di[84];
+		struct ext4ro *fs = fs_of(0);
+		memset(di, 0, sizeof(di));
+		uint32_t v512 = 512, spc = fs ? fs->bsize / 512 : 8, blocks = fs ? (uint32_t)fs->blocks : 0;
+		memcpy(di + 48, &v512, 4);
+		memcpy(di + 52, &spc, 4);
+		memcpy(di + 56, &blocks, 4);
+		memcpy(di + 64, &v512, 4);
+		rep_s32(fs ? 0 : -1);
+		(void)rep_arg(di, 84);
+		break;
+	}
+	case 0x1010: {                          /* GETATTRIBUTES */
+		struct node n;
+		r = a.n ? conv_path(a.p[0], a.len[0], &p) : E_PARAM;
+		if (!r)
+			r = resolve(&p, &n);
+		rep_s32(r ? r : (int32_t)((n.isdir ? 0x10 : 0) | (n.ro ? 0x01 : 0)));
+		break;
+	}
+	case 0x1012: {                          /* FINDFIRST */
+		if (a.n < 4) {
+			rep_s32(E_PARAM);
+			break;
+		}
+		int hh = find_first(a.p[0], a.len[0], a.p[1][0], a.p[2][0], arg_u32(&a, 3));
+		if (hh < 0) {
+			uint8_t e[1];
+			rep_s32(hh);
+			(void)rep_arg(e, 0);
+			(void)rep_arg(e, 0);
+			break;
+		}
+		uint32_t before = rlen;
+		find_reply(&hd[hh], hh, arg_u32(&a, 3));
+		if (g32(reply_buf + 16 + before + 4) == (uint32_t)E_NO_MORE)
+			h_free(hh);     /* nothing matched: no handle */
+		break;
+	}
+	case 0x1013: {                          /* FINDNEXT */
+		struct hnd *x = h_get(arg_u32(&a, 0), true);
+		if (!x) {
+			uint8_t e[1];
+			rep_s32(E_HANDLE);
+			(void)rep_arg(e, 0);
+			(void)rep_arg(e, 0);
+			break;
+		}
+		find_reply(x, 0, arg_u32(&a, 1));
+		break;
+	}
+	case 0x1014: {                          /* FINDCLOSE */
+		struct hnd *x = h_get(arg_u32(&a, 0), true);
+		if (x)
+			h_free((int)arg_u32(&a, 0));
+		rep_s32(x ? 0 : E_HANDLE);
+		break;
+	}
+	case 0x1015: case 0x1019: case 0x101C:  /* LOCKFAT, CLEARDISKFLAG, SETDISKFLAG */
+		rep_s32(0);
+		break;
+	case 0x1016:                            /* UNLOCKALL */
+		rep_s32(1);
+		break;
+	case 0x101A: {                          /* GETDRIVE */
+		uint32_t type = arg_u32(&a, 0), serial = arg_u32(&a, 1), alt = arg_u32(&a, 2);
+		bool bad = !(type & 0x1c) || (type & ~0x1cu) || (type != 0x10 && serial > 2) || serial == 0 ||
+		    (type == 0x10 && serial > 1) || (alt != 1 && (alt & 1)) || (alt != 2 && (alt & 2));
+		rep_s32(!bad && type == 4 ? 0x5A : E_PARAM);
+		break;
+	}
+	case 0x101B: {                          /* GETCLUSTERSIZE */
+		uint32_t d = arg_u32(&a, 0);
+		int fi = d == 'Z' || d == 'V' ? 0 : d == 'X' ? 1 : d == 'Y' ? 2 : d == 'P' ? 3 : -1;
+		struct ext4ro *fs = fi >= 0 ? fs_of(fi) : NULL;
+		rep_s32(d < 'O' || d > 'Z' ? E_DRIVE : fs ? (int32_t)fs->bsize : 4096);
+		break;
+	}
+	case 0x101D: case 0x1020:               /* OTP_WRITE, OTP_LOCK: refused */
+		cnt.refused++;
+		rep_s32(E_OTP);
+		break;
+	case 0x101E: {                          /* OTP_READ: refused, zeros of the asked length */
+		static uint8_t zeros[1024];
+		uint32_t len = arg_u32(&a, 2);
+		cnt.refused++;
+		rep_s32(E_OTP);
+		(void)rep_arg(zeros, len < sizeof(zeros) ? len : sizeof(zeros));
+		break;
+	}
+	case 0x101F: {                          /* OTP_QUERYLEN: refused */
+		uint32_t z = 0;
+		cnt.refused++;
+		rep_s32(E_OTP);
+		(void)rep_arg(&z, 4);
+		break;
+	}
+	case 0x1021:                            /* RESTORE (from the nvram partition): refused */
+		cnt.refused++;
+		printf("A34 CELL FS: RESTORE refused (would write the flash)\n");
+		rep_s32(E_GENERAL);
+		break;
+	case 0x1023:                            /* BIN_REGION_ACCESS (nvram partition): refused */
+		cnt.refused++;
+		printf("A34 CELL FS: BIN_REGION_ACCESS type %u refused (backup/restore of the nvram partition)\n",
+		    arg_u32(&a, 0));
+		rep_s32(E_PARAM);
+		break;
+	case 0x1025: {                          /* GETFILEDETAIL */
+		struct node n;
+		uint64_t t[3] = { 0, 0, 0 };
+		r = a.n ? conv_path(a.p[0], a.len[0], &p) : E_PARAM;
+		if (!r)
+			r = resolve(&p, &n);
+		if (!r) {
+			t[0] = n.mtime;
+			t[1] = n.atime;
+			t[2] = n.ctime;
+		}
+		rep_s32(r);
+		(void)rep_arg(t, 24);
+		break;
+	}
+	case 0x1022:                            /* CMPT_READ */
+	case 0x1026: {                          /* CMPT_READ_EX */
+		uint32_t need = op == 0x1022 ? 40 : 44, done = 0, nread = 0, fsize = 0;
+		int32_t err = 0, hh = -1;
+		static uint8_t data[STREAM_MAX];
+		if (a.n < 2 || a.len[1] < need) {
+			rep_s32(E_PARAM);
+			break;
+		}
+		const uint8_t *q = a.p[1];
+		uint32_t map = g32(q), flags = g32(q + 12), wh = g32(q + 24), len = g32(q + 32);
+		int32_t so = (int32_t)g32(q + 20);
+		if (len > STREAM_MAX - 0x60)
+			len = STREAM_MAX - 0x60;
+		if (map & 0x01) {
+			r = conv_path(a.p[0], a.len[0], &p);
+			hh = r ? r : open_path(&p, flags);
+			if (hh < 0)
+				err = hh;
+			else
+				done |= 0x01;
+		} else if (op == 0x1026) {
+			hh = (int32_t)g32(q + 40);
+			if (!h_get((uint32_t)hh, false))
+				err = -1;
+		} else {
+			err = -7;
+		}
+		struct hnd *x = !err ? h_get((uint32_t)hh, false) : NULL;
+		if (x) {
+			fsize = (uint32_t)(x->n.ov >= 0 ? ov[x->n.ov].size : x->n.size);
+			if (map & 0x02)
+				done |= 0x02;
+			if (map & 0x04) {
+				int64_t base = wh == 0 ? 0 : wh == 1 ? x->pos : wh == 2 ? fsize : -1;
+				if (base < 0 || base + so < 0)
+					err = E_PARAM;
+				else {
+					x->pos = (uint32_t)(base + so);
+					done |= 0x04;
+				}
+			}
+			if (!err && (map & 0x08)) {
+				err = do_read(x, len, data, &nread);
+				if (!err)
+					done |= 0x08;
+			}
+			if ((map & 0x10) || err || op == 0x1022) {
+				h_free(hh);
+				hh = -1;
+				if (map & 0x10)
+					done |= 0x10;
+			}
+		}
+		uint32_t de[2] = { done, (uint32_t)err };
+		(void)rep_arg(de, 8);
+		(void)rep_arg(&fsize, 4);
+		(void)rep_arg(&nread, 4);
+		(void)rep_arg(data, nread);
+		if (op == 0x1026)
+			(void)rep_arg(&hh, 4);
+		break;
+	}
+	case 0x1024: {                          /* CMPT_WRITE: RAM */
+		uint32_t done = 0, w = 0;
+		int32_t err = 0, hh;
+		if (a.n < 3 || a.len[1] < 36) {
+			rep_s32(E_PARAM);
+			break;
+		}
+		const uint8_t *q = a.p[1];
+		uint32_t map = g32(q), flags = g32(q + 12), wh = g32(q + 20), len = g32(q + 28);
+		int32_t so = (int32_t)g32(q + 16);
+		hh = (int32_t)g32(q + 32);
+		if (hh < 0) {
+			if (!(map & 0x01)) {
+				uint32_t de[2] = { 0, (uint32_t)E_PARAM };
+				int32_t m1 = -1;
+				(void)rep_arg(de, 8);
+				(void)rep_arg(&m1, 4);
+				(void)rep_arg(&w, 4);
+				break;
+			}
+			r = conv_path(a.p[0], a.len[0], &p);
+			hh = r ? r : open_path(&p, flags);
+			if (hh < 0)
+				err = hh;
+			else
+				done |= 0x01;
+		}
+		struct hnd *x = !err ? h_get((uint32_t)hh, false) : NULL;
+		if (x) {
+			if (map & 0x04) {
+				int64_t base = wh == 0 ? 0 : wh == 1 ? x->pos : wh == 2 ?
+				    (int64_t)(x->n.ov >= 0 ? ov[x->n.ov].size : x->n.size) : -1;
+				if (base < 0 || base + so < 0)
+					err = E_PARAM;
+				else {
+					x->pos = (uint32_t)(base + so);
+					done |= 0x04;
+				}
+			}
+			if (!err && (map & 0x20)) {
+				if (len > a.len[2])
+					len = a.len[2];
+				err = do_write(x, a.p[2], len);
+				if (!err) {
+					w = len;
+					done |= 0x20;
+				}
+			}
+			if ((map & 0x10) || err) {
+				h_free(hh);
+				if (map & 0x10)
+					done |= 0x10;
+			}
+		} else if (!err) {
+			err = E_HANDLE;
+		}
+		uint32_t de[2] = { done, (uint32_t)err };
+		(void)rep_arg(de, 8);
+		(void)rep_arg(&hh, 4);
+		(void)rep_arg(&w, 4);
+		break;
+	}
+	default:
+		printf("A34 CELL FS: unknown op 0x%x\n", op);
+		cnt.errors++;
+		rep_s32(E_PARAM);
+		break;
+	}
+	rep_send(&h, slot);
+}
+
+/* ---- reassembly (per slot) ---- */
+
+static uint8_t slot_buf[SLOTS][SLOT_SIZE];
+static uint32_t slot_len[SLOTS];
+static bool slot_inprog[SLOTS];
+
+void
+a34_cellfs_rx(const uint8_t *pkt, uint32_t len)
+{
+	struct ccci_hdr h;
+
+	if (len < 16)
+		return;
+	memcpy(&h, pkt, 16);
+	uint32_t slot = h.reserved, plen = h.data1;
+	if (h.channel != CH_FS_RX || slot >= SLOTS || plen > SLOT_SIZE || plen > len || plen < 16) {
+		cnt.errors++;
+		printf("A34 CELL FS: bad packet (slot %u, length %u of %u)\n", slot, plen, len);
+		return;
+	}
+	bool more = h.data0 & 0x80000000u;
+	h.data0 &= ~0x40000000u;                /* the AP-wakeup flag */
+	uint8_t *b = slot_buf[slot];
+	if (!slot_inprog[slot]) {
+		memcpy(b, pkt, plen);
+		memcpy(b, &h, 16);
+		slot_len[slot] = plen;
+		if (more) {
+			slot_inprog[slot] = true;
+			return;
+		}
+	} else {
+		if (plen > 20 && slot_len[slot] + plen - 20 <= SLOT_SIZE) {
+			memcpy(b + slot_len[slot], pkt + 20, plen - 20);
+			slot_len[slot] += plen - 20;
+		}
+		if (more)
+			return;
+		memcpy(b, &h, 16);
+		slot_inprog[slot] = false;
+	}
+	uint32_t total = slot_len[slot];
+	slot_len[slot] = 0;
+	handle_request(b, total, slot);
+}
+#endif
diff --git a/bsd/dev/a34_ext4ro.c b/bsd/dev/a34_ext4ro.c
new file mode 100644
index 0000000..e6c91e2
--- /dev/null
+++ b/bsd/dev/a34_ext4ro.c
@@ -0,0 +1,351 @@
+/* A34 (0951): identical to userland/a34cell/ext4ro.c (tested there), built into the kernel. */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * ext4ro: read-only ext4 (ext4ro.h). Layouts: the ext4 disk format as documented in the Linux
+ * kernel's Documentation/filesystems/ext4 (superblock, group descriptors, inodes, extent tree,
+ * directory entries); our own code.
+ */
+#include "a34_ext4ro.h"
+
+#include <string.h>
+
+#define SB_OFF                  1024u
+#define EXT4_MAGIC              0xEF53u
+#define INCOMPAT_FILETYPE       0x0002u
+#define INCOMPAT_META_BG        0x0010u
+#define INCOMPAT_EXTENTS        0x0040u
+#define INCOMPAT_64BIT          0x0080u
+#define INCOMPAT_INLINE_DATA    0x8000u
+#define INCOMPAT_ENCRYPT        0x10000u
+#define INODE_EXTENTS_FL        0x00080000u
+#define INODE_INLINE_FL         0x10000000u
+#define EXT_MAGIC               0xF30Au
+
+static uint16_t
+g16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+g32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static int
+rd(struct ext4ro *fs, uint64_t off, void *buf, uint32_t len)
+{
+	return fs->read(fs->ctx, off, buf, len) ? EXT4RO_EIO : 0;
+}
+
+static int
+rd_block(struct ext4ro *fs, uint64_t blk, uint8_t *buf)
+{
+	if (blk == 0 || blk >= fs->blocks)
+		return EXT4RO_EIO;
+	return rd(fs, blk * fs->bsize, buf, fs->bsize);
+}
+
+int
+ext4ro_mount(struct ext4ro *fs, ext4ro_read_fn read, void *ctx, uint8_t *scratch)
+{
+	uint8_t sb[1024];
+
+	memset(fs, 0, sizeof(*fs));
+	fs->read = read;
+	fs->ctx = ctx;
+	if (rd(fs, SB_OFF, sb, sizeof(sb)))
+		return EXT4RO_EIO;
+	if (g16(sb + 0x38) != EXT4_MAGIC)
+		return EXT4RO_EINVAL;
+	uint32_t log = g32(sb + 0x18);
+	if (log > 6)
+		return EXT4RO_EINVAL;
+	fs->bsize = 1024u << log;
+	fs->incompat = g32(sb + 0x60);
+	if (fs->incompat & (INCOMPAT_META_BG | INCOMPAT_INLINE_DATA | INCOMPAT_ENCRYPT))
+		return EXT4RO_ENOTSUP;
+	fs->inodes_per_group = g32(sb + 0x28);
+	uint32_t blocks_per_group = g32(sb + 0x20);
+	fs->inode_size = g32(sb + 0x4C) == 0 ? 128u : g16(sb + 0x58);
+	fs->blocks = g32(sb + 0x04);
+	if (fs->incompat & INCOMPAT_64BIT)
+		fs->blocks |= (uint64_t)g32(sb + 0x150) << 32;
+	fs->desc_size = (fs->incompat & INCOMPAT_64BIT) ? g16(sb + 0xFE) : 32u;
+	if (fs->desc_size < 32 || fs->desc_size > 1024 || fs->inode_size < 128 ||
+	    fs->inode_size > fs->bsize || fs->inodes_per_group == 0 || blocks_per_group == 0)
+		return EXT4RO_EINVAL;
+	uint32_t first_data = g32(sb + 0x14);
+	fs->groups = (uint32_t)((fs->blocks - first_data + blocks_per_group - 1) / blocks_per_group);
+	fs->gdt_block = first_data + 1;
+	fs->blk = scratch;
+	fs->blk2 = scratch + EXT4RO_MAX_BLOCK;
+	fs->blk3 = scratch + 2 * EXT4RO_MAX_BLOCK;
+	return 0;
+}
+
+/* The inode's raw bytes (inode_size, at most 1024) into out. */
+static int
+read_inode(struct ext4ro *fs, uint32_t ino, uint8_t *out)
+{
+	if (ino == 0)
+		return EXT4RO_EINVAL;
+	uint32_t group = (ino - 1) / fs->inodes_per_group, index = (ino - 1) % fs->inodes_per_group;
+	if (group >= fs->groups)
+		return EXT4RO_EINVAL;
+	uint8_t d[64];
+	uint64_t doff = fs->gdt_block * fs->bsize + (uint64_t)group * fs->desc_size;
+	if (rd(fs, doff, d, fs->desc_size < 64 ? 32 : 64))
+		return EXT4RO_EIO;
+	uint64_t table = g32(d + 0x08);
+	if (fs->desc_size >= 64)
+		table |= (uint64_t)g32(d + 0x28) << 32;
+	uint32_t n = fs->inode_size > 1024 ? 1024 : fs->inode_size;
+	return rd(fs, table * fs->bsize + (uint64_t)index * fs->inode_size, out, n);
+}
+
+int
+ext4ro_stat(struct ext4ro *fs, uint32_t ino, struct ext4ro_stat *st)
+{
+	uint8_t in[1024];
+	int e = read_inode(fs, ino, in);
+
+	if (e)
+		return e;
+	st->mode = g16(in + 0x00);
+	st->size = g32(in + 0x04) | (uint64_t)g32(in + 0x6C) << 32;
+	st->atime = g32(in + 0x08);
+	st->ctime = g32(in + 0x0C);
+	st->mtime = g32(in + 0x10);
+	return 0;
+}
+
+/*
+ * The physical block of logical block lblk, 0 for a hole (or an uninitialized extent: zeros),
+ * or a negative code. Extent trees are walked from the inode's root down to the leaf.
+ */
+static int64_t
+map_block(struct ext4ro *fs, const uint8_t *in, uint64_t lblk)
+{
+	uint32_t flags = g32(in + 0x20);
+
+	if (flags & INODE_INLINE_FL)
+		return EXT4RO_ENOTSUP;
+	if (flags & INODE_EXTENTS_FL) {
+		const uint8_t *node = in + 0x28;
+		uint32_t node_len = 60;
+		for (int level = 0; level < 8; level++) {
+			if (node_len < 12 || g16(node) != EXT_MAGIC)
+				return EXT4RO_EIO;
+			uint16_t entries = g16(node + 2), depth = g16(node + 6);
+			if (12u + (uint32_t)entries * 12u > node_len)
+				return EXT4RO_EIO;
+			if (depth == 0) {
+				for (uint16_t i = 0; i < entries; i++) {
+					const uint8_t *e = node + 12 + 12 * i;
+					uint32_t first = g32(e);
+					uint32_t len = g16(e + 4);
+					bool uninit = len > 32768;
+					if (uninit)
+						len -= 32768;
+					if (lblk >= first && lblk < (uint64_t)first + len) {
+						if (uninit)
+							return 0;
+						uint64_t start = g32(e + 8) | (uint64_t)g16(e + 6) << 32;
+						return (int64_t)(start + (lblk - first));
+					}
+				}
+				return 0;       /* a hole */
+			}
+			/* index: the last entry whose first block <= lblk */
+			const uint8_t *pick = NULL;
+			for (uint16_t i = 0; i < entries; i++) {
+				const uint8_t *e = node + 12 + 12 * i;
+				if (g32(e) <= lblk)
+					pick = e;
+			}
+			if (!pick)
+				return 0;
+			uint64_t child = g32(pick + 4) | (uint64_t)g16(pick + 8) << 32;
+			uint8_t *buf = (level & 1) ? fs->blk3 : fs->blk2;
+			if (rd_block(fs, child, buf))
+				return EXT4RO_EIO;
+			node = buf;
+			node_len = fs->bsize;
+		}
+		return EXT4RO_EIO;
+	}
+	/* classic block map: 12 direct, then single, double, triple indirect */
+	uint64_t per = fs->bsize / 4;
+	if (lblk < 12)
+		return g32(in + 0x28 + 4 * lblk);
+	lblk -= 12;
+	uint64_t span = per;
+	for (int level = 1; level <= 3; level++) {
+		if (lblk < span) {
+			uint32_t blk = g32(in + 0x28 + 4 * (11 + level));
+			for (int l = level; l > 0; l--) {
+				if (blk == 0)
+					return 0;
+				if (rd_block(fs, blk, fs->blk2))
+					return EXT4RO_EIO;
+				uint64_t div = 1;
+				for (int k = 1; k < l; k++)
+					div *= per;
+				blk = g32(fs->blk2 + 4 * ((lblk / div) % per));
+			}
+			return blk;
+		}
+		lblk -= span;
+		span *= per;
+	}
+	return EXT4RO_EINVAL;
+}
+
+long
+ext4ro_pread(struct ext4ro *fs, uint32_t ino, uint64_t off, void *buf, uint32_t len)
+{
+	uint8_t in[1024];
+	struct ext4ro_stat st;
+	int e = read_inode(fs, ino, in);
+
+	if (e)
+		return e;
+	if ((e = ext4ro_stat(fs, ino, &st)))
+		return e;
+	if (off >= st.size)
+		return 0;
+	if (len > st.size - off)
+		len = (uint32_t)(st.size - off);
+	uint32_t done = 0;
+	while (done < len) {
+		uint64_t pos = off + done;
+		uint64_t lblk = pos / fs->bsize;
+		uint32_t skip = (uint32_t)(pos % fs->bsize);
+		uint32_t n = fs->bsize - skip;
+		if (n > len - done)
+			n = len - done;
+		int64_t pb = map_block(fs, in, lblk);
+		if (pb < 0)
+			return (long)pb;
+		if (pb == 0) {
+			memset((uint8_t *)buf + done, 0, n);
+		} else {
+			if (rd_block(fs, (uint64_t)pb, fs->blk))
+				return EXT4RO_EIO;
+			memcpy((uint8_t *)buf + done, fs->blk + skip, n);
+		}
+		done += n;
+	}
+	return (long)done;
+}
+
+int
+ext4ro_readdir(struct ext4ro *fs, uint32_t ino, ext4ro_dir_fn fn, void *ctx)
+{
+	uint8_t in[1024];
+	struct ext4ro_stat st;
+	int e = read_inode(fs, ino, in);
+
+	if (e)
+		return e;
+	if ((e = ext4ro_stat(fs, ino, &st)))
+		return e;
+	if ((st.mode & 0xF000) != 0x4000)
+		return EXT4RO_ENOTDIR;
+	for (uint64_t lblk = 0; lblk * fs->bsize < st.size; lblk++) {
+		int64_t pb = map_block(fs, in, lblk);
+		if (pb < 0)
+			return (int)pb;
+		if (pb == 0)
+			continue;
+		if (rd_block(fs, (uint64_t)pb, fs->blk))
+			return EXT4RO_EIO;
+		for (uint32_t o = 0; o + 8 <= fs->bsize;) {
+			const uint8_t *d = fs->blk + o;
+			uint32_t dino = g32(d);
+			uint16_t rec = g16(d + 4);
+			uint32_t nlen = (fs->incompat & INCOMPAT_FILETYPE) ? d[6] : g16(d + 6);
+			uint8_t type = (fs->incompat & INCOMPAT_FILETYPE) ? d[7] : 0;
+			if (rec < 8 || o + rec > fs->bsize || 8u + nlen > rec)
+				break;
+			if (dino != 0 && nlen > 0) {
+				int r = fn(ctx, (const char *)d + 8, nlen, dino, type);
+				if (r)
+					return r;
+			}
+			o += rec;
+		}
+	}
+	return 0;
+}
+
+struct find {
+	const char *name;
+	uint32_t len;
+	bool nocase;
+	uint32_t ino;
+};
+
+static int
+eq(const char *a, const char *b, uint32_t n, bool nocase)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		char x = a[i], y = b[i];
+		if (nocase) {
+			if (x >= 'A' && x <= 'Z')
+				x = (char)(x - 'A' + 'a');
+			if (y >= 'A' && y <= 'Z')
+				y = (char)(y - 'A' + 'a');
+		}
+		if (x != y)
+			return 0;
+	}
+	return 1;
+}
+
+static int
+find_fn(void *ctx, const char *name, uint32_t namelen, uint32_t ino, uint8_t type)
+{
+	struct find *f = ctx;
+
+	(void)type;
+	if (namelen == f->len && eq(name, f->name, namelen, f->nocase)) {
+		f->ino = ino;
+		return 1;
+	}
+	return 0;
+}
+
+int
+ext4ro_lookup(struct ext4ro *fs, const char *path, bool nocase, uint32_t *ino)
+{
+	uint32_t cur = EXT4RO_ROOT_INO;
+
+	if (!path || path[0] != '/')
+		return EXT4RO_EINVAL;
+	const char *p = path;
+	while (*p) {
+		while (*p == '/')
+			p++;
+		if (!*p)
+			break;
+		const char *end = p;
+		while (*end && *end != '/')
+			end++;
+		struct find f = { p, (uint32_t)(end - p), nocase, 0 };
+		if (f.len > 255)
+			return EXT4RO_EINVAL;
+		int r = ext4ro_readdir(fs, cur, find_fn, &f);
+		if (r < 0)
+			return r;
+		if (r == 0 || f.ino == 0)
+			return EXT4RO_ENOENT;
+		cur = f.ino;
+		p = end;
+	}
+	*ino = cur;
+	return 0;
+}
+#endif
diff --git a/bsd/dev/a34_ext4ro.h b/bsd/dev/a34_ext4ro.h
new file mode 100644
index 0000000..b2d2e2c
--- /dev/null
+++ b/bsd/dev/a34_ext4ro.h
@@ -0,0 +1,65 @@
+/*
+ * ext4ro: a read-only ext4 reader with no write path at all, for the modem's file server
+ * (docs/cellular-plan.md, stage 1c). Plain C without OS dependencies: the same two files are
+ * built into the kernel (bsd/dev/a34_ext4ro.c, xnu/patches/0951) and tested on the host here
+ * (tests/test_ext4ro.sh builds images with mke2fs and compares every file).
+ *
+ * Reads superblock, group descriptors, inodes (extents or block maps), directories (linear,
+ * htree interior blocks are skipped as the empty entries they look like). No journal replay:
+ * the data read is what the last completed checkpoint left on the disk. Refuses features it
+ * does not understand (meta_bg, inline data, encryption).
+ */
+#ifndef A34_EXT4RO_H
+#define A34_EXT4RO_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define EXT4RO_MAX_BLOCK        65536u
+#define EXT4RO_ROOT_INO         2u
+
+/* Reads len bytes at byte offset off of the file system into buf. 0 on success. */
+typedef int (*ext4ro_read_fn)(void *ctx, uint64_t off, void *buf, uint32_t len);
+
+struct ext4ro {
+	ext4ro_read_fn read;
+	void *ctx;
+	uint32_t bsize, inode_size, inodes_per_group, groups, desc_size;
+	uint64_t blocks, gdt_block;
+	uint32_t incompat;
+	uint8_t *blk;           /* scratch: one block, given by the caller (bsize bytes) */
