+/*
+ * A34 (0951): cellular stage 1b -- the modem's control path, boot-arg a34cell=3.
+ *
+ * After 0950's checks (LK loaded the modem, MD1 on, BROM PASS) and before the modem is let go,
+ * a34_ccci_prepare() lays out the AP<->modem shared memory from LK's tag table and builds the
+ * CCIF ring buffers in it; when the modem's first handshake (HS1) arrives, a34_ccci_hs1() answers
+ * it with the AP's runtime data and a polling thread then serves the rings: the modem's file
+ * server requests (bsd/dev/a34_cellfs.c, read only), its RPC requests, the second handshake (HS2),
+ * and from then on the AT channel as /dev/a34at0 (CCCI tx 12 / rx 10, ttyC0) for
+ * userland/a34cell. No voltage, power or clock-mux change; no partition is written.
+ *
+ * Facts (all from Samsung's A34 kernel sources, eccci/ccci_util, our own code; details in
+ * docs/cellular-plan.md): shared-memory regions from LK tags nc_smem_layout/c_smem_layout or the
+ * gen6297 fallback tables (ccci_util_md_mem.c), MD view = offset + 0x40000000; runtime-feature
+ * entries {u8 id, u8 mask|ver<<4, u8 rsv[2], u32 len, data} in RAW_RUNTIME_DATA (ccci_fsm.c
+ * prepare_runtime_data); the SRAM reply ap_query_md_feature_v2_1 at CCIF SRAM+0x100 with its
+ * header at +0xF0, doorbell bit 15 (modem_sys1.c); 16 rings back to back in CCISM_MCU, each
+ * {0xEE0000EE x2, rx read/write/len, tx read/write/len, rx area, tx area, 0xFF0000FF x2}, frames
+ * {0xAABBAABB, len, packet, pad to 8, 0xCCDDEEFF x2} (ccci_ringbuf.c), doorbell bit = queue;
+ * sequence numbers per channel with the assert bit (ccci_hif_internal.h).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/select.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+#include <sys/random.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include "a34_ccci.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/*
+ * Shared memory is mapped out of kernel_map (ml_io_map_unmappable), never the 8 MiB io_submap
+ * ml_io_map uses: io_map() allocates with KMA_NOFAIL, so a region that does not fit there panics
+ * (0996-cell3: a 7 MiB region). Regions kept mapped are at most CC_MAP_MAX; larger ones are only
+ * ever touched through CC_WIN windows, unmapped again (ml_io_unmap) right after.
+ */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+#define CC_WIMG_IO      0x7u            /* VM_WIMG_IO: device memory, as ml_io_map */
+#define CC_MAP_MAX      (1u << 20)
+#define CC_WIN          (1u << 20)
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+extern bool a34_cell_lk_tag(const char *name, const uint8_t **data, uint32_t *len);
+bool a34_ccci_prepare(vm_offset_t ap_ccif, vm_offset_t md_ccif);
+void a34_ccci_hs1(vm_offset_t ap_ccif, vm_offset_t md_ccif, const uint32_t feature_query[56]);
+
+#define MD_VIEW_BASE            0x40000000u
+#define CCIF_BUSY               0x04u
+#define CCIF_TCHNUM             0x0Cu
+#define CCIF_RCHNUM             0x10u
+#define CCIF_ACK                0x14u
+#define CCIF_SRAM               0x100u
+#define SRAM_UP_HEADER          0xF0u
+#define SRAM_AP_RT              0x100u
+#define H2D_SRAM                15u
+#define MD_INIT_CHK_ID          0x5555FFFFu
+#define AP_PATTERN              0x43434349u
+#define MD_PATTERN              0x49434343u
+#define RT_HALF                 0x800u
+#define SMC_CCCI                0xC2000505ull
+#define SMC_CCIF_CLK_RELEASE    15u
+#define MAX_PKT                 (3456u + 32u)
+
+enum { R_MDCCCI_DBG = 12, R_MDSS_DBG = 13, R_RUNTIME = 14, R_CCISM_SCP = 16, R_CCISM_MCU = 19,
+	R_CCISM_MCU_EXP = 20, NREG = 48 };
+
+/* ---- little helpers ---- */
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t
+le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+}
+
+static uint32_t
+rd32(vm_offset_t b, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(b + off);
+	__asm__ volatile ("dsb ld" ::: "memory");
+	return v;
+}
+
+static void
+wr32(vm_offset_t b, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(b + off) = v;
+	__asm__ volatile ("dsb st" ::: "memory");
+}
+
+/* Shared memory is mapped as device memory: aligned 32-bit accesses only. */
+static void
+dm_zero(vm_offset_t b, uint32_t off, uint32_t len)
+{
+	for (uint32_t o = 0; o + 4 <= len; o += 4)
+		*(volatile uint32_t *)(b + off + o) = 0;
+	__asm__ volatile ("dsb st" ::: "memory");
+}
+
+static void
+dm_put(vm_offset_t b, uint32_t off, const void *src, uint32_t len)        /* len % 4 == 0 */
+{
+	const uint8_t *s = src;
+	for (uint32_t o = 0; o < len; o += 4) {
+		uint32_t w;
+		memcpy(&w, s + o, 4);
+		*(volatile uint32_t *)(b + off + o) = w;
+	}
+}
+
+static void
+dm_get(void *dst, vm_offset_t b, uint32_t off, uint32_t len)              /* len % 4 == 0 */
+{
+	uint8_t *d = dst;
+	for (uint32_t o = 0; o < len; o += 4) {
+		uint32_t w = *(volatile uint32_t *)(b + off + o);
+		memcpy(d + o, &w, 4);
+	}
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	static int chan;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+tag(const char *name, const uint8_t **p, uint32_t len)
+{
+	uint32_t l = 0;
+	return a34_cell_lk_tag(name, p, &l) && l == len;
+}
+
+static bool
+tag_u32(const char *name, uint32_t *v)
+{
+	const uint8_t *p;
+	if (!tag(name, &p, 4))
+		return false;
+	*v = le32(p);
+	return true;
+}
+
+/* ---- shared memory regions ---- */
+
+static struct region {
+	uint64_t ap;
+	uint32_t md, size;
+	vm_offset_t va;
+} rg[NREG];
+static uint32_t nc_start, nc_total, c_start, c_total, cache_off = 0x08000000u;
+static uint64_t bank0_pa, smem_base, cache_pa;
+static uint32_t bank0_size, md1img_size, smem_off, smem_size, cache_size, sib_size, mtee;
+static bool have_sib;
+
+static void
+set_region(int id, uint64_t ap, uint32_t md, uint32_t size)
+{
+	if (id >= 0 && id < NREG) {
+		rg[id].ap = ap;
+		rg[id].md = md;
+		rg[id].size = size;
+		rg[id].va = 0;
+	}
+}
+
+static bool
+smem_direct(void)
+{
+	uint32_t n = 0, m = 0;
+	const uint8_t *t;
+
+	if (!tag_u32("nc_smem_layout_num", &n) || n == 0 || n > 64 || !tag("nc_smem_layout", &t, 40 * n))
+		return false;
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *e = t + 40 * i;
+		uint32_t md = MD_VIEW_BASE + le32(e + 0x24);
+		set_region((int)le32(e + 0x10), le64(e), md, le32(e + 0x18));
+		if (i == 0)
+			nc_start = md;
+		nc_total += le32(e + 0x18);
+	}
+	if (tag_u32("c_smem_layout_num", &m) && m > 0 && m <= 64 && tag("c_smem_layout", &t, 40 * m)) {
+		for (uint32_t i = 0; i < m; i++) {
+			const uint8_t *e = t + 40 * i;
+			uint32_t md = MD_VIEW_BASE + le32(e + 0x24);
+			set_region((int)le32(e + 0x10), le64(e), md, le32(e + 0x18));
+			if (i == 0)
+				c_start = md;
+			c_total += le32(e + 0x18);
+		}
+	}
+	printf("A34 CELL: shared memory from LK's layout tags: %u non-cached regions (%u KiB), %u cached (%u KiB)\n",
+	    n, nc_total >> 10, m, c_total >> 10);
+	return true;
+}
+
+/* The gen6297 fallback tables (ccci_util_md_mem.c): non-cached bank packed in this order. */
+static const struct { int id; uint32_t size; } nc6297[] = {
+	{ 10, 0 }, { 27, 0 }, { 31, 0 }, { 34, 0 }, { 29, 0 }, { 12, 0x800 }, { 13, 0x3800 }, { 37, 0 },
+	{ 18, 0xA800 }, { 14, 0x1000 }, { 15, 0x400 }, { 33, 0x200 }, { 0, 0x200 }, { 16, 0x8000 },
+	{ 4, 0x1000 }, { 7, 0x2000 }, { 8, 0x1000 }, { 9, 0xD000 }, { 19, 0xB4400 }, { 20, 0x1E400 },
+	{ 43, 0x800 }, { 44, 0x80 }, { 40, 0x3F80 }, { 41, 0 },   /* MTK_TC10_FEATURE_BIG_DATA (Samsung's build) */
+};
+static const int c6297[] = { 22, 32, 1, 46, 28, 24 };
+
+static bool
+smem_legacy(void)
+{
+	const uint8_t *t;
+	uint32_t k = 0;
+
+	if (!tag("smem_layout", &t, 40)) {
+		printf("A34 CELL: no smem_layout tag and no layout tags: shared memory unknown\n");
+		return false;
+	}
+	uint64_t base = le64(t);
+	uint32_t off = 0;
+	for (size_t i = 0; i < sizeof(nc6297) / sizeof(nc6297[0]); i++) {
+		int id = nc6297[i].id;
+		uint32_t size = nc6297[i].size, v;
+		const uint8_t *x;
+		if (tag_u32("nc_smem_info_ext_num", &k) && k > 0 && k <= 64 && tag("nc_smem_info_ext", &x, 16 * k)) {
+			for (uint32_t j = 0; j < k; j++)
+				if ((int)le32(x + 16 * j + 12) == id)
+					size = le32(x + 16 * j + 8);
+		}
+		if (id == 10 && tag_u32("smem_dfd_size", &v) && (int32_t)v >= 0)
+			size = v;
+		if (id == 29 && tag_u32("smem_amms_pos_size", &v) && (int32_t)v >= 0)
+			size = v;
+		if (id == 27 && tag("udc_layout", &x, 8) && le32(x) > 0)
+			size = le32(x);
+		set_region(id, base + off, MD_VIEW_BASE + off, size);
+		off += size;
+	}
+	nc_start = MD_VIEW_BASE;
+	nc_total = off;
+
+	/* cached bank */
+	uint64_t cbase = 0;
+	uint32_t ccb_size = 0, v;
+	if (tag("md1_bank4_cache_info", &t, 24))
+		cbase = le64(t);
+	if (tag("ccb_info", &t, 16)) {
+		if (!cbase)
+			cbase = le64(t);
+		ccb_size = le32(t + 8);
+	}
+	if (tag_u32("md1_smem_cahce_offset", &v))
+		cache_off = v;
+	uint32_t items = 0, lay_len = 0;
+	const uint8_t *lay = NULL;
+	if (a34_cell_lk_tag("md1_bank4_cache_layout", &lay, &lay_len))
+		items = lay_len / 24;
+	uint32_t coff = 0;
+	for (size_t i = 0; i < sizeof(c6297) / sizeof(c6297[0]); i++) {
+		int id = c6297[i];
+		uint32_t size = id == 1 ? ccb_size : 0, o = coff;
+		for (uint32_t j = 0; j < items && j < 10; j++) {
+			const uint8_t *e = lay + 24 * j;
+			if ((int)le32(e + 16) == id) {
+				size = le32(e + 12);
+				o = le32(e + 8);
+			}
+		}
+		set_region(id, cbase + o, MD_VIEW_BASE + cache_off + o, size);
+		coff = o + size;
+		c_total += size;
+	}
+	c_start = MD_VIEW_BASE + cache_off;
+	printf("A34 CELL: shared memory from the gen6297 tables: non-cached at 0x%llx (%u KiB), cached at 0x%llx (%u KiB)\n",
+	    base, nc_total >> 10, cbase, c_total >> 10);
+	return true;
+}
+
+static bool
+smem_layout(void)
+{
+	const uint8_t *t;
+	uint32_t v;
+
+	memset(rg, 0, sizeof(rg));
+	nc_total = c_total = 0;
+	if (!smem_direct() && !smem_legacy())
+		return false;
+	if (tag("hdr_tbl_inf", &t, 24)) {
+		bank0_pa = le64(t);
+		bank0_size = le32(t + 8);
+	}
+	if (tag_u32("md1img", &v))
+		md1img_size = v;
+	if (tag("smem_layout", &t, 40)) {
+		smem_base = le64(t);
+		smem_off = le32(t + 8);
+		smem_size = le32(t + 12);
+	}
+	if (tag("md1_bank4_cache_info", &t, 24)) {
+		cache_pa = le64(t);
+		cache_size = le32(t + 12);
+	}
+	if (tag("md1_sib_info", &t, 16)) {
+		have_sib = le64(t) != 0;
+		sib_size = have_sib ? le32(t + 8) : 0;
+	}
+	(void)tag_u32("mtee_support", &mtee);
+	/* CCB split (ap_md_mem.c post_cfg_for_ccb): DHL/MONITOR/META 2 MiB each, then RAW_DHL/MDM. */
+	uint32_t s = rg[1].size;
+	if (s > (2u << 20)) {
+		uint64_t ap = rg[1].ap;
+		uint32_t md = rg[1].md;
+		set_region(1, ap, md, 2u << 20);
+		set_region(2, ap, md, 2u << 20);
+		set_region(3, ap, md, 2u << 20);
+		set_region(5, ap + (2u << 20), md + (2u << 20), s - (2u << 20));
+		set_region(6, ap + (2u << 20), md + (2u << 20), s - (2u << 20));
+	} else {
+		rg[1].size = rg[2].size = rg[3].size = rg[5].size = rg[6].size = 0;
+	}
+	/*
+	 * Then Android's port_smem.c collect_ccb_info (run at port init, after the above): each
+	 * CCB user gets the size of its entries in ccb_configs[] (DL + UL buffers, 4 KiB aligned),
+	 * packed from CCB_DHL's base: DHL 0x70000, MD_MONITOR 0x8000, META 0x104000. The modem's
+	 * CCB buffer manager (ccci_shm_bm) checks this layout (CCB_SHARE_MEMORY's total, 0x17c000).
+	 */
+	{
+		static const uint32_t ccb_sz[3] = { 0x70000, 0x8000, 0x104000 };
+		uint64_t ap = rg[1].ap;
+		uint32_t md = rg[1].md;
+		for (int k = 0; k < 3; k++) {
+			set_region(1 + k, ap, md, ccb_sz[k]);
+			ap += ccb_sz[k];
+			md += ccb_sz[k];
+		}
+	}
+	for (int id = 0; id < NREG; id++)
+		if (rg[id].size)
+			printf("A34 CELL: smem %2d: AP 0x%llx MD 0x%08x %u bytes\n", id, rg[id].ap, rg[id].md,
+			    rg[id].size);
+	return rg[R_CCISM_MCU].size >= 0xB4280 && rg[R_CCISM_MCU_EXP].size >= 0x1E280 &&
+	       rg[R_RUNTIME].size >= 2 * RT_HALF;
+}
+
+static vm_offset_t
+rva(int id)
+{
+	if (!rg[id].va && rg[id].size && rg[id].ap) {
+		uint64_t page = rg[id].ap & ~(uint64_t)PAGE_MASK;
+		vm_size_t len = ((vm_size_t)(rg[id].ap - page) + rg[id].size + PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+		if (len > CC_MAP_MAX) {
+			printf("A34 CELL: smem %d (%u bytes) is too large to keep mapped; not mapped\n", id,
+			    rg[id].size);
+			return 0;
+		}
+		vm_offset_t m = ml_io_map_unmappable((vm_offset_t)page, len, CC_WIMG_IO);
+		if (m)
+			rg[id].va = m + (vm_offset_t)(rg[id].ap - page);
+	}
+	return rg[id].va;
+}
+
+/* Zero physical [pa, pa + len) through CC_WIN windows, each unmapped after use. */
+static bool
+pa_zero(uint64_t pa, uint32_t len)
+{
+	while (len >= 4) {
+		uint64_t page = pa & ~(uint64_t)PAGE_MASK;
+		uint32_t off = (uint32_t)(pa - page);
+		uint32_t n = len < CC_WIN - off ? len : CC_WIN - off;
+		vm_size_t mlen = ((vm_size_t)off + n + PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+		vm_offset_t m = ml_io_map_unmappable((vm_offset_t)page, mlen, CC_WIMG_IO);
+		if (!m)
+			return false;
+		dm_zero(m, off, n & ~3u);
+		ml_io_unmap(m, mlen);
+		pa += n;
+		len -= n;
+	}
+	return true;
+}
+
+/* ---- CCB control: what Android's userspace writes ---- */
+
+/*
+ * port_smem.c ccb_configs[] (dl_page_size, ul_page_size, dl_buff_size, ul_buff_size): 18 DHL
+ * entries (control, exception, PS, HW loggers 1-3, 12 dummies), MD_MONITOR, META. The data
+ * buffers lie in this order from CCB_DHL's base (DL then UL), 0x17c000 in all.
+ */
+#define R_CCB_CTRL      4
+#define CCB_GUARD_E     0xEEFF0011u
+static const uint32_t ccb_cfg[20][4] = {
+	{ 0x400, 0x400, 0x8000, 0x8000 }, { 0x5000, 0x80, 0x1e000, 0x80 },
+	{ 0x200, 0x400, 0x9000, 0x8000 }, { 0x200, 0x80, 0x8000, 0x80 },
+	{ 0x200, 0x80, 0x8000, 0x80 }, { 0x200, 0x80, 0x20000, 0x80 },
+	{ 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 },
+	{ 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 },
+	{ 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 },
+	{ 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x80, 0x80 }, { 0x80, 0x80, 0x280, 0x80 },
+	{ 0x200, 0x400, 0x4000, 0x4000 },                                       /* MD_MONITOR */
+	{ 0x10400, 0x10400, 0x82000, 0x82000 },                                 /* META */
+};
+
+/*
+ * Android's ccci_mdinit, right after it starts the modem ("modem boot up, set runtime data"),
+ * calls libccci_util ccci_ccb_init_users for DHL, MD_MONITOR and META: through
+ * /dev/ccci_ccb_ctrl it writes one 64-byte buffer header per ccb_configs[] entry, at
+ * (the user's ccb_ctrl_offset + k) * 64: DL {0, 0, 0, 0, 0, page size, buffer size,
+ * 0xEEFF0011}, then UL the same. The kernel never writes CCB_CTRL; without these headers the
+ * modem's CCB buffer manager (ccci_shm_bm) asserts.
+ */
+static bool
+ccb_ctrl_init(void)
+{
+	vm_offset_t c = rva(R_CCB_CTRL);
+
+	if (!c || rg[R_CCB_CTRL].size < 20 * 64) {
+		printf("A34 CELL: CCB_CTRL missing or too small (%u bytes): no CCB headers\n",
+		    rg[R_CCB_CTRL].size);
+		return false;
+	}
+	for (int i = 0; i < 20; i++) {
+		uint32_t h[16];
+		memset(h, 0, sizeof(h));
+		h[5] = ccb_cfg[i][0];
+		h[6] = ccb_cfg[i][2];
+		h[7] = CCB_GUARD_E;
+		h[13] = ccb_cfg[i][1];
+		h[14] = ccb_cfg[i][3];
+		h[15] = CCB_GUARD_E;
+		dm_put(c, 64u * (uint32_t)i, h, sizeof(h));
+	}
+	__asm__ volatile ("dsb st" ::: "memory");
+	printf("A34 CELL: CCB_CTRL: 20 buffer headers written as Android's ccci_mdinit "
+	    "(DHL 18, MD_MONITOR 1, META 1)\n");
+	return true;
+}
+
+/* CCB_CTRL header words (indices, sizes, guards) in hex. */
+static void
+ccb_ctrl_show(const char *when, uint32_t first, uint32_t count)
+{
+	vm_offset_t c = rva(R_CCB_CTRL);
+	uint32_t w[16];
+
+	if (!c || rg[R_CCB_CTRL].size < 64u * (first + count))
+		return;
+	for (uint32_t i = first; i < first + count; i++) {
+		dm_get(w, c, 64u * i, sizeof(w));
+		printf("A34 CELL: CCB_CTRL %s: header %u DL %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    when, i, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		printf("A34 CELL: CCB_CTRL %s: header %u UL %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    when, i, w[8], w[9], w[10], w[11], w[12], w[13], w[14], w[15]);
+	}
+}
+
+/*
+ * Whether the start of each CCB data area holds anything: a count of non-zero words only,
+ * never their contents (these buffers carry the modem's own logs).
+ */
+static void
+ccb_data_show(const char *when)
+{
+	static const char *const nm[4] = { "", "DHL", "MD_MONITOR", "META" };
+
+	for (int id = 1; id <= 3; id++) {
+		if (!rg[id].size || (rg[id].ap & PAGE_MASK))
+			continue;
+		vm_offset_t m = ml_io_map_unmappable((vm_offset_t)rg[id].ap, PAGE_SIZE, CC_WIMG_IO);
+		if (!m)
+			continue;
+		uint32_t nz = 0;
+		for (uint32_t o = 0; o < 64; o += 4)
+			nz += rd32(m, o) != 0;
+		ml_io_unmap(m, PAGE_SIZE);
+		printf("A34 CELL: CCB %s data %s: %u of its first 16 words non-zero\n", nm[id], when, nz);
+	}
+}
+
+/* ---- rings ---- */
+
+static const uint16_t rx_kib[16] = { 80, 80, 40, 80, 20, 20, 64, 0, 8, 0, 0, 0, 0, 0, 0, 0 };
+static const uint16_t tx_kib[16] = { 128, 40, 8, 40, 20, 20, 64, 0, 8, 0, 0, 0, 0, 0, 0, 0 };
+static const uint16_t exp_kib[16] = { 12, 32, 8, 0, 0, 0, 8, 0, 0, 0, 0, 0, 0, 0, 0, 0 };
+
+static struct ring {
+	vm_offset_t blk;
+	uint32_t rxlen, txlen;
+	uint32_t rx_packets, tx_packets;
+} q[16];
+static uint32_t ccism_size;     /* what the modem is told: the rings' total, 0xB4280 */
+
+static uint32_t
+rings_build(vm_offset_t base, uint32_t region, const uint16_t *rx, const uint16_t *tx, struct ring *out)
+{
+	uint32_t off = 0;
+
+	dm_zero(base, 0, region & ~3u);
+	for (int i = 0; i < 16; i++) {
+		uint32_t r = (uint32_t)rx[i] << 10, t = (uint32_t)tx[i] << 10;
+		if (off + 40 + r + t > region)
+			return 0;
+		wr32(base, off + 0x00, 0xEE0000EEu);
+		wr32(base, off + 0x04, 0xEE0000EEu);
+		wr32(base, off + 0x10, r);
+		wr32(base, off + 0x1C, t);
+		wr32(base, off + 0x20 + r + t, 0xFF0000FFu);
+		wr32(base, off + 0x24 + r + t, 0xFF0000FFu);
+		if (out) {
+			out[i].blk = base + off;
+			out[i].rxlen = r;
+			out[i].txlen = t;
+		}
+		off += 40 + r + t;
+	}
+	return off;
+}
+
+/* ---- state, sending ---- */
+
+enum { ST_OFF, ST_WAIT_HS2, ST_READY, ST_EXCEPTION };
+static int state = ST_OFF;
+static vm_offset_t ap, md_ccif;
+static bool prepared;
+static uint16_t seq_out[512];
+static LCK_GRP_DECLARE(cc_grp, "a34_ccci");
+static LCK_MTX_DECLARE(tx_lock, &cc_grp);
+
+static int
+tx_queue(uint16_t ch)
+{
+	switch (ch) {
+	case CH_AT_TX: return 5;
+	case CH_FS_TX: return 4;
+	case CH_RPC_TX: return 1;
+	case CH_CTRL_TX: case CH_SYS_TX: return 0;
+	default: return -1;
+	}
+}
+
+static void
+doorbell(uint32_t bit)
+{
+	if (rd32(ap, CCIF_BUSY) & (1u << bit))
+		return;         /* the modem has not taken the last one yet: it sees the ring anyway */
+	wr32(ap, CCIF_BUSY, 1u << bit);
+	wr32(ap, CCIF_TCHNUM, bit);
+}
+
+bool
+a34_ccci_send(uint16_t channel, const struct ccci_hdr *hdr, const void *payload, uint32_t len)
+{
+	static uint8_t frame[MAX_PKT + 32];
+	int qn = tx_queue(channel);
+
+	if (qn < 0 || !prepared || state == ST_OFF || state == ST_EXCEPTION || len + 16 > MAX_PKT)
+		return false;
+	if (state == ST_WAIT_HS2 && channel != CH_FS_TX && channel != CH_RPC_TX)
+		return false;   /* only the file server and RPC may talk before HS2 */
+	struct ring *r = &q[qn];
+	lck_mtx_lock(&tx_lock);
+	uint32_t L = r->txlen, rp = rd32(r->blk, 0x14), wp = rd32(r->blk, 0x18);
+	uint32_t plen = len + 16, need = (plen + 16 + 7) & ~7u;
+	uint32_t free = rp == wp ? L - 1 : rp < wp ? L - wp - 1 + rp : rp - wp - 1;
+	if (plen > L || need >= free || wp >= L || (wp & 7)) {
+		lck_mtx_unlock(&tx_lock);
+		return false;
+	}
+	struct ccci_hdr h = *hdr;
+	h.channel = channel;
+	bool assert_bit = !((channel == CH_FS_TX || channel == CH_RPC_TX) && state != ST_WAIT_HS2);
+	h.seq = (uint16_t)((seq_out[channel]++ & 0x7FFF) | (assert_bit ? 0x8000 : 0));
+	uint32_t w0 = 0xAABBAABBu, w1 = plen, foot = 0xCCDDEEFFu;
+	memset(frame, 0, need);
+	memcpy(frame, &w0, 4);
+	memcpy(frame + 4, &w1, 4);
+	memcpy(frame + 8, &h, 16);
+	if (len)
+		memcpy(frame + 24, payload, len);
+	memcpy(frame + need - 8, &foot, 4);
+	memcpy(frame + need - 4, &foot, 4);
+	vm_offset_t area = r->blk + 0x20 + r->rxlen;
+	uint32_t first = need <= L - wp ? need : L - wp;
+	dm_put(area, wp, frame, first);
+	if (first < need)
+		dm_put(area, 0, frame + first, need - first);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr32(r->blk, 0x18, (wp + need) % L);
+	r->tx_packets++;
+	doorbell((uint32_t)qn);
+	lck_mtx_unlock(&tx_lock);
+	return true;
+}
+
+/* ---- /dev/a34at0 ---- */
+
+#define AT_FIFO         16384u
+
+static LCK_MTX_DECLARE(at_lock, &cc_grp);
+static struct {
+	uint8_t fifo[AT_FIFO];
+	uint32_t head, len, dropped;
+	struct selinfo si;
+	bool open, up;
+	int major;
+} at;
+
+static void
+at_rx(const uint8_t *p, uint32_t n)
+{
+	lck_mtx_lock(&at_lock);
+	for (uint32_t i = 0; i < n; i++) {
+		if (at.len == AT_FIFO) {
+			at.dropped += n - i;
+			break;
+		}
+		at.fifo[(at.head + at.len) % AT_FIFO] = p[i];
+		at.len++;
+	}
+	selwakeup(&at.si);
+	wakeup(&at.fifo);
+	lck_mtx_unlock(&at_lock);
+}
+
+static int
+at_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	int e = 0;
+
+	lck_mtx_lock(&at_lock);
+	if (!at.up)
+		e = ENXIO;
+	else if (at.open)
+		e = EBUSY;
+	else
+		at.open = true;
+	lck_mtx_unlock(&at_lock);
+	return e;
+}
+
+static int
+at_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	lck_mtx_lock(&at_lock);
+	at.open = false;
+	lck_mtx_unlock(&at_lock);
+	return 0;
+}
+
+static int
+at_read(__unused dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t tmp[512];
+	int e = 0;
+
+	lck_mtx_lock(&at_lock);
+	while (at.len == 0) {
+		if (!at.up || (ioflag & IO_NDELAY)) {
+			lck_mtx_unlock(&at_lock);
+			return at.up ? EWOULDBLOCK : EIO;
+		}
+		e = msleep(&at.fifo, &at_lock, PCATCH | PZERO, "a34at", NULL);
+		if (e) {
+			lck_mtx_unlock(&at_lock);
+			return e;
+		}
+	}
+	while (at.len > 0 && uio_resid(uio) > 0) {
+		uint32_t n = at.len < sizeof(tmp) ? at.len : (uint32_t)sizeof(tmp);
+		if ((user_ssize_t)n > uio_resid(uio))
+			n = (uint32_t)uio_resid(uio);
+		for (uint32_t i = 0; i < n; i++)
+			tmp[i] = at.fifo[(at.head + i) % AT_FIFO];
+		at.head = (at.head + n) % AT_FIFO;
+		at.len -= n;
+		lck_mtx_unlock(&at_lock);
+		e = uiomove((caddr_t)tmp, (int)n, uio);
+		lck_mtx_lock(&at_lock);
+		if (e)
+			break;
+	}
+	lck_mtx_unlock(&at_lock);
+	return e;
+}
+
+static int
+at_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint8_t buf[2048];
+	user_ssize_t n = uio_resid(uio);
+	struct ccci_hdr h = { 0, 0, 0, 0, 0 };
+	int e;
+
+	if (!at.up || state != ST_READY)
+		return EIO;
+	if (n <= 0)
+		return 0;
+	if (n > (user_ssize_t)sizeof(buf))
+		return EMSGSIZE;        /* one write() is one packet */
+	if ((e = uiomove((caddr_t)buf, (int)n, uio)))
+		return e;
+	h.data1 = (uint32_t)n + 16;
+	for (int tries = 0; tries < 100; tries++) {
+		if (a34_ccci_send(CH_AT_TX, &h, buf, (uint32_t)n))
+			return 0;
+		sleep_ms(5);    /* ring full: the modem is behind */
+	}
+	return EIO;
+}
+
+static int
+at_select(__unused dev_t dev, int which, void *wql, struct proc *p)
+{
+	int r = 0;
+
+	lck_mtx_lock(&at_lock);
+	if (which == FREAD) {
+		if (at.len > 0 || !at.up)
+			r = 1;
+		else
+			selrecord(p, &at.si, wql);
+	} else if (which == FWRITE) {
+		r = 1;
+	}
+	lck_mtx_unlock(&at_lock);
+	return r;
+}
+
+static const struct cdevsw at_cdevsw = {
+	.d_open       = at_open,
+	.d_close      = at_close,
+	.d_read       = at_read,
+	.d_write      = at_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = at_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+static void
+at_up(void)
+{
+	at.major = cdevsw_add(-1, &at_cdevsw);
+	if (at.major < 0) {
+		printf("A34 CELL: no character device major for a34at0\n");
+		return;
+	}
+	devfs_make_node(makedev(at.major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "a34at0");
+	lck_mtx_lock(&at_lock);
+	at.up = true;
+	lck_mtx_unlock(&at_lock);
+	printf("A34 CELL: /dev/a34at0 ready (AT: CCCI tx %u / rx %u, queue 5)\n", CH_AT_TX, CH_AT_RX);
+}
+
+/* ---- receiving ---- */
+
+static uint32_t unknown_ch_seen[16];
+
+static void
+hs2(const struct ccci_hdr *h)
+{
+	if (state != ST_WAIT_HS2)
+		return;
+	state = ST_READY;
+	printf("A34 CELL: HS2 -- the modem is ready (reserved 0x%08x)\n", h->reserved);
+	register uint64_t x0 __asm__("x0") = SMC_CCCI;
+	register uint64_t x1 __asm__("x1") = SMC_CCIF_CLK_RELEASE;
+	__asm__ volatile("mov x2, xzr\n\tmov x3, xzr\n\tmov x4, xzr\n\tmov x5, xzr\n\tmov x6, xzr\n\t"
+	    "mov x7, xzr\n\tsmc #0\n\t" : "+r"(x0), "+r"(x1) : : "x2", "x3", "x4", "x5", "x6", "x7",
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a34_cellfs_report();
+	at_up();
+}
+
+static void
+sys_rx(const struct ccci_hdr *h)
+{
+	struct ccci_hdr r = { 0xFFFFFFFFu, 0, 0, 0, 0 };
+
+	printf("A34 CELL: sys message 0x%x (param 0x%x)\n", h->data1, h->reserved);
+	if (state != ST_READY)
+		return;
+	if (h->data1 == 0x105) {                /* MD_GET_BATTERY_INFO: battery mV */
+		r.data1 = 0x105;
+		r.reserved = 3800;
+		(void)a34_ccci_send(CH_SYS_TX, &r, NULL, 0);
+	} else if (h->data1 == 0x114 || h->data1 == 0x116) {    /* test echo */
+		r.data1 = h->data1 + 1;
+		r.reserved = h->reserved;
+		(void)a34_ccci_send(CH_SYS_TX, &r, NULL, 0);
+	}
+}
+
+/*
+ * RPC (Android's port_rpc.c, served in the kernel there too): {op, argc, {len, data pad 4}...}
+ * on channel 32, the answer {op|0xFFFF0000, argc, args} on 33 with the same header.reserved.
+ * The answers come from what Android reads for them: LK's device tree (gpio_usage_mapping,
+ * MD1-SIMn-HOT-PLUG-EINT, md_attr_node, md-auxadc), the GPIO input levels and the SoC AUXADC
+ * channel of the modem -- all read only; nothing of any identity is involved.
+ */
+extern bool a34_cell_fdt_prop(const char *node_name, const char *compat, const char *prop,
+    const uint8_t **val, uint32_t *len);
+
+#define RPC_FS_PARAM_ERROR      (-2)
+#define RPC_FS_FUNC_FAIL        (-5)
+#define RPC_ERR_SIM_QUERY_TYPE  (-12)
+#define RPC_ERR_SIM_QUERY_STR   (-11)
+
+static struct {
+	uint8_t buf[2048];
+	uint32_t len, argc;
+} ro;
+
+static void
+ro_init(uint32_t op)
+{
+	uint32_t v = op | 0xFFFF0000u;
+	memcpy(ro.buf, &v, 4);
+	ro.len = 8;
+	ro.argc = 0;
+}
+
+static void
+ro_arg(const void *d, uint32_t len)
+{
+	uint32_t padded = (len + 3) & ~3u;
+	if (ro.len + 4 + padded > sizeof(ro.buf))
+		return;
+	memcpy(ro.buf + ro.len, &len, 4);
+	if (len)
+		memcpy(ro.buf + ro.len + 4, d, len);
+	memset(ro.buf + ro.len + 4 + len, 0, padded - len);
+	ro.len += 4 + padded;
+	ro.argc++;
+}
+
+static void
+ro_u32(uint32_t v)
+{
+	ro_arg(&v, 4);
+}
+
+static uint32_t
+be32c(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+/* cell idx of a device-tree property (big endian), or false */
+static bool
+dt_cell(const char *node, const char *compat, const char *prop, uint32_t idx, uint32_t *v)
+{
+	const uint8_t *p;
+	uint32_t l = 0;
+	if (!a34_cell_fdt_prop(node, compat, prop, &p, &l) || 4 * (idx + 1) > l)
+		return false;
+	*v = be32c(p + 4 * idx);
+	return true;
+}
+
+/* port_rpc.c gpio_mapping_table: the modem's names -> the device tree's (underscore style) */
+static const struct { const char *md, *dts; } gpio_names[] = {
+	{ "GPIO_FDD_Band_Support_Detection_1", "GPIO_FDD_BAND_SUPPORT_DETECT_1ST_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_2", "GPIO_FDD_BAND_SUPPORT_DETECT_2ND_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_3", "GPIO_FDD_BAND_SUPPORT_DETECT_3RD_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_4", "GPIO_FDD_BAND_SUPPORT_DETECT_4TH_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_5", "GPIO_FDD_BAND_SUPPORT_DETECT_5TH_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_6", "GPIO_FDD_BAND_SUPPORT_DETECT_6TH_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_7", "GPIO_FDD_BAND_SUPPORT_DETECT_7TH_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_8", "GPIO_FDD_BAND_SUPPORT_DETECT_8TH_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_9", "GPIO_FDD_BAND_SUPPORT_DETECT_9TH_PIN" },
+	{ "GPIO_FDD_Band_Support_Detection_A", "GPIO_FDD_BAND_SUPPORT_DETECT_ATH_PIN" },
+	{ "GPIO_RF_PWREN_RST_PIN", "GPIO_RF_PWREN_RST_PIN" },
+	{ "GPIO_SIM1_HOT_PLUG", "GPIO_SIM1_HOT_PLUG" },
+	{ "GPIO_SIM2_HOT_PLUG", "GPIO_SIM2_HOT_PLUG" },
+	{ "GPIO_SIM2_SCLK", "GPIO_SIM2_SCLK" },
+	{ "GPIO_SIM2_SRST", "GPIO_SIM2_SRST" },
+	{ "GPIO_SIM2_SIO", "GPIO_SIM2_SIO" },
+	{ "GPIO_SIM1_SIO", "GPIO_SIM1_SIO" },
+	{ "GPIO_SIM1_SRST", "GPIO_SIM1_SRST" },
+	{ "GPIO_SIM1_SCLK", "GPIO_SIM1_SCLK" },
+};
+
+/* The modem's GPIO number for a name (gpio_usage_mapping <&pio pin md-pin>), -1 if none. */
+static int
+md_gpio(const uint8_t *name, uint32_t len, uint32_t *ap_pin)
+{
+	char n[64];
+	uint32_t k = 0;
+	for (; k < len && k + 1 < sizeof(n) && name[k]; k++)
+		n[k] = (char)name[k];
+	n[k] = 0;
+	const char *prop = n;
+	for (size_t i = 0; i < sizeof(gpio_names) / sizeof(gpio_names[0]); i++)
+		if (strcmp(n, gpio_names[i].md) == 0)
+			prop = gpio_names[i].dts;
+	uint32_t pin;
+	if (!dt_cell(NULL, "mediatek,gpio_usage_mapping", prop, 1, &pin))
+		return -1;
+	if (ap_pin)
+		*ap_pin = pin;
+	return (int)pin;
+}
+
+static vm_offset_t gpio_base, adc_base;
+
+static uint32_t
+gpio_in(uint32_t pin)
+{
+	if (!gpio_base)
+		gpio_base = ml_io_map(0x10005000, PAGE_SIZE);
+	if (!gpio_base || pin > 255)
+		return 0;
+	return (rd32(gpio_base, 0x200 + (pin / 32) * 0x10) >> (pin % 32)) & 1;   /* DIN */
+}
+
+/* SoC AUXADC channel ch, raw 12 bits, as mt6577_auxadc_read; -1 on a timeout. */
+static int
+auxadc_raw(uint32_t ch)
+{
+	if (!adc_base)
+		adc_base = ml_io_map(0x11001000, PAGE_SIZE);
+	if (!adc_base || ch > 15)
+		return -1;
+	uint32_t dat = 0x14 + 4 * ch;
+	wr32(adc_base, 0x94, rd32(adc_base, 0x94) | (1u << 14));        /* MISC: PDN_EN, power */
+	wr32(adc_base, 0x0C, 1u << ch);                                 /* CON1_CLR */
+	for (int i = 0; i < 100 && (rd32(adc_base, dat) & (1u << 12)); i++)
+		delay(100);
+	wr32(adc_base, 0x08, 1u << ch);                                 /* CON1_SET: sample */
+	delay(25);
+	for (int i = 0; i < 100 && (rd32(adc_base, 0x10) & 1); i++)     /* CON2 STA: busy */
+		delay(100);
+	for (int i = 0; i < 100; i++) {
+		uint32_t v = rd32(adc_base, dat);
+		if (v & (1u << 12))
+			return (int)(v & 0xFFF);
+		delay(100);
+	}
+	return -1;
+}
+
+static int adc_num = -1, adc_val = -1;
+
+static void
+adc_probe(void)
+{
+	static bool done;
+	uint32_t ch;
+	if (done)
+		return;
+	done = true;
+	if (dt_cell(NULL, "mediatek,md_auxadc", "io-channels", 1, &ch)) {
+		adc_num = (int)ch;
+		adc_val = auxadc_raw(ch);       /* Android reads it once at probe, too */
+	}
+	printf("A34 CELL: RPC: modem ADC channel %d, raw %d\n", adc_num, adc_val);
+	/*
+	 * Android's raw value is calibrated: mt6577_auxadc.c (mt6765 compatible: sample_data_cali)
+	 * with the devinfo efuse word at 0x1c4 (auxadc node: cali-efuse-reg-offset, en bit 20,
+	 * ge bits 10-19, oe bits 0-9, each - 512), which Android's devinfo takes from LK's /chosen
+	 * atag,devinfo (word 1 + 0x1c4 / 4). Only that word is read; only ge/oe are logged.
+	 */
+	const uint8_t *dv;
+	uint32_t dvl = 0;
+	if (adc_val >= 0 && a34_cell_fdt_prop("chosen", NULL, "atag,devinfo", &dv, &dvl) &&
+	    dvl >= 4u * (2u + 0x1c4u / 4u)) {
+		uint32_t w = le32(dv + 4u * (1u + 0x1c4u / 4u));
+		if ((w >> 20) & 1u) {
+			int ge = (int)((w >> 10) & 0x3ffu) - 512, oe = (int)(w & 0x3ffu) - 512;
+			int cal = (4096 * (adc_val - oe)) / (4096 + ge);
+			printf("A34 CELL: RPC: ADC calibration as Android's AUXADC driver (devinfo ge %d, oe %d): "
+			    "raw %d -> %d\n", ge, oe, adc_val, cal);
+			adc_val = cal;
+		} else {
+			printf("A34 CELL: RPC: ADC calibration not enabled in devinfo: raw value as is\n");
+		}
+	} else if (adc_val >= 0) {
+		printf("A34 CELL: RPC: no atag,devinfo in LK's device tree: ADC raw value as is\n");
+	}
+}
+
+/* EINT attribute of SIM n's hot-plug interrupt (port_rpc.c get_eint_attr_val), < 0 if none. */
+static int
+sim_eint_attr(uint32_t sim, uint32_t type)
+{
+	char node[32];
+	uint32_t v;
+	snprintf(node, sizeof(node), "MD1-SIM%u-HOT-PLUG-EINT", sim);
+	switch (type) {
+	case 0: return dt_cell(node, NULL, "interrupts", 0, &v) ? (int)v : RPC_ERR_SIM_QUERY_TYPE;
+	case 1: return dt_cell(node, NULL, "debounce", 1, &v) ? (int)(v / 1000) : RPC_ERR_SIM_QUERY_TYPE;
+	case 2: case 3:
+		if (!dt_cell(node, NULL, "interrupts", 1, &v))
+			return RPC_ERR_SIM_QUERY_TYPE;
+		if (v != 1 && v != 2 && v != 4 && v != 8)
+			return -1;
+		return type == 2 ? ((v & 5) ? 1 : 0) : ((v & 3) ? 1 : 0);
+	case 4: return dt_cell(node, NULL, "sockettype", 1, &v) ? (int)v : RPC_ERR_SIM_QUERY_TYPE;
+	case 5: return dt_cell(node, NULL, "dedicated", 1, &v) ? (int)v : RPC_ERR_SIM_QUERY_TYPE;
+	case 6: return (dt_cell(node, NULL, "src-pin", 1, &v) || dt_cell(node, NULL, "src_pin", 1, &v)) ?
+		    (int)v : RPC_ERR_SIM_QUERY_TYPE;
+	default: return RPC_ERR_SIM_QUERY_TYPE;
+	}
+}
+
+static void
+gpio_adc(const uint8_t *in, uint32_t inlen, uint8_t *out, uint32_t *outlen)
+{
+	bool v2 = inlen == 425;
+	uint32_t count = v2 ? 10 : 3;
+	uint32_t req = v2 ? (uint32_t)(in[0] | in[1] << 8) : in[0];
+	uint32_t valid = v2 ? (uint32_t)(in[2] | in[3] << 8) : in[1];
+	const uint8_t *names = in + (v2 ? 4 : 2);
+	const uint8_t *pinnum = names + count * 34;
+	const uint8_t *adcname = pinnum + count * 4;
+	uint32_t adcchnum = le32(adcname + 33), meas = le32(adcname + 37);
+	uint32_t *o_num = (uint32_t *)out, *o_val = o_num + count, *o_adc = o_val + count;
+
+	*outlen = (2 * count + 2) * 4;
+	memset(out, 0x0F, *outlen);             /* 0xF for failure, as Android */
+	for (uint32_t i = 0; i < count; i++) {
+		if (!(valid & (1u << i)))
+			continue;
+		uint32_t ap_pin;
+		if ((req & 3) == 3 || (req & 1)) {
+			int md = md_gpio(names + 34 * i, 34, &ap_pin);
+			if (md >= 0) {
+				o_num[i] = (uint32_t)md;
+				if ((req & 3) == 3)
+					o_val[i] = gpio_in(ap_pin);
+			}
+		} else if (req & 2) {
+			o_val[i] = gpio_in(le32(pinnum + 4 * i));
+		}
+	}
+	if (req & 0x30) {
+		adc_probe();
+		if ((req & 0x30) == 0x30 || (req & 0x10)) {
+			if (adc_num >= 0)
+				o_adc[0] = (uint32_t)adc_num;
+		}
+		if ((req & 0x30) == 0x30 ? adc_num >= 0 : (req & 0x20) != 0) {
+			o_adc[1] = 0;
+			for (uint32_t k = 0; k < meas && k < 64; k++)
+				o_adc[1] += (uint32_t)adc_val;
+		}
+		(void)adcchnum;
+	}
+}
+
+static void
+rpc_rx(const uint8_t *pkt, uint32_t len)
+{
+	struct ccci_hdr h;
+	const uint8_t *arg[6];
+	uint32_t alen[6], argc, op, off = 24;
+
+	if (len < 24)
+		return;
+	memcpy(&h, pkt, 16);
+	op = le32(pkt + 16);
+	argc = le32(pkt + 20);
+	if (argc > 6)
+		argc = 0;
+	for (uint32_t i = 0; i < argc; i++) {
+		if (off + 4 > len)
+			break;
+		alen[i] = le32(pkt + off);
+		arg[i] = pkt + off + 4;
+		if (off + 4 + alen[i] > len) {
+			argc = i;
+			break;
+		}
+		off += 4 + ((alen[i] + 3) & ~3u);
+	}
+	ro_init(op);
+	switch (op) {
+	case 0x4002: {                                  /* GET_GPIO_NUM */
+		int n = argc >= 2 && alen[0] ? md_gpio(arg[0], alen[0], NULL) : -1;
+		int32_t r = argc < 2 ? RPC_FS_PARAM_ERROR : n < 0 ? RPC_FS_FUNC_FAIL : n;
+		ro_u32((uint32_t)r);
+		ro_u32((uint32_t)r);
+		char nm[40];
+		uint32_t k = 0;
+		for (; argc && k < alen[0] && k + 1 < sizeof(nm) && arg[0][k]; k++)
+			nm[k] = (char)arg[0][k];
+		nm[k] = 0;
+		printf("A34 CELL: RPC GET_GPIO_NUM %s -> %d\n", nm, r);
+		break;
+	}
+	case 0x4005: {                                  /* GET_EINT_ATTR */
+		int32_t r = RPC_ERR_SIM_QUERY_STR;
+		uint32_t type = argc >= 3 && alen[2] >= 4 ? le32(arg[2]) : 0xFF;
+		char nm[40];
+		uint32_t k = 0;
+		for (; argc && k < alen[0] && k + 1 < sizeof(nm) && arg[0][k]; k++)
+			nm[k] = (char)arg[0][k];
+		nm[k] = 0;
+		if (argc < 3) {
+			r = RPC_FS_PARAM_ERROR;
+		} else if (type >= 7) {
+			r = RPC_ERR_SIM_QUERY_TYPE;
+		} else {
+			for (uint32_t sim = 1; sim <= 4; sim++) {
+				char a[32], b[32];
+				snprintf(a, sizeof(a), "MD1_SIM%u_HOT_PLUG_EINT", sim);
+				snprintf(b, sizeof(b), "MD1-SIM%u-HOT-PLUG-EINT", sim);
+				if (strcmp(nm, a) == 0 || strcmp(nm, b) == 0) {
+					int v = sim_eint_attr(sim, type);
+					r = v >= 0 ? 0 : RPC_ERR_SIM_QUERY_STR;
+					if (v >= 0) {
+						ro_u32(0);
+						ro_u32((uint32_t)v);
+						printf("A34 CELL: RPC GET_EINT_ATTR %s type %u -> %d\n", nm, type, v);
+					}
+					break;
+				}
+			}
+		}
+		if (r != 0) {
+			ro_u32((uint32_t)r);
+			ro_u32((uint32_t)r);
+			printf("A34 CELL: RPC GET_EINT_ATTR %s type %u -> error %d\n", nm, type, r);
+		}
+		break;
+	}
+	case 0x400E: {                                  /* DTSI_QUERY: md_attr_node */
+		uint8_t o[68];
+		memset(o, 0x0F, sizeof(o));
+		if (argc != 1 || alen[0] < 3) {
+			ro_u32((uint32_t)RPC_FS_PARAM_ERROR);
+			ro_u32((uint32_t)RPC_FS_PARAM_ERROR);
+			break;
+		}
+		char nm[66];
+		uint32_t k = 0;
+		for (; 2 + k < alen[0] && k + 1 < sizeof(nm) && arg[0][2 + k]; k++)
+			nm[k] = (char)arg[0][2 + k];
+		nm[k] = 0;
+		uint32_t v;
+		if (arg[0][0] == 1 && dt_cell(NULL, "mediatek,md_attr_node", nm, 0, &v))
+			memcpy(o, &v, 4);
+		ro_u32(0);
+		ro_arg(o, sizeof(o));
+		printf("A34 CELL: RPC DTSI_QUERY %s -> 0x%x\n", nm, le32(o));
+		break;
+	}
+	case 0x4009: {                                  /* GET_GPIO_ADC */
+		uint32_t o32[24];
+		uint8_t *o = (uint8_t *)o32;
+		uint32_t olen = 0;
+		if (argc != 1 || (alen[0] != 157 && alen[0] != 425)) {
+			ro_u32((uint32_t)RPC_FS_PARAM_ERROR);
+			ro_u32((uint32_t)RPC_FS_PARAM_ERROR);
+			printf("A34 CELL: RPC GET_GPIO_ADC: input of %u bytes not understood\n", argc ? alen[0] : 0);
+			break;
+		}
+		gpio_adc(arg[0], alen[0], o, &olen);
+		ro_u32(0);
+		ro_arg(o, olen);
+		printf("A34 CELL: RPC GET_GPIO_ADC (v%d, request 0x%x) answered\n", alen[0] == 425 ? 2 : 1, arg[0][0]);
+		break;
+	}
+	case 0x4012: {                                  /* TRNG */
+		uint32_t rnd = 0;
+		read_random(&rnd, sizeof(rnd));
+		ro_u32(0);
+		ro_u32(rnd);
+		printf("A34 CELL: RPC TRNG answered\n");
+		break;
+	}
+	default:                                        /* not served: FS_NO_OP (-1), as Android */
+		ro_u32(0xFFFFFFFFu);
+		printf("A34 CELL: RPC op 0x%x not served (-1)\n", op);
+		break;
+	}
+	memcpy(ro.buf + 4, &ro.argc, 4);
+	h.data1 = ro.len + 16;
+	(void)a34_ccci_send(CH_RPC_TX, &h, ro.buf, ro.len);
+}
