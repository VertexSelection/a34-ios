+int
+sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len, uint64_t *part_bytes)
+{
+	uint64_t first = 0, n = 0;
+	bool listed = false;
+	int error;
+
+	for (size_t i = 0; i < sizeof(sweet_ufs_ro_parts) / sizeof(sweet_ufs_ro_parts[0]); i++) {
+		if (strcmp(name, sweet_ufs_ro_parts[i]) == 0) {
+			listed = true;
+		}
+	}
+	if (!listed) {
+		printf("SWEET UFS: refusing to read partition \"%s\" (not on the read-only list)\n", name);
+		return EPERM;
+	}
+	if (!su.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_find_partition(name, &first, &n);
+	if (!error && part_bytes) {
+		*part_bytes = n * UFS_BLOCK;
+	}
+	if (!error && (off > n * UFS_BLOCK || len > n * UFS_BLOCK - off)) {
+		error = EINVAL;
+	}
+	for (uint32_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(len - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(first + pos / UFS_BLOCK, blocks);
+		if (!error) {
+			memcpy((char *)buf + done, (const char *)(su.dma + DMA_BOUNCE) + skip, want);
+			done += want;
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
