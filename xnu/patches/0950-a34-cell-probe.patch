+/* The modem's exception overview at the start of RAW_MDSS_DBG (mdee_dumper_v5.h ex_overview_t,
+ * gen97): offending core, exception class, assert file/line or fatal codes. Firmware
+ * diagnostics only. */
+static void
+md_exception_report(void)
+{
+	vm_offset_t b = rva(R_MDSS_DBG);
+	uint8_t ov[448];
+
+	if (!b || rg[R_MDSS_DBG].size < sizeof(ov)) {
+		printf("A34 CELL: modem exception: MDSS_DBG not mapped\n");
+		return;
+	}
+	dm_get(ov, b, 0, sizeof(ov));
+	uint32_t verno = le32(ov), cores = le32(ov + 4);
+	char offender[64] = "";
+	for (uint32_t c = 0; c < 12; c++) {
+		const uint8_t *r = ov + 8 + 12 * c;
+		if (r[11]) {
+			size_t o = strlen(offender);
+			for (int k = 0; k < 11 && r[k] && o + 2 < sizeof(offender); k++)
+				offender[o++] = (r[k] >= 0x20 && r[k] < 0x7f) ? (char)r[k] : '.';
+			offender[o++] = ' ';
+			offender[o] = 0;
+		}
+	}
+	const uint8_t *ex = ov + 152;
+	uint32_t ex_type = (uint32_t)(ex[0] | ex[1] << 8), content = ex[3];
+	const uint8_t *in = ex + 8;
+	char file[257];
+	uint32_t k = 0;
+	for (; k < 256 && in[k]; k++)
+		file[k] = (in[k] >= 0x20 && in[k] < 0x7f) ? (char)in[k] : '.';
+	file[k] = 0;
+	printf("A34 CELL: modem exception: overview v%u, %u cores, offender %s, type 0x%x, class %u\n",
+	    verno, cores, offender[0] ? offender : "?", ex_type, content);
+	printf("A34 CELL: modem exception: assert %s line %u (p1 0x%x p2 0x%x p3 0x%x lr 0x%x)\n",
+	    file[0] ? file : "(none)", le32(in + 256), le32(in + 260), le32(in + 264), le32(in + 268),
+	    le32(in + 272));
+	printf("A34 CELL: modem exception: as fatal: code1 0x%x code2 0x%x code3 0x%x\n", le32(in),
+	    le32(in + 4), le32(in + 8));
+	a34_ccci_md_pmic("at the exception", false);
+	ccb_ctrl_show("at the exception", 0, 3);
+	ccb_ctrl_show("at the exception", 18, 2);
+	ccb_data_show("at the exception");
+}
+
+static void
+dispatch(int qn, const uint8_t *pkt, uint32_t len)
+{
+	struct ccci_hdr h;
+
+	if (len < 16)
+		return;
+	memcpy(&h, pkt, 16);
+	switch (h.channel) {
+	case CH_CTRL_RX:
+		if (h.data1 == 0 && h.reserved != MD_INIT_CHK_ID)
+			hs2(&h);
+		else if (h.data1 == 4) {
+			printf("A34 CELL: the modem reports an exception (MD_EX, 0x%08x)\n", h.reserved);
+			state = ST_EXCEPTION;
+		} else
+			printf("A34 CELL: control message 0x%x (0x%08x)\n", h.data1, h.reserved);
+		break;
+	case CH_SYS_RX:
+		sys_rx(&h);
+		break;
+	case CH_AT_RX:
+		at_rx(pkt + 16, len - 16);
+		break;
+	case CH_FS_RX:
+		a34_cellfs_rx(pkt, len);        /* never logged beyond names and sizes */
+		break;
+	case CH_RPC_RX:
+		rpc_rx(pkt, len);
+		break;
+	default:
+		if (!(unknown_ch_seen[h.channel % 16] & (1u << (h.channel / 16 % 32)))) {
+			unknown_ch_seen[h.channel % 16] |= 1u << (h.channel / 16 % 32);
+			printf("A34 CELL: packet on channel %u (queue %d, %u bytes): dropped\n", h.channel, qn, len);
+		}
+		break;
+	}
+}
+
+static void
+ring_rx(int qn)
+{
+	static uint8_t pkt[MAX_PKT + 64];
+	struct ring *r = &q[qn];
+	uint32_t L = r->rxlen;
+	vm_offset_t area = r->blk + 0x20;
+
+	for (int budget = 0; budget < 16; budget++) {
+		uint32_t rp = rd32(r->blk, 0x08), wp = rd32(r->blk, 0x0C);
+		if (rp >= L || wp >= L || (rp & 3))
+			return;
+		uint32_t avail = (wp + L - rp) % L;
+		if (avail < 32)
+			return;
+		uint32_t hw[2];
+		dm_get(hw, area, rp, 8);        /* rp is 8-aligned, never at L-4 */
+		if (hw[0] != 0xAABBAABBu) {
+			printf("A34 CELL: queue %d: bad frame header 0x%08x at %u: queue stopped\n", qn, hw[0], rp);
+			r->rxlen = 0;
+			return;
+		}
+		uint32_t len = hw[1], pkg = (len + 16 + 7) & ~7u;
+		if (len < 16 || len > MAX_PKT) {
+			printf("A34 CELL: queue %d: frame of %u bytes: queue stopped\n", qn, len);
+			r->rxlen = 0;
+			return;
+		}
+		if (pkg > avail)
+			return;
+		uint32_t first = pkg <= L - rp ? pkg : L - rp;
+		dm_get(pkt, area, rp, first);
+		if (first < pkg)
+			dm_get(pkt + first, area, 0, pkg - first);
+		if (le32(pkt + pkg - 8) != 0xCCDDEEFFu || le32(pkt + pkg - 4) != 0xCCDDEEFFu) {
+			printf("A34 CELL: queue %d: bad frame footer: queue stopped\n", qn);
+			r->rxlen = 0;
+			return;
+		}
+		wr32(r->blk, 0x08, (rp + pkg) % L);     /* consumed before dispatch: a copy is in pkt */
+		r->rx_packets++;
+		dispatch(qn, pkt + 8, len);
+	}
+}
