+static void
+sram_message(void)
+{
+	uint32_t h[4];
+
+	for (int k = 0; k < 4; k++)
+		h[k] = rd32(ap, CCIF_SRAM + 4u * (uint32_t)k);
+	struct ccci_hdr hd;
+	memcpy(&hd, h, 16);
+	if (hd.channel == CH_CTRL_RX && hd.data1 == 0 && hd.reserved != MD_INIT_CHK_ID)
+		hs2(&hd);
+	else
+		printf("A34 CELL: SRAM message %08x %08x %08x %08x\n", h[0], h[1], h[2], h[3]);
+}
+
+/* ---- while waiting for HS2: AMMS, doorbells, where the modem stands ---- */
+
+/* SMC fid with x1, x2; x0..x3 back. */
+static void
+cc_smc(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t out[4])
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	out[0] = x0;
+	out[1] = x1;
+	out[2] = x2;
+	out[3] = x3;
+}
+
+/*
+ * AMMS (Android's amms driver, DT amms_control, SPI 295): the modem asks the AP, through ATF, to
+ * take back memory it no longer needs (DRDI: the RF sets LK loaded that it did not pick) or to
+ * lend/return its POS area, and waits for the acknowledgement. Android's interrupt handler reads
+ * MTK_SIP_KERNEL_AMMS_GET_PENDING, for DRDI_FREE gets the range (GET_FREE_ADDR/LENGTH), frees it
+ * into the kernel and acks (ACK_PENDING with the bit). Here the same SMCs are polled every
+ * 100 ms (XNU does not take SPI 295); a freed range stays reserved (it is outside XNU's memory);
+ * POS requests are logged, not served (this phone's layout has no POS area).
+ */
+#define SIP_AMMS_GET_FREE_ADDR          0xC2000250ull
+#define SIP_AMMS_GET_FREE_LENGTH        0xC2000251ull
+#define SIP_AMMS_GET_PENDING            0xC2000252ull
+#define SIP_AMMS_ACK_PENDING            0xC2000253ull
+#define SIP_AMMS_GET_SEQ_ID             0xC2000258ull
+#define AMMS_DRDI_FREE                  (1ull << 0)
+#define AMMS_POS_DEALLOC                (1ull << 1)
+#define AMMS_POS_ALLOC                  (1ull << 2)
+
+/*
+ * After the modem gives the DRDI range back (AMMS), it is the AP's again (Android frees it into
+ * its kernel), so it can be read: is it what LK should have loaded, md1drdi from the md1img
+ * partition? md1drdi is 0x8880 bytes larger than LK's drdi_memory, so the region is compared
+ * with the section from offset 0 and from offset (section - region). Firmware only (no identity
+ * in it); FNV-1a 64 hashes and match results are logged. Its own thread: the file server keeps
+ * running.
+ */
+extern bool a34_cell_md1img_drdi(uint64_t *off, uint32_t *size);
+extern int sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len, uint64_t *part_bytes);
+static uint64_t drdi_pa;
+static uint32_t drdi_len;
+
+static uint64_t
+fnv64(uint64_t h, const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		h ^= p[i];
+		h *= 0x100000001b3ull;
+	}
+	return h;
+}
+
+static void
+drdi_compare(uint8_t *ram, uint8_t *img, uint32_t CH, uint64_t secoff, uint32_t secsize)
+{
+	uint64_t h_ram = 0xcbf29ce484222325ull, h0 = h_ram, h1 = h_ram;
+	uint32_t shift = secsize > drdi_len ? secsize - drdi_len : 0;
+	uint32_t zeros = 0, ffs = 0, first_diff0 = ~0u, first_diff1 = ~0u;
+
+	for (uint32_t o = 0; o < drdi_len; o += CH) {
+		uint32_t n = drdi_len - o < CH ? drdi_len - o : CH;
+		vm_size_t ml = ((vm_size_t)n + PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+		vm_offset_t m = ml_io_map_unmappable((vm_offset_t)(drdi_pa + o), ml, CC_WIMG_IO);
+		if (!m) {
+			printf("A34 CELL: DRDI check: no mapping at +0x%x\n", o);
+			return;
+		}
+		dm_get(ram, m, 0, n & ~3u);
+		ml_io_unmap(m, ml);
+		h_ram = fnv64(h_ram, ram, n);
+		for (uint32_t i = 0; i < n; i++) {
+			zeros += ram[i] == 0;
+			ffs += ram[i] == 0xff;
+		}
+		for (int k = 0; k < 2; k++) {
+			uint64_t so = (k ? shift : 0) + (uint64_t)o;
+			uint32_t sn = so >= secsize ? 0 : (secsize - so < n ? (uint32_t)(secsize - so) : n);
+			memset(img, 0, n);
+			if (sn && sweet_ufs_read_part("md1img", secoff + so, img, sn, NULL) != 0) {
+				printf("A34 CELL: DRDI check: md1img read failed at +0x%llx\n", so);
+				return;
+			}
+			if (k == 0)
+				h0 = fnv64(h0, img, n);
+			else
+				h1 = fnv64(h1, img, n);
+			uint32_t *fd = k ? &first_diff1 : &first_diff0;
+			if (*fd == ~0u && memcmp(ram, img, n) != 0)
+				for (uint32_t i = 0; i < n; i++)
+					if (ram[i] != img[i]) {
+						*fd = o + i;
+						break;
+					}
+		}
+	}
+	printf("A34 CELL: DRDI check: RAM 0x%llx + 0x%x hash %016llx (%u zero, %u 0xff bytes); md1drdi (%u bytes) "
+	    "from +0 hash %016llx, from +0x%x hash %016llx\n", drdi_pa, drdi_len, h_ram, zeros, ffs, secsize, h0,
+	    shift, h1);
+	printf("A34 CELL: DRDI check: RAM %s md1drdi from +0 (first difference at 0x%x), %s it from +0x%x (first "
+	    "difference at 0x%x)\n", first_diff0 == ~0u ? "MATCHES" : "differs from", first_diff0,
+	    first_diff1 == ~0u ? "MATCHES" : "differs from", shift, first_diff1);
+}
+
+static void
+drdi_check_thread(void *arg, wait_result_t wr)
+{
+	const uint32_t CH = 64u << 10;
+	uint8_t *ram = kalloc_data(CH, Z_WAITOK), *img = kalloc_data(CH, Z_WAITOK);
+	uint64_t secoff = 0;
+	uint32_t secsize = 0;
+
+	(void)arg;
+	(void)wr;
+	if (ram && img && a34_cell_md1img_drdi(&secoff, &secsize) && drdi_len)
+		drdi_compare(ram, img, CH, secoff, secsize);
+	else
+		printf("A34 CELL: DRDI check: nothing to compare with\n");
+	if (ram)
+		kfree_data(ram, CH);
+	if (img)
+		kfree_data(img, CH);
+	(void)thread_terminate(current_thread());
+}
+
+static void
+amms_poll(bool verbose)
+{
+	static uint64_t last = ~0ull;
+	uint64_t r[4], pending;
+
+	cc_smc(SIP_AMMS_GET_PENDING, 0, 0, r);
+	pending = r[0];
+	if (pending == last && !verbose)
+		return;
+	last = pending;
+	if ((int64_t)pending < 0) {
+		printf("A34 CELL: AMMS: GET_PENDING answers %lld\n", (long long)(int64_t)pending);
+		return;
+	}
+	printf("A34 CELL: AMMS: pending 0x%llx\n", pending);
+	if (pending & AMMS_DRDI_FREE) {
+		uint64_t a[4], l[4], k[4];
+		cc_smc(SIP_AMMS_GET_FREE_ADDR, 0, 0, a);
+		cc_smc(SIP_AMMS_GET_FREE_LENGTH, 0, 0, l);
+		cc_smc(SIP_AMMS_ACK_PENDING, AMMS_DRDI_FREE, 0, k);
+		printf("A34 CELL: AMMS: the modem gives back 0x%llx + 0x%llx (DRDI); kept reserved here; "
+		    "acknowledged (0x%llx)\n", a[0], l[0], k[0]);
+		last = ~0ull;
+		if (!drdi_len && a[0] && l[0] && l[0] <= (64u << 20) && (a[0] & PAGE_MASK) == 0) {
+			thread_t t;
+			drdi_pa = a[0];
+			drdi_len = (uint32_t)l[0];
+			if (kernel_thread_start(drdi_check_thread, NULL, &t) == KERN_SUCCESS)
+				thread_deallocate(t);
+		}
+	}
+	if (pending & (AMMS_POS_DEALLOC | AMMS_POS_ALLOC))
+		printf("A34 CELL: AMMS: POS request 0x%llx not served (no POS area in this layout)\n",
+		    pending & (AMMS_POS_DEALLOC | AMMS_POS_ALLOC));
+}
+
+/* Where the modem stands when HS2 does not come: CCIF both sides, boot status, its exception
+ * record (whatever is there), AMMS. Registers and the modem's own record only. */
+static void
+md_stall_report(void)
+{
+	uint64_t r[4];
+
+	printf("A34 CELL: stall: AP CCIF RCHNUM 0x%08x BUSY 0x%08x TCHNUM 0x%08x; MD CCIF RCHNUM 0x%08x "
+	    "BUSY 0x%08x TCHNUM 0x%08x\n", rd32(ap, CCIF_RCHNUM), rd32(ap, CCIF_BUSY), rd32(ap, CCIF_TCHNUM),
+	    rd32(md_ccif, CCIF_RCHNUM), rd32(md_ccif, CCIF_BUSY), rd32(md_ccif, CCIF_TCHNUM));
+	cc_smc(SMC_CCCI, 6, 4, r);              /* MD_POWER_CONFIG / MD_BOOT_STATUS */
+	printf("A34 CELL: stall: MD boot status ret 0x%llx status0 0x%llx status1 0x%llx\n", r[0], r[1], r[2]);
+	printf("A34 CELL: stall: the modem's exception record as it is now (none was signalled):\n");
+	md_exception_report();
+	amms_poll(true);
+}
+
+static void
+poll_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	uint64_t start = mach_absolute_time(), last_report = start, hz;
+	uint32_t exc_seen = 0, bells_seen = 0, bells = 0;
+	uint64_t exc_at = 0, last_amms = start;
+	bool timeout_said = false, exc_said = false, late_said = false;
+	uint64_t r0[4];
+
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &hz);
+	cc_smc(SIP_AMMS_GET_SEQ_ID, 0, 0, r0);
+	printf("A34 CELL: AMMS: sequence id 0x%llx at HS1\n", r0[0]);
+	for (;;) {
+		uint32_t ch = rd32(ap, CCIF_RCHNUM);
+		if (ch) {
+			wr32(ap, CCIF_ACK, ch & 0xFFFFu);
+			bells++;
+			if ((ch & 0xFFFFu) & ~bells_seen) {
+				printf("A34 CELL: CCIF doorbell(s) 0x%04x from the modem (first time)\n",
+				    (ch & 0xFFFFu) & ~bells_seen);
+				bells_seen |= ch & 0xFFFFu;
+			}
+			if (ch & (1u << H2D_SRAM))
+				sram_message();
+			if ((ch >> 16) & ~exc_seen) {
+				printf("A34 CELL: CCIF exception/peer bits 0x%x from the modem\n", ch >> 16);
+				exc_seen |= ch >> 16;
+				if ((exc_seen & 1) && !exc_at)
+					exc_at = mach_absolute_time();
+			}
+		}
+		for (int i = 0; i < 16; i++)
+			if (q[i].rxlen)
+				ring_rx(i);
+		uint64_t now = mach_absolute_time();
+		if (exc_at && !exc_said && ((exc_seen & 2) || now - exc_at > 2 * hz)) {
+			exc_said = true;
+			md_exception_report();
+		}
+		if (now - last_amms > hz / 10) {
+			amms_poll(false);
+			last_amms = now;
+		}
+		if (state == ST_WAIT_HS2 && !timeout_said && now - start > 30 * hz) {
+			printf("A34 CELL: no HS2 within 30 s\n");
+			a34_cellfs_report();
+			md_stall_report();
+			timeout_said = true;
+		}
+		if (state == ST_WAIT_HS2 && !late_said && now - start > 120 * hz) {
+			printf("A34 CELL: no HS2 within 120 s\n");
+			md_stall_report();
+			late_said = true;
+		}
+		if (now - last_report > 10 * hz && state != ST_READY) {
+			uint32_t rx_other = 0;
+			for (int i = 0; i < 16; i++)
+				if (i != 0 && i != 1 && i != 4 && i != 5)
+					rx_other += q[i].rx_packets;
+			printf("A34 CELL: state %d; packets rx q0 %u q1 %u q4 %u q5 %u (others %u), tx q0 %u q1 %u q4 %u "
+			    "q5 %u; doorbells %u (bits 0x%04x)\n", state, q[0].rx_packets, q[1].rx_packets, q[4].rx_packets,
+			    q[5].rx_packets, rx_other, q[0].tx_packets, q[1].tx_packets, q[4].tx_packets, q[5].tx_packets,
+			    bells, bells_seen);
+			last_report = now;
+		}
+		sleep_ms(state == ST_READY ? 2 : 1);
+	}
+}
+
+/* ---- before the modem is let go ---- */
+
+/*
+ * ap_md_mem.c ccci_md_clear_smem(first_boot) at BOOT_WAITING_FOR_HS1: every region of
+ * md1_noncacheable_tbl / md1_cacheable_tbl without SMF_NCLR_FIRST is zeroed with its final
+ * size (after the CCB layout above). Kept: SECURITY_SMEM 34, CCISM_MCU 19 / _EXP 20 (our rings),
+ * MD_DRDI 41, PHY_CAP 23, AMMS_POS 29, MD_CONSYS 22, USIP 24. RAM only.
+ */
+static const uint8_t clear_first[] = {
+	10, 27, 31, 12, 13, 37, 18, 14, 15, 33, 0, 16, 4, 7, 8, 9, 43, 44, 40, 11, 30, /* non-cached */
+	32, 1, 2, 3, 5, 6, 46, 28,                                              /* cached */
+};
+
+static void
+smem_clear_first_boot(void)
+{
+	uint32_t n = 0, kib = 0;
+
+	for (size_t i = 0; i < sizeof(clear_first); i++) {
+		int id = clear_first[i];
+		bool dup = false;
+		if (!rg[id].size || !rg[id].ap)
+			continue;
+		for (size_t j = 0; j < i; j++)
+			if (rg[clear_first[j]].ap == rg[id].ap && rg[clear_first[j]].size == rg[id].size)
+				dup = true;
+		if (dup)
+			continue;
+		if (!pa_zero(rg[id].ap, rg[id].size)) {
+			printf("A34 CELL: smem %d: no mapping to clear it; clearing stopped\n", id);
+			break;
+		}
+		n++;
+		kib += rg[id].size >> 10;
+	}
+	printf("A34 CELL: shared memory cleared as Android's first boot: %u regions, %u KiB "
+	    "(rings, DRDI, PHY_CAP, AMMS, CONSYS, USIP kept)\n", n, kib);
+}
+
+/* ---- the modem's PMIC rails (md_sys1_platform.c md1_pmic_setting_on) ---- */
+
+extern int ruby_pwrap_read(uintptr_t pwrap, uint16_t reg, uint16_t *val);
+extern void a34_pmic_lock(void);
+extern void a34_pmic_unlock(void);
+#define PW_PA           0x10026000u
+#define PW_ACC          0x880u
+#define PW_WDATA        0x884u
+#define PW_STA          0x8a8u
+#define PW_INIT_DONE    (1u << 15)
+/* MT6359P (include/linux/mfd/mt6359p/registers.h): buck VPU = the device tree's md-vdigrf */
+#define PM_VPU_CON0     0x1488u         /* RG_BUCK_VPU_EN bit 0 */
+#define PM_VPU_DBG0     0x14a6u         /* DA_VPU_VOSEL bits 0-6 */
+#define PM_VPU_DBG1     0x14a8u         /* DA_VPU_EN */
+#define PM_VPU_ELR0     0x14acu         /* RG_BUCK_VPU_VOSEL bits 0-6: 400 mV + 6.25 mV steps */
+#define PM_VPU_700MV    48u             /* (700000 - 400000) / 6250 */
+static vm_offset_t pw;
+
+static bool
+pm_idle(void)
+{
+	for (uint32_t i = 0; i < 100000u; i++)
+		if (((rd32(pw, PW_STA) >> 1) & 7u) == 0)
+			return true;
+	return false;
+}
+
+static bool
+pm_read(uint16_t reg, uint16_t *v)
+{
+	a34_pmic_lock();
+	int err = ruby_pwrap_read(pw, reg, v);
+	a34_pmic_unlock();
+	return err == 0;
+}
+
+static bool
+pm_write(uint16_t reg, uint16_t v)
+{
+	bool ok = false;
+	a34_pmic_lock();
+	if ((rd32(pw, PW_STA) & PW_INIT_DONE) && pm_idle()) {
+		wr32(pw, PW_WDATA, v);
+		wr32(pw, PW_ACC, (1u << 29) | reg);
+		ok = pm_idle();
+	}
+	a34_pmic_unlock();
+	return ok;
+}
+
+/*
+ * Android's md_cd_power_on, step 1 (power-flow-config 0x2: no DPSW): md1_pmic_setting_on sets
+ * md-vmodem 825 mV, md-vsram 825 mV (MT6315 #3 bucks 1 and 4) and md-vdigrf 700 mV (MT6359P
+ * buck VPU: the RF transceiver's digital supply). With set, VPU is set to 700 mV here as there
+ * (boot-arg a34cellpmic=0: read only); the MT6315 bucks sit on SPMI, which this kernel does not
+ * drive, and are left as the boot loader set them. The RF LDOs (VFE28, VRF18, VRF12, VRFCK,
+ * VBBCK: no consumer in the device tree, run by the modem) are only read.
+ */
+void
+a34_ccci_md_pmic(const char *when, bool set)
+{
+	static const struct { const char *nm; uint16_t con0, mon; } ldo[] = {
+		{ "VFE28", 0x1b88, 0x1b8c }, { "VRF18", 0x1bac, 0x1bb0 }, { "VRF12", 0x1bbe, 0x1bc2 },
+		{ "VRFCK", 0x1d1c, 0x1d20 }, { "VBBCK", 0x1d2e, 0x1d32 },
+	};
+	uint32_t pmic = 1;
+	uint16_t con0 = 0, dbg0 = 0, dbg1 = 0, elr0 = 0;
+
+	if (!pw)
+		pw = ml_io_map(PW_PA, PAGE_SIZE);
+	if (!pw || !(rd32(pw, PW_STA) & PW_INIT_DONE)) {
+		printf("A34 CELL: PMIC %s: the wrapper is not ready; modem rails not read\n", when);
+		return;
+	}
+	(void)PE_parse_boot_argn("a34cellpmic", &pmic, (int)sizeof(pmic));
+	if (!pm_read(PM_VPU_CON0, &con0) || !pm_read(PM_VPU_DBG0, &dbg0) || !pm_read(PM_VPU_DBG1, &dbg1) ||
+	    !pm_read(PM_VPU_ELR0, &elr0)) {
+		printf("A34 CELL: PMIC %s: VPU (md-vdigrf) not readable\n", when);
+		return;
+	}
+	printf("A34 CELL: PMIC %s: md-vdigrf (MT6359P VPU) en %u/%u, %u uV now, %u uV set "
+	    "(CON0 0x%04x DBG1 0x%04x)\n", when, con0 & 1u, dbg1 & 1u, 400000u + 6250u * (dbg0 & 0x7fu),
+	    400000u + 6250u * (elr0 & 0x7fu), con0, dbg1);
+	for (size_t i = 0; i < sizeof(ldo) / sizeof(ldo[0]); i++) {
+		uint16_t c = 0, m = 0;
+		if (pm_read(ldo[i].con0, &c) && pm_read(ldo[i].mon, &m))
+			printf("A34 CELL: PMIC %s: %s CON0 0x%04x MON 0x%04x (on: %u)\n", when, ldo[i].nm, c, m,
+			    m & 1u);
+	}
+	/* Pin modes of the modem's RF control pins (MT6877: GPIO 66-69 MIPI_M/MIPI2, 70 MD_UCNT,
+	 * 71-81 BPI_BUS0-10, 82-85 MIPI1/MIPI0, 87-97 BPI_BUS11-21: their function is mode 1), one
+	 * hex digit per pin, as the boot loaders left them (nothing on the AP side changes them). */
+	if (!gpio_base)
+		gpio_base = ml_io_map(0x10005000, PAGE_SIZE);
+	if (gpio_base) {
+		char modes[40];
+		for (uint32_t pin = 66; pin <= 97; pin++) {
+			uint32_t m = (rd32(gpio_base, 0x300 + (pin / 8) * 0x10) >> ((pin % 8) * 4)) & 7u;
+			modes[pin - 66] = (char)('0' + m);
+		}
+		modes[32] = 0;
+		printf("A34 CELL: %s: RF pin modes GPIO66..97 %s\n", when, modes);
+	}
+	/* The RF power-enable pin the device tree gives the modem (gpio_usage_mapping): its state only. */
+	uint32_t rfpin;
+	if (dt_cell(NULL, "mediatek,gpio_usage_mapping", "GPIO_RF_PWREN_RST_PIN", 1, &rfpin) && rfpin < 256) {
+		if (!gpio_base)
+			gpio_base = ml_io_map(0x10005000, PAGE_SIZE);
+		if (gpio_base)
+			printf("A34 CELL: %s: GPIO_RF_PWREN_RST_PIN = GPIO %u: mode %u, dir %u, out %u, in %u\n", when,
+			    rfpin, (rd32(gpio_base, 0x300 + (rfpin / 8) * 0x10) >> ((rfpin % 8) * 4)) & 7u,
+			    (rd32(gpio_base, 0x000 + (rfpin / 32) * 0x10) >> (rfpin % 32)) & 1u,
+			    (rd32(gpio_base, 0x100 + (rfpin / 32) * 0x10) >> (rfpin % 32)) & 1u,
+			    (rd32(gpio_base, 0x200 + (rfpin / 32) * 0x10) >> (rfpin % 32)) & 1u);
+	}
+	if (!set)
+		return;
+	if (!pmic) {
+		printf("A34 CELL: PMIC: a34cellpmic=0: md-vdigrf left as it is\n");
+	} else if ((elr0 & 0x7fu) != PM_VPU_700MV) {
+		bool ok = pm_write(PM_VPU_ELR0, (uint16_t)((elr0 & ~0x7fu) | PM_VPU_700MV));
+		delay(200);
+		uint16_t now = 0;
+		(void)pm_read(PM_VPU_DBG0, &now);
+		printf("A34 CELL: PMIC: md-vdigrf set to 700 mV as Android%s: %u uV now\n", ok ? "" : " (write FAILED)",
+		    400000u + 6250u * (now & 0x7fu));
+	} else {
+		printf("A34 CELL: PMIC: md-vdigrf already 700 mV\n");
+	}
+	printf("A34 CELL: PMIC: md-vmodem/md-vsram (MT6315 on SPMI, 825 mV on Android) left as the boot loader set them\n");
+}
+
+bool
+a34_ccci_prepare(vm_offset_t ap_ccif, vm_offset_t md)
+{
+	ap = ap_ccif;
+	md_ccif = md;
+	if (!smem_layout()) {
+		printf("A34 CELL: shared memory layout incomplete (CCISM_MCU/EXP or runtime data missing): stage 3 off\n");
+		return false;
+	}
+	vm_offset_t mcu = rva(R_CCISM_MCU), exp = rva(R_CCISM_MCU_EXP);
+	if (!mcu || !exp || !rva(R_RUNTIME)) {
+		printf("A34 CELL: shared memory not mapped\n");
+		return false;
+	}
+	ccb_ctrl_show("before the clear", 0, 1);
+	ccb_data_show("before the clear");
+	smem_clear_first_boot();
+	if (ccb_ctrl_init())
+		ccb_ctrl_show("as written", 0, 1);
+	ccism_size = rings_build(mcu, rg[R_CCISM_MCU].size, rx_kib, tx_kib, q);
+	uint32_t exp_total = rings_build(exp, rg[R_CCISM_MCU_EXP].size, exp_kib, exp_kib, NULL);
+	if (ccism_size != 0xB4280u || exp_total != 0x1E280u) {
+		printf("A34 CELL: rings did not fit (0x%x, 0x%x)\n", ccism_size, exp_total);
+		return false;
+	}
+	memset(seq_out, 0, sizeof(seq_out));
+	/* SRAM tail: magic, MDSS_DBG (modem view) and its size (ccci_reset_ccif_hw) */
+	wr32(ap, CCIF_SRAM + 0x1F4, 0x7274626Eu);
+	wr32(ap, CCIF_SRAM + 0x1F8, rg[R_MDSS_DBG].md);
+	wr32(ap, CCIF_SRAM + 0x1FC, rg[R_MDSS_DBG].size);
+	prepared = true;
+	printf("A34 CELL: rings built in CCISM_MCU (MD 0x%08x, 0x%x bytes) and CCISM_MCU_EXP\n",
+	    rg[R_CCISM_MCU].md, ccism_size);
+	return true;
+}
+
+/* ---- the answer to HS1 ---- */
+
+struct rt_writer {
+	vm_offset_t base;
+	uint32_t off;
+	bool full;
+};
+
+static void
+rt_emit(struct rt_writer *w, uint8_t id, uint8_t info, const void *data, uint32_t len)
+{
+	uint8_t h[8] = { id, info, 0, 0, 0, 0, 0, 0 };
+	uint8_t pad[64];
+
+	memcpy(h + 4, &len, 4);
+	if (w->off + 8 + len > RT_HALF || len > sizeof(pad)) {
+		w->full = true;
+		return;
+	}
+	/* entries are packed without padding: assemble through 32-bit read-modify-writes */
+	uint8_t buf[72];
+	memcpy(buf, h, 8);
+	if (len)
+		memcpy(buf + 8, data, len);
+	for (uint32_t i = 0; i < 8 + len; i++) {
+		uint32_t o = w->off + i, word;
+		dm_get(&word, w->base, o & ~3u, 4);
+		uint8_t *b = (uint8_t *)&word;
+		b[o & 3] = buf[i];
+		dm_put(w->base, o & ~3u, &word, 4);
+	}
+	(void)pad;
+	w->off += 8 + len;
+}
+
+/* {MD view, size} of a region; as Android, the address of a table region is sent even when
+ * its size is 0 (MD_DRDI, ...); a region in no table gives {0, 0}. */
+static void
+share(uint32_t out[2], int id)
+{
+	out[0] = rg[id].md;
+	out[1] = rg[id].size;
+}
+
+/* The AP's policy per feature (config_ap_side_feature under the MT6877 build): 2 MUST, 3 OPT,
+ * 1 not supported, 0 not exist. */
+static uint8_t
+ap_mask(int id)
+{
+	switch (id) {
+	case 0: case 1: case 2: case 5: case 6: case 7: case 8: case 9: case 10: case 11: case 12:
+	case 14: case 15: case 16: case 17: case 18: case 19: case 20: case 25: case 26: case 27:
+	case 28: case 30: case 36: case 45: case 48:
+	case 46: case 47:                               /* Samsung's BIG_DATA regions (TC10) */
+		return 2;
+	case 13: case 31: case 32: case 35: case 38: case 54: case 55: case 56: case 57:
+		return 3;
+	case 29:
+		return (sib_size > 0) ? 2 : 1;
+	case 33:
+		return rg[29].size > 0 ? 2 : 1;
+	case 34:
+		return rg[27].size > 0 && rg[28].size > 0 ? 2 : 1;
+	case 3: case 4: case 21: case 24: case 37:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static uint32_t sbp_code, rat_bitmap = 0x79;    /* N/Lf/Lt/W/G; boot-args a34cellsbp, a34cellrat */
+/*
+ * AP_DEBUG_LEVEL (MTK_TC10_FEATURE_SET_DEBUG_LEVEL): ccci_mdinit hands the kernel
+ * ro.boot.debug_level (0x4f4c LOW on a retail phone), which ccci_get_ap_debug_level turns into
+ * 0; -1 only when no level was set. Boot-arg a34celldbg (0, 1, 2).
+ */
+static uint32_t dbg_level;
+static bool mpu_v21;
+
+static void
+rt_feature(struct rt_writer *w, int id, uint8_t info, uint8_t ver)
+{
+	uint32_t d[12];
+	uint32_t n = 0;
+
+	memset(d, 0, sizeof(d));
+	switch (id) {
+	case 0:                                         /* BOOT_INFO: channel, start id, attributes (phone), ready id */
+		d[2] = 0x2;
+		n = 16;
+		break;
+	case 1:                                         /* EXCEPTION_SHARE_MEMORY */
+		if (!rg[R_MDCCCI_DBG].size)
+			return;
+		d[0] = rg[R_MDCCCI_DBG].md;
+		d[1] = 0x10000;
+		n = 8;
+		break;
+	case 2:                                         /* CCIF_SHARE_MEMORY: the rings */
+		d[0] = rg[R_CCISM_MCU].md;
+		d[1] = ccism_size;
+		n = 8;
+		break;
+	case 5: case 6: case 8: case 19:
+		n = 16;
+		break;
+	case 7:                                         /* MISC_INFO_RANDOM_SEED_NUM */
+		read_random(&d[0], sizeof(d[0]));
+		n = 16;
+		break;
+	case 9:                                         /* SBP_ID: code, RAT bitmap */
+		d[0] = sbp_code;
+		d[1] = rat_bitmap;
+		n = 16;
+		break;
+	case 10:                                        /* MISC_INFO_CCCI: seq checks, AP polls status */
+		d[0] = 0x3;
+		n = 16;
+		break;
+	case 11: {                                      /* CLIB_TIME */
+		clock_sec_t s;
+		clock_usec_t us;
+		uint64_t cnt;
+		clock_get_calendar_microtime(&s, &us);
+		__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(cnt));
+		d[0] = (uint32_t)s;
+		d[1] = (uint32_t)((uint64_t)s >> 32);
+		d[4] = (uint32_t)us;
+		d[6] = (uint32_t)cnt;
+		d[7] = (uint32_t)(cnt >> 32);
+		n = ver == 1 ? 32 : 16;
+		break;
+	}
+	case 12:                                        /* MISC_INFO_C2K: 'C' not in the RAT bitmap */
+		d[0] = (rat_bitmap & 0x4) ? 0x4 : 0;
+		n = 16;
+		break;
+	case 13:                                        /* MD_IMAGE_START_MEMORY */
+		d[0] = (uint32_t)bank0_pa;
+		d[1] = md1img_size;
+		n = 8;
+		break;
+	case 14: share(d, R_CCISM_SCP); n = 8; break;
+	case 15:                                        /* CCB_SHARE_MEMORY */
+		d[0] = rg[4].size ? rg[4].md : 0;
+		d[1] = rg[4].size;
+		d[2] = rg[1].size ? rg[1].md : 0;
+		d[3] = rg[1].size + rg[2].size + rg[3].size;
+		n = 16;
+		break;
+	case 16: share(d, 5); n = 8; break;
+	case 17: share(d, 7); n = 8; break;
+	case 18: share(d, 8); n = 8; break;
+	case 20: d[0] = 3568; n = 4; break;           /* AP_CCMNI_MTU */
+	case 22: d[0] = 1; n = 4; break;              /* CCCI_FAST_HEADER */
+	case 25: share(d, 11); n = 8; break;
+	case 26: share(d, 9); n = 8; break;
+	case 27: n = 0; break;                          /* MULTI_MD_MPU */
+	case 28:                                        /* CCISM_SHARE_MEMORY_EXP */
+		share(d, R_CCISM_MCU_EXP);
+		n = 8;
+		break;
+	case 29: d[0] = 0; d[1] = sib_size; n = 8; break;
+	case 30: share(d, 22); n = 8; break;
+	case 31: share(d, 24); n = 8; break;
+	case 32: d[0] = mtee; n = 4; break;
+	case 33: share(d, 29); n = 8; break;
+	case 34: share(d, 27); share(d + 2, 28); n = 16; break;
+	case 35: share(d, 31); n = 8; break;
+	case 36: share(d, 32); n = 8; break;
+	case 38:                                        /* MD_MEM_AP_VIEW_INF */
+		d[0] = 0;
+		d[1] = bank0_size;
+		d[2] = (uint32_t)bank0_pa;
+		d[3] = (uint32_t)(bank0_pa >> 32);
+		d[4] = MD_VIEW_BASE;
+		d[5] = smem_size;
+		d[6] = (uint32_t)(smem_base + smem_off);
+		d[7] = (uint32_t)((smem_base + smem_off) >> 32);
+		d[8] = MD_VIEW_BASE + cache_off;
+		d[9] = cache_size;
+		d[10] = (uint32_t)cache_pa;
+		d[11] = (uint32_t)(cache_pa >> 32);
+		n = 48;
+		break;
+	case 45: share(d, 41); n = 8; break;
+	case 46: share(d, 43); n = 8; break;          /* CCCI_MD_BIGDATA_SHARE_MEMORY */
+	case 47: share(d, 44); n = 8; break;          /* CCCI_MD_IPCA_BIGDATA_SHARE_MEMORY */
+	case 48: d[0] = dbg_level; n = 4; break;      /* AP_DEBUG_LEVEL: 0 LOW, 1 MID, 2 HIGH */
+	case 54: d[0] = 0; n = 4; break;              /* SPM_MD_PARA: none in the DTS */
+	case 55: share(d, 46); n = 8; break;
+	case 56: share(d, 33); n = 8; break;
+	case 57: share(d, 0); n = 8; break;
+	default:
+		return;                                 /* no case: nothing emitted */
+	}
+	rt_emit(w, (uint8_t)id, info, d, n);
+}
+
+void
+a34_ccci_hs1(vm_offset_t ap_ccif, vm_offset_t md, const uint32_t f[56])
+{
+	struct rt_writer w;
+	const uint8_t *mf = (const uint8_t *)&f[1];
+	int musts_missing = 0;
+	thread_t t;
+
+	(void)md;
+	if (!prepared) {
+		printf("A34 CELL: HS1 not answered: shared memory was not prepared\n");
+		return;
+	}
+	ap = ap_ccif;
+	(void)PE_parse_boot_argn("a34cellsbp", &sbp_code, (int)sizeof(sbp_code));
+	(void)PE_parse_boot_argn("a34cellrat", &rat_bitmap, (int)sizeof(rat_bitmap));
+	(void)PE_parse_boot_argn("a34celldbg", &dbg_level, (int)sizeof(dbg_level));
+	if (f[0] != MD_PATTERN || f[17] != MD_PATTERN)
+		printf("A34 CELL: HS1 feature query patterns 0x%08x/0x%08x: answering without runtime data\n", f[0], f[17]);
+	w.base = rva(R_RUNTIME);
+	w.off = 0;
+	w.full = false;
+	dm_zero(w.base, 0, 2 * RT_HALF);
+	mpu_v21 = false;
+	for (int i = 0; i < 64 && f[0] == MD_PATTERN && f[17] == MD_PATTERN; i++) {
+		uint8_t m = mf[i] & 0xF, mv = mf[i] >> 4, a = ap_mask(i), av = (i == 11 && mv == 1) ? 1 : 0;
+		uint8_t mask, ver;
+		if (m == 2 && a < 2) {
+			printf("A34 CELL: the modem needs feature %d, which the AP does not offer: runtime data cut there\n", i);
+			musts_missing++;
+			break;
+		}
+		if (m == 0) { mask = 0; ver = mv; }
+		else if (m == 2) { mask = 2; ver = mv; }
+		else if (m == 3) { mask = (mv == av && a >= 2) ? 2 : 1; ver = av; }
+		else if (m == 4) { mask = mv >= av ? 2 : 1; ver = av; }
+		else { mask = 0; ver = 0; }
+		uint8_t info = (uint8_t)(mask | ver << 4);
+		if (i == 27 && mask == 2)
+			mpu_v21 = true;
+		if (mask == 2)
+			rt_feature(&w, i, info, ver);
+		else
+			rt_emit(&w, (uint8_t)i, info, NULL, 0);
+	}
+	printf("A34 CELL: runtime data: %u bytes in RAW_RUNTIME_DATA (MD 0x%08x)%s, SRAM reply v%s\n", w.off,
+	    rg[R_RUNTIME].md, w.full ? " (FULL)" : "", mpu_v21 ? "2.1" : "2");
+
+	/* SRAM: up_header, then ap_query_md_feature (v2_1 or v2) at +0x100 */
+	uint32_t up[4] = { 0, mpu_v21 ? 172u : 236u, 1u, MD_INIT_CHK_ID };
+	for (int k = 0; k < 4; k++)
+		wr32(ap, CCIF_SRAM + SRAM_UP_HEADER + 4u * (uint32_t)k, up[k]);
+	uint32_t rep[55];
+	memset(rep, 0, sizeof(rep));
+	rep[0] = AP_PATTERN;
+	((uint8_t *)&rep[1])[1] = 0x10;                /* feature_set[1]: MPU size includes md1-md3 share */
+	rep[17] = mpu_v21 ? 2 : 1;                      /* share_memory_support @0x44 */
+	rep[18] = rg[R_RUNTIME].md;                     /* @0x48 */
+	rep[19] = RT_HALF;
+	rep[20] = rg[R_RUNTIME].md + RT_HALF;
+	rep[21] = RT_HALF;
+	rep[22] = nc_start;                             /* @0x58 */
+	rep[23] = nc_total;
+	if (mpu_v21) {
+		rep[24] = c_start;                      /* @0x60 */
+		rep[25] = c_total;
+		rep[38] = AP_PATTERN;                   /* tail @0x98 */
+		dm_zero(ap, CCIF_SRAM + SRAM_AP_RT, 156);
+		dm_put(ap, CCIF_SRAM + SRAM_AP_RT, rep, 156);
+	} else {
+		rep[24] = AP_PATTERN;                   /* tail @0x60 */
+		dm_zero(ap, CCIF_SRAM + SRAM_AP_RT, 220);
+		dm_put(ap, CCIF_SRAM + SRAM_AP_RT, rep, 220);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	state = ST_WAIT_HS2;
+	doorbell(H2D_SRAM);
+	printf("A34 CELL: HS1 answered (doorbell 15); serving the file server and RPC until HS2\n");
+	if (kernel_thread_start(poll_thread, NULL, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+	(void)musts_missing;
+}
+#endif
diff --git a/bsd/dev/a34_ccci.h b/bsd/dev/a34_ccci.h
new file mode 100644
index 0000000..0e1aaf3
--- /dev/null
+++ b/bsd/dev/a34_ccci.h
@@ -0,0 +1,45 @@
+/*
+ * A34 (0951): the modem's control path (CCCI over CCIF) and its file server, shared declarations.
+ * bsd/dev/a34_ccci.c (shared memory, rings, handshake, ports), bsd/dev/a34_cellfs.c (the modem's
+ * NVRAM file server, read only), bsd/dev/a34_ext4ro.c (ext4 without a write path).
+ */
+#ifndef A34_CCCI_H
+#define A34_CCCI_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* CCCI channels (Samsung A34 kernel eccci/inc/ccci_core.h) */
+#define CH_CTRL_RX      0
+#define CH_CTRL_TX      1
+#define CH_SYS_RX       2
+#define CH_SYS_TX       3
+#define CH_AT_RX        10      /* ttyC0 */
+#define CH_AT_TX        12
+#define CH_FS_RX        14
+#define CH_FS_TX        15
+#define CH_RPC_RX       32
+#define CH_RPC_TX       33
+
+struct ccci_hdr {
+	uint32_t data0;
+	uint32_t data1;
+	uint16_t channel;
+	uint16_t seq;           /* bits 0-14 sequence, bit 15 assert */
+	uint32_t reserved;
+};
+
+/* Sends one packet: hdr (16 bytes, channel/seq set here) + payload. true if queued. */
+bool a34_ccci_send(uint16_t channel, const struct ccci_hdr *hdr, const void *payload, uint32_t len);
+
+/* The modem's PMIC rails (Android's md1_pmic_setting_on): read, and with set md-vdigrf to 700 mV. */
+void a34_ccci_md_pmic(const char *when, bool set);
+
+/* a34_cellfs.c: one packet from CCCI_FS_RX (header included), and the session's counters. */
+void a34_cellfs_rx(const uint8_t *pkt, uint32_t len);
+void a34_cellfs_report(void);
+
+/* sweet_ufs.c (0950/0951): read only, partitions on a fixed list. */
+int sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len, uint64_t *part_bytes);
+
+#endif
diff --git a/bsd/dev/a34_cell.c b/bsd/dev/a34_cell.c
new file mode 100644
index 0000000..8c9615f
--- /dev/null
+++ b/bsd/dev/a34_cell.c
@@ -0,0 +1,1029 @@
+/*
+ * A34 (0950): cellular, stage 0 -- how the modem's side looks, read only.
+ *
+ * Boot-arg a34cell=1 (default 0: nothing here runs, nothing is mapped); a34cell=2 adds the
+ * first contact with the modem (ac_first_contact(), below), the only part that writes registers
+ * (CCIF clocks and reset, the modem's start) -- never a voltage, never a partition; a34cell=3
+ * (0951, bsd/dev/a34_ccci.c) answers the handshake and serves the modem. One thread, a few
+ * seconds after the disk is up, logs "A34 CELL:" lines and fills the read-only sysctl
+ * kern.a34cell with a one-line summary (userland/a34cell prints it). Plan and evidence:
+ * docs/cellular-plan.md.
+ *
+ * Nothing is written anywhere. What is read:
+ *  1. The boot loader's flattened device tree, which LK leaves in DRAM below the memory XNU
+ *     manages (0x47c80000 on this phone, a34lkfdt=ADDR to change): /chosen's
+ *     "ccci,modem_info_v2" says whether LK loaded and verified the modem image (it does on a
+ *     normal boot and skips it on a recovery boot, LK's own log string "recovery mode, no need
+ *     load modem"), and /reserved-memory lists what LK reserved (all regions are logged with
+ *     a check against XNU's memory, ADT /chosen dram-base/dram-size; the loader already trims
+ *     XNU's memory around any of them).
+ *     The struct is MediaTek's _ccci_lk_info_v2 (Samsung kernel ccci_util_lib_fo.c), copied as
+ *     raw little-endian bytes into the property. When LK loaded the modem, its tag table
+ *     (reserved "ccci_tag_mem") is listed: tag names, sizes, small values in hex.
+ *  2. The SPM's power status of the modem's MTCMOS domain: PWR_STATUS 0x10006EF0 and
+ *     PWR_STATUS_2ND 0x10006EF4, bit 0 = MD1; MD1_PWR_CON 0x10006E00 (clk-mt6877-pg.c).
+ *  3. The infracfg_ao clock gates of the CCIF blocks (status registers, 1 = gated):
+ *     CG1 status 0x10001094 bits 23 (CCIF_AP), 26 (CCIF_MD), 12 (CCIF1_AP), 13 (CCIF1_MD)
+ *     (clk-mt6877.c). The CCIF registers themselves are not touched (a gated block's
+ *     registers can stall the bus).
+ *  4. Only when the MD1 domain is on: the modem's boot status through the secure monitor,
+ *     SMC 0xC2000505 (MTK_SIP_KERNEL_CCCI_CONTROL) with MD_POWER_CONFIG (6) / MD_BOOT_STATUS
+ *     (4), the same query Android's ccci driver makes for its logs, and MD_CHECK_DONE (3), the
+ *     boot ROM check Android polls before its first start (md_sys1_platform.c).
+ *  5. The md1img partition, through sweet_ufs_read_part() (read only, a fixed list of
+ *     partitions): its MediaTek section headers (magic 0x58881688, name, size; a 512-byte
+ *     header per section, 16-byte alignment) and md1rom's CHECK_HEADER (version, platform,
+ *     build strings) at the end of its data. The GPT bounds of the other modem partitions are
+ *     printed (names and sizes only; their contents are never read here).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* LK's tag table and device tree are read through temporary kernel_map mappings (not the
+ * 8 MiB io_submap, where a failed allocation panics), unmapped once copied. */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+/* bsd/dev/sweet_ufs.c (A34 0950) */
+extern int sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len,
+    uint64_t *part_bytes);
+extern int sweet_ufs_part_bounds(const char *name, uint64_t *first_block, uint64_t *nblocks);
+void a34_cell_init(void);
+
+#define AC_LK_FDT_PA            0x47c80000ull   /* LK's DTB (README: "DTB 0x47c80000") */
+#define AC_FDT_MAX              (2u << 20)
+#define AC_SPM_PA               0x10006000ull
+#define AC_SPM_MD1_PWR_CON      0xE00u
+#define AC_SPM_MD_BUCK_ISO      0xEE8u
+#define AC_SPM_PWR_STATUS       0xEF0u
+#define AC_SPM_PWR_STATUS_2ND   0xEF4u
+#define AC_INFRA_PA             0x10001000ull
+#define AC_INFRA_CG1_STA        0x094u
+#define AC_SMC_CCCI_CONTROL     0xC2000505ull
+#define AC_MD_POWER_CONFIG      6u
+#define AC_MD_BOOT_STATUS       4u
+
+static uint32_t ac_mode;
+static char ac_state[256] = "a34cell=0";
+SYSCTL_STRING(_kern, OID_AUTO, a34cell, CTLFLAG_RD | CTLFLAG_LOCKED, ac_state, sizeof(ac_state),
+    "A34 cellular stage 0 summary");
+
+/* Appends " <text>" to the sysctl's summary. */
+#define AC_NOTE(...) do {                                                       \
+	size_t n_ = strlen(ac_state);                                            \
+	if (n_ + 2 < sizeof(ac_state)) {                                         \
+		ac_state[n_] = ' ';                                              \
+		snprintf(ac_state + n_ + 1, sizeof(ac_state) - n_ - 1, __VA_ARGS__); \
+	}                                                                        \
+} while (0)
+
+/* Does s contain w? (no strstr here) */
+static bool
+ac_has(const char *s, const char *w)
+{
+	size_t n = strlen(w);
+
+	for (; *s; s++)
+		if (strncmp(s, w, n) == 0)
+			return true;
+	return false;
+}
+
+static uint32_t
+ac_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dsb ld" ::: "memory");
+	return v;
+}
+
+static uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t
+le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+}
+
+/* Keeps printable ASCII of a fixed-size field, for the log. */
+static void
+ac_printable(char *out, size_t outsz, const uint8_t *in, size_t inlen)
+{
+	size_t o = 0;
+
+	for (size_t i = 0; i < inlen && in[i] && o + 1 < outsz; i++)
+		out[o++] = (in[i] >= 0x20 && in[i] < 0x7f) ? (char)in[i] : '.';
+	out[o] = 0;
+}
+
+/* ---- 1. LK's device tree ---- */
+
+#define FDT_BEGIN_NODE  1
+#define FDT_END_NODE    2
+#define FDT_PROP        3
+#define FDT_NOP         4
+#define FDT_END         9
+
+static int ac_lk_md = -1;       /* -1 unknown, 0 not loaded, 1 loaded */
+static uint8_t *ac_fdt;         /* LK's device tree, a copy kept for the modem's RPC queries */
+static uint32_t ac_fdt_struct, ac_fdt_strings, ac_fdt_struct_size, ac_fdt_strings_size;
+static uint64_t ac_xnu_base, ac_xnu_size;       /* XNU's memory: ADT /chosen dram-base, dram-size */
+static uint8_t *ac_tags;        /* LK's tag table, kept for a34_ccci.c (0951) */
+static uint32_t ac_tags_size;
+static uint32_t ac_resv, ac_resv_hits;
+static uint64_t ac_tag_base;
+static uint32_t ac_tag_size, ac_tag_count, ac_tag_version;
+
+static void
+ac_modem_info(const char *node, const uint8_t *v, uint32_t len)
+{
+	if (len < 32) {
+		printf("A34 CELL: LK %s ccci,modem_info_v2: %u bytes (expected 32+)\n", node, len);
+		return;
+	}
+	/* struct _ccci_lk_info_v2 { u64 base; u32 size; s32 err_no; s32 version; s32 tag_num;
+	 * u32 ld_flag; s32 ld_md_errno; } -- raw little-endian bytes */
+	uint64_t base = le64(v);
+	uint32_t size = le32(v + 8), version = le32(v + 16), tags = le32(v + 20), flag = le32(v + 24);
+	int32_t err = (int32_t)le32(v + 12), mderr = (int32_t)le32(v + 28);
+	bool loaded = base != 0 && err == 0 && (flag & 1);
+
+	if (base == 0 && err == 0 && flag == 0)
+		printf("A34 CELL: LK %s ccci,modem_info_v2 all zero: the boot loader did not load the "
+		    "modem (it skips it on a recovery boot)\n", node);
+	else
+		printf("A34 CELL: LK %s ccci,modem_info_v2: tag table 0x%llx (+0x%x) v%u, %u tags, "
+		    "load flags 0x%x, err %d, md errno %d -> modem %s\n", node, base, size, version,
+		    tags, flag, err, mderr, loaded ? "LOADED by LK" : "not loaded");
+	if (ac_lk_md != 1)
+		ac_lk_md = loaded ? 1 : 0;
+	if (loaded && ac_tag_base == 0) {
+		ac_tag_base = base;
+		ac_tag_size = size;
+		ac_tag_count = tags;
+		ac_tag_version = version;
+	}
+}
+
+/*
+ * LK's tag table (reserved "ccci_tag_mem", which Android's ccci_util maps and reads the same
+ * way): tags {char name[64]; u32 data_offset, data_size, next_tag_offset} for version >= 2
+ * (16-byte names before), offsets from the table's start. They carry the modem's memory and
+ * shared-memory layout (smem_layout, nc/c_smem_layout*, md_mpu_inf, ...) that the kernel's
+ * start sequence needs. Small values are printed in hex; nothing in them is an identity.
+ */
+/* Map [pa, pa + len) temporarily: *base/*mlen are what ac_unmap_tmp takes back. */
+static vm_offset_t
+ac_map_tmp(uint64_t pa, uint32_t len, vm_offset_t *base, vm_size_t *mlen)
+{
+	uint64_t page = pa & ~(uint64_t)PAGE_MASK;
+	*mlen = ((vm_size_t)(pa - page) + len + PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+	*base = ml_io_map_unmappable((vm_offset_t)page, *mlen, 0x7u /* VM_WIMG_IO */);
+	return *base ? *base + (vm_offset_t)(pa - page) : 0;
+}
+
+static void
+ac_unmap_tmp(vm_offset_t base, vm_size_t mlen)
+{
+	if (base)
+		ml_io_unmap(base, mlen);
+}
+
+static void
+ac_lk_tags(void)
+{
+	uint32_t size = ac_tag_size;
+
+	if (ac_tag_base == 0 || size == 0 || size > 0x10000 || ac_tag_count > 256)
+		return;
+	vm_offset_t mb = 0;
+	vm_size_t ml = 0;
+	vm_offset_t m = ac_map_tmp(ac_tag_base, size, &mb, &ml);
+	uint8_t *t = kalloc_data(size + 4, Z_WAITOK | Z_ZERO);
+	if (!m || !t) {
+		if (t)
+			kfree_data(t, size + 4);
+		ac_unmap_tmp(mb, ml);
+		return;
+	}
+	for (uint32_t o = 0; o + 4 <= size; o += 4) {
+		uint32_t w = ac_rd32(m, o);
+		memcpy(t + o, &w, 4);
+	}
+	ac_unmap_tmp(mb, ml);
+	uint32_t namelen = ac_tag_version >= 2 ? 64 : 16, cur = 0;
+	for (uint32_t i = 0; i < ac_tag_count && cur + namelen + 12 <= size; i++) {
+		char name[68];
+		ac_printable(name, sizeof(name), t + cur, namelen);
+		uint32_t off = le32(t + cur + namelen), len = le32(t + cur + namelen + 4);
+		uint32_t next = le32(t + cur + namelen + 8);
+		char hex[3 * 64 + 1];
+		size_t h = 0;
+		if (off <= size && len <= size - off && len <= 64) {
+			for (uint32_t k = 0; k < len; k++)
+				h += (size_t)snprintf(hex + h, sizeof(hex) - h, "%02x", t[off + k]);
+		}
+		hex[h] = 0;
+		if (len > 64 && strcmp(name, "md1_chk") == 0 && off <= size && len <= size - off && len >= 168) {
+			char plat[20], build[70];
+			ac_printable(plat, sizeof(plat), t + off + 24, 16);
+			ac_printable(build, sizeof(build), t + off + 40, 64);
+			printf("A34 CELL: LK tag %-24s %u bytes: check header in modem memory, %s %s\n", name,
+			    len, plat, build);
+		} else {
+			printf("A34 CELL: LK tag %-24s %u bytes%s%s\n", name, len, h ? ": " : "", hex);
+		}
+		if (next <= cur || next >= size)
+			break;
+		cur = next;
+	}
+	ac_tags = t;            /* kept: the start sequence (0951) reads the layout from it */
+	ac_tags_size = size;
+}
+
+/*
+ * A34 (0951): LK's tag `name` (data inside the kept copy of the table), for bsd/dev/a34_ccci.c.
+ */
+bool a34_cell_lk_tag(const char *name, const uint8_t **data, uint32_t *len);
+bool a34_ccci_prepare(vm_offset_t ap_ccif, vm_offset_t md_ccif);
+void a34_ccci_md_pmic(const char *when, bool set);
+void a34_ccci_hs1(vm_offset_t ap_ccif, vm_offset_t md_ccif, const uint32_t feature_query[56]);
+bool
+a34_cell_lk_tag(const char *name, const uint8_t **data, uint32_t *len)
+{
+	uint32_t namelen = ac_tag_version >= 2 ? 64 : 16, cur = 0;
+
+	if (!ac_tags)
+		return false;
+	for (uint32_t i = 0; i < ac_tag_count && cur + namelen + 12 <= ac_tags_size; i++) {
+		const uint8_t *t = ac_tags + cur;
+		uint32_t off = le32(t + namelen), l = le32(t + namelen + 4), next = le32(t + namelen + 8);
+		if (strncmp((const char *)t, name, namelen) == 0 && off <= ac_tags_size &&
+		    l <= ac_tags_size - off) {
+			*data = ac_tags + off;
+			*len = l;
+			return true;
+		}
+		if (next <= cur || next >= ac_tags_size)
+			break;
+		cur = next;
+	}
+	return false;
+}
+
+static void
+ac_lk_fdt(void)
+{
+	uint64_t pa = AC_LK_FDT_PA;
+	uint8_t hdr[40];
+
+	(void)PE_parse_boot_argn("a34lkfdt", &pa, (int)sizeof(pa));
+	{
+		DTEntry chosen;
+		void const *pv;
+		unsigned int sz;
+		if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess) {
+			if (SecureDTGetProperty(chosen, "dram-base", &pv, &sz) == kSuccess && sz == 8)
+				memcpy(&ac_xnu_base, pv, 8);
+			if (SecureDTGetProperty(chosen, "dram-size", &pv, &sz) == kSuccess && sz == 8)
+				memcpy(&ac_xnu_size, pv, 8);
+		}
+	}
+	vm_offset_t hb = 0;
+	vm_size_t hl = 0;
+	vm_offset_t m = ac_map_tmp(pa, 40, &hb, &hl);
+	if (!m) {
+		printf("A34 CELL: LK FDT 0x%llx: no mapping\n", pa);
+		return;
+	}
+	for (int i = 0; i < 10; i++) {
+		uint32_t w = ac_rd32(m, (uint32_t)(4 * i));
+		memcpy(hdr + 4 * i, &w, 4);
+	}
+	ac_unmap_tmp(hb, hl);
+	uint32_t magic = be32(hdr), total = be32(hdr + 4), off_struct = be32(hdr + 8);
+	uint32_t off_strings = be32(hdr + 12), size_strings = be32(hdr + 32), size_struct = be32(hdr + 36);
+	if (magic != 0xd00dfeedu || total < 64 || total > AC_FDT_MAX ||
+	    off_struct >= total || off_strings >= total || size_struct > total - off_struct ||
+	    size_strings > total - off_strings) {
+		printf("A34 CELL: no LK device tree at 0x%llx (magic 0x%08x, size %u)\n", pa, magic, total);
+		AC_NOTE("lkfdt=none");
+		return;
+	}
+	vm_offset_t ab = 0;
+	vm_size_t al = 0;
+	vm_offset_t all = ac_map_tmp(pa, total, &ab, &al);
+	uint8_t *f = kalloc_data(total, Z_WAITOK);
+	if (!all || !f) {
+		printf("A34 CELL: LK FDT: no memory for %u bytes\n", total);
+		if (f)
+			kfree_data(f, total);
+		ac_unmap_tmp(ab, al);
+		return;
+	}
+	for (uint32_t o = 0; o + 4 <= total; o += 4) {
+		uint32_t w = ac_rd32(all, o);   /* aligned 32-bit reads only: it is mapped as device */
+		memcpy(f + o, &w, 4);
+	}
+	ac_unmap_tmp(ab, al);
+	printf("A34 CELL: LK device tree at 0x%llx, %u bytes\n", pa, total);
+
+	/* Walk the structure block: /chosen props, /reserved-memory children, and any node's
+	 * ccci,modem_info_v2 (the mddriver node carries a copy). */
+	const uint8_t *s = f + off_struct, *end = s + size_struct;
+	const char *strs = (const char *)f + off_strings;
+	int depth = 0, nregions = 0;
+	char names[8][48];
+	bool in_resv = false;
+
+	memset(names, 0, sizeof(names));
+	while (s + 4 <= end) {
+		uint32_t tok = be32(s);
+		s += 4;
+		if (tok == FDT_BEGIN_NODE) {
+			const char *nm = (const char *)s;
+			size_t l = 0;
+			while (s + l < end && nm[l])
+				l++;
+			if (depth < 8)
+				strlcpy(names[depth], nm, sizeof(names[depth]));
+			depth++;
+			in_resv = depth == 3 && strcmp(names[1], "reserved-memory") == 0;
+			s += (l + 1 + 3) & ~(size_t)3;
+		} else if (tok == FDT_END_NODE) {
+			if (depth > 0)
+				depth--;
+			in_resv = false;
+		} else if (tok == FDT_PROP) {
+			if (s + 8 > end)
+				break;
+			uint32_t len = be32(s), nameoff = be32(s + 4);
+			const uint8_t *v = s + 8;
+			s += 8 + ((len + 3) & ~3u);
+			if (s > end || nameoff >= size_strings)
+				break;
+			const char *pn = strs + nameoff;
+			const char *node = depth >= 1 && depth <= 8 ? names[depth - 1] : "?";
+			if (strcmp(pn, "ccci,modem_info_v2") == 0) {
+				ac_modem_info(depth == 2 && strcmp(node, "chosen") == 0 ? "/chosen" : node, v, len);
+			} else if (depth == 2 && strcmp(node, "chosen") == 0 && strcmp(pn, "atag,mdinfo") == 0) {
+				printf("A34 CELL: LK /chosen atag,mdinfo: %u bytes, first word 0x%08x\n", len,
+				    len >= 4 ? be32(v) : 0);
+			} else if (in_resv && strcmp(pn, "reg") == 0 && len >= 16) {
+				/* every region LK reserved, and whether it touches XNU's memory */
+				for (uint32_t k = 0; k + 16 <= len; k += 16) {
+					uint64_t rb = (uint64_t)be32(v + k) << 32 | be32(v + k + 4);
+					uint64_t rs = (uint64_t)be32(v + k + 8) << 32 | be32(v + k + 12);
+					bool hit = rs && rb < ac_xnu_base + ac_xnu_size && rb + rs > ac_xnu_base;
+					printf("A34 CELL: LK reserved %s: 0x%llx-0x%llx (%llu KiB)%s\n", node, rb,
+					    rb + rs, rs >> 10, hit ? " OVERLAPS XNU MEMORY" : "");
+					ac_resv++;
+					ac_resv_hits += hit;
+					if (ac_has(node, "md") || ac_has(node, "ccci") || ac_has(node, "MD"))
+						nregions++;
+				}
+			}
+		} else if (tok == FDT_NOP) {
+			continue;
+		} else {
+			break;  /* FDT_END or garbage */
+		}
+	}
+	ac_fdt = f;                     /* kept (read only): the modem's RPC answers read it (a34_ccci.c) */
+	ac_fdt_struct = off_struct;
+	ac_fdt_strings = off_strings;
+	ac_fdt_struct_size = size_struct;
+	ac_fdt_strings_size = size_strings;
+	printf("A34 CELL: LK modem regions in reserved-memory: %d; all reserved regions: %u, overlapping XNU's 0x%llx-0x%llx: %u\n",
+	    nregions, ac_resv, ac_xnu_base, ac_xnu_base + ac_xnu_size, ac_resv_hits);
+	AC_NOTE("resv=%u overlap=%u", ac_resv, ac_resv_hits);
+	ac_lk_tags();
+	AC_NOTE("lk=%s mdregions=%d", ac_lk_md == 1 ? "loaded" : ac_lk_md == 0 ? "notloaded" : "noinfo",
+	    nregions);
+}
+
+/*
+ * A34 (0950): a property of LK's device tree (the kept copy, read only): the first node whose
+ * name is node_name (any depth) or, if node_name is NULL, whose "compatible" is compat. For
+ * the modem's RPC answers (GPIO and EINT tables, md_attr_node, md-auxadc), as Android's
+ * port_rpc.c reads them from the same tree.
+ */
+bool a34_cell_fdt_prop(const char *node_name, const char *compat, const char *prop,
+    const uint8_t **val, uint32_t *len);
+
+static const uint8_t *
+fdt_props(const uint8_t *s, const uint8_t *end, const char *prop, uint32_t *len)
+{
+	/* direct properties of the node whose body starts at s (they come before subnodes) */
+	while (s + 4 <= end) {
+		uint32_t tok = be32(s);
+		if (tok == FDT_NOP) {
+			s += 4;
+			continue;
+		}
+		if (tok != FDT_PROP || s + 12 > end)
+			return NULL;
+		uint32_t l = be32(s + 4), no = be32(s + 8);
+		if (no < ac_fdt_strings_size && strcmp((const char *)ac_fdt + ac_fdt_strings + no, prop) == 0) {
+			*len = l;
+			return s + 12;
+		}
+		s += 12 + ((l + 3) & ~3u);
+	}
+	return NULL;
+}
+
+bool
+a34_cell_fdt_prop(const char *node_name, const char *compat, const char *prop,
+    const uint8_t **val, uint32_t *len)
+{
+	if (!ac_fdt)
+		return false;
+	const uint8_t *s = ac_fdt + ac_fdt_struct, *end = s + ac_fdt_struct_size;
+	while (s + 4 <= end) {
+		uint32_t tok = be32(s);
+		s += 4;
+		if (tok == FDT_BEGIN_NODE) {
+			const char *nm = (const char *)s;
+			size_t l = 0;
+			while (s + l < end && nm[l])
+				l++;
+			s += (l + 1 + 3) & ~(size_t)3;
+			bool match = false;
+			if (node_name) {
+				match = strcmp(nm, node_name) == 0;
+			} else {
+				uint32_t cl = 0;
+				const uint8_t *c = fdt_props(s, end, "compatible", &cl);
+				for (uint32_t o = 0; c && o < cl; o += (uint32_t)strlen((const char *)c + o) + 1)
+					if (strcmp((const char *)c + o, compat) == 0)
+						match = true;
+			}
+			if (match) {
+				const uint8_t *v = fdt_props(s, end, prop, len);
+				if (v) {
+					*val = v;
+					return true;
+				}
+				return false;
+			}
+		} else if (tok == FDT_PROP) {
+			if (s + 8 > end)
+				return false;
+			s += 8 + ((be32(s) + 3) & ~3u);
+		} else if (tok == FDT_END_NODE || tok == FDT_NOP) {
+			continue;
+		} else {
+			return false;
+		}
+	}
+	return false;
+}
+
+/* ---- 2..4. power, clocks, boot status ---- */
+
+static bool
+ac_md1_power(void)
+{
+	vm_offset_t spm = ml_io_map((vm_offset_t)AC_SPM_PA, PAGE_SIZE);
+	if (!spm)
+		return false;
+	uint32_t con = ac_rd32(spm, AC_SPM_MD1_PWR_CON), iso = ac_rd32(spm, AC_SPM_MD_BUCK_ISO);
+	uint32_t st1 = ac_rd32(spm, AC_SPM_PWR_STATUS), st2 = ac_rd32(spm, AC_SPM_PWR_STATUS_2ND);
+	bool on = (st1 & 1) && (st2 & 1);
+	printf("A34 CELL: MD1 power domain %s (PWR_STATUS 0x%08x / 2ND 0x%08x, MD1_PWR_CON 0x%08x, "
+	    "MD_BUCK_ISO 0x%08x)\n", on ? "ON" : (st1 & 1) || (st2 & 1) ? "half on" : "off",
+	    st1, st2, con, iso);
+	AC_NOTE("md1=%s", on ? "on" : "off");
+	return on;
+}
+
+static void
+ac_ccif_clocks(void)
+{
+	vm_offset_t infra = ml_io_map((vm_offset_t)AC_INFRA_PA, PAGE_SIZE);
+	if (!infra)
+		return;
+	uint32_t cg1 = ac_rd32(infra, AC_INFRA_CG1_STA);
+	printf("A34 CELL: CCIF clocks (infracfg_ao CG1 status 0x%08x, 1 = gated): CCIF_AP %u "
+	    "CCIF_MD %u CCIF1_AP %u CCIF1_MD %u\n", cg1, cg1 >> 23 & 1, cg1 >> 26 & 1, cg1 >> 12 & 1,
+	    cg1 >> 13 & 1);
+	AC_NOTE("ccifclk=%s", (cg1 >> 23 & 1) ? "gated" : "on");
+}
+
+/* SMC 0xC2000505 (MTK_SIP_KERNEL_CCCI_CONTROL) with x1 = sub-ID, x2 = argument; x0..x3 back. */
+static void
+ac_smc(uint64_t sub, uint64_t arg, uint64_t out[4])
+{
+	register uint64_t x0 __asm__("x0") = AC_SMC_CCCI_CONTROL;
+	register uint64_t x1 __asm__("x1") = sub;
+	register uint64_t x2 __asm__("x2") = arg;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	out[0] = x0;
+	out[1] = x1;
+	out[2] = x2;
+	out[3] = x3;
+}
+
+static void
+ac_boot_status(void)
+{
+	register uint64_t x0 __asm__("x0") = AC_SMC_CCCI_CONTROL;
+	register uint64_t x1 __asm__("x1") = AC_MD_POWER_CONFIG;
+	register uint64_t x2 __asm__("x2") = AC_MD_BOOT_STATUS;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	printf("A34 CELL: MD boot status (SMC MD_POWER_CONFIG/MD_BOOT_STATUS): ret 0x%llx status0 "
+	    "0x%llx status1 0x%llx\n", x0, x1, x2);
+	AC_NOTE("mdboot=0x%llx", x1);
+}
+
+/* MD_POWER_CONFIG / MD_CHECK_DONE (3): 0 once the modem's boot ROM check passed ("BROM PASS"
+ * in Android's md_start_platform, which polls it the same way). */
+static bool
+ac_brom_check(void)
+{
+	register uint64_t x0 __asm__("x0") = AC_SMC_CCCI_CONTROL;
+	register uint64_t x1 __asm__("x1") = AC_MD_POWER_CONFIG;
+	register uint64_t x2 __asm__("x2") = 3;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	printf("A34 CELL: MD boot ROM check (SMC MD_POWER_CONFIG/MD_CHECK_DONE): 0x%llx%s\n", x0,
+	    x0 == 0 ? " = BROM PASS" : "");
+	AC_NOTE("brom=%s", x0 == 0 ? "pass" : "no");
+	return x0 == 0;
+}
