+/*
+ * A34 (0950): cellular, stage 0 -- how the modem's side looks, read only.
+ *
+ * Boot-arg a34cell=1 (default 0: nothing here runs, nothing is mapped); a34cell=2 adds the
+ * first contact with the modem (ac_first_contact(), below), the only part that writes registers
+ * (CCIF clocks and reset, the modem's start) -- never a voltage, never a partition. One thread, a few
+ * seconds after the disk is up, logs "A34 CELL:" lines and fills the read-only sysctl
+ * kern.a34cell with a one-line summary (userland/a34cell prints it). Plan and evidence:
+ * docs/cellular-plan.md.
+ *
+ * Nothing is written anywhere. What is read:
+ *  1. The boot loader's flattened device tree, which LK leaves in DRAM below the memory XNU
+ *     manages (0x47c80000 on this phone, a34lkfdt=ADDR to change): /chosen's
+ *     "ccci,modem_info_v2" says whether LK loaded and verified the modem image (it does on a
+ *     normal boot and skips it on a recovery boot, LK's own log string "recovery mode, no need
+ *     load modem"), and /reserved-memory lists what LK reserved (all regions are logged with
+ *     a check against XNU's memory, ADT /chosen dram-base/dram-size; the loader already trims
+ *     XNU's memory around any of them).
+ *     The struct is MediaTek's _ccci_lk_info_v2 (Samsung kernel ccci_util_lib_fo.c), copied as
+ *     raw little-endian bytes into the property. When LK loaded the modem, its tag table
+ *     (reserved "ccci_tag_mem") is listed: tag names, sizes, small values in hex.
+ *  2. The SPM's power status of the modem's MTCMOS domain: PWR_STATUS 0x10006EF0 and
+ *     PWR_STATUS_2ND 0x10006EF4, bit 0 = MD1; MD1_PWR_CON 0x10006E00 (clk-mt6877-pg.c).
+ *  3. The infracfg_ao clock gates of the CCIF blocks (status registers, 1 = gated):
+ *     CG1 status 0x10001094 bits 23 (CCIF_AP), 26 (CCIF_MD), 12 (CCIF1_AP), 13 (CCIF1_MD)
+ *     (clk-mt6877.c). The CCIF registers themselves are not touched (a gated block's
+ *     registers can stall the bus).
+ *  4. Only when the MD1 domain is on: the modem's boot status through the secure monitor,
+ *     SMC 0xC2000505 (MTK_SIP_KERNEL_CCCI_CONTROL) with MD_POWER_CONFIG (6) / MD_BOOT_STATUS
+ *     (4), the same query Android's ccci driver makes for its logs, and MD_CHECK_DONE (3), the
+ *     boot ROM check Android polls before its first start (md_sys1_platform.c).
+ *  5. The md1img partition, through sweet_ufs_read_part() (read only, a fixed list of
+ *     partitions): its MediaTek section headers (magic 0x58881688, name, size; a 512-byte
+ *     header per section, 16-byte alignment) and md1rom's CHECK_HEADER (version, platform,
+ *     build strings) at the end of its data. The GPT bounds of the other modem partitions are
+ *     printed (names and sizes only; their contents are never read here).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+/* bsd/dev/sweet_ufs.c (A34 0950) */
+extern int sweet_ufs_read_part(const char *name, uint64_t off, void *buf, uint32_t len,
+    uint64_t *part_bytes);
+extern int sweet_ufs_part_bounds(const char *name, uint64_t *first_block, uint64_t *nblocks);
+void a34_cell_init(void);
+
+#define AC_LK_FDT_PA            0x47c80000ull   /* LK's DTB (README: "DTB 0x47c80000") */
+#define AC_FDT_MAX              (2u << 20)
+#define AC_SPM_PA               0x10006000ull
+#define AC_SPM_MD1_PWR_CON      0xE00u
+#define AC_SPM_MD_BUCK_ISO      0xEE8u
+#define AC_SPM_PWR_STATUS       0xEF0u
+#define AC_SPM_PWR_STATUS_2ND   0xEF4u
+#define AC_INFRA_PA             0x10001000ull
+#define AC_INFRA_CG1_STA        0x094u
+#define AC_SMC_CCCI_CONTROL     0xC2000505ull
+#define AC_MD_POWER_CONFIG      6u
+#define AC_MD_BOOT_STATUS       4u
+
+static uint32_t ac_mode;
+static char ac_state[256] = "a34cell=0";
+SYSCTL_STRING(_kern, OID_AUTO, a34cell, CTLFLAG_RD | CTLFLAG_LOCKED, ac_state, sizeof(ac_state),
+    "A34 cellular stage 0 summary");
+
+/* Appends " <text>" to the sysctl's summary. */
+#define AC_NOTE(...) do {                                                       \
+	size_t n_ = strlen(ac_state);                                            \
+	if (n_ + 2 < sizeof(ac_state)) {                                         \
+		ac_state[n_] = ' ';                                              \
+		snprintf(ac_state + n_ + 1, sizeof(ac_state) - n_ - 1, __VA_ARGS__); \
+	}                                                                        \
+} while (0)
+
+/* Does s contain w? (no strstr here) */
+static bool
+ac_has(const char *s, const char *w)
+{
+	size_t n = strlen(w);
+
+	for (; *s; s++)
+		if (strncmp(s, w, n) == 0)
+			return true;
+	return false;
+}
+
+static uint32_t
+ac_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dsb ld" ::: "memory");
+	return v;
+}
+
+static uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t
+le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+}
+
+/* Keeps printable ASCII of a fixed-size field, for the log. */
+static void
+ac_printable(char *out, size_t outsz, const uint8_t *in, size_t inlen)
+{
+	size_t o = 0;
+
+	for (size_t i = 0; i < inlen && in[i] && o + 1 < outsz; i++)
+		out[o++] = (in[i] >= 0x20 && in[i] < 0x7f) ? (char)in[i] : '.';
+	out[o] = 0;
+}
+
+/* ---- 1. LK's device tree ---- */
+
+#define FDT_BEGIN_NODE  1
+#define FDT_END_NODE    2
+#define FDT_PROP        3
+#define FDT_NOP         4
+#define FDT_END         9
+
+static int ac_lk_md = -1;       /* -1 unknown, 0 not loaded, 1 loaded */
+static uint64_t ac_xnu_base, ac_xnu_size;       /* XNU's memory: ADT /chosen dram-base, dram-size */
+static uint32_t ac_resv, ac_resv_hits;
+static uint64_t ac_tag_base;
+static uint32_t ac_tag_size, ac_tag_count, ac_tag_version;
+
+static void
+ac_modem_info(const char *node, const uint8_t *v, uint32_t len)
+{
+	if (len < 32) {
+		printf("A34 CELL: LK %s ccci,modem_info_v2: %u bytes (expected 32+)\n", node, len);
+		return;
+	}
+	/* struct _ccci_lk_info_v2 { u64 base; u32 size; s32 err_no; s32 version; s32 tag_num;
+	 * u32 ld_flag; s32 ld_md_errno; } -- raw little-endian bytes */
+	uint64_t base = le64(v);
+	uint32_t size = le32(v + 8), version = le32(v + 16), tags = le32(v + 20), flag = le32(v + 24);
+	int32_t err = (int32_t)le32(v + 12), mderr = (int32_t)le32(v + 28);
+	bool loaded = base != 0 && err == 0 && (flag & 1);
+
+	if (base == 0 && err == 0 && flag == 0)
+		printf("A34 CELL: LK %s ccci,modem_info_v2 all zero: the boot loader did not load the "
+		    "modem (it skips it on a recovery boot)\n", node);
+	else
+		printf("A34 CELL: LK %s ccci,modem_info_v2: tag table 0x%llx (+0x%x) v%u, %u tags, "
+		    "load flags 0x%x, err %d, md errno %d -> modem %s\n", node, base, size, version,
+		    tags, flag, err, mderr, loaded ? "LOADED by LK" : "not loaded");
+	if (ac_lk_md != 1)
+		ac_lk_md = loaded ? 1 : 0;
+	if (loaded && ac_tag_base == 0) {
+		ac_tag_base = base;
+		ac_tag_size = size;
+		ac_tag_count = tags;
+		ac_tag_version = version;
+	}
+}
+
+/*
+ * LK's tag table (reserved "ccci_tag_mem", which Android's ccci_util maps and reads the same
+ * way): tags {char name[64]; u32 data_offset, data_size, next_tag_offset} for version >= 2
+ * (16-byte names before), offsets from the table's start. They carry the modem's memory and
+ * shared-memory layout (smem_layout, nc/c_smem_layout*, md_mpu_inf, ...) that the kernel's
+ * start sequence needs. Small values are printed in hex; nothing in them is an identity.
+ */
+static void
+ac_lk_tags(void)
+{
+	uint32_t size = ac_tag_size;
+
+	if (ac_tag_base == 0 || size == 0 || size > 0x10000 || ac_tag_count > 256)
+		return;
+	vm_offset_t m = ml_io_map((vm_offset_t)ac_tag_base, ((vm_size_t)size + PAGE_MASK) & ~(vm_size_t)PAGE_MASK);
+	uint8_t *t = kalloc_data(size + 4, Z_WAITOK | Z_ZERO);
+	if (!m || !t) {
+		if (t)
+			kfree_data(t, size + 4);
+		return;
+	}
+	for (uint32_t o = 0; o + 4 <= size; o += 4) {
+		uint32_t w = ac_rd32(m, o);
+		memcpy(t + o, &w, 4);
+	}
+	uint32_t namelen = ac_tag_version >= 2 ? 64 : 16, cur = 0;
+	for (uint32_t i = 0; i < ac_tag_count && cur + namelen + 12 <= size; i++) {
+		char name[68];
+		ac_printable(name, sizeof(name), t + cur, namelen);
+		uint32_t off = le32(t + cur + namelen), len = le32(t + cur + namelen + 4);
+		uint32_t next = le32(t + cur + namelen + 8);
+		char hex[3 * 64 + 1];
+		size_t h = 0;
+		if (off <= size && len <= size - off && len <= 64) {
+			for (uint32_t k = 0; k < len; k++)
+				h += (size_t)snprintf(hex + h, sizeof(hex) - h, "%02x", t[off + k]);
+		}
+		hex[h] = 0;
+		if (len > 64 && strcmp(name, "md1_chk") == 0 && off <= size && len <= size - off && len >= 168) {
+			char plat[20], build[70];
+			ac_printable(plat, sizeof(plat), t + off + 24, 16);
+			ac_printable(build, sizeof(build), t + off + 40, 64);
+			printf("A34 CELL: LK tag %-24s %u bytes: check header in modem memory, %s %s\n", name,
+			    len, plat, build);
+		} else {
+			printf("A34 CELL: LK tag %-24s %u bytes%s%s\n", name, len, h ? ": " : "", hex);
+		}
+		if (next <= cur || next >= size)
+			break;
+		cur = next;
+	}
+	kfree_data(t, size + 4);
+}
+
+static void
+ac_lk_fdt(void)
+{
+	uint64_t pa = AC_LK_FDT_PA;
+	uint8_t hdr[40];
+
+	(void)PE_parse_boot_argn("a34lkfdt", &pa, (int)sizeof(pa));
+	{
+		DTEntry chosen;
+		void const *pv;
+		unsigned int sz;
+		if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess) {
+			if (SecureDTGetProperty(chosen, "dram-base", &pv, &sz) == kSuccess && sz == 8)
+				memcpy(&ac_xnu_base, pv, 8);
+			if (SecureDTGetProperty(chosen, "dram-size", &pv, &sz) == kSuccess && sz == 8)
+				memcpy(&ac_xnu_size, pv, 8);
+		}
+	}
+	vm_offset_t m = ml_io_map((vm_offset_t)pa, PAGE_SIZE);
+	if (!m) {
+		printf("A34 CELL: LK FDT 0x%llx: no mapping\n", pa);
+		return;
+	}
+	for (int i = 0; i < 10; i++) {
+		uint32_t w = ac_rd32(m, (uint32_t)(4 * i));
+		memcpy(hdr + 4 * i, &w, 4);
+	}
+	uint32_t magic = be32(hdr), total = be32(hdr + 4), off_struct = be32(hdr + 8);
+	uint32_t off_strings = be32(hdr + 12), size_strings = be32(hdr + 32), size_struct = be32(hdr + 36);
+	if (magic != 0xd00dfeedu || total < 64 || total > AC_FDT_MAX ||
+	    off_struct >= total || off_strings >= total || size_struct > total - off_struct ||
+	    size_strings > total - off_strings) {
+		printf("A34 CELL: no LK device tree at 0x%llx (magic 0x%08x, size %u)\n", pa, magic, total);
+		AC_NOTE("lkfdt=none");
+		return;
+	}
+	vm_offset_t all = ml_io_map((vm_offset_t)pa, ((vm_size_t)total + PAGE_MASK) & ~(vm_size_t)PAGE_MASK);
+	uint8_t *f = kalloc_data(total, Z_WAITOK);
+	if (!all || !f) {
+		printf("A34 CELL: LK FDT: no memory for %u bytes\n", total);
+		if (f)
+			kfree_data(f, total);
+		return;
+	}
+	for (uint32_t o = 0; o + 4 <= total; o += 4) {
+		uint32_t w = ac_rd32(all, o);   /* aligned 32-bit reads only: it is mapped as device */
+		memcpy(f + o, &w, 4);
+	}
+	printf("A34 CELL: LK device tree at 0x%llx, %u bytes\n", pa, total);
+
+	/* Walk the structure block: /chosen props, /reserved-memory children, and any node's
+	 * ccci,modem_info_v2 (the mddriver node carries a copy). */
+	const uint8_t *s = f + off_struct, *end = s + size_struct;
+	const char *strs = (const char *)f + off_strings;
+	int depth = 0, nregions = 0;
+	char names[8][48];
+	bool in_resv = false;
+
+	memset(names, 0, sizeof(names));
+	while (s + 4 <= end) {
+		uint32_t tok = be32(s);
+		s += 4;
+		if (tok == FDT_BEGIN_NODE) {
+			const char *nm = (const char *)s;
+			size_t l = 0;
+			while (s + l < end && nm[l])
+				l++;
+			if (depth < 8)
+				strlcpy(names[depth], nm, sizeof(names[depth]));
+			depth++;
+			in_resv = depth == 3 && strcmp(names[1], "reserved-memory") == 0;
+			s += (l + 1 + 3) & ~(size_t)3;
+		} else if (tok == FDT_END_NODE) {
+			if (depth > 0)
+				depth--;
+			in_resv = false;
+		} else if (tok == FDT_PROP) {
+			if (s + 8 > end)
+				break;
+			uint32_t len = be32(s), nameoff = be32(s + 4);
+			const uint8_t *v = s + 8;
+			s += 8 + ((len + 3) & ~3u);
+			if (s > end || nameoff >= size_strings)
+				break;
+			const char *pn = strs + nameoff;
+			const char *node = depth >= 1 && depth <= 8 ? names[depth - 1] : "?";
+			if (strcmp(pn, "ccci,modem_info_v2") == 0) {
+				ac_modem_info(depth == 2 && strcmp(node, "chosen") == 0 ? "/chosen" : node, v, len);
+			} else if (depth == 2 && strcmp(node, "chosen") == 0 && strcmp(pn, "atag,mdinfo") == 0) {
+				printf("A34 CELL: LK /chosen atag,mdinfo: %u bytes, first word 0x%08x\n", len,
+				    len >= 4 ? be32(v) : 0);
+			} else if (in_resv && strcmp(pn, "reg") == 0 && len >= 16) {
+				/* every region LK reserved, and whether it touches XNU's memory */
+				for (uint32_t k = 0; k + 16 <= len; k += 16) {
+					uint64_t rb = (uint64_t)be32(v + k) << 32 | be32(v + k + 4);
+					uint64_t rs = (uint64_t)be32(v + k + 8) << 32 | be32(v + k + 12);
+					bool hit = rs && rb < ac_xnu_base + ac_xnu_size && rb + rs > ac_xnu_base;
+					printf("A34 CELL: LK reserved %s: 0x%llx-0x%llx (%llu KiB)%s\n", node, rb,
+					    rb + rs, rs >> 10, hit ? " OVERLAPS XNU MEMORY" : "");
+					ac_resv++;
+					ac_resv_hits += hit;
+					if (ac_has(node, "md") || ac_has(node, "ccci") || ac_has(node, "MD"))
+						nregions++;
+				}
+			}
+		} else if (tok == FDT_NOP) {
+			continue;
+		} else {
+			break;  /* FDT_END or garbage */
+		}
+	}
+	kfree_data(f, total);
+	printf("A34 CELL: LK modem regions in reserved-memory: %d; all reserved regions: %u, overlapping XNU's 0x%llx-0x%llx: %u\n",
+	    nregions, ac_resv, ac_xnu_base, ac_xnu_base + ac_xnu_size, ac_resv_hits);
+	AC_NOTE("resv=%u overlap=%u", ac_resv, ac_resv_hits);
+	ac_lk_tags();
+	AC_NOTE("lk=%s mdregions=%d", ac_lk_md == 1 ? "loaded" : ac_lk_md == 0 ? "notloaded" : "noinfo",
+	    nregions);
+}
+
+/* ---- 2..4. power, clocks, boot status ---- */
+
+static bool
+ac_md1_power(void)
+{
+	vm_offset_t spm = ml_io_map((vm_offset_t)AC_SPM_PA, PAGE_SIZE);
+	if (!spm)
+		return false;
+	uint32_t con = ac_rd32(spm, AC_SPM_MD1_PWR_CON), iso = ac_rd32(spm, AC_SPM_MD_BUCK_ISO);
+	uint32_t st1 = ac_rd32(spm, AC_SPM_PWR_STATUS), st2 = ac_rd32(spm, AC_SPM_PWR_STATUS_2ND);
+	bool on = (st1 & 1) && (st2 & 1);
+	printf("A34 CELL: MD1 power domain %s (PWR_STATUS 0x%08x / 2ND 0x%08x, MD1_PWR_CON 0x%08x, "
+	    "MD_BUCK_ISO 0x%08x)\n", on ? "ON" : (st1 & 1) || (st2 & 1) ? "half on" : "off",
+	    st1, st2, con, iso);
+	AC_NOTE("md1=%s", on ? "on" : "off");
+	return on;
+}
+
+static void
+ac_ccif_clocks(void)
+{
+	vm_offset_t infra = ml_io_map((vm_offset_t)AC_INFRA_PA, PAGE_SIZE);
+	if (!infra)
+		return;
+	uint32_t cg1 = ac_rd32(infra, AC_INFRA_CG1_STA);
+	printf("A34 CELL: CCIF clocks (infracfg_ao CG1 status 0x%08x, 1 = gated): CCIF_AP %u "
+	    "CCIF_MD %u CCIF1_AP %u CCIF1_MD %u\n", cg1, cg1 >> 23 & 1, cg1 >> 26 & 1, cg1 >> 12 & 1,
+	    cg1 >> 13 & 1);
+	AC_NOTE("ccifclk=%s", (cg1 >> 23 & 1) ? "gated" : "on");
+}
+
+/* SMC 0xC2000505 (MTK_SIP_KERNEL_CCCI_CONTROL) with x1 = sub-ID, x2 = argument; x0..x3 back. */
+static void
+ac_smc(uint64_t sub, uint64_t arg, uint64_t out[4])
+{
+	register uint64_t x0 __asm__("x0") = AC_SMC_CCCI_CONTROL;
+	register uint64_t x1 __asm__("x1") = sub;
+	register uint64_t x2 __asm__("x2") = arg;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	out[0] = x0;
+	out[1] = x1;
+	out[2] = x2;
+	out[3] = x3;
+}
+
+static void
+ac_boot_status(void)
+{
+	register uint64_t x0 __asm__("x0") = AC_SMC_CCCI_CONTROL;
+	register uint64_t x1 __asm__("x1") = AC_MD_POWER_CONFIG;
+	register uint64_t x2 __asm__("x2") = AC_MD_BOOT_STATUS;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	printf("A34 CELL: MD boot status (SMC MD_POWER_CONFIG/MD_BOOT_STATUS): ret 0x%llx status0 "
+	    "0x%llx status1 0x%llx\n", x0, x1, x2);
+	AC_NOTE("mdboot=0x%llx", x1);
+}
+
+/* MD_POWER_CONFIG / MD_CHECK_DONE (3): 0 once the modem's boot ROM check passed ("BROM PASS"
+ * in Android's md_start_platform, which polls it the same way). */
+static bool
+ac_brom_check(void)
+{
+	register uint64_t x0 __asm__("x0") = AC_SMC_CCCI_CONTROL;
+	register uint64_t x1 __asm__("x1") = AC_MD_POWER_CONFIG;
+	register uint64_t x2 __asm__("x2") = 3;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	__asm__ volatile(
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	      "x17", "memory");
+	printf("A34 CELL: MD boot ROM check (SMC MD_POWER_CONFIG/MD_CHECK_DONE): 0x%llx%s\n", x0,
+	    x0 == 0 ? " = BROM PASS" : "");
+	AC_NOTE("brom=%s", x0 == 0 ? "pass" : "no");
+	return x0 == 0;
+}
+
+/* ---- a34cell=2: first contact (starts the modem LK loaded; no power or voltage change) ---- */
+
+#define AC_AP_CCIF_PA           0x10209000ull
+#define AC_MD_CCIF_PA           0x1020A000ull
+#define CCIF_BUSY               0x04u
+#define CCIF_RCHNUM             0x10u
+#define CCIF_ACK                0x14u
+#define CCIF_CHDATA             0x100u
+#define CCIF_SRAM_SIZE          512u
+#define CCIF_D2H_SRAM           15u
+#define AC_INFRA_CG1_CLR        0x08Cu
+#define AC_INFRA_CG3_CLR        0x0C4u
+#define AC_INFRA_CG3_STA        0x0C8u
+#define AC_INFRA_RST_SET        0x150u
+#define AC_INFRA_RST_CLR        0x154u
+#define AC_CCIF_CLK_REQUEST     14u
+#define AC_MD_KERNEL_BOOT_UP    0u
+#define AC_MD_INIT_CHK_ID       0x5555FFFFu
+#define AC_MD_PATTERN           0x49434343u
+
+static void
+ac_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb st" ::: "memory");
+}
+
+static void
+ac_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ac_tag_base, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * Android's order (ccci_fsm.c fsm_routine_start, ccci_hif_ccif.c ccif_start/ccci_reset_ccif_hw,
+ * md_sys1_platform.c md_cd_let_md_go), minus the power cycle: LK has powered the modem and its
+ * boot ROM check passed (checked first); no regulator, MTCMOS or clock-mux is changed here.
+ *   1. SMC CCIF_CLK_REQUEST; the six CCIF clock gates opened (infracfg_ao CG1 clr bits 23, 26,
+ *      12, 13; CG3 clr bits 10, 29).
+ *   2. CCIF reset (infracfg_ao +0x150/+0x154 bit 8), both CCIF SRAMs cleared.
+ *   3. SMC MD_POWER_CONFIG / MD_KERNEL_BOOT_UP ("make boot vector take effect").
+ *   4. Wait up to 30 s for the modem's first handshake: D2H_SRAM (bit 15) in AP_CCIF RCHNUM, the
+ *      CCCI header at CHDATA (channel 0, data[1] = MD_INIT_START_BOOT 0, reserved 0x5555FFFF)
+ *      and its feature query behind it (head/tail 0x49434343, 64 feature bytes), acknowledged.
+ * Not yet: the AP's runtime data answer (stage 1b proper), so the modem then waits and times
+ * out; the transmitter is never switched on by a modem that has not finished its handshake and
+ * read its NVRAM.
+ */
+static void
+ac_first_contact(void)
+{
+	uint64_t r[4];
+	vm_offset_t infra = ml_io_map((vm_offset_t)AC_INFRA_PA, PAGE_SIZE);
+	vm_offset_t ap = ml_io_map((vm_offset_t)AC_AP_CCIF_PA, PAGE_SIZE);
+	vm_offset_t md = ml_io_map((vm_offset_t)AC_MD_CCIF_PA, PAGE_SIZE);
+
+	if (!infra || !ap || !md)
+		return;
+	printf("A34 CELL: first contact (a34cell=2): CCIF up, modem let go, waiting for its handshake\n");
+	ac_smc(AC_CCIF_CLK_REQUEST, 0, r);
+	printf("A34 CELL: SMC CCIF_CLK_REQUEST: 0x%llx\n", r[0]);
+	ac_wr32(infra, AC_INFRA_CG1_CLR, (1u << 23) | (1u << 26) | (1u << 12) | (1u << 13));
+	ac_wr32(infra, AC_INFRA_CG3_CLR, (1u << 10) | (1u << 29));
+	uint32_t cg1 = ac_rd32(infra, AC_INFRA_CG1_STA), cg3 = ac_rd32(infra, AC_INFRA_CG3_STA);
+	printf("A34 CELL: CCIF clock gates now CG1 0x%08x CG3 0x%08x (bits 23/26/12/13, 10/29 should be 0)\n",
+	    cg1, cg3);
+	if ((cg1 >> 23 & 1) || (cg1 >> 26 & 1)) {
+		printf("A34 CELL: CCIF clocks still gated: stopping before touching CCIF\n");
+		AC_NOTE("contact=noclk");
+		return;
+	}
+	ac_wr32(infra, AC_INFRA_RST_SET, 1u << 8);
+	ac_wr32(infra, AC_INFRA_RST_CLR, 1u << 8);
+	for (uint32_t o = 0; o < CCIF_SRAM_SIZE; o += 4) {
+		ac_wr32(ap, CCIF_CHDATA + o, 0);
+		ac_wr32(md, CCIF_CHDATA + o, 0);
+	}
+	printf("A34 CELL: CCIF reset, SRAM cleared (AP RCHNUM 0x%08x BUSY 0x%08x)\n",
+	    ac_rd32(ap, CCIF_RCHNUM), ac_rd32(ap, CCIF_BUSY));
+
+	ac_smc(AC_MD_POWER_CONFIG, AC_MD_KERNEL_BOOT_UP, r);
+	printf("A34 CELL: SMC MD_KERNEL_BOOT_UP: ret %llu boot_status_0 %llu boot_status_1 %llu boot_slave %llu\n",
+	    r[0], r[1], r[2], r[3]);
+
+	uint32_t seen = 0;
+	for (int i = 0; i < 3000; i++) {
+		uint32_t ch = ac_rd32(ap, CCIF_RCHNUM);
+		if (ch & ~seen) {
+			printf("A34 CELL: CCIF from the modem: RCHNUM 0x%08x after %d ms\n", ch, i * 10);
+			seen |= ch;
+		}
+		if (ch & (1u << CCIF_D2H_SRAM)) {
+			uint32_t h[4], f[56];
+			for (int k = 0; k < 4; k++)
+				h[k] = ac_rd32(ap, CCIF_CHDATA + 4u * (uint32_t)k);
+			for (int k = 0; k < 56; k++)
+				f[k] = ac_rd32(ap, CCIF_CHDATA + 16u + 4u * (uint32_t)k);
+			ac_wr32(ap, CCIF_ACK, ch & 0xFFFFu);
+			bool hs1 = h[1] == 0 && (h[2] & 0xFFFF) == 0 && h[3] == AC_MD_INIT_CHK_ID;
+			printf("A34 CELL: %s: header %08x %08x %08x %08x; feature query head 0x%08x tail 0x%08x\n",
+			    hs1 ? "HS1 -- the modem is running and asks for the AP's features" : "SRAM message",
+			    h[0], h[1], h[2], h[3], f[0], f[17]);
+			char hex[64 * 2 + 1];
+			const uint8_t *fb = (const uint8_t *)&f[1];
+			for (int k = 0; k < 64; k++)
+				snprintf(hex + 2 * k, 3, "%02x", fb[k]);
+			printf("A34 CELL: modem feature set: %s\n", hex);
+			AC_NOTE("contact=%s", hs1 ? "hs1" : "sram");
+			ac_smc(AC_MD_POWER_CONFIG, AC_MD_BOOT_STATUS, r);
+			printf("A34 CELL: MD boot status now 0x%llx 0x%llx\n", r[1], r[2]);
+			return;
+		}
+		if (ch)
+			ac_wr32(ap, CCIF_ACK, ch & 0xFFFFu);
+		ac_sleep_ms(10);
+	}
+	ac_smc(AC_MD_POWER_CONFIG, AC_MD_BOOT_STATUS, r);
+	printf("A34 CELL: no handshake in 30 s (RCHNUM seen 0x%08x); MD boot status 0x%llx 0x%llx\n",
+	    seen, r[1], r[2]);
+	AC_NOTE("contact=none");
+}
+
+/* ---- 5. the md1img partition ---- */
+
+#define MD_MAGIC        0x58881688u
+#define MD_EXT_MAGIC    0x58891689u
+
+static void
+ac_md1img(void)
+{
+	uint8_t h[512];
+	uint64_t part = 0, off = 0;
+	int nsec = 0;
+	char platform[20] = "", build[70] = "", ver[70] = "";
+	const uint32_t tsz = 4096;
+	uint8_t *t = kalloc_data(tsz, Z_WAITOK);
+
+	if (!t)
+		return;
+	if (sweet_ufs_read_part("md1img", 0, h, sizeof(h), &part) != 0) {
+		printf("A34 CELL: md1img: cannot read\n");
+		AC_NOTE("md1img=unreadable");
+		kfree_data(t, tsz);
+		return;
+	}
+	for (int i = 0; i < 48; i++) {
+		if (i > 0 && sweet_ufs_read_part("md1img", off, h, sizeof(h), NULL) != 0)
+			break;
+		if (le32(h) != MD_MAGIC)
+			break;
+		uint32_t dsize = le32(h + 4);
+		char name[36];
+		ac_printable(name, sizeof(name), h + 8, 32);
+		uint32_t hsz = 512, align = 16, last = 0;
+		if (le32(h + 48) == MD_EXT_MAGIC) {
+			hsz = le32(h + 52);
+			last = le32(h + 64);
+			align = le32(h + 68);
+			if (hsz < 64 || hsz > 4096)
+				hsz = 512;
+			if (align == 0 || align > 4096)
+				align = 16;
+		}
+		nsec++;
+		printf("A34 CELL: md1img 0x%08llx %-24s %u bytes\n", off, name, dsize);
+		if (strcmp(name, "md1rom") == 0 && dsize >= tsz) {
+			/* CHECK_HEADER sits at the end of md1rom's data (v6: platform at +24,
+			 * build time at +40, build version at +104). */
+			uint64_t tail = off + hsz + dsize - tsz;
+			if (sweet_ufs_read_part("md1img", tail, t, tsz, NULL) == 0) {
+				for (int k = (int)tsz - 168; k >= 0; k -= 4) {
+					if (memcmp(t + k, "CHECK_HEADER", 12) == 0) {
+						ac_printable(platform, sizeof(platform), t + k + 24, 16);
+						ac_printable(build, sizeof(build), t + k + 40, 64);
+						ac_printable(ver, sizeof(ver), t + k + 104, 64);
+						printf("A34 CELL: md1rom CHECK_HEADER v%u: platform %s, built %s, %s\n",
+						    le32(t + k + 12), platform, build, ver);
+						break;
+					}
+				}
+			}
+		}
+		off += (uint64_t)hsz + dsize;
+		off = (off + align - 1) / align * align;
+		if (last || off + 512 > part)
+			break;
+	}
+	kfree_data(t, tsz);
+	printf("A34 CELL: md1img: %d sections, partition %llu MiB\n", nsec, part >> 20);
+	AC_NOTE("md1img=%dsec,%s", nsec, platform[0] ? platform : "?");
+}
+
+static void
+ac_partitions(void)
+{
+	static const char *const names[] = {
+		"md1img", "md_udc", "nvcfg", "nvdata", "nvram", "protect1", "protect2", "proinfo",
+	};
+
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		uint64_t first = 0, n = 0;
+		if (sweet_ufs_part_bounds(names[i], &first, &n) == 0)
+			printf("A34 CELL: partition %-9s first block 0x%llx, %llu KiB (bounds only; never "
+			    "written, contents not read)\n", names[i], first, n * 4);
+		else
+			printf("A34 CELL: partition %-9s not found\n", names[i]);
+	}
+}
+
+static void
+ac_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	uint64_t deadline;
+	clock_interval_to_deadline(3, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&ac_mode, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+	printf("A34 CELL: stage 0 probe (a34cell=%u): read only, nothing is written\n", ac_mode);
+	strlcpy(ac_state, "stage0", sizeof(ac_state));
+	ac_lk_fdt();
+	bool on = ac_md1_power();
+	ac_ccif_clocks();
+	bool brom = false;
+	if (on) {
+		ac_boot_status();
+		brom = ac_brom_check();
+	}
+	else
+		printf("A34 CELL: MD1 is off: no boot status query\n");
+	ac_partitions();
+	ac_md1img();
+	if (ac_mode >= 2) {
+		if (ac_lk_md == 1 && on && brom)
+			ac_first_contact();
+		else
+			printf("A34 CELL: a34cell=2 needs a modem LK loaded (%d), MD1 on (%d) and BROM PASS (%d): "
+			    "not started\n", ac_lk_md, on, brom);
+	}
+	printf("A34 CELL: summary: %s\n", ac_state);
+	if (ac_lk_md != 1)
+		printf("A34 CELL: the modem cannot be started from this boot: LK loads and verifies "
+		    "md1img only on a normal (non-recovery) boot (docs/cellular-plan.md, stage 1)\n");
+}
+
+void
+a34_cell_init(void)
+{
+	thread_t t;
+
+	(void)PE_parse_boot_argn("a34cell", &ac_mode, (int)sizeof(ac_mode));
+	if (ac_mode == 0)
+		return;
+	if (kernel_thread_start(ac_thread, NULL, &t) == KERN_SUCCESS)
+		thread_deallocate(t);
+}
+#else
+void a34_cell_init(void);
+void
+a34_cell_init(void)
+{
+}
+#endif
