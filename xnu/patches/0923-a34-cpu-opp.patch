+/* The clusters, in the CSRAM's order (mt_cpu_dvfs_id: LL, L, CCI). */
+#define CK_CLUSTERS             3
+
+static const struct {
+	const char *name;
+	uint32_t con0, div;
+} ck_cluster[CK_CLUSTERS] = {
+	{ "LL (cpu0-5, Cortex-A55)", ARMPLL_LL_CON0, CKDIV1_LL },
+	{ "L (cpu6-7, Cortex-A78)", ARMPLL_BL_CON0, CKDIV1_L },
+	{ "CCI", CCIPLL_CON0, CKDIV1_CCI },
+};
+
+/* A cluster's clock from its PLL and divider (get_cur_phy_freq()), kHz; 0: not from its PLL or 26 MHz. */
+static uint32_t
+ck_cpu_khz(unsigned i, uint32_t *con0, uint32_t *con1, uint32_t *div)
+{
+	uint32_t mux, sel, posdiv, vco;
+
+	*con0 = ruby_rd32(ck_apmixed, ck_cluster[i].con0);
+	*con1 = ruby_rd32(ck_apmixed, ck_cluster[i].con0 + 4u);
+	*div = ruby_rd32(ck_mcucfg, ck_cluster[i].div);
+	mux = (*div >> 9) & 3u;
+	sel = (*div >> 17) & 0x1fu;
+	posdiv = (*con1 >> CON1_POSDIV_SHIFT) & 7u;
+	vco = (uint32_t)((((uint64_t)(*con1 & 0x3fffffu) * 26u) >> 14) * 1000u);   /* kHz, as _cpu_freq_calc() */
+	return mux == 1 ? ck_cpu_divide(vco >> (posdiv > 4 ? 4 : posdiv), sel) : (mux == 0 ? 26000 : 0);
+}
