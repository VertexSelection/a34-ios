 {
@@ -988,6 +1136,8 @@ a34_clocks_init(void)
 		printf("A34 CLOCKS: nothing read or changed (a34clocks=0)\n");
 		return;
 	}
+	(void)PE_parse_boot_argn("a34bat", &ck_bat_on, (int)sizeof(ck_bat_on));   /* A34 (0929), before ck_pwrap is set */
+	(void)PE_parse_boot_argn("a34batguard", &ck_bat_guard, (int)sizeof(ck_bat_guard));
 	ck_top = ml_io_map(CK_TOP_PA, CK_PAGE);
 	ck_spm = ml_io_map(CK_SPM_PA, CK_PAGE);
 	ck_apmixed = ml_io_map(CK_APMIXED_PA, CK_PAGE);
@@ -1018,7 +1168,12 @@ a34_clocks_init(void)
 		printf("A34 CLOCKS: a34cpufreq=%u does nothing: a34cpuopp=<L MHz>,<LL MHz> asks MCUPM's firmware, "
 		    "never the PLLs or Vproc directly\n", cpu);
 	}
-	ck_cpu_requests();
+	ck_bat_boot();                  /* A34 (0929) */
+	if (ck_bat_low_boot) {
+		ck_gpu_want_mhz = 0;    /* (a34_clocks_gpu_wanted(): no) */
+	} else {
+		ck_cpu_requests();
+	}
 	if (ck_gpu_want_mhz != 0) {
 		printf("A34 CLOCKS: a34gpumhz=%u: the GPU's clock is raised before programs get the GPU (a34_mali.c)\n",
 		    ck_gpu_want_mhz);
