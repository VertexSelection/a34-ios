+/*
+ * A radio more, CONNSYS already up (cs_mtx held): consys_hw_pwr_on() with curr_status != 0 --
+ * conn_infra woken (its TOP wake-up, version polled), the radio's bit in sysram, the sleep
+ * controller's A-die table and the A-die clock buffer for the radios now on, conn_infra let sleep
+ * again; Bluetooth's raise when the radio is Bluetooth; then the radio's rails.
+ */
+static int
+cs_more_on(uint32_t radio, uint32_t next)
+{
+	bool bt_only = next == CS_RADIO_BIT(A34_CONNSYS_BT);
+	uint32_t x1 = 0, x2 = 0, v = 0;
+
+	wr(cs_hc, 0x1a0, 1);                                                    /* consys_conninfra_wakeup */
+	for (int i = 0; i < 10 && (v = rd(cs_cfg, 0x000)) != 0x02060002u; i++) {
+		delay(1000);
+	}
+	if (v != 0x02060002u) {
+		printf("A34 CONNSYS: %s: conn_infra did not wake (version %#x)\n", cs_radio_name(radio), v);
+		wr(cs_hc, 0x1a0, 0);
+		return EIO;
+	}
+	cs_ph11_status(radio);
+	cs_ph7_sleep_ctl(bt_only);
+	if (radio == A34_CONNSYS_BT) {
+		cs_ph12_raise();
+	}
+	cs_adie_clock_buffer(bt_only, &x1, &x2);
+	printf("A34 CONNSYS: %s added: radio status %#x, sleep table ON3 %#x, XTAL %#x %#x (was)\n", cs_radio_name(radio),
+	    rd(cs_sysram, 0x2834), rd(cs_slp, 0x038), x1, x2);
+	wr(cs_hc, 0x1a0, 0);                                                    /* consys_conninfra_sleep */
+	cs_radio_rails(radio);
+	return 0;
+}
+
+/*
+ * CONNSYS up for `radio` (A34_CONNSYS_BT or A34_CONNSYS_WIFI): 0, or an errno. Counted: each
+ * successful get wants one put. A first power-on that failed is not tried again this boot (EIO).
+ */
+int
+a34_connsys_get(uint32_t radio)
+{
+	int err = 0;
+
+	if (radio != A34_CONNSYS_BT && radio != A34_CONNSYS_WIFI) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&cs_mtx);
+	if (cs_radios & CS_RADIO_BIT(radio)) {
+		cs_users[radio]++;
+	} else if (!cs_up) {
+		err = cs_tried ? EIO : cs_first_on(radio);
+	} else {
+		err = cs_more_on(radio, cs_radios | CS_RADIO_BIT(radio));
+	}
+	if (err == 0 && !(cs_radios & CS_RADIO_BIT(radio))) {
+		cs_radios |= CS_RADIO_BIT(radio);
+		cs_users[radio] = 1;
+	}
+	lck_mtx_unlock(&cs_mtx);
+	return err;
+}
+
+/* One get given back. CONNSYS and the radio's rails stay on (no power-off yet); the count says who still uses it. */
+void
+a34_connsys_put(uint32_t radio)
+{
+	if (radio != A34_CONNSYS_BT && radio != A34_CONNSYS_WIFI) {
+		return;
+	}
+	lck_mtx_lock(&cs_mtx);
+	if (cs_users[radio] > 0 && --cs_users[radio] == 0) {
+		printf("A34 CONNSYS: %s let go of CONNSYS (it stays powered: no power-off before a reboot)\n",
+		    cs_radio_name(radio));
+	}
+	lck_mtx_unlock(&cs_mtx);
+}
+
+/* Bluetooth's entry (a34_bt.c, 0939) */
+int
+a34_connsys_on(void)
+{
+	return a34_connsys_get(A34_CONNSYS_BT);
+}
+
+/* the MT6635's chip id as read at power-on (0 before) */
+uint32_t
+a34_connsys_adie_id(void)
+{
+	return cs_adie_id;
+}
