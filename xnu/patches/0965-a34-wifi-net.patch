diff --git a/bsd/dev/a34_wifi_net.c b/bsd/dev/a34_wifi_net.c
new file mode 100644
index 0000000..13552fd
--- /dev/null
+++ b/bsd/dev/a34_wifi_net.c
@@ -0,0 +1,247 @@
+/*
+ * A34 (0965): Wi-Fi's network interface -- an Ethernet interface as far as the rest of the
+ * kernel and iOS's user space can tell, whose frames a34_wifi.c carries over the MT6877's
+ * WFDMA data rings once step 8 has joined a network.
+ *
+ * Made with the kernel's own interface KPI (as bsd/net/if_fake.c makes "feth"): family
+ * Ethernet, subfamily Wi-Fi, the stock Ethernet framing and demultiplexing, one function the
+ * stack hands a frame to send (a34w_net_output) and one call that hands an arrived frame to the
+ * stack (a34_wifi_net_input). No IONetworkingFamily object behind it: Apple80211/wifid are
+ * milestone 4's (docs/wifi-plan.md). An address comes from DHCP in user space (a34wifi dhcp).
+ *
+ * The shape -- legacy model, no Skywalk nexus, the SIOCGIFMEDIA answer, the link events -- is
+ * HakiOS's bsd/dev/redwood_net.c (github.com/oosexgang/hakios-xnu-kernel, branch mtk, APSL 2.0),
+ * cut down to what one radio needs.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#include "a34_wifi_net.h"
+
+#define A34N_FRAME_MOST                 (ETHER_HDR_LEN + ETHERMTU)
+
+static LCK_GRP_DECLARE(a34n_grp, "a34_wifi_net");
+static LCK_MTX_DECLARE(a34n_out_mtx, &a34n_grp);
+static ifnet_t a34n_ifp;
+static bool a34n_link_up;
+static a34_wifi_net_tx_t a34n_tx;
+static char a34n_name[IFNAMSIZ];
+
+static struct {
+	uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+} a34n_count;
+
+/* the stack has a frame to send: an mbuf chain from the Ethernet header on */
+static errno_t
+a34n_output(ifnet_t ifp, mbuf_t packet)
+{
+	static uint8_t frame[A34N_FRAME_MOST];
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (a34n_link_up && length >= ETHER_HDR_LEN && length <= sizeof(frame)) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		lck_mtx_lock(&a34n_out_mtx);    /* (legacy output: any thread may call it) */
+		if (mbuf_copydata(packet, 0, length, frame) == 0) {
+			sent = a34n_tx(frame, (uint32_t)length);
+		}
+		lck_mtx_unlock(&a34n_out_mtx);
+	}
+	if (sent) {
+		a34n_count.sent++;
+		a34n_count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		a34n_count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+void
+a34_wifi_net_input(const uint8_t *frame, uint32_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	if (a34n_ifp == NULL || length < ETHER_HDR_LEN || length > A34N_FRAME_MOST ||
+	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		a34n_count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		a34n_count.dropped_in++;
+		return;
+	}
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, a34n_ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(a34n_ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	a34n_count.received++;
+	a34n_count.received_bytes += length;
+	ifnet_input(a34n_ifp, packet, &stats);
+}
+
+static errno_t
+a34n_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	const int media[] = { IFM_IEEE80211 | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (a34n_link_up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* every multicast frame the radio hears comes up anyway */
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* configd and the like learn of the link from these */
+static void
+a34n_link_event(uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(a34n_ifp);
+	about->if_unit = ifnet_unit(a34n_ifp);
+	strlcpy(about->if_name, ifnet_name(a34n_ifp), IFNAMSIZ);
+	ifnet_event(a34n_ifp, header);
+}
+
+void
+a34_wifi_net_link(bool up)
+{
+	if (a34n_ifp == NULL || up == a34n_link_up) {
+		return;
+	}
+	a34n_link_up = up;
+	a34n_link_event(up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+const char *
+a34_wifi_net_name(void)
+{
+	return a34n_name;
+}
+
+/* the interface, once: "en" with the first free unit; 0 or an errno */
+int
+a34_wifi_net_attach(const uint8_t address[6], a34_wifi_net_tx_t tx)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "a34-wifi",
+		.uniqueid_len = 8,
+		.name = "en",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = IFNET_SUBFAMILY_WIFI,
+		.type = IFT_ETHER,
+		.output = a34n_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = a34n_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	ifnet_t ifp = NULL;
+	errno_t error = EEXIST;
+
+	if (a34n_ifp != NULL) {
+		return 0;
+	}
+	a34n_tx = tx;
+	/* the first unit of "en" nothing has taken yet (dlil_if_acquire: EBUSY for a name in use) */
+	for (uint32_t unit = 0; unit < 8u && (error == EEXIST || error == EBUSY); unit++) {
+		init.unit = unit;
+		error = ifnet_allocate_extended(&init, &ifp);
+	}
+	if (error != 0) {
+		return error;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 54 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		ifnet_release(ifp);
+		return error;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	snprintf(a34n_name, sizeof(a34n_name), "%s%u", ifnet_name(ifp), ifnet_unit(ifp));
+	a34n_ifp = ifp;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/a34_wifi_net.h b/bsd/dev/a34_wifi_net.h
