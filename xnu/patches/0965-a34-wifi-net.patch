@@ -0,0 +1,18 @@
+/*
+ * A34 (0965): Wi-Fi's network interface (a34_wifi_net.c), as a34_wifi.c sees it.
+ */
+#ifndef _A34_WIFI_NET_H_
+#define _A34_WIFI_NET_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* sends one Ethernet frame (header and payload, no FCS); false if it could not */
+typedef bool (*a34_wifi_net_tx_t)(const uint8_t *frame, uint32_t length);
+
+int a34_wifi_net_attach(const uint8_t address[6], a34_wifi_net_tx_t tx);
+void a34_wifi_net_input(const uint8_t *frame, uint32_t length);
+void a34_wifi_net_link(bool up);
+const char *a34_wifi_net_name(void);
+
+#endif
