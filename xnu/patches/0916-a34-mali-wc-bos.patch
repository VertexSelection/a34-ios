 /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
+/*
+ * A34 (0916): a buffer's pages as programs map them, write-combined, as
+ * Linux panfrost maps every buffer (Mesa 26.3 at driver 1.5 takes every
+ * mapping for write-combined and does no cache maintenance of its own): no
+ * cache upkeep around jobs for them at all.
+ *
+ * The pages are a physically contiguous IOBufferMemoryDescriptor of the
+ * kernel's (no cache mode: its own VM object, whose attributes nobody
+ * changes). This describes the same pages as physical memory with the
+ * write-combine cache mode of its own (kIOMemoryBufferCacheMask): mapped,
+ * IOKit makes a device pager for it and the VM enters each page
+ * write-combined into the program's pmap, per mapping (pmap_enter with the
+ * object's WIMG), without vm_object_change_wimg_mode() or a cache flush by
+ * physical address -- the path that panicked. The panel's surface is mapped
+ * through the same path (SweetFramebuffer). A program's cache-mode request
+ * cannot turn it cacheable: the default mode of a physical range is the
+ * descriptor's own.
+ *
+ * The kernel's mappings of those pages stay cacheable and are not used
+ * after the buffer was zeroed and cleaned+invalidated in createBo(): no
+ * dirty line of them can exist, so nothing can be written back over what a
+ * program or the GPU wrote; lines the CPU may fetch ahead through them are
+ * clean, the GPU does not look at the CPU's caches, and the program reads
+ * and writes past them, write-combined -- arm64 Linux keeps the same
+ * cacheable linear alias of its non-coherent write-combined DMA buffers.
+ *
+ * The pages live as long as this does (it holds the buffer): a program's
+ * mapping holds it, so they are not freed under a mapping that outlives
+ * GEM_CLOSE. (In a DEVELOPMENT kernel IOKit reports each mapping of
+ * managed pages through a physical descriptor once, with a backtrace.)
+ */
+class A34MaliWCMemory : public IOGeneralMemoryDescriptor
+{
+	OSDeclareDefaultStructors(A34MaliWCMemory);
+
+	IOBufferMemoryDescriptor *fBacking;
+
+public:
+	static A34MaliWCMemory *withBuffer(IOBufferMemoryDescriptor *backing);
+	void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(A34MaliWCMemory, IOGeneralMemoryDescriptor);
+
+/* The write-combined view of a physically contiguous buffer, or NULL (not contiguous, no memory). */
+A34MaliWCMemory *
+A34MaliWCMemory::withBuffer(IOBufferMemoryDescriptor *backing)
+{
+	A34MaliWCMemory *me;
+	IOAddressRange range;
+	IOByteCount contiguous = 0;
+	addr64_t pa = backing->getPhysicalSegment(0, &contiguous, kIOMemoryMapperNone);
+
+	if (pa == 0 || (pa & PAGE_MASK) != 0 || contiguous < backing->getLength()) {
+		return NULL;
+	}
+	range.address = (IOVirtualAddress)pa;
+	range.length = backing->getLength();
+	me = OSTypeAlloc(A34MaliWCMemory);
+	if (me == NULL) {
+		return NULL;
+	}
+	if (!me->initWithOptions(&range, 1, 0, TASK_NULL, kIOMemoryTypePhysical64 | kIODirectionInOut | kIOMemoryMapperNone |
+	    ((IOOptionBits)kIOWriteCombineCache << kIOMemoryBufferCacheShift), NULL)) {
+		me->release();
+		return NULL;
+	}
+	backing->retain();
+	me->fBacking = backing;
+	return me;
+}
+
+/* No mapping of it is left (each held it): the pages may go. */
+void
+A34MaliWCMemory::free(void)
+{
+	OSSafeReleaseNULL(fBacking);
+	IOGeneralMemoryDescriptor::free();
+}
