 	if (!a34w_ram_code_load()) {
@@ -3402,6 +3517,8 @@ SYSCTL_PROC(_kern_a34wifi, OID_AUTO, rescan, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_
     a34w_sysctl_rescan, "I", "write 1: scan again (after step 7)");
 SYSCTL_INT(_kern_a34wifi, OID_AUTO, busy, CTLFLAG_RD | CTLFLAG_LOCKED, &a34w_busy, 0, "working");
 SYSCTL_INT(_kern_a34wifi, OID_AUTO, failed, CTLFLAG_RD | CTLFLAG_LOCKED, &a34w_failed, 0, "the step that failed");
+SYSCTL_INT(_kern_a34wifi, OID_AUTO, phyaction, CTLFLAG_RW | CTLFLAG_LOCKED, &a34w_phyaction, 0,
+    "(0966) 1: PHY_ACTION before the RAM code (set before step 5)");
 
 /* (0964) 1 while joined to the network of /a34/wifi/network */
 static int
@@ -3485,6 +3602,7 @@ a34_wifi_init(void)
 {
 	int step = 0;
 
+	(void)PE_parse_boot_argn("a34wifiphy", &a34w_phyaction, sizeof(a34w_phyaction));       /* (0966) */
