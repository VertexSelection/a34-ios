+/*
+ * (0966) PHY_ACTION, opt-in (boot-arg a34wifiphy=1, or sysctl kern.a34wifi.phyaction=1 before step
+ * 5): what Android's wlanPreCal sends when it has no calibration of its own to give back
+ * (pre_cal.c:576-645): INIT command 8 {magic 0x556789aa, 3 tags, version 1, length} with CAL
+ * {force calibration}, NVRAM (tags 7-9 of the vendor's default image /vendor/firmware/WIFI, as
+ * wlanGetEpaElnaFromNvram cuts them: with their 3-byte headers, padded to 4, 512 at most -- never
+ * the phone's own nvdata copy) and COM_FEM (104 zero bytes: connfem never binds on the MT6877, so
+ * Android's is all zeros too), before the RAM code; INIT event 5 answers it. Off by default:
+ * steps 1-7 ran without it on the phone; it is for when the AP never acknowledges our frames.
+ */
+#define PHY_ACTION_MAGIC                0x556789aau
+#define PHY_ACTION_NVRAM_MOST           512u
+#define A34W_NVRAM_FILE                 "WIFI"
+
+static int a34w_phyaction;
+
+static void
+a34w_le32_put(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+/* the NVRAM tag's body out of an NVRAM image: from tag 7 up to tag 10, then tag 21 if any; its length */
+static uint32_t
+a34w_nvram_body(const uint8_t *d, uint32_t size, uint8_t *out)
+{
+	uint32_t at = 256u, total, start = 0, n = 0;
+
+	if (size < 262u) {
+		return 0;
+	}
+	total = (uint32_t)(d[at + 4u] | d[at + 5u] << 8) + 256u;        /* the control tag says the tags' length */
+	if (total > size) {
+		total = size;
+	}
+	while (at + 3u <= total) {
+		uint32_t tag = d[at], length = (uint32_t)(d[at + 1u] | d[at + 2u] << 8);
+
+		if ((tag == 0 && length == 0) || at + 3u + length > size) {
+			break;
+		}
+		if (tag == 7u) {
+			start = at;
+		} else if (tag == 10u && start != 0) {
+			n = at - start > PHY_ACTION_NVRAM_MOST ? PHY_ACTION_NVRAM_MOST : at - start;
+			memcpy(out, d + start, n);
+		} else if (tag == 21u && n != 0 && n + 3u + length <= PHY_ACTION_NVRAM_MOST) {
+			memcpy(out + n, d + at, 3u + length);
+			n += 3u + length;
+		}
+		at += 3u + length;
+	}
+	while ((n & 3u) != 0) {
+		out[n++] = 0;
+	}
+	return n;
+}
+
+static bool
+a34w_phy_action(void)
+{
+	static uint8_t message[8u + 8u + 4u + PHY_ACTION_NVRAM_MOST + 4u + 104u];
+	uint8_t answer[64], eid = 0, seq;
+	uint32_t size = 0, nvram, n = 8;
+	uint8_t *image = a34w_file(A34W_NVRAM_FILE, 512u, "tools/wifi-fw.sh copies the vendor's default", &size);
+	const uint8_t *r;
+	int got;
+
+	if (image == NULL) {
+		a34w_say("step 5: PHY_ACTION NOT SENT (no NVRAM image)");
+		return false;
+	}
+	bzero(message, sizeof(message));
+	message[n] = 1;                                 /* CAL: force calibration */
+	message[n + 2u] = 4;
+	message[n + 4u] = 0x01;
+	n += 8u;
+	nvram = a34w_nvram_body(image, size, message + n + 4u);    /* NVRAM */
+	message[n + 2u] = (uint8_t)nvram;
+	message[n + 3u] = (uint8_t)(nvram >> 8);
+	n += 4u + nvram;
+	message[n] = 2;                                 /* COM_FEM: none */
+	message[n + 2u] = 104;
+	n += 4u + 104u;
+	a34w_le32_put(message, PHY_ACTION_MAGIC);
+	message[4] = 3;                                 /* tags */
+	message[5] = 1;                                 /* version */
+	message[6] = (uint8_t)(n - 8u);
+	message[7] = (uint8_t)((n - 8u) >> 8);
+	kfree_data(image, (vm_size_t)size);
+	seq = a34w_init_cmd(INIT_CMD_ID_PHY_ACTION, message, n);
+	got = seq != 0 ? a34w_init_event(seq, &eid, answer, sizeof(answer), 3000) : -1;
+	if (got < 28 || eid != INIT_EVENT_ID_PHY_ACTION || a34w_le32(answer) != PHY_ACTION_MAGIC) {
+		a34w_say("step 5: PHY_ACTION (%u bytes, NVRAM part %u) %s (event 0x%02x, %d bytes)", n, nvram,
+		    seq == 0 ? "NOT SENT" : "NOT ANSWERED", eid, got);
+		return false;
+	}
+	r = answer + 12;                                /* after the header and the tag's own 4 bytes */
+	a34w_say("step 5: PHY_ACTION (force calibration; the default NVRAM's tags 7-9, %u bytes; no FEM): event 0x%02x "
+	    "status %u (0x81/0 calibrated, 0x82/2 recalibrated), calibration data %u bytes at 0x%08x, temperature %u",
+	    nvram, r[0], r[1], a34w_le32(r + 8), a34w_le32(r + 4), a34w_le32(r + 12));
+	return (r[0] == 0x81u && r[1] == 0) || (r[0] == 0x82u && r[1] == 2u);
+}
+
 /* the RAM code's regions (fw_dl.c: wlanImageSectionDownloadStage with dynamic memory mapping) */
