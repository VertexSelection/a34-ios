@@ -355,6 +355,7 @@ extern char *proc_name_address(struct proc *p);
 void a34_big_init(void);
 void a34_big_report(void);
 static processor_t a34_big_choose(thread_t thread, processor_t processor);
+bool a34_thread_bind_cpu(int cpu);      /* A34 (0928): iokit/Kernel/arm/A34Mali.cpp */
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
 uint64_t        sched_one_second_interval;
@@ -9235,4 +9236,29 @@ a34_big_report(void)
 	    (unsigned long long)(cpu_ns[6] / NSEC_PER_MSEC), (unsigned long long)(cpu_ns[7] / NSEC_PER_MSEC),
 	    (unsigned long long)busiest_tid, busiest_pri, (unsigned long long)(ns / NSEC_PER_MSEC), busiest_cpu);
 }
+
+/*
+ * A34 (0928): the calling thread bound to processor `cpu` (thread_bind(),
+ * taking effect at the block here). For iokit/Kernel/arm/A34Mali.cpp's job
+ * thread, which spins while the GPU runs a job: unbound, at kernel priority
+ * on a Cortex-A78, it would keep that core from the UI threads a34big sends
+ * there (a34_big_choose() takes a big core only from a lower priority).
+ * False: no such processor, or it is not available; the thread stays unbound.
+ */
+bool
+a34_thread_bind_cpu(int cpu)
+{
+	processor_t processor;
+
+	if (cpu < 0 || cpu >= MAX_SCHED_CPUS || cpu > ml_get_max_cpu_number()) {
+		return false;
+	}
+	processor = processor_array[cpu];
+	if (processor == PROCESSOR_NULL || processor->state < PROCESSOR_IDLE) {
+		return false;
+	}
+	(void)thread_bind(processor);
+	thread_block(THREAD_CONTINUE_NULL);
+	return current_processor() == processor;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
