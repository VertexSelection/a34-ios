+	a34w_result_count = 0;
+	for (uint32_t i = 0; i < a34w_heard_count; i++) {
+		const struct a34w_bss *b = &a34w_heard[i];
+		struct a34_sta_bss *r = &a34w_results[a34w_result_count++];
+
+		bzero(r, sizeof(*r));
+		memcpy(r->bssid, b->bssid, 6);
+		memcpy(r->ssid, b->ssid, b->ssid_length);
+		r->ssid_length = b->ssid_length;
+		r->channel = b->channel;
+		r->rssi = b->rssi;
+		r->beacon_interval = b->beacon_interval;
+		r->capability = b->capability;
+		r->elements_length = b->ies_length;
+		memcpy(r->elements, b->ies, b->ies_length);
+		r->age_ms = (uint32_t)(a34w_ms() - b->heard_at);
+	}
+	lck_mtx_unlock(&a34w_sta_mtx);
+}
+
+bool
+a34_sta_heard(unsigned index, struct a34_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&a34w_sta_mtx);
+	there = index < a34w_result_count;
+	if (there) {
+		*bss = a34w_results[index];
+	}
+	lck_mtx_unlock(&a34w_sta_mtx);
+	return there;
+}
+
+bool
+a34_sta_switched_off(void)
+{
+	return a34w_sta_off;
+}
+
+bool
+a34_sta_powered(void)
+{
+	return a34w_done >= 7 && !a34w_sta_off;
+}
+
+bool
+a34_sta_address(uint8_t address[6])
+{
+	if (a34w_done < 6) {
+		return false;
+	}
+	memcpy(address, a34w_mac, 6);
 	return true;
 }
 
+void
+a34_sta_state(struct a34_sta_state *state)
+{
+	bzero(state, sizeof(*state));
+	state->phase = a34w_sta_off || a34w_done < 7 ? A34_STA_OFF : a34w_joined ? A34_STA_JOINED : a34w_sta_phase_now;
+	if (a34w_joined) {
+		memcpy(state->bss.ssid, a34w_net.ssid, a34w_net.ssid_length);
+		state->bss.ssid_length = (uint8_t)a34w_net.ssid_length;
+		memcpy(state->bss.bssid, a34w_target.bssid, 6);
+		state->bss.channel = a34w_target.channel;
+		state->bss.rssi = a34w_target.rssi;
+		state->bss.beacon_interval = a34w_target.beacon_interval;
+		state->bss.capability = a34w_target.capability;
+	}
+}
+
+static int
+a34w_sta_queue(int *flag)
+{
+	lck_mtx_lock(&a34w_run_mtx);
+	if (a34w_failed != 0) {
+		lck_mtx_unlock(&a34w_run_mtx);
+		return EIO;
+	}
+	*flag = 1;
+	thread_wakeup((event_t)&a34w_chan);
+	lck_mtx_unlock(&a34w_run_mtx);
+	return 0;
+}
+
+int
+a34_sta_ask_scan(const uint8_t *ssid, uint32_t ssid_length)
+{
+	(void)ssid;                             /* (passive scans only: a hidden network is not asked for) */
+	(void)ssid_length;
+	return a34_sta_powered() ? a34w_sta_queue(&a34w_sta_scan) : ENETDOWN;
+}
+
+int
+a34_sta_ask_join(const struct a34_sta_join *what)
+{
+	if (!a34_sta_powered()) {
+		return ENETDOWN;
+	}
+	lck_mtx_lock(&a34w_run_mtx);
+	a34w_sta_join_what = *what;
+	lck_mtx_unlock(&a34w_run_mtx);
+	return a34w_sta_queue(&a34w_sta_join_asked);
+}
+
+int
+a34_sta_ask_leave(void)
+{
+	return a34w_sta_queue(&a34w_sta_leave);
+}
+
+int
+a34_sta_ask_power(bool on)
+{
+	if (!on) {
+		a34w_sta_off = true;
+		a34_apple80211_event(A34_STA_POWER, 0);
+		return a34w_joined ? a34w_sta_queue(&a34w_sta_leave) : 0;
+	}
+	a34w_sta_off = false;
+	if (a34w_done >= 7) {
+		a34_apple80211_event(A34_STA_POWER, 1);
+		return 0;
+	}
+	a34w_sta_power_wait = true;
+	return a34w_ask(7);                     /* the firmware up and a first scan; POWER when that is done */
+}
+
+/* (the thread) what iOS asked for, one after the other: leave, join, scan */
+static void
+a34w_sta_do(bool leave, const struct a34_sta_join *join, bool scan)
+{
+	if (leave && a34w_joined) {
+		a34w_say("iOS asks us to leave the network");
+		a34w_auto_rejoin_at = 0;
+		a34w_unjoin(true);
+	}
+	if (join != NULL) {
+		char ssid[33];
+		bool ok;
+
+		if (a34w_joined) {
+			a34w_unjoin(true);
+		}
+		bzero(&a34w_net, sizeof(a34w_net));
+		memcpy(a34w_net.ssid, join->ssid, join->ssid_length);
+		a34w_net.ssid_length = join->ssid_length;
+		a34w_net.bssid_given = (join->bssid[0] | join->bssid[1] | join->bssid[2] | join->bssid[3] | join->bssid[4] |
+		    join->bssid[5]) != 0;
+		memcpy(a34w_net.bssid, join->bssid, 6);
+		a34w_net.psk_given = join->security == A34_STA_WPA2_PSK;
+		if (a34w_net.psk_given && join->passphrase_length != 0) {
+			a34_wpa_pmk(join->passphrase, join->passphrase_length, a34w_net.ssid, a34w_net.ssid_length, a34w_net.pmk);
+		} else if (a34w_net.psk_given) {
+			memcpy(a34w_net.pmk, join->pmk, 32);
+		}
+		a34w_net_ssid(ssid);
+		a34w_say("iOS asks us to join \"%s\" (%s)", ssid, a34w_net.psk_given ? "WPA2-PSK" : "open");
+		a34w_sta_phase_now = A34_STA_JOINING;
+		ok = a34w_join_now();
+		a34w_sta_phase_now = A34_STA_IDLE;
+		if (ok) {
+			a34w_auto_rejoins = 0;
+		}
+		a34_apple80211_event(A34_STA_JOIN_DONE, ok ? 0 : a34w_join_error != 0 ? a34w_join_error : EIO);
+	}
+	if (scan) {
+		bool ok;
+
+		a34w_sta_phase_now = A34_STA_SCANNING;
+		ok = a34w_scan("scan for iOS", a34w_joined);
+		a34w_sta_phase_now = A34_STA_IDLE;
+		a34_apple80211_event(A34_STA_SCAN_DONE, ok ? 0 : EIO);
+	}
+}
