diff --git a/iokit/Kernel/arm/A34WLAN.cpp b/iokit/Kernel/arm/A34WLAN.cpp
new file mode 100644
index 0000000..9e4a25a
--- /dev/null
+++ b/iokit/Kernel/arm/A34WLAN.cpp
@@ -0,0 +1,237 @@
+/*
+ * A34 (0969): the registry entries by which iOS finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (bsd/dev/a34_wifi_net.c) and has no IOKit object of its
+ * own; iOS looks for some, as IO80211Family and IONetworkingFamily would have made them:
+ *
+ *   - wifid's device is the service with IO80211InterfaceRole = "Infrastructure", and
+ *     IO80211.framework binds to an interface through a service whose IOInterfaceName is its
+ *     name. That service has no user client, on purpose: the framework's attempt to open one
+ *     fails, it falls back to ioctls, which bsd/dev/a34_apple80211.c answers.
+ *   - SystemConfiguration lists IONetworkInterface objects and calls one Wi-Fi when its parent
+ *     is an IO80211Controller (whose IOMACAddress is the address); configd makes a network
+ *     service for an interface it has listed -- which wifid waits for after a join.
+ *   - configd's interface namer opens IOResources/IONetworkStack before it says the registry
+ *     is quiet; until then SCNetworkInterfaceCopyAll -- wifid, and behind it SpringBoard -- waits
+ *     up to five minutes. The stand-in here can be opened and names nothing.
+ *
+ * The classes are named as Apple's are and have nothing but properties. This is HackiOS's
+ * iokit/Kernel/RedwoodWLAN.cpp and MiniIONetworkStack.cpp (github.com/oosexgang/hakios-xnu-kernel,
+ * branch mtk, APSL 2.0), made once a34_wifi.c has its interface.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <sys/proc.h>
+
+extern "C" void a34_wlan_registry(const char *interface, const uint8_t *address);
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class A34WLAN : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(A34WLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(A34WLAN, IONetworkInterface);
+
+/* there is none (see the top); that somebody asked shows that the service was found */
+IOReturn
+A34WLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("A34 WIFI: A34WLAN: a user client of type %u is asked for: there is none (ioctls instead)\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	proc_selfname(who, sizeof(who));
+	IOLog("A34 WIFI: IONetworkStack opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "name this interface": there are none to name (ours are born with their names) */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("A34 WIFI: IONetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+static void
+a34_wlan_stack(void)
+{
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("A34 WIFI: IONetworkStack cannot be made\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
+
+/* once, when the interface exists: the controller with the address, below it the interface; and the network stack */
+void
+a34_wlan_registry(const char * interface, const uint8_t * address)
+{
+	static bool made;
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller;
+	A34WLAN * wlan;
+	OSData * mac;
+	OSNumber * number;
+	unsigned unit = 0;
+
+	if (made || interface == NULL || interface[0] == '\0') {
+		return;
+	}
+	made = true;
+	a34_wlan_stack();
+	controller = OSTypeAlloc(IO80211Controller);
+	wlan = OSTypeAlloc(A34WLAN);
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("A34 WIFI: A34WLAN: the services cannot be made\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	if ((controller = (IO80211Controller *) publish(controller, platform, "A34WLANController")) == NULL) {
+		wlan->release();
+		IOLog("A34 WIFI: A34WLAN: the controller did not start\n");
+		return;
+	}
+	for (const char * p = interface + 2; *p >= '0' && *p <= '9'; p++) {
+		unit = unit * 10 + (unsigned) (*p - '0');
+	}
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) unit, 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "A34WLAN") == NULL) {
+		IOLog("A34 WIFI: A34WLAN: the interface's service did not start\n");
+	} else {
+		wlan->release();
+		IOLog("A34 WIFI: A34WLAN: %s in the registry (IO80211Controller / IONetworkInterface, Infrastructure)\n", interface);
+	}
+	controller->release();
+}
+#endif /* SWEET */
