+/*
+ * A34 (0969): the station boundary -- what iOS's Wi-Fi side (a34_apple80211.c, wifid's requests)
+ * asks of the radio (a34_wifi.c), and what the radio tells it back.
+ *
+ * Every request is asked and returns at once; a34_wifi.c's thread does the work, one thing at a
+ * time with its own steps, and says how it went as an event. Frames do not pass here (they go
+ * through a34_wifi_net.c's interface).
+ *
+ * After HackiOS's bsd/sys/redwood_sta.h (github.com/oosexgang/hakios-xnu-kernel, branch mtk,
+ * APSL 2.0), cut down to one radio that is already ours.
+ */
+#ifndef _A34_STA_H_
+#define _A34_STA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define A34_STA_ELEMENTS_MOST   384
+
+/* one access point, as the last scan heard it */
+struct a34_sta_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint8_t channel;
+	int16_t rssi;                           /* dBm */
+	uint16_t beacon_interval;               /* TU */
+	uint16_t capability;
+	uint32_t age_ms;
+	uint16_t elements_length;
+	uint8_t elements[A34_STA_ELEMENTS_MOST];
+};
+
+enum { A34_STA_OPEN, A34_STA_WPA2_PSK };
+
+struct a34_sta_join {
+	uint8_t ssid[32], ssid_length;
+	uint8_t bssid[6];                       /* all zero: the one of that name heard best */
+	int security;
+	uint8_t pmk[32];                        /* WPA2: the key ... */
+	uint8_t passphrase[64], passphrase_length;      /* ... or, if this is not empty, the passphrase */
+};
+
+enum a34_sta_phase { A34_STA_OFF, A34_STA_IDLE, A34_STA_SCANNING, A34_STA_JOINING, A34_STA_JOINED };
+
+struct a34_sta_state {
+	enum a34_sta_phase phase;
+	struct a34_sta_bss bss;                 /* the network joined (its elements not filled) */
+};
+
+enum a34_sta_event {
+	A34_STA_POWER,                          /* status: 1 on, 0 off */
+	A34_STA_SCAN_DONE,                      /* status: 0, or an errno */
+	A34_STA_JOIN_DONE,                      /* status: 0, EAUTH (a wrong passphrase), ETIMEDOUT, or another errno */
+	A34_STA_LINK,                           /* status: 1 joined, 0 left when asked, an errno: lost */
+};
+
+/* ---- a34_wifi.c: asked from any thread; 0 or an errno, the outcome comes as an event ---- */
+int  a34_sta_ask_power(bool on);
+int  a34_sta_ask_scan(const uint8_t *ssid, uint32_t ssid_length);
+int  a34_sta_ask_join(const struct a34_sta_join *what);
+int  a34_sta_ask_leave(void);
+bool a34_sta_powered(void);
+bool a34_sta_switched_off(void);                /* iOS turned the radio off */
+bool a34_sta_heard(unsigned index, struct a34_sta_bss *bss);   /* the `index`th of the last scan */
+void a34_sta_state(struct a34_sta_state *state);
+bool a34_sta_address(uint8_t address[6]);
+
+/* ---- a34_apple80211.c: told what happened (on a34_wifi.c's thread) ---- */
+void a34_apple80211_event(enum a34_sta_event event, int status);
+int  a34_apple80211_ioctl(unsigned long command, void *data);
+
+#endif
