+/* (1010) the RX vector's first two words (group 3): the AP's RSSI, averaged */
+static void
+a34w_link_rssi_note(const uint8_t *g3)
+{
+	uint32_t rv0, rv1, rcpi;
+	int rssi;
+
+	memcpy(&rv0, g3, 4);
+	memcpy(&rv1, g3 + 4, 4);
+	rcpi = ((rv0 >> 18) & 7u) == 0u ? ((rv1 & 0xffu) >= 255u ? (rv1 >> 8) & 0xffu : rv1 & 0xffu) :
+	    ((rv1 & 0xffu) > ((rv1 >> 8) & 0xffu) ? rv1 & 0xffu : (rv1 >> 8) & 0xffu);
+	if (rcpi == 0 || rcpi > 220u) {
+		return;
+	}
+	rssi = (int)(rcpi >> 1) - 110;
+	a34w_link_rssi = a34w_ms() - a34w_link_rssi_at > 10000u ? rssi : (7 * a34w_link_rssi + rssi) / 8;
+	a34w_link_rssi_at = a34w_ms();
+}
