  * of taking the EINT14 interrupt; one header read is ~0.3 ms of bus time.
  * Coordinates go to SweetHIDTouch, which knows the panel size (0903).
  *
+ * A34 (1001): while a finger is down, every a34touchms (default 4: 240 a
+ * second, two looks a 120 Hz frame) on an even beat: the next look at the
+ * last one's time + the period, slept to with a timer that is not coalesced
+ * (a34_sleep_until(): the 8 ms of before came 8 to 9 ms apart, drifting
+ * against the panel's 8.34 ms, so a drag moved unevenly from frame to
+ * frame). The chip sets bit 7 of its header only for a new report, so a look
+ * between two costs one 8-byte read. Each event is stamped with the time its
+ * report was read (sweet_hid_touch_at()), not when it was made into an event.
+ * When a finger lifts: one line of how often reports came (first 32
+ * gestures).
+ *
  * Boot arg a34touch=1 (default off). a34touchlog=N logs the first N raw
  * event frames (default 24).
  */
@@ -37,6 +48,8 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_touch_at(int finger, int down, int x, int y, uint64_t when);   /* A34 (1001) */
+extern void a34_sleep_until(uint64_t deadline);                                     /* A34 (1001): osfmk/kern/sched_prim.c */
 void a34_touch_init(void);
 
 #define AT_PAGE          0x4000u
@@ -99,6 +112,11 @@ static uint32_t at_parent;
 static uint32_t at_log_left = 24;
 static uint64_t at_frames, at_errors;
 static bool at_down[GT_FINGERS];
+static uint64_t at_when;                /* A34 (1001): mach time of the read at_poll() works on */
+static uint32_t at_period_ms = 4;       /* A34 (1001): a34touchms, while a finger is down */
+/* A34 (1001): the gesture under way: reports, empty looks, first and last report, the longest gap */
+static uint32_t at_g_reports, at_g_empty, at_g_said;
+static uint64_t at_g_first, at_g_last, at_g_most;
 
 static inline void
 at_w16(vm_offset_t base, uint32_t off, uint16_t v)
@@ -283,7 +301,7 @@ at_release_all(void)
 	for (int f = 0; f < GT_FINGERS; f++) {
 		if (at_down[f]) {
 			at_down[f] = false;
-			sweet_hid_touch(f, 0, 0, 0);
+			sweet_hid_touch_at(f, 0, 0, 0, at_when);
 		}
 	}
 }
@@ -295,14 +313,20 @@ at_poll(void)
 	uint8_t buf[8 + GT_FINGERS * GT_REC + 2];
 	uint32_t count, len;
 	bool seen[GT_FINGERS] = { false };
-	bool any = false;
+	bool any = false, held = false;
 
+	at_when = mach_absolute_time();         /* A34 (1001): the report's time, for its events */
+	for (int f = 0; f < GT_FINGERS; f++) {
+		held |= at_down[f];
+	}
 	if (at_read(GT_TOUCH, buf, 8)) {
 		at_errors++;
-		return false;
+		return held;                    /* A34 (1001): (a finger stays down over one bad read) */
+	}
+	if (buf[0] == 0) {
+		at_g_empty += held ? 1u : 0u;   /* A34 (1001): no new report since the last look */
+		return held;
 	}
-	if (buf[0] == 0)
-		return false;
 	count = buf[2] & 0x0fu;
 	if (count > GT_FINGERS)
 		count = GT_FINGERS;
@@ -331,6 +355,14 @@ at_poll(void)
 		at_errors++;
 		return false;
 	}
+	/* A34 (1001): the gesture's reports and the gaps between them */
+	if (at_g_first == 0) {
+		at_g_first = at_when;
+	} else if (at_when - at_g_last > at_g_most) {
+		at_g_most = at_when - at_g_last;
+	}
+	at_g_last = at_when;
+	at_g_reports++;
 	for (uint32_t i = 0; i < count; i++) {
 		const uint8_t *r = buf + 8 + i * GT_REC;
 		uint32_t id = (r[0] >> 2) & 15u, action = r[0] >> 6;
@@ -341,19 +373,19 @@ at_poll(void)
 			continue;
 		if (action == 3) {
 			if (at_down[id])
-				sweet_hid_touch((int)id, 0, x, y);
+				sweet_hid_touch_at((int)id, 0, x, y, at_when);
 			at_down[id] = false;
 			continue;
 		}
 		seen[id] = true;
 		at_down[id] = true;
-		sweet_hid_touch((int)id, 1, x, y);
+		sweet_hid_touch_at((int)id, 1, x, y, at_when);
 	}
 	for (int f = 0; f < GT_FINGERS; f++) {
 		if (at_down[f] && !seen[f]) {
 			/* not in this frame: the chip lists every finger down */
 			at_down[f] = false;
-			sweet_hid_touch(f, 0, 0, 0);
+			sweet_hid_touch_at(f, 0, 0, 0, at_when);
 		}
 		any |= at_down[f];
 	}
@@ -378,10 +410,32 @@ at_thread(void *arg, wait_result_t result)
 	} else {
 		printf("A34 TOUCH: version read failed\n");
 	}
+	uint64_t next = 0, period;
+	bool wasDown = false;
+
+	nanoseconds_to_absolutetime((uint64_t)at_period_ms * NSEC_PER_MSEC, &period);
 	for (;;) {
 		uint64_t errors = at_errors;
 		bool down = at_poll();
 
+		if (wasDown && !down && at_g_reports > 1 && at_g_said < 32) {
+			/* A34 (1001): how often the chip's reports came in the gesture that just ended */
+			uint64_t span, most;
+
+			at_g_said++;
+			absolutetime_to_nanoseconds(at_g_last - at_g_first, &span);
+			absolutetime_to_nanoseconds(at_g_most, &most);
+			printf("A34 TOUCH: gesture: %u reports in %llu ms (every %llu us, longest gap %llu us), %u looks found none "
+			    "(a34touchms=%u)\n", at_g_reports, (unsigned long long)(span / NSEC_PER_MSEC),
+			    (unsigned long long)(span / 1000 / (at_g_reports - 1)), (unsigned long long)(most / 1000), at_g_empty,
+			    at_period_ms);
+		}
+		if (!down) {
+			at_g_reports = at_g_empty = 0;
+			at_g_first = at_g_last = at_g_most = 0;
+		}
+		wasDown = down;
+
 		if (at_errors != errors) {
 			if (++bad == 5 || bad % 500 == 0)
 				printf("A34 TOUCH: %llu I2C errors (%llu frames)\n",
@@ -394,7 +448,19 @@ at_thread(void *arg, wait_result_t result)
 		} else {
 			bad = 0;
 		}
-		at_sleep_ms(down ? 8 : 10);
+		if (down) {
+			/* A34 (1001): on the beat, not coalesced */
+			uint64_t now = mach_absolute_time();
+
+			next = next != 0 ? next + period : at_when + period;
+			if (next <= now) {
+				next = now + period;    /* (late: from here) */
+			}
+			a34_sleep_until(next);
+		} else {
+			next = 0;
+			at_sleep_ms(10);
+		}
 	}
 }
 
@@ -413,6 +479,9 @@ a34_touch_init(void)
 		return;
 	}
 	PE_parse_boot_argn("a34touchlog", &at_log_left, sizeof(at_log_left));
+	if (PE_parse_boot_argn("a34touchms", &at_period_ms, sizeof(at_period_ms)) && (at_period_ms < 2 || at_period_ms > 20)) {
+		at_period_ms = 4;               /* A34 (1001) */
+	}
 	at_i2c = ml_io_map(AT_I2C_PA, AT_PAGE);
 	at_top = ml_io_map(AT_TOP_PA, AT_PAGE);
 	at_apdma = ml_io_map(AT_APDMA_PA, AT_PAGE);
