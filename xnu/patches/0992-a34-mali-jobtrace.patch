+/*
+ * A34 (0992), with the lock held: the job just run into the ring; logged at
+ * once when request 0x79 named it; every A34_TRACE_EVERY_NS the jobs that
+ * started in the A34_TRACE_FRAME_NS before the newest one ended ("frame").
+ */
+void
+RedwoodMaliUserClient::jobRecord(const struct a34_mali_job *job, const struct a34_qjob *q, uint64_t upkeepTicks, bool done)
+{
+	struct a34_jobrec *r = &gA34JobRing[gA34JobN % A34_JOBRING];
+	uint64_t us, now = mach_absolute_time(), every, frame;
+
+	bzero(r, sizeof(*r));
+	r->client = this;
+	r->queued = q != NULL ? q->queued : 0;
+	r->start = job->started;
+	if (job->started != 0) {
+		uint64_t ticks;
+
+		nanoseconds_to_absolutetime(job->ns, &ticks);
+		r->end = job->started + ticks;
+	}
+	r->seq = q != NULL ? q->seq : 0;
+	r->gseq = q != NULL ? q->gseq : 0;
+	absolutetime_to_nanoseconds(upkeepTicks, &us);
+	r->upkeepUs = (uint32_t)(us / 1000);
+	r->ahead = q != NULL ? q->depth : 0;
+	r->fs = (job->requirements & PANFROST_JD_REQ_FS) != 0;
+	r->failed = !done;
+	strlcpy(r->name, fName, sizeof(r->name));
+	gA34JobN++;
+	if (q != NULL && fTraceFirst != 0 && q->seq >= fTraceFirst && q->seq <= fTraceLast) {
+		if (fTraceT0 == 0) {
+			fTraceT0 = r->start;
+		}
+		a34_job_say(r, fTraceT0, "asked");
+		if (q->seq == fTraceLast) {
+			fTraceFirst = fTraceLast = fTraceT0 = 0;
+		}
+	}
+	nanoseconds_to_absolutetime(A34_TRACE_EVERY_NS, &every);
+	if (gA34JobDumpAt != 0 && now - gA34JobDumpAt < every) {
+		return;
+	}
+	if (gA34JobDumpAt == 0) {
+		gA34JobDumpAt = now;
+		return;
+	}
+	gA34JobDumpAt = now;
+	/* the jobs that started within one frame before the newest ended, oldest first */
+	nanoseconds_to_absolutetime(A34_TRACE_FRAME_NS, &frame);
+	uint32_t n = 0, have = gA34JobN < A34_JOBRING ? gA34JobN : A34_JOBRING;
+
+	while (n < have && n < A34_TRACE_MAX) {
+		const struct a34_jobrec *o = &gA34JobRing[(gA34JobN - 1 - n) % A34_JOBRING];
+
+		if (o->start == 0 || r->end < o->start || r->end - o->start > frame) {
+			break;
+		}
+		n++;
+	}
+	if (n == 0) {
+		return;
+	}
+	const struct a34_jobrec *first = &gA34JobRing[(gA34JobN - n) % A34_JOBRING];
+
+	IOLog("A34 MALI JOB: frame: the %u jobs that started in the %llu us before the newest ended (GPU %u MHz)\n", n,
+	    (unsigned long long)(A34_TRACE_FRAME_NS / 1000), a34_clocks_gpu_khz() / 1000u);
+	for (uint32_t i = 0; i < n; i++) {
+		a34_job_say(&gA34JobRing[(gA34JobN - n + i) % A34_JOBRING], first->start, "frame");
+	}
+}
