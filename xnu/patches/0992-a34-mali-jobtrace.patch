+/* A34 (0992), with the lock held: one ring record as an "A34 MALI JOB" line, times from t0. */
+static void
+a34_job_say(const struct a34_jobrec *r, uint64_t t0, const char *why)
+{
+	uint64_t start, len, wait = 0;
+
+	absolutetime_to_nanoseconds(r->start > t0 ? r->start - t0 : 0, &start);
+	absolutetime_to_nanoseconds(r->end > r->start ? r->end - r->start : 0, &len);
+	if (r->queued != 0 && r->start > r->queued) {
+		absolutetime_to_nanoseconds(r->start - r->queued, &wait);
+	}
+	IOLog("A34 MALI JOB: %s %s #%llu (g%llu) %s: start +%llu us, %llu us on the GPU, %llu us queued (%u ahead), "
+	    "upkeep %u us%s\n", why, r->name, (unsigned long long)r->seq, (unsigned long long)r->gseq,
+	    r->fs ? "fragment" : "vertex/tiler", (unsigned long long)(start / 1000), (unsigned long long)(len / 1000),
+	    (unsigned long long)(wait / 1000), r->ahead, r->upkeepUs, r->failed ? ", FAILED" : "");
+}
