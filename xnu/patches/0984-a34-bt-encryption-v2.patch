+/*
+ * (0984) connections counted; Encryption Change (v1, 0x08) given as v2 (0x59: status, handle, enabled, key size)
+ * while bluetoothd has v2 enabled. a has room for the byte more. The new length.
+ */
+static uint32_t
+br_link_event(uint8_t *a, uint32_t n)
+{
+	static uint32_t said;
+
+	if (n >= 6 && a[0] == 0x04 && a[1] == 0x03 && a[3] == 0) {                     /* Connection Complete */
+		br_links++;
+	} else if (n >= 6 && a[0] == 0x04 && a[1] == 0x3e && (a[3] == 0x01 || a[3] == 0x0a) && a[4] == 0) {
+		br_links++;                                                             /* LE (Enhanced) Connection Complete */
+	} else if (n >= 7 && a[0] == 0x04 && a[1] == 0x05 && a[3] == 0) {              /* Disconnection Complete */
+		br_links -= br_links != 0 ? 1u : 0u;
+	} else if (n >= 7 && a[0] == 0x04 && a[1] == 0x0e && a[4] == 0x03 && a[5] == 0x0c && a[6] == 0) {
+		br_links = 0;                                                           /* HCI_Reset */
+		br_enc_v2 = false;
+	} else if (br_enc_v2 && n == 7 && a[0] == 0x04 && a[1] == 0x08) {             /* Encryption Change v1 */
+		a[1] = 0x59;
+		a[2] = 5;
+		a[7] = a[3] == 0 && a[6] != 0 ? 16 : 0;
+		if (said++ < 8) {
+			printf("A34 BT: br: Encryption Change (status %#x, handle %#x, %s) given to bluetoothd as v2, key size %u\n",
+			    a[3], (unsigned)(a[4] | ((a[5] & 0x0f) << 8)), a[6] == 0 ? "off" : a[6] == 2 ? "AES-CCM" : "E0",
+			    a[7]);
+		}
+		return 8;
+	}
+	return n;
+}
