@@ -37,6 +38,8 @@ a34_hb_thread(void *arg, wait_result_t result)
 	(void)arg;
 	(void)result;
 
+	uint64_t prev[6] = { 0 };
+
 	absolutetime_to_nanoseconds(1000, &tick_ns);    /* ns per 1000 ticks */
