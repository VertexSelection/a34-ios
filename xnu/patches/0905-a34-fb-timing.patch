 		    sweet_fb_swap_count, line);
+
+		/* present() cost since the last line, in microseconds per present */
+		uint64_t s[6], dp;
+		for (int k = 0; k < 6; k++) {
+			s[k] = a34_fb_stats[k];
+		}
+		dp = s[0] - prev[0];
+		if (dp != 0) {
+			printf("A34 FB %llu presents %llu vsyncs: copy %lluus flush %lluus kick %lluus (max %lluus)\n",
