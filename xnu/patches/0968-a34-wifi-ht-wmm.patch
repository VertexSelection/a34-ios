 /* CMD_UPDATE_STA_RECORD (168 bytes, version 0) for the AP: state 0 (STA_STATE_1) or 2 (STA_STATE_3) */
 static uint8_t
 a34w_sta_record(uint8_t state, bool need_response)
@@ -3114,6 +3226,36 @@ a34w_sta_record(uint8_t state, bool need_response)
 	c[55] = 0xffu;                                  /* ucBMCWlanIndex, as cnmStaSendUpdateCmd */
 	c[74] = (uint8_t)fixed;                         /* u2HwDefaultFixedRateCode */
 	c[75] = (uint8_t)(fixed >> 8);
+	if (a34w_qos) {                                 /* (0968) cnmStaSendUpdateCmd for a QoS AP */
+		c[18] = 1;                              /* ucIsQoS */
+	}
+	if (a34w_ht) {
+		const uint8_t *ht = a34w_ap_ie(45, -1); /* the AP's own HT Capabilities, as they are */
+
+		c[13] |= 0x10u;                         /* ucDesiredPhyTypeSet: + HT */
+		if (ht != NULL && ht[1] >= 26u) {
+			uint16_t info = (uint16_t)((ht[2] | ht[3] << 8) & ~0x0042u);     /* no 40 MHz, no SGI40: we are at 20 */
+
+			c[21] = ht[5];                  /* ucMcsSet: MCS 0-7 */
+			c[22] = (uint8_t)((ht[9] & 1u) != 0);   /* ucSupMcs32 */
+			memcpy(c + 24, ht + 5, 10);     /* aucRxMcsBitmask */
+			c[34] = ht[15];                 /* u2RxHighestSupportedRate */
+			c[35] = ht[16];
+			memcpy(c + 36, ht + 17, 4);     /* u4TxRateInfo */
+			c[40] = (uint8_t)info;          /* u2HtCapInfo */
+			c[41] = (uint8_t)(info >> 8);
+			c[42] = ht[21];                 /* u2HtExtendedCap */
+			c[43] = ht[22];
+			memcpy(c + 44, ht + 23, 4);     /* u4TxBeamformingCap */
+			c[48] = ht[4];                  /* ucAmpduParam */
+			c[49] = ht[27];                 /* ucAselCap */
+		}
+		c[68] = 3;                              /* ucRtsPolicy: legacy (cnm_mem.c) */
+		c[76] = 1;                              /* ucTxAmpdu */
+		c[77] = 1;                              /* ucRxAmpdu */
+		c[92] = 64;                             /* rBaSize: TX 64, RX 64; no A-MSDU in A-MPDU (+128 stay 0) */
+		c[93] = 64;
+	}
 	return a34w_cmd(CMD_ID_UPDATE_STA_RECORD, CMD_SET, c, sizeof(c));
 }
 
