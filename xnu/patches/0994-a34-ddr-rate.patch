 }
+/*
+ * ---- DRAM's data rate (A34 0994) ----
+ *
+ * Read only, as Android's dramc.c fmeter_v1() computes it from the DDRPHY
+ * PLL of channel 0 with the phone's device tree (recon/android-DYG1/live.dts
+ * dramc@10230000: fmeter-version 1, crystal-freq 52, shu-of 0x700, shu-lv
+ * and pll-id in DDRPHY NAO 0x50c, the PLL fields in DDRPHY AO at the
+ * offsets below plus 0x700 a shuffle; resources 6 and 4 of its reg:
+ * DDRPHY NAO ch0 0x10236000, AO ch0 0x10238000). freq_step of the same node
+ * (Mbps by DDR OPP): 4266 4266 3733 2667 1866 1600 1200 800. With DVFSRC off
+ * (boot 0991: BASIC_CONTROL 0x00000008) DRAM stays at the shuffle the boot
+ * loader left.
+ */
+#define CK_DDRPHY_NAO_PA        0x10236000u
+#define CK_DDRPHY_AO_PA         0x10238000u
+#define CK_DDRPHY_AO_SIZE       0x2000u
+static vm_offset_t ck_ddrphy_nao, ck_ddrphy_ao;
+
+struct ck_ddr_field {
+	uint16_t off[2];        /* by PLL id */
+	uint32_t mask;
+	uint8_t shift;
+};
+static const struct ck_ddr_field ck_ddr_sdmpcw = { { 0x704, 0x724 }, 0xffff0000u, 16 };
+static const struct ck_ddr_field ck_ddr_prediv = { { 0x708, 0x728 }, 0x000c0000u, 18 };
+static const struct ck_ddr_field ck_ddr_posdiv = { { 0x708, 0x728 }, 0x00000007u, 0 };
+static const struct ck_ddr_field ck_ddr_ckdiv4 = { { 0x874, 0x874 }, 0x00000004u, 2 };
+static const struct ck_ddr_field ck_ddr_pllmd = { { 0x744, 0x744 }, 0x00000100u, 8 };
+static const struct ck_ddr_field ck_ddr_cldiv2 = { { 0x8b4, 0x8b4 }, 0x00000002u, 1 };
+static const struct ck_ddr_field ck_ddr_fbksel = { { 0x70c, 0x70c }, 0x00000040u, 6 };
+static const struct ck_ddr_field ck_ddr_dqsopen = { { 0x870, 0x870 }, 0x00100000u, 20 };
+static const struct ck_ddr_field ck_ddr_dqopen = { { 0x870, 0x870 }, 0x00200000u, 21 };
+static const struct ck_ddr_field ck_ddr_ckdiv4ca = { { 0xb74, 0xb74 }, 0x00000004u, 2 };
+
+static uint32_t
+ck_ddr_get(const struct ck_ddr_field *f, uint32_t pll, uint32_t shu)
+{
+	return (ruby_rd32(ck_ddrphy_ao, f->off[pll] + 0x700u * shu) & f->mask) >> f->shift;
+}
+
+/* dramc.c decode_freq(): the measured rate to its nominal one */
+static uint32_t
+ck_ddr_decode(uint32_t v)
+{
+	static const uint16_t raw[] = { 8528, 6378, 6370, 5490, 5486, 4095, 4264, 3718, 3588, 3068, 2652, 2664, 2366,
+		                        2106, 2132, 1859, 1846, 1794, 1542, 1534, 1144, 1196, 754, 799, 396 };
+	static const uint16_t nom[] = { 8533, 6400, 6400, 5500, 5500, 4100, 4266, 3733, 3733, 3200, 2667, 2667, 2400,
+		                        2133, 2133, 1866, 1866, 1866, 1600, 1600, 1200, 1200, 800, 800, 400 };
+
+	for (uint32_t i = 0; i < sizeof(raw) / sizeof(raw[0]); i++) {
+		if (raw[i] == v) {
+			return nom[i];
+		}
+	}
+	return v;
+}
+
+/* DRAM's data rate in Mbps (0: not read); *shuffle: the DDRPHY shuffle level in use. */
+uint32_t
+a34_ddr_mbps(uint32_t *shuffle)
+{
+	uint32_t nao, shu, pll, vco;
+
+	if (ck_ddrphy_nao == 0) {
+		ck_ddrphy_nao = ml_io_map(CK_DDRPHY_NAO_PA, CK_PAGE);
+	}
+	if (ck_ddrphy_ao == 0) {
+		ck_ddrphy_ao = ml_io_map(CK_DDRPHY_AO_PA, CK_DDRPHY_AO_SIZE);
+	}
+	if (ck_ddrphy_nao == 0 || ck_ddrphy_ao == 0) {
+		return 0;
+	}
+	nao = ruby_rd32(ck_ddrphy_nao, 0x50cu);
+	shu = (nao & 0x30000u) >> 16;
+	pll = (nao & 0x100u) >> 8;
+	if (shuffle != NULL) {
+		*shuffle = shu;
+	}
+	vco = ((52u >> ck_ddr_get(&ck_ddr_prediv, pll, shu)) * (ck_ddr_get(&ck_ddr_sdmpcw, pll, shu) >> 7)) >>
+	    ck_ddr_get(&ck_ddr_posdiv, pll, shu) >> 1 >> ck_ddr_get(&ck_ddr_ckdiv4, pll, shu) >>
+	    ck_ddr_get(&ck_ddr_pllmd, pll, shu) >> ck_ddr_get(&ck_ddr_cldiv2, pll, shu) << ck_ddr_get(&ck_ddr_fbksel, pll, shu);
+	if (ck_ddr_get(&ck_ddr_dqsopen, pll, shu) == 1 || ck_ddr_get(&ck_ddr_dqopen, pll, shu) == 1) {
+		vco >>= ck_ddr_get(&ck_ddr_ckdiv4ca, pll, shu) == 1 ? 2 : 1;
+	}
+	return ck_ddr_decode(vco);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
