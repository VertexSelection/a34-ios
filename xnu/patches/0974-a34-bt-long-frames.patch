+/* (0974) what the firmware left in its coredump area (EMI +0x43C00: control block, then its text from +0x100) */
+static void
+bt_dump_say(void)
+{
+	const volatile uint8_t *text;
+	uint32_t state, print, any = 0, k, j = 0, lines = 0;
+	char line[121];
+
+	if (bt_emi == 0) {
+		return;
+	}
+	state = *(volatile uint32_t *)(bt_emi + BT_DUMP_OFFSET + 0x4);
+	print = *(volatile uint32_t *)(bt_emi + BT_DUMP_OFFSET + 0xc);
+	for (k = 0; k < 0x200; k += 4) {
+		any |= *(volatile uint32_t *)(bt_emi + BT_DUMP_OFFSET + k);
+	}
+	if (any == 0) {
+		printf("A34 BT: the firmware's coredump area (EMI +%#x) is still clear: no assert written\n", BT_DUMP_OFFSET);
+		return;
+	}
+	printf("A34 BT: the firmware's coredump area (EMI +%#x): state %#x, text index %#x, dump index %#x\n",
+	    BT_DUMP_OFFSET, state, print, *(volatile uint32_t *)(bt_emi + BT_DUMP_OFFSET + 0x10));
+	text = (const volatile uint8_t *)(bt_emi + BT_DUMP_OFFSET + 0x100);
+	for (k = 0; k < 0x7f00 && lines < 6; k++) {
+		uint8_t c = text[k];
+
+		if (c >= 0x20 && c < 0x7f) {
+			line[j++] = (char)c;
+		}
+		if ((c < 0x20 || c >= 0x7f || j == sizeof(line) - 1) && j > 0) {
+			line[j] = 0;
+			if (j >= 4 || c >= 0x20) {
+				printf("A34 BT: coredump: %s\n", line);
+				lines++;
+			}
+			j = 0;
+		}
+	}
+}
