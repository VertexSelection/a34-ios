+/* (0974) how frames go out: the AP DMA if it sends a long frame whole, else paced PIO if that does, else neither */
+static void
+bt_long_setup(void)
+{
+	if (bt_tx == BT_TX_PIO) {
+		printf("A34 BT: step 9: TX in 16-byte bursts (a34bttx=0), no long-frame test\n");
+		return;
+	}
+	if (bt_tx == BT_TX_DMA && !bt_dma_setup()) {
+		bt_tx = BT_TX_PACED;
+	}
+	if (bt_long_test(bt_tx_name())) {
+		return;
+	}
+	if (bt_dma_on) {
+		bool moved = bt_dma_moved;
+
+		bt_dma_off();
+		bt_tx = BT_TX_PACED;
+		printf("A34 BT: step 9: the AP DMA %s: PIO with %u us between bursts instead\n",
+		    moved ? "sent, but not whole" : "sent nothing", bt_pace_us);
+		if (bt_long_test(bt_tx_name())) {
+			return;
+		}
+	}
+	bt_long_broken = true;
+	printf("A34 BT: step 9: LONG FRAMES DO NOT GET THROUGH: commands over 16 bytes are answered here, longer data "
+	    "is dropped\n");
+}
