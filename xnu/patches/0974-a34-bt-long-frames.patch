+/* one frame through the channel, and out of BTIF (the caller holds bt_tx_lock); bt_dma_moved: anything left the ring */
+static int
+bt_dma_write(const uint8_t *b, uint32_t n)
+{
+	static uint32_t said;
+	uint64_t start = mach_absolute_time(), limit, settle, t;
+	uint32_t w, wpt, wrap, valid, least = n;
+
+	nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &limit);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &settle);
+	bt_dma_moved = false;
+	while (rd(bt_apdma, APDMA_FLUSH) & 1u) {                               /* a flush still going */
+		if (mach_absolute_time() - start > limit) {
+			goto stuck;
+		}
+	}
+	if (rd(bt_apdma, APDMA_VFF_LEFT) < n) {
+		goto stuck;
+	}
+	w = rd(bt_apdma, APDMA_VFF_WPT);
+	wpt = w & 0xffffu;
+	wrap = w & 0x10000u;
+	for (uint32_t i = 0; i < n; i++) {
+		*(volatile uint8_t *)(bt_vff + wpt) = b[i];
+		if (++wpt == BT_VFF_SIZE) {
+			wpt = 0;
+			wrap ^= 0x10000u;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	setb(bt_apdma, APDMA_EN, 1u << 0);
+	wr(bt_apdma, APDMA_VFF_WPT, wpt | wrap);
+	for (;;) {
+		valid = rd(bt_apdma, APDMA_VFF_VALID);
+		least = valid < least ? valid : least;
+		if (valid == 0) {
+			break;
+		}
+		if (valid > 0 && valid < 8 && !(rd(bt_apdma, APDMA_FLUSH) & 1u) && !(rd(bt_apdma, APDMA_STOP) & 1u)) {
+			setb(bt_apdma, APDMA_FLUSH, 1u << 0);                  /* the last bytes short of 8 */
+		}
+		if (mach_absolute_time() - start > limit) {
+			goto stuck;
+		}
+	}
+	bt_dma_moved = true;
+	for (t = mach_absolute_time(); rd(bt_apdma, APDMA_INT_BUF) != 0 && mach_absolute_time() - t < settle;) {
+		/* the channel's own buffer into BTIF's FIFO (hal_dma_is_tx_complete), 2 ms at most */
+	}
+	while (!(rd(bt_btif, BTIF_LSR) & (1u << 6))) {
+		if (mach_absolute_time() - start > limit) {
+			goto stuck;
+		}
+	}
+	return 0;
+stuck:
+	bt_dma_moved = bt_dma_moved || least < n;
+	if (said++ < 8) {
+		char what[64];
+
+		snprintf(what, sizeof(what), "stuck with a %u-byte frame (%s)", n, bt_dma_moved ? "some of it went" :
+		    "none of it went");
+		bt_dma_say(what);
+	}
+	return ETIMEDOUT;
+}
