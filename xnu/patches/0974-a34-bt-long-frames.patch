+/*
+ * (0974) A frame longer than BTIF's FIFO, as bluetoothd's first long one (Change_Local_Name, 252 bytes), and the name
+ * read back (Read_Local_Name, a 255-byte event): whole and unchanged, or not. bluetoothd sets its own name later.
+ */
+static bool
+bt_long_test(const char *how)
+{
+	static uint8_t cmd[4 + 248], ans[BT_PKT_MAX];
+	static const uint8_t read_name[4] = { 0x01, 0x14, 0x0c, 0x00 };
+	static const char tag[] = "A34 BTIF long frame test ";
+	uint32_t n, i, start = bt_ms();
+
+	cmd[0] = 0x01;
+	cmd[1] = 0x13;
+	cmd[2] = 0x0c;
+	cmd[3] = 248;
+	for (i = 0; i < 248; i++) {
+		cmd[4 + i] = i < sizeof(tag) - 1 ? (uint8_t)tag[i] : i < 240 ? (uint8_t)('a' + i % 26) : 0;
+	}
+	n = bt_command(cmd, sizeof(cmd), 0x0e, ans, 1000);
+	if (n < 7 || ans[6] != 0) {
+		printf("A34 BT: step 9: long frames (%s): the 252-byte Change_Local_Name %s\n", how,
+		    n == 0 ? "was not answered" : "failed");
+		return false;
+	}
+	n = bt_command(read_name, sizeof(read_name), 0x0e, ans, 1000);
+	if (n != 7 + 248 || ans[6] != 0) {
+		printf("A34 BT: step 9: long frames (%s): Read_Local_Name: %u bytes back, status %#x\n", how, n,
+		    n >= 7 ? ans[6] : 0xffu);
+		return false;
+	}
+	for (i = 0; i < 248 && ans[7 + i] == cmd[4 + i]; i++) {
+	}
+	if (i < 248) {
+		printf("A34 BT: step 9: long frames (%s): the name read back differs from byte %u on (%02x, not %02x)\n",
+		    how, i, ans[7 + i], cmd[4 + i]);
+		return false;
+	}
+	printf("A34 BT: step 9: long frames (%s): a 252-byte command and a 255-byte answer, whole (%u ms)\n", how,
+	    bt_ms() - start);
+	return true;
+}
