+static bool
+bt_dma_setup(void)
+{
+	uint64_t emi = a34_connsys_emi_pa();
+	vm_offset_t page;
+	uint32_t i;
+
+	if ((bt_vff_pa & 0xfffull) != 0 || bt_vff_pa < 0x40000000ull || bt_vff_pa + BT_VFF_SIZE > 0x100000000ull ||
+	    (bt_vff_pa < emi + a34_connsys_emi_size() && bt_vff_pa + BT_VFF_SIZE > emi)) {
+		printf("A34 BT: TX DMA: a34btvff=%#llx is not 4 KB aligned RAM below 4 GB outside CONNSYS's memory\n",
+		    bt_vff_pa);
+		return false;
+	}
+	wr(bt_infra, INFRA_CG2_CLR, 1u << 18);                                 /* ifrao_apdma ungated */
+	delay(10);
+	if (rd(bt_infra, INFRA_CG2_STA) & (1u << 18)) {
+		printf("A34 BT: TX DMA: the AP DMA's clock is still gated (CG2 %#x)\n", rd(bt_infra, INFRA_CG2_STA));
+		return false;
+	}
+	if (bt_apdma == 0 && (page = ml_io_map(BT_APDMA_PA, BT_PAGE)) != 0) {
+		bt_apdma = page + BT_APDMA_TX;
+	}
+	if (bt_vff == 0) {
+		bt_vff = ml_io_map_wcomb((vm_offset_t)bt_vff_pa, BT_VFF_SIZE);  /* normal memory, uncached */
+	}
+	if (bt_apdma == 0 || bt_vff == 0) {
+		printf("A34 BT: TX DMA: the channel or its ring %#llx could not be mapped\n", bt_vff_pa);
+		return false;
+	}
+	setb(bt_apdma, APDMA_RST, 1u << 0);                                    /* warm reset */
+	for (i = 0; i < 10 && (rd(bt_apdma, APDMA_EN) & 1u); i++) {
+		delay(100);
+	}
+	if (rd(bt_apdma, APDMA_EN) & 1u) {
+		setb(bt_apdma, APDMA_RST, 1u << 1);                            /* hard reset */
+		clrb(bt_apdma, APDMA_RST, 1u << 1);
+	}
+	for (i = 0; i < BT_VFF_SIZE; i += 4) {
+		*(volatile uint32_t *)(bt_vff + i) = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(bt_apdma, APDMA_VFF_ADDR, (uint32_t)bt_vff_pa);
+	wr(bt_apdma, APDMA_VFF_ADDR_H, (uint32_t)(bt_vff_pa >> 32));
+	wr(bt_apdma, APDMA_VFF_LEN, BT_VFF_SIZE);
+	wr(bt_apdma, APDMA_VFF_WPT, 0);
+	wr(bt_apdma, APDMA_VFF_RPT, 0);
+	wr(bt_apdma, APDMA_VFF_THRE, BT_VFF_SIZE - 7);                         /* DMA_TX_THRE */
+	clrb(bt_apdma, APDMA_INT_FLAG, 1u << 0);
+	wr(bt_apdma, APDMA_INT_EN, 0);
+	bt_dma_say("set up");
+	if (rd(bt_apdma, APDMA_VFF_LEN) != BT_VFF_SIZE || rd(bt_apdma, APDMA_VFF_VALID) != 0) {
+		printf("A34 BT: TX DMA: the channel did not take its ring\n");
+		return false;
+	}
+	for (i = 0; i < 1000 && !(rd(bt_btif, BTIF_LSR) & (1u << 6)); i++) {
+		delay(10);
+	}
+	setb(bt_btif, BTIF_DMA_EN, 1u << 1);                                   /* BTIF's TX FIFO fed by the channel */
+	bt_dma_on = true;
+	printf("A34 BT: TX DMA: on, ring at %#llx\n", bt_vff_pa);
+	return true;
+}
