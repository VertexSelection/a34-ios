+/* back to PIO: the channel stopped (btif_tx_dma_ctrl, DMA_CTRL_DISABLE), BTIF's TX no longer fed by it */
+static void
+bt_dma_off(void)
+{
+	for (uint32_t i = 0; i < 100; i++) {
+		setb(bt_apdma, APDMA_STOP, 1u << 0);
+		if (!(rd(bt_apdma, APDMA_STOP) & 1u)) {
+			break;
+		}
+		delay(10);
+	}
+	clrb(bt_btif, BTIF_DMA_EN, 1u << 1);
+	bt_dma_on = false;
+	bt_dma_say("off");
+}
