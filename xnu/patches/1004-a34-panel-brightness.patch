+/*
+ * A34 (1004): the panel's brightness. Samsung's sequence for the S6E3FC5
+ * (smcdsd_panel_send_msg, a34x_s6e3fc5_sdc_param.h), the parts that change
+ * with the level: the keys 9F/F0/FC open, 53 28 (dimming: smooth, normal
+ * mode -- E0 would be HBM), 51 DBV (2 bytes, 0x002..0x3FF: Samsung's UI
+ * levels 0..255; its 256..510 are HBM and not used), F7 0F (update), the
+ * keys closed. ACL, IRC and TSET stay as the loader set them. Sent like the
+ * 120 Hz commands (panelHzSend): display lock held, the link idle, the frame
+ * header put back. From the kick work loop only: right after a transfer
+ * (kickOne) or from fBLTimer when no frame goes out; one every
+ * SWEET_FB_BL_GAP_MS at most (CoreBrightness fades in many small steps; the
+ * panel's smooth dimming fills in), the newest level wins.
+ */
+void
+AppleCLCD::blArm(uint32_t ms)
+{
+	if (fBLTimer != NULL && OSCompareAndSwap(0, 1, &fBLArmed)) {
+		fBLTimer->setTimeoutMS(ms);
+	}
+}
+
+bool
+AppleCLCD::panelBLSend(uint32_t dbv, uint64_t *took)
+{
+	static const uint8_t keyOn[3][3] = { { 0x9F, 0xA5, 0xA5 }, { 0xF0, 0x5A, 0x5A }, { 0xFC, 0x5A, 0x5A } };
+	static const uint8_t keyOff[3][3] = { { 0xFC, 0xA5, 0xA5 }, { 0xF0, 0xA5, 0xA5 }, { 0x9F, 0x5A, 0x5A } };
+	static const uint8_t dimming[2] = { 0x53, 0x28 }, update[2] = { 0xF7, 0x0F };
+	uint8_t level[3] = { 0x51, (uint8_t)((dbv >> 8) & 0x03u), (uint8_t)(dbv & 0xffu) };
+	uint32_t cmdq0, cmdqCon, type1;
+	uint64_t t, t0 = mach_absolute_time();
+	bool ok = true, closed = true;
+
+	*took = 0;
+	if (dbv < SWEET_FB_BL_DBV_MIN || dbv > SWEET_FB_BL_DBV_MAX || !a34_dsi_lock()) {
+		return false;
+	}
+	if (!a34_dsi_wait_idle(&t, SWEET_FB_BL_IDLE_MS)) {
+		a34_dsi_unlock();
+		return false;
+	}
+	cmdq0 = a34_dsi_rd(SWEET_FB_DSI_CMDQ(0));
+	cmdqCon = a34_dsi_rd(SWEET_FB_DSI_CMDQ_CON);
+	type1 = a34_dsi_rd(SWEET_FB_DSI_TYPE1_HS);
+	a34_dsi_wr(SWEET_FB_DSI_TYPE1_HS, type1 & ~SWEET_FB_HS_BLANKING);
+	for (unsigned i = 0; i < 3 && ok; i++) {
+		ok = sweet_fb_dcs(keyOn[i], 3);
+	}
+	ok = ok && sweet_fb_dcs(dimming, 2);
+	ok = ok && sweet_fb_dcs(level, 3);
+	ok = ok && sweet_fb_dcs(update, 2);
+	for (unsigned i = 0; i < 3; i++) {
+		closed = sweet_fb_dcs(keyOff[i], 3) && closed;
+	}
+	a34_dsi_wr(SWEET_FB_DSI_CMDQ(0), cmdq0);
+	a34_dsi_wr(SWEET_FB_DSI_CMDQ_CON, cmdqCon);
+	a34_dsi_wr(SWEET_FB_DSI_TYPE1_HS, type1);
+	a34_dsi_unlock();
+	*took = mach_absolute_time() - t0;
+	return ok && closed;
+}
+
+/* A34 (1004): on the kick work loop: the wanted DBV sent if it is new and the last one is SWEET_FB_BL_GAP_MS old */
+void
+AppleCLCD::blPoll(bool timer)
+{
+	uint32_t want = fBLWant;
+	uint64_t now = mach_absolute_time(), gap, took = 0, ns = 0;
+	bool ok;
+
+	if (timer) {
+		(void)OSCompareAndSwap(1, 0, &fBLArmed);
+	}
+	if (!fBLPanel || want == 0 || want == fBLSent) {
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_BL_GAP_MS * NSEC_PER_MSEC, &gap);
+	if (fBLSentAt != 0 && now - fBLSentAt < gap) {
+		absolutetime_to_nanoseconds(gap - (now - fBLSentAt), &ns);
+		blArm((uint32_t)(ns / NSEC_PER_MSEC) + 1);
+		return;
+	}
+	ok = panelBLSend(want, &took);
+	fBLSentAt = mach_absolute_time();
+	absolutetime_to_nanoseconds(took, &ns);
+	if (ok) {
+		fBLSent = want;
+		fBLSends++;
+	} else {
+		fBLFails++;
+		blArm(SWEET_FB_BL_GAP_MS);
+	}
+	if ((ok && (fBLSends <= 8 || (fBLSends % 256) == 0)) || (!ok && fBLFails <= 8)) {
+		IOLog("A34 BL: panel DBV 0x%03x %s in %llu us (%s; %u sent, %u failed)\n", want, ok ? "sent" : "NOT sent",
+		    (unsigned long long)(ns / NSEC_PER_USEC), timer ? "timer" : "after a frame", fBLSends, fBLFails);
+	}
+}
