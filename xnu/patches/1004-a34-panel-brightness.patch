+static void
+sweet_fb_bl_fired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = OSDynamicCast(AppleCLCD, owner);
+
+	(void)sender;
+	if (fb != NULL) {
+		fb->blPoll(true);
 	}
 }
 
