+/*
+ * (0979) the duplicate filter, here: on while bluetoothd's scan asked for it (the controller's off), emptied at
+ * each scan start; Apple's adverts are never filtered (BD_VSC_OLYMPIC_ADV_DUPLICATE_FILTER_BYPASS_CONFIG's job)
+ */
+#define BR_DUP_MAX              512u
+static uint32_t br_dup[BR_DUP_MAX], br_dup_n, br_dup_passed;
+
+static bool
+br_dup_apple(const uint8_t *data, uint32_t len)
+{
+	for (uint32_t at = 0; at + 1 < len;) {
+		uint32_t l = data[at];
+
+		if (l == 0 || at + 1 + l > len) {
+			break;
+		}
+		if (l >= 3 && data[at + 1] == 0xff && data[at + 2] == 0x4c && data[at + 3] == 0x00) {
+			return true;
+		}
+		at += 1 + l;
+	}
+	return false;
+}
+
+/* one report: true to pass it on */
+static bool
+br_dup_pass(uint8_t type, const uint8_t *addr6, uint8_t addr_type, const uint8_t *data, uint32_t len)
+{
+	uint32_t h = 2166136261u;
+
+	if (!br_dup_on || br_dup_apple(data, len)) {
+		return true;
+	}
+	h = (h ^ type) * 16777619u;
+	h = (h ^ addr_type) * 16777619u;
+	for (uint32_t i = 0; i < 6; i++) {
+		h = (h ^ addr6[i]) * 16777619u;
+	}
+	for (uint32_t i = 0; i < len; i++) {
+		h = (h ^ data[i]) * 16777619u;
+	}
+	for (uint32_t i = 0; i < br_dup_n; i++) {
+		if (br_dup[i] == h) {
+			return false;
+		}
+	}
+	if (br_dup_n == BR_DUP_MAX) {
+		br_dup_n = 0;                   /* (full: start again; a few repeats are harmless) */
+	}
+	br_dup[br_dup_n++] = h;
+	return true;
+}
+
+/* an LE Advertising Report (legacy) with the duplicates taken out; the new length, 0 if none is left */
+static uint32_t
+br_dup_report(uint8_t *p, uint32_t n)
+{
+	uint32_t at = 5, o = 5, kept = 0, count = n > 4 ? p[4] : 0;
+
+	if (!br_dup_on || n < 5 || p[0] != 0x04 || p[1] != 0x3e || p[3] != 0x02) {
+		return n;
+	}
+	for (uint32_t i = 0; i < count && at + 10 <= n; i++) {
+		uint32_t dl = p[at + 8], one = 10 + dl;
+
+		if (at + one > n) {
+			break;
+		}
+		if (br_dup_pass(p[at], p + at + 2, p[at + 1], p + at + 9, dl)) {
+			if (o != at) {
+				memmove(p + o, p + at, one);
+			}
+			o += one;
+			kept++;
+		}
+		at += one;
+	}
+	if (kept == 0) {
+		return 0;
+	}
+	p[2] = (uint8_t)(o - 3);
+	p[4] = (uint8_t)kept;
+	br_dup_passed += kept;
+	return o;
+}
+
+/* bluetoothd's scan enable on its way out: the controller's duplicate filter off, this one on in its place */
+static void
+br_dup_command(uint8_t *pkt, uint32_t n)
+{
+	static uint32_t said;
+
+	if (pkt[0] != 0x01 || n < 6 || pkt[2] != 0x20 || (pkt[1] != 0x0c && pkt[1] != 0x42) || (pkt[1] == 0x42 && n < 10)) {
+		return;
+	}
+	if (pkt[4] != 0) {                                      /* enabling: a new scan, an empty filter */
+		br_dup_on = pkt[5] != 0;
+		br_dup_n = 0;
+		if (pkt[5] != 0) {
+			if (said++ < 4) {
+				printf("A34 BT: br: scanning with the duplicate filter here, not in the controller: Apple's adverts "
+				    "all go to bluetoothd\n");
+			}
+			pkt[5] = 0;
+		}
+	}
+}
